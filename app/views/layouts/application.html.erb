<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "CloseYourIt" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CloseYourIt">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= csp_mode_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Design system: Atkinson Hyperlegible Next / Mono (self-hosted in application.css); icons are inline Lucide SVG %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-100 font-sans text-zinc-900 antialiased">
    <% if impersonating? %>
      <div class="sticky top-0 z-50 flex items-center gap-3 bg-amber-50 border-b border-amber-200 px-4 py-2" data-test="impersonation-banner">
        <%= render Ui::IconComponent.new(name: "venetian-mask", class: "text-amber-600 text-[14px]") %>
        <span class="flex-1 text-[12.5px] text-zinc-900"><%= t("impersonations.banner", email: Current.account.email) %></span>
        <%= button_to t("impersonations.exit"), impersonation_path, method: :delete, class: "inline-flex items-center gap-1.5 h-7 px-2.5 rounded-md text-[12px] font-medium text-amber-700 bg-white border border-amber-200 hover:bg-amber-100", data: { test: "impersonation-exit" } %>
      </div>
    <% end %>
    <%= render "shared/flash" %>
    <%= yield %>
    <%= render "shared/icon_templates" %>
  </body>
</html>
