<%# Riga colonna del form. locals: index (numerico o "__INDEX__" nel template), column (o nil).
    Ogni colonna ha un ruolo Input (dato, es. foto) o Target (attributo da predire). Il ruolo è
    forzato/bloccato per kind=photo da datasets-columns#syncRole (option "target" disabilitata, non
    l'intero select — vedi commento nel controller). %>
<div data-column-row class="grid grid-cols-[1fr_115px_130px_auto] gap-3 items-start rounded-md border border-stone-100 dark:border-zinc-800 bg-stone-50/50 dark:bg-zinc-800/50 p-2.5" data-test="datasets-column-row">
  <div>
    <input type="text" name="columns[<%= index %>][label]" value="<%= column&.label %>" placeholder="<%= t('member.datasets.form.column_label_placeholder') %>" data-test="datasets-column-label" class="w-full h-[34px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus:border-indigo-600 dark:focus:border-indigo-400">
    <input type="text" name="columns[<%= index %>][options]" value="<%= column&.option_values&.join(', ') %>" data-options <%= "hidden" unless column&.kind_category? %> placeholder="<%= t('member.datasets.form.options_placeholder') %>" data-test="datasets-column-options" class="mt-2 w-full h-[34px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus:border-indigo-600 dark:focus:border-indigo-400">
    <label class="mt-2 inline-flex items-center gap-1.5 text-[12px] text-gray-600 dark:text-zinc-400 select-none">
      <input type="checkbox" name="columns[<%= index %>][required]" value="1" <%= "checked" if column&.required? %> class="h-3.5 w-3.5 rounded border-stone-300 dark:border-zinc-700 text-indigo-600 dark:text-indigo-400 focus:ring-indigo-500 dark:focus:ring-indigo-400"><%= t("member.datasets.form.required") %>
    </label>
  </div>
  <%= render Ui::SelectComponent.new(name: "columns[#{index}][role]",
        options: [ [ t("member.datasets.form.role_input"), "input" ], [ t("member.datasets.form.role_target"), "target" ] ],
        selected: (column&.role_input? ? "input" : "target"), test_id: "datasets-column-role") %>
  <select name="columns[<%= index %>][kind]" data-action="datasets-columns#onKindChange" data-test="datasets-column-kind" class="h-[34px] px-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus:border-indigo-600 dark:focus:border-indigo-400">
    <% Datasets::Column.kinds.keys.each do |kind| %>
      <option value="<%= kind %>" <%= "selected" if column&.kind == kind %>><%= t("member.datasets.kinds.#{kind}") %></option>
    <% end %>
  </select>
  <button type="button" data-action="datasets-columns#remove" data-test="datasets-column-remove" class="h-[34px] w-[34px] inline-flex items-center justify-center rounded-md text-gray-400 dark:text-zinc-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/15" aria-label="<%= t('member.datasets.form.remove_column') %>"><%= render Ui::IconComponent.new(name: "x", class: "text-[13px]") %></button>
</div>
