<% editing = @row.persisted? %>
<% ordered = @columns.select(&:role_input?) + @columns.select(&:role_target?) %>
<% input_klass = "w-full h-[34px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus:border-indigo-600 dark:focus:border-indigo-400" %>

<%= form_with url: (editing ? member_dataset_row_path(@dataset, @row) : member_dataset_rows_path(@dataset)),
              method: (editing ? :patch : :post), multipart: true do %>
  <div class="p-7 space-y-6" data-test="member-dataset-row-form">
    <%= render Ui::PageHeaderComponent.new(
          title: editing ? t("member.datasets.rows.edit_title") : t("member.datasets.rows.new_title"),
          breadcrumb: [ { label: t("member.datasets.title"), href: member_datasets_path },
                        { label: @dataset.name, href: member_dataset_path(@dataset) },
                        { label: editing ? t("member.datasets.rows.edit") : t("member.datasets.rows.new") } ]) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.datasets.cancel"), href: member_dataset_path(@dataset), variant: :secondary_muted, size: :sm, test_id: "dataset-row-cancel") %>
        <%= render Ui::ButtonComponent.new(label: t("member.datasets.save"), type: "submit", variant: :primary, size: :sm, icon: "check", test_id: "dataset-row-submit") %>
      <% end %>
    <% end %>

    <% if flash.now[:alert].present? %>
      <div class="rounded-md border border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/15 px-4 py-3 text-[12.5px] text-red-700 dark:text-red-300 max-w-2xl" data-test="dataset-row-errors"><%= flash.now[:alert] %></div>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 space-y-5 max-w-2xl">
      <% ordered.each do |column| %>
        <% required = column.role_target? || (column.role_input? && column.required?) %>
        <div data-test="row-field-<%= column.code %>">
          <label class="flex items-center gap-2 text-[12px] font-medium text-gray-700 dark:text-zinc-300 mb-1.5">
            <span><%= column.label %><% if required %><span class="text-red-500 dark:text-red-400 ml-0.5">*</span><% end %></span>
            <% if column.role_target? %><span class="font-mono text-[9px] uppercase tracking-[0.5px] text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/15 rounded px-1.5 py-0.5"><%= t("member.datasets.form.role_target") %></span><% end %>
          </label>
          <% case column.kind %>
          <% when "photo" %>
            <% existing = editing ? @row.cells.detect { |c| c.column_id == column.id && c.image.attached? } : nil %>
            <% if existing %>
              <%= image_tag rails_blob_path(existing.image, disposition: :inline),
                    alt: t("member.datasets.rows.photo_preview_alt", column: column.label),
                    loading: "lazy", decoding: "async",
                    class: "w-16 h-16 object-cover rounded border border-stone-200 dark:border-zinc-800 mb-2" %>
            <% end %>
            <input type="file" name="photos[<%= column.code %>]" accept="image/png,image/jpeg,image/webp" class="block text-[12.5px] text-gray-600 dark:text-zinc-400 file:mr-3 file:h-[30px] file:px-3 file:rounded-md file:border file:border-stone-200 dark:file:border-zinc-800 file:bg-white dark:file:bg-zinc-900 file:text-[12px] file:text-gray-700 dark:file:text-zinc-300">
          <% when "boolean" %>
            <label class="inline-flex items-center gap-2 text-[13px] text-gray-700 dark:text-zinc-300">
              <input type="checkbox" name="values[<%= column.code %>]" value="true" <%= "checked" if ActiveModel::Type::Boolean.new.cast(@row.value_for(column.code)) %> class="h-4 w-4 rounded border-stone-300 dark:border-zinc-700 text-indigo-600 dark:text-indigo-400 focus:ring-indigo-500 dark:focus:ring-indigo-400">
              <%= column.label %>
            </label>
          <% when "category" %>
            <%= render Ui::SelectComponent.new(name: "values[#{column.code}]", test_id: "row-value-#{column.code}",
                  options: column.option_values.map { |option| [ option, option ] },
                  selected: @row.value_for(column.code), include_blank: true,
                  placeholder: t("member.datasets.rows.choose")) %>
          <% when "number" %>
            <input type="number" step="any" name="values[<%= column.code %>]" value="<%= @row.value_for(column.code) %>" class="<%= input_klass %>">
          <% else %>
            <input type="text" name="values[<%= column.code %>]" value="<%= @row.value_for(column.code) %>" class="<%= input_klass %>">
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
