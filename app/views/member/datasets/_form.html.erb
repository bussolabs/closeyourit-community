<% editing = @dataset.persisted? %>
<% columns = editing ? @dataset.columns.ordered.to_a : [] %>
<% locked = @locked_columns %>
<% input_klass = "w-full h-[34px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus:border-indigo-600 dark:focus:border-indigo-400" %>

<%= form_with url: (editing ? member_dataset_path(@dataset) : member_datasets_path),
              method: (editing ? :patch : :post),
              data: { controller: "datasets-columns", "datasets-columns-index-value": columns.size } do %>
  <div class="p-7 space-y-6" data-test="member-dataset-form">
    <%= render Ui::PageHeaderComponent.new(
          title: editing ? t("member.datasets.edit_title") : t("member.datasets.new_title"),
          breadcrumb: [ { label: t("member.datasets.title"), href: member_datasets_path },
                        { label: editing ? @dataset.name : t("member.datasets.new") } ]) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.datasets.cancel"), href: (editing ? member_dataset_path(@dataset) : member_datasets_path), variant: :secondary_muted, size: :sm, test_id: "datasets-form-cancel") %>
        <%= render Ui::ButtonComponent.new(label: (editing ? t("member.datasets.save") : t("member.datasets.create_action")), type: "submit", variant: :primary, size: :sm, icon: "check", test_id: "datasets-form-submit") %>
      <% end %>
    <% end %>

    <% if flash.now[:alert].present? %>
      <div class="rounded-md border border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/15 px-4 py-3 text-[12.5px] text-red-700 dark:text-red-300 max-w-3xl" data-test="datasets-form-errors"><%= flash.now[:alert] %></div>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 space-y-5 max-w-3xl">
      <div>
        <label class="block text-[12px] font-medium text-gray-700 dark:text-zinc-300 mb-1.5"><%= t("member.datasets.form.name") %><span class="text-red-500 dark:text-red-400 ml-0.5">*</span></label>
        <input type="text" name="dataset[name]" value="<%= @dataset.name %>" required data-test="datasets-form-name" class="<%= input_klass %>">
      </div>

      <div>
        <label class="block text-[12px] font-medium text-gray-700 dark:text-zinc-300 mb-1.5"><%= t("member.datasets.form.description") %></label>
        <textarea name="dataset[description]" rows="2" data-test="datasets-form-description" class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 focus:border-indigo-600 dark:focus:border-indigo-400"><%= @dataset.description %></textarea>
      </div>

      <% if editing %>
        <div class="text-[12.5px] text-gray-500 dark:text-zinc-400" data-test="datasets-form-project-fixed"><%= t("member.datasets.form.project") %>: <span class="font-medium text-gray-700 dark:text-zinc-300"><%= @dataset.project.name %></span></div>
      <% else %>
        <div>
          <label class="block text-[12px] font-medium text-gray-700 dark:text-zinc-300 mb-1.5"><%= t("member.datasets.form.project") %><span class="text-red-500 dark:text-red-400 ml-0.5">*</span></label>
          <%= render Ui::SelectComponent.new(name: "dataset[project_id]", options: @projects.map { |p| [ p.name, p.id ] }, selected: @dataset.project_id, required: true, include_blank: true, placeholder: t("member.datasets.form.project_placeholder"), test_id: "datasets-form-project") %>
        </div>
      <% end %>

      <div class="border-t border-stone-100 dark:border-zinc-800 pt-5">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-[13px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.datasets.form.columns_title") %></h3>
          <% unless locked %>
            <button type="button" data-action="datasets-columns#add" data-test="datasets-form-add-column" class="inline-flex items-center gap-1.5 h-[30px] px-2.5 rounded-md border border-stone-200 dark:border-zinc-800 text-[12px] text-gray-600 dark:text-zinc-400 hover:border-stone-300 dark:hover:border-zinc-700"><%= render Ui::IconComponent.new(name: "plus", class: "text-[11px]") %><%= t("member.datasets.form.add_column") %></button>
          <% end %>
        </div>
        <p class="text-[12px] text-gray-500 dark:text-zinc-400 mb-3"><%= t("member.datasets.form.columns_hint") %></p>

        <% if locked %>
          <div class="text-[12.5px] text-gray-500 dark:text-zinc-400 mb-2" data-test="datasets-form-locked"><%= t("member.datasets.form.locked") %></div>
          <div class="space-y-1.5" data-test="datasets-form-columns-locked">
            <% columns.each do |column| %>
              <div class="text-[12.5px] text-gray-600 dark:text-zinc-400"><%= column.label %> <span class="font-mono text-[10.5px] text-gray-500 dark:text-zinc-400">(<%= t("member.datasets.form.role_#{column.role}") %> · <%= t("member.datasets.kinds.#{column.kind}") %>)</span></div>
            <% end %>
          </div>
        <% else %>
          <div class="space-y-2.5" data-datasets-columns-target="list" data-test="datasets-form-columns">
            <% columns.each_with_index do |column, index| %>
              <%= render "member/datasets/column_row", index: index, column: column %>
            <% end %>
          </div>
          <p class="text-[12px] text-gray-500 dark:text-zinc-400 py-2" data-datasets-columns-target="empty" <%= "hidden" if columns.any? %> data-test="datasets-form-columns-empty"><%= t("member.datasets.form.no_columns") %></p>
          <template data-datasets-columns-target="template">
            <%= render "member/datasets/column_row", index: "__INDEX__", column: nil %>
          </template>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
