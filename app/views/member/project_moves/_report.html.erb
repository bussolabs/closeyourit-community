<%# locals: report %>
<%# CYRA-879 — the three lists of a dry run: what blocks the move, what it creates in the
    destination, which links stay behind. Each list is empty in its own words, never hidden. %>
<% item_class = "px-4 py-2.5 text-[12.5px]" %>
<% empty_text = t("member.project_moves.report.empty") %>

<%= render Ui::SectionComponent.new(title: t("member.project_moves.report.blockers"), body_class: nil,
      test_id: "move-blockers") do %>
  <% if report.blockers.empty? %>
    <%= render Ui::EmptyNoteComponent.new(text: empty_text, inset: true) %>
  <% else %>
    <ul class="divide-y divide-stone-200 dark:divide-zinc-800">
      <% report.blockers.each do |blocker| %>
        <li class="<%= item_class %> text-red-700 dark:text-red-300 flex items-start gap-2" data-test="move-blocker-<%= blocker[:code] %>">
          <%= render Ui::IconComponent.new(name: "circle-alert", class: "mt-0.5 text-[12px]") %>
          <span><%= t("member.project_moves.blockers.#{blocker[:code]}", detail: blocker[:detail]) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%= render Ui::SectionComponent.new(title: t("member.project_moves.report.creations"), body_class: nil,
      test_id: "move-creations") do %>
  <% if report.creations.empty? %>
    <%= render Ui::EmptyNoteComponent.new(text: empty_text, inset: true) %>
  <% else %>
    <ul class="divide-y divide-stone-200 dark:divide-zinc-800">
      <% report.creations.each do |creation| %>
        <li class="<%= item_class %> text-zinc-900 dark:text-zinc-100" data-test="move-creation">
          <%= project_move_creation_text(creation) %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%= render Ui::SectionComponent.new(title: t("member.project_moves.report.detachments"), body_class: nil,
      test_id: "move-detachments") do %>
  <% if report.detachments.empty? %>
    <%= render Ui::EmptyNoteComponent.new(text: empty_text, inset: true) %>
  <% else %>
    <ul class="divide-y divide-stone-200 dark:divide-zinc-800">
      <% report.detachments.each do |detachment| %>
        <li class="<%= item_class %> text-zinc-900 dark:text-zinc-100" data-test="move-detachment-<%= detachment[:table] %>">
          <%= project_move_detachment_text(detachment) %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
