<%# locals: (name:, description:, name_editable:, dom:, errors: nil) %>
<%# CYRA-924 — the variable's name and its one description, on top of both secret dialogs. %>
<% field_class = "mt-1 block w-full rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-2.5 py-1.5 text-zinc-900 dark:text-zinc-100 focus:border-indigo-600 dark:focus:border-indigo-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400" %>
<div class="space-y-3">
  <div>
    <label for="secret-name-<%= dom %>" class="text-[12px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.secrets.name_label") %></label>
    <% if name_editable %>
      <input type="text" id="secret-name-<%= dom %>" name="name" value="<%= name %>" placeholder="<%= t('member.secrets.new_name') %>"
             autocomplete="off" required pattern="[A-Za-z_][A-Za-z0-9_]*" title="<%= t("member.review_fixes.secret_name_hint") %>" autofocus data-test="secret-<%= dom %>-name"
             class="<%= field_class %> font-mono text-[12.5px] <%= 'border-rose-300 dark:border-rose-500/50' if errors.present? %>">
    <% else %>
      <input type="hidden" name="name" value="<%= name %>">
      <input type="text" id="secret-name-<%= dom %>" value="<%= name %>" readonly data-test="secret-<%= dom %>-name"
             class="<%= field_class %> bg-stone-50 dark:bg-zinc-800 font-mono text-[12.5px] text-gray-500 dark:text-zinc-400">
    <% end %>
    <% if errors.present? %>
      <p class="mt-1 text-[12px] text-rose-600 dark:text-rose-400" data-test="secret-<%= dom %>-error"><%= errors.values.flatten.first %></p>
    <% end %>
  </div>
  <div>
    <label for="secret-description-<%= dom %>" class="text-[12px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.secrets.description_placeholder") %></label>
    <input type="text" id="secret-description-<%= dom %>" name="description" value="<%= description %>"
           data-secret-row-target="description" data-test="secret-<%= dom %>-description"
           class="<%= field_class %> text-[12.5px]">
  </div>
</div>
