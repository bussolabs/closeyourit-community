<%# locals: (hit:, query:) %>
<%# data-global-search-result feeds keyboard navigation and the recents list (ui--global-search). %>
<%# CYRA-1145 — an action the viewer may not run stays visible, greyed, with the reason; it is not a result. %>
<% if hit.blocked %>
  <div class="flex items-center gap-3 px-3 py-2 text-left opacity-60 cursor-not-allowed" aria-disabled="true"
       data-test="global-search-result-<%= hit.test_id %>">
    <%= render "member/searches/hit_body", hit: hit, query: query, meta: hit.blocked %>
  </div>
<% else %>
  <%= link_to hit.href,
        class: "flex items-center gap-3 px-3 py-2 text-left hover:bg-stone-50 dark:hover:bg-zinc-800 focus-visible:outline-none focus-visible:bg-indigo-50 dark:focus-visible:bg-indigo-500/15 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-600",
        data: { test: "global-search-result-#{hit.test_id}", turbo_frame: "_top", turbo_method: hit.method,
                turbo_confirm: hit.confirm, global_search_result: "", title: hit.title, meta: hit.meta, icon: hit.icon,
                action: "keydown->ui--global-search#resultKeydown click->ui--global-search#remember" } do %>
    <%= render "member/searches/hit_body", hit: hit, query: query, meta: hit.meta %>
  <% end %>
<% end %>
