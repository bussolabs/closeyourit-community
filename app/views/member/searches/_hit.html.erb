<%# locals: (hit:, query:) %>
<%# data-global-search-result feeds keyboard navigation and the recents list (ui--global-search). %>
<%= link_to hit.href,
      class: "flex items-center gap-3 px-3 py-2 text-left hover:bg-stone-50 dark:hover:bg-zinc-800 focus-visible:outline-none focus-visible:bg-indigo-50 dark:focus-visible:bg-indigo-500/15 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-600",
      data: { test: "global-search-result-#{hit.test_id}", turbo_frame: "_top", turbo_method: hit.method,
              global_search_result: "", title: hit.title, meta: hit.meta, icon: hit.icon,
              action: "keydown->ui--global-search#resultKeydown click->ui--global-search#remember" } do %>
  <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-stone-100 dark:bg-zinc-800 text-gray-500 dark:text-zinc-400" aria-hidden="true">
    <%= render Ui::IconComponent.new(name: hit.icon, class: "text-[12px]") %>
  </span>
  <span class="min-w-0">
    <span class="block truncate text-[13px] font-medium text-zinc-900 dark:text-zinc-100"><%= search_highlight(hit.title, query) %></span>
    <span class="mt-0.5 block truncate font-mono text-[10px] text-gray-500 dark:text-zinc-400"><%= hit.meta %></span>
  </span>
<% end %>
