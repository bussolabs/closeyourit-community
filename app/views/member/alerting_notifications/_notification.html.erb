<%# locals: group — riga del notification center: un Alerting::NotificationGroup (broadcast via Turbo
     ne crea uno di un solo elemento, vedi Notifications::Deliver) %>
<% notification = group.representative %>
<% tone = alerting_event_tone(notification.event_type) %>
<%# CYRA-488 — un guasto grave di produzione si distingue a colpo d'occhio (barra rossa + chip),
     così non serve leggerle tutte per trovarlo in mezzo alle ripetizioni. %>
<% critical = alerting_critical?(notification.event_type) %>
<%# href: solo path interni (notification.url è un path Rails da Alerting::Content) — guard anti-XSS %>
<% safe_url = notification.url.to_s.start_with?("/") ? notification.url : "#" %>
<li id="<%= dom_id(notification) %>"
    class="relative flex items-start gap-3 px-4 py-3.5 <%= "border-l-2 border-rose-500 " if critical %><%= group.read? ? "hover:bg-stone-50 dark:hover:bg-zinc-800" : "bg-indigo-50/40 dark:bg-indigo-500/10 hover:bg-indigo-50/70 dark:hover:bg-indigo-500/15" %>"
    data-test="notification-row">
  <% unless group.read? %>
    <span class="absolute left-1.5 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-indigo-500" data-test="notification-unread-dot"></span>
  <% end %>
  <span class="ml-1.5 inline-flex items-center justify-center w-8 h-8 rounded-full <%= tone[:bg] %> <%= tone[:fg] %> shrink-0">
    <%= render Ui::IconComponent.new(name: tone[:icon], class: "text-[13px]") %>
  </span>
  <div class="min-w-0 flex-1">
    <%= link_to(safe_url, class: "block") do %>
      <%# CYRA-488 — etichetta scritta del tipo accanto all'icona: dichiara di che avviso si tratta
           («Server giù», «Revisione richiesta») senza doverlo dedurre dalla sola icona. %>
      <p class="flex items-center gap-1.5 mb-0.5">
        <span class="font-mono text-[10.5px] uppercase tracking-wide text-gray-400 dark:text-zinc-500" data-test="notification-type-label"><%= alerting_event_label(notification.event_type) %></span>
        <% if critical %>
          <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 dark:bg-rose-500/15 px-1.5 py-0.5 text-[10px] font-semibold text-rose-700 dark:text-rose-300 uppercase tracking-wide" data-test="notification-critical"><%= render Ui::IconComponent.new(name: "triangle-alert", class: "text-[9px]") %><%= t("alerting.notifications.severity.critical") %></span>
        <% end %>
      </p>
      <p class="text-[13px] <%= group.read? ? "font-medium text-gray-600 dark:text-zinc-400" : "font-semibold text-zinc-900 dark:text-zinc-100" %>">
        <%= notification.title %>
        <% if group.repeated? %>
          <span class="ml-1 inline-flex items-center rounded-full bg-stone-100 dark:bg-zinc-800 px-1.5 py-0.5 text-[10px] font-semibold text-gray-600 dark:text-zinc-400 align-middle" data-test="notification-repeat-badge">×<%= group.count %></span>
        <% end %>
        <% if alerting_conversation?(notification.event_type) %>
          <span class="ml-1 inline-flex items-center rounded-full bg-sky-50 dark:bg-sky-500/15 px-1.5 py-0.5 text-[10px] font-semibold text-sky-700 dark:text-sky-300 align-middle" data-test="notification-conversation-tag"><%= t("alerting.notifications.category.conversation") %></span>
        <% end %>
      </p>
      <% if notification.body.present? %>
        <p class="text-[12.5px] text-gray-500 dark:text-zinc-400 mt-0.5 truncate"><%= notification.body %></p>
      <% end %>
      <p class="font-mono text-[11px] text-gray-500 dark:text-zinc-400 mt-1">
        <% if notification.project %><span class="text-indigo-600 dark:text-indigo-400"><%= notification.project.key %></span> · <% end %><%= t("alerting.notifications.time_ago", time: time_ago_in_words(notification.created_at)) %>
        <%# F115 — the recovery of this alert, when one arrived (absent on a broadcast row). %>
        <% if (recovered_at = (local_assigns[:recoveries] || {})[notification.id]) %>
          · <span class="text-emerald-700 dark:text-emerald-300" data-test="notification-recovered"><%= t("alerting.notifications.recovered_after", time: distance_of_time_in_words(notification.created_at, recovered_at)) %></span>
        <% end %>
      </p>
    <% end %>
    <% if notification.details.present? %>
      <details class="mt-1 text-[12px]" data-test="notification-details">
        <summary class="cursor-pointer text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300"><%= t("alerting.notifications.show_details") %></summary>
        <ul class="mt-1 pl-4 list-disc text-gray-600 dark:text-zinc-400">
          <% Array(notification.details).each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
  <% unless group.read? %>
    <%= button_to read_member_alerting_notification_path(notification, ids: group.ids), method: :patch,
          class: "shrink-0 inline-flex items-center justify-center h-7 w-7 rounded-md text-gray-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-white dark:hover:bg-zinc-900 border border-transparent hover:border-stone-200 dark:hover:border-zinc-800",
          form: { data: { turbo_stream: true } },
          title: t("alerting.notifications.mark_read"), aria: { label: t("alerting.notifications.mark_read") },
          data: { test: "notification-read" } do %>
      <%= render Ui::IconComponent.new(name: "check", class: "text-[12px]") %>
    <% end %>
  <% end %>
</li>
