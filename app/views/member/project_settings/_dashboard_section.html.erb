<%# CYRA-1112 — where CloseYourIt reads the service's Open Dashboard, its key, the last read and its controls. %>
<% feed = @dashboard_feed %>
<%= render Ui::SectionComponent.new(title: t("member.dashboards.settings.title"), id: "dashboard", class: "scroll-mt-4",
      body_class: "divide-y divide-stone-100 dark:divide-zinc-800", test_id: "project-dashboard") do |section| %>
  <% section.with_subtitle do %>
    <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.dashboards.settings.subtitle") %></p>
  <% end %>

  <% if @dashboard_revealed %>
    <%= render "member/project_settings/dashboard_reveal" %>
  <% end %>

  <%= form_with url: member_project_dashboard_feed_path(@project), method: :post, class: "block px-4 py-4",
        data: { test: "dashboard-form" } do %>
    <%= render Ui::InputComponent.new(name: "url", id: "dashboard_url", type: "url", required: true,
          label: t("member.dashboards.settings.url_label"), value: @dashboard_url || feed&.url,
          hint: t("member.dashboards.settings.url_hint"), error: @dashboard_errors&.dig(:url)&.first,
          autocomplete: "url", inputmode: "url", test_id: "dashboard-url") %>
    <div class="mt-3 flex justify-end">
      <%= render Ui::ButtonComponent.new(label: t("member.dashboards.settings.#{feed ? 'reconnect' : 'connect'}"),
            type: "submit", variant: :primary, size: :sm, icon: "link", test_id: "dashboard-connect") %>
    </div>
  <% end %>

  <% if feed %>
    <% state = Dashboards::ReportView.new(feed).state %>
    <% error_key = feed.last_error.to_s.start_with?("http_") ? "http" : feed.last_error %>
    <div class="px-4 py-4">
      <%= render Ui::DescriptionListComponent.new(columns: 2, test_id: "dashboard-status") do |list| %>
        <% list.with_item(label: t("member.dashboards.settings.last_read"), test_id: "dashboard-state") do %>
          <%= render Ui::BadgeComponent.new(label: t("member.dashboards.settings.state_#{state}"), dot: true,
                color: { ok: :green, failed: :red, never: :gray }.fetch(state)) %>
          <% if feed.checked_at && state != :never %>
            <span class="ml-1.5 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.dashboards.settings.read_ago", time: time_ago_in_words(feed.checked_at)) %></span>
          <% end %>
        <% end %>
        <% if error_key.present? %>
          <% list.with_item(label: t("member.dashboards.settings.last_error"), test_id: "dashboard-error",
                value: t("member.dashboards.errors.#{error_key}")) %>
        <% end %>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-2 px-4 py-3" data-test="dashboard-actions">
      <%= render Ui::ButtonComponent.new(label: t("member.dashboards.settings.refresh"), variant: :secondary, size: :sm,
            href: refresh_member_project_dashboard_feed_path(@project), method: :post, icon: "refresh-cw",
            test_id: "dashboard-refresh") %>
      <%= render Ui::ButtonComponent.new(label: t("member.dashboards.settings.#{feed.enabled? ? 'pause' : 'resume'}"),
            variant: :secondary, size: :sm, href: member_project_dashboard_feed_path(@project, enabled: feed.enabled? ? 0 : 1),
            method: :patch, icon: feed.enabled? ? "pause" : "play", test_id: "dashboard-toggle") %>
      <%= render Ui::ConfirmDialogComponent.new(title: t("member.dashboards.settings.disconnect_confirm_title", project: @project.name),
            url: member_project_dashboard_feed_path(@project), confirm_label: t("member.dashboards.settings.disconnect"),
            test_id: "dashboard-disconnect-dialog") do |dialog| %>
        <% dialog.with_body { t("member.dashboards.settings.disconnect_confirm_body") } %>
        <%= dialog.button_trigger(label: t("member.dashboards.settings.disconnect"), icon: "unlink", test_id: "dashboard-disconnect") %>
      <% end %>
    </div>
  <% end %>
<% end %>
