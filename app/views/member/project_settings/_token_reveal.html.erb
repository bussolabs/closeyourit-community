<%# The bearer secret and the project ID, shown once after creation: the gem needs both. %>
<div data-test="token-reveal" class="border-b border-indigo-200 dark:border-indigo-500/40 bg-indigo-50/40 dark:bg-indigo-500/10">
  <div class="flex items-center gap-2 px-4 py-3 border-b border-indigo-200 dark:border-indigo-500/40 flex-wrap">
    <%= render Ui::IconComponent.new(name: "circle-check", class: "text-indigo-600 dark:text-indigo-400 text-[13px]") %>
    <h3 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.tokens.reveal.created", name: @revealed[:token].name) %></h3>
    <%= render Ui::BadgeComponent.new(label: @revealed[:token].environment.label, color: @revealed[:token].environment.color, dot: true) %>
    <% if @revealed[:token].expires_at %>
      <span class="inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 text-[11px] font-medium bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400" data-test="token-reveal-expiry"><%= render Ui::IconComponent.new(name: "clock", class: "text-[10px]") %><%= t("member.tokens.reveal.expires_at", date: l(@revealed[:token].expires_at.to_date, format: :long)) %></span>
    <% end %>
    <span class="ml-auto inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 text-[11px] font-medium bg-amber-50 dark:bg-amber-500/15 text-amber-700 dark:text-amber-300"><%= render Ui::IconComponent.new(name: "triangle-alert", class: "text-[10px]") %><%= t("member.tokens.reveal.copy_now") %></span>
  </div>
  <div class="px-4 py-4 space-y-3">
    <div data-controller="clipboard" data-clipboard-copied-value="<%= t('member.tokens.reveal.copied') %>">
      <p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.tokens.reveal.bearer") %></p>
      <div class="mt-1.5 flex items-stretch gap-2">
        <code data-clipboard-target="source" data-test="token-secret" class="flex-1 min-w-0 truncate rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 py-2 font-mono text-[12px] text-zinc-800 dark:text-zinc-200"><%= @revealed[:secret] %></code>
        <button type="button" data-action="clipboard#copy" class="inline-flex items-center gap-1.5 h-[37px] px-3 rounded-md text-[12px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800 shrink-0"><%= render Ui::IconComponent.new(name: "copy", class: "text-[12px] text-gray-400 dark:text-zinc-500") %><span data-clipboard-target="label"><%= t("member.tokens.reveal.copy") %></span></button>
      </div>
    </div>
    <div data-controller="clipboard" data-clipboard-copied-value="<%= t('member.tokens.reveal.copied') %>">
      <p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.tokens.reveal.project_id") %></p>
      <div class="mt-1.5 flex items-stretch gap-2">
        <code data-clipboard-target="source" data-test="token-project-id" class="flex-1 min-w-0 truncate rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 py-2 font-mono text-[12px] text-zinc-800 dark:text-zinc-200"><%= @project.id %></code>
        <button type="button" data-action="clipboard#copy" class="inline-flex items-center gap-1.5 h-[37px] px-3 rounded-md text-[12px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800 shrink-0"><%= render Ui::IconComponent.new(name: "copy", class: "text-[12px] text-gray-400 dark:text-zinc-500") %><span data-clipboard-target="label"><%= t("member.tokens.reveal.copy") %></span></button>
      </div>
    </div>
    <%= render Ui::DescriptionListComponent.new(columns: 1) do |list| %>
      <% list.with_item(label: t("member.tokens.reveal.sentry_dsn")) do %>
        <%= render Ui::StackComponent.new(direction: :row, gap: 2, align: :start, class: "mt-1.5",
              data: { controller: "clipboard", clipboard_copied_value: t("member.tokens.reveal.copied") }) do %>
          <code data-clipboard-target="source" data-test="token-sentry-dsn" class="flex-1 min-w-0 break-all font-mono text-[12px] text-zinc-800 dark:text-zinc-200"><%= @revealed[:sentry_dsn] %></code>
          <%= render Ui::ButtonComponent.new(variant: :secondary, size: :sm, icon: "copy",
                data: { action: "clipboard#copy" }) do %>
            <span data-clipboard-target="label"><%= t("member.tokens.reveal.copy") %></span>
          <% end %>
        <% end %>
        <p class="mt-1 text-[12px] font-sans text-gray-500 dark:text-zinc-400"><%= t("member.tokens.reveal.sentry_hint") %></p>
      <% end %>
    <% end %>
    <div class="flex justify-end pt-1">
      <%= link_to t("member.tokens.reveal.close"), member_project_settings_path(@project, anchor: "tokens"), class: "inline-flex items-center h-[30px] px-3 rounded-md text-[12px] font-medium text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100", data: { test: "token-reveal-close" } %>
    </div>
  </div>
</div>
