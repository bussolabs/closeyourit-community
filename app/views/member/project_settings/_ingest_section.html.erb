<%= render Ui::SectionComponent.new(title: t("member.project_settings.ingest_section"), id: "ingest",
      class: "scroll-mt-20", body_class: "px-4 py-4", test_id: "project-ingest-section") do |section| %>
  <% section.with_actions do %><%= render "member/project_settings/save_action", anchor: "ingest" %><% end %>
  <label for="allowed_origins" class="block text-[12px] font-medium text-zinc-900 dark:text-zinc-100 mb-1.5"><%= t("member.project_settings.allowed_origins_label") %></label>
  <textarea name="allowed_origins" id="allowed_origins" rows="3" data-test="project-allowed-origins" placeholder="<%= t("member.project_settings.allowed_origins_placeholder") %>" class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 font-mono text-[12.5px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= @project.allowed_origins.join("\n") %></textarea>
  <p class="mt-1.5 text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.project_settings.allowed_origins_hint") %></p>
  <% if @errors&.dig(:allowed_origins)&.first %>
    <p class="mt-1 text-[11px] text-red-600 dark:text-red-400" data-test="project-allowed-origins-error"><%= @errors.dig(:allowed_origins).first %></p>
  <% end %>
<% end %>
