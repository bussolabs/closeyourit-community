<%# locals: () %>
<%# CYRA-935 — waits under the page: the Support button slides the whole page up and this shows. %>
<div hidden data-ui--support-target="screen" data-test="support-screen"
     class="absolute inset-0 z-0 flex flex-col md:p-3.5 bg-stone-100 dark:bg-zinc-950">
  <div class="relative flex-1 min-h-0 overflow-hidden md:rounded-xl md:border md:border-stone-200 dark:md:border-zinc-800">
    <div data-panels="flush" data-controller="ui--panel-edges" class="relative h-full overflow-y-auto md:overflow-x-hidden">
      <%= render "member/support_requests/form", body: nil, error: nil %>
    </div>
  </div>
</div>
