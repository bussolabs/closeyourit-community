<%# locals: (position:, options:) %>
<%# The agent's proposed answers for one question: the recommended one is already picked, «Altro» leaves
    the free text. The radios belong to the reply form through `form=`. CYRA-887 %>
<fieldset class="mt-1.5 ml-5 flex flex-wrap gap-1.5" data-test="approvals-clarification-options">
  <legend class="sr-only"><%= t("member.approvals.clarification.options_legend", position: position) %></legend>
  <% options.each do |option| %>
    <label class="inline-flex items-center gap-1.5 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-2.5 py-1 text-[12.5px] cursor-pointer has-[:checked]:border-indigo-600 dark:has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50 dark:has-[:checked]:bg-indigo-500/15 has-[:checked]:text-indigo-700 dark:has-[:checked]:text-indigo-300">
      <%= radio_button_tag "answers[#{position}]", option["label"], option["recommended"] == true, form: "approvals-reply-form", class: "accent-indigo-600" %>
      <%= option["label"] %>
      <% if option["recommended"] == true %><span class="text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.approvals.clarification.recommended") %></span><% end %>
    </label>
  <% end %>
  <label class="inline-flex items-center gap-1.5 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-2.5 py-1 text-[12.5px] cursor-pointer has-[:checked]:border-indigo-600 dark:has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50 dark:has-[:checked]:bg-indigo-500/15">
    <%= radio_button_tag "answers[#{position}]", "", false, form: "approvals-reply-form", class: "accent-indigo-600" %>
    <%= t("member.approvals.clarification.other") %>
  </label>
</fieldset>
