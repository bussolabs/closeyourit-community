<%# locals: (card:) %>
  <%# ANTI-DISCLOSURE: qui non compare MAI il valore del segreto — solo di cosa si tratta, chi l'ha
      chiesto e perché. Il valore resta cifrato e non serve per decidere. %>
  <%# One sentence for the change; in production the risk says what breaks. CYRA-884 %>
  <% change = card.record %>
  <div class="px-4 pt-3.5 space-y-2" data-test="approvals-secret-headline">
    <p class="font-display text-[16px] font-semibold text-zinc-900 dark:text-zinc-100 leading-snug text-balance">
      <%= t("member.approvals.secret.headline.#{change.action}", name: change.name, environment: change.environment.label) %>
    </p>
    <% if change.environment.code == "production" %>
      <p class="inline-flex items-start gap-1.5 rounded-md border border-rose-200 dark:border-rose-500/40 bg-rose-50 dark:bg-rose-500/15 px-2.5 py-1.5 text-[12.5px] text-rose-800 dark:text-rose-200" data-test="approvals-secret-risk">
        <%= render Ui::IconComponent.new(name: "triangle-alert", class: "text-[10px] mt-1") %><span><%= t("member.approvals.secret.production_risk.#{change.action}") %></span>
      </p>
    <% end %>
  </div>
  <dl class="px-4 py-3.5 grid grid-cols-1 sm:grid-cols-2 gap-4" data-test="approvals-detail-secret">
    <div>
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.approvals.secret.variable") %></dt>
      <dd class="mt-0.5 font-mono text-[12.5px] text-zinc-900 dark:text-zinc-100"><%= card.record.name %></dd>
    </div>
    <div>
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.approvals.secret.environment") %></dt>
      <dd class="mt-0.5 text-[12.5px] text-zinc-900 dark:text-zinc-100"><%= card.record.environment.label %></dd>
    </div>
    <div>
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.approvals.secret.project") %></dt>
      <dd class="mt-0.5 text-[12.5px] text-zinc-900 dark:text-zinc-100"><%= card.record.project.name %></dd>
    </div>
    <div>
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.approvals.secret.requested_by") %></dt>
      <dd class="mt-0.5 text-[12.5px] text-zinc-900 dark:text-zinc-100"><%= card.record.requested_by&.name %></dd>
    </div>
    <% if card.record.reason.present? %>
      <div class="sm:col-span-2">
        <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.approvals.secret.reason") %></dt>
        <dd class="mt-0.5 text-[12.5px] text-zinc-700 dark:text-zinc-300 leading-relaxed"><%= card.record.reason %></dd>
      </div>
    <% end %>
  </dl>
