<%# locals: category, group, url, method, title, submit_label %>
<% content_for :title, title %>
<% crumbs = [ { label: t("member.product.matrices.title"), href: member_product_matrices_path },
              { label: group.name, href: member_product_matrix_path(group) },
              { label: category.persisted? ? t("member.breadcrumb.edit") : t("member.breadcrumb.new") } ] %>

<div class="p-7">
  <%= form_with url: url, method: method, class: "space-y-6", data: { test: "product-category-form" } do %>
    <%= render Ui::PageHeaderComponent.new(title: title, breadcrumb: crumbs) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.product.cancel"), href: member_product_matrix_path(group), variant: :secondary_muted, size: :sm) %>
        <%= render Ui::ButtonComponent.new(label: submit_label, type: "submit", icon: "check", size: :sm, test_id: "product-category-submit") %>
      <% end %>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
          <%= render Ui::InputComponent.new(name: "name", label: t("member.product.categories.name"), required: true,
                value: category.name, placeholder: "Auth", test_id: "product-category-name",
                error: @errors&.dig(:name)&.first) %>
          <%= render Ui::InputComponent.new(name: "position", label: t("member.product.categories.position"), type: "number",
                value: category.position, test_id: "product-category-position") %>
        </div>
      </div>
    </div>
  <% end %>
</div>
