<% content_for :title, t("member.product.cells.new", feature: @feature.name) %>

<div class="p-7 space-y-6" data-test="member-product-cell-new">
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.product.cells.new", feature: @feature.name),
        subtitle: t("member.product.cells.new_help"),
        breadcrumb: [ { label: t("member.product.matrices.title"), href: member_product_matrices_path },
                      { label: @group.name, href: member_product_matrix_path(@group) },
                      { label: @feature.name } ],
        test_id: "product-cell-new-header") %>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 max-w-md">
    <% if @platform.nil? %>
      <p class="text-[12.5px] text-gray-500 dark:text-zinc-400" data-test="product-cell-no-platforms"><%= t("member.product.cells.no_assignable_platforms") %></p>
    <% else %>
      <%= form_with url: member_product_feature_cells_path(@feature), method: :post, class: "space-y-4", data: { test: "product-cell-new-form" } do %>
        <%# La piattaforma la sceglie il form: è così che nasce una colonna nuova. Le versioni
            indicabili dipendono dalla piattaforma, quindi si caricano dopo il salvataggio (dalla
            modifica della cella appena creata) — qui si dichiara solo a che punto siamo. %>
        <%= render Ui::SelectComponent.new(name: "platform_id", label: t("member.product.cells.platform"),
              options: @assignable.map { |platform| [ platform.label, platform.id, platform.color ] },
              selected: @platform.id, required: true, test_id: "product-cell-new-platform") %>
        <%= render Ui::SelectComponent.new(name: "status_id", label: t("member.product.cells.status"),
              options: @statuses.map { |status| [ status.label, status.id, status.color ] },
              required: true, test_id: "product-cell-new-status") %>
        <div class="flex items-center gap-1.5">
          <%= render Ui::ButtonComponent.new(label: t("member.product.cells.save"), type: "submit", size: :sm, icon: "check", test_id: "product-cell-new-submit") %>
          <%= render Ui::ButtonComponent.new(label: t("member.product.cancel"), href: member_product_matrix_path(@group), variant: :secondary_muted, size: :sm) %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
