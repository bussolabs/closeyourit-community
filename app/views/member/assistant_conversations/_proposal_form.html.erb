<%# Edit a card before confirming: text as typed, choices from the same scopes as the tools (CYRA-907). %>
<%= form_with url: member_assistant_conversation_proposal_path(proposal.message.conversation, proposal), method: :patch, scope: :proposal,
      class: "mt-2 flex flex-col gap-2 rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 p-2.5" do |f| %>
  <% Member::AssistantProposalsController::EDITABLE.fetch(proposal.kind).each do |key| %>
    <% if key.end_with?("_id") %>
      <%= render Ui::SelectComponent.new(name: "proposal[#{key}]", label: t("member.assistant.proposals.fields.#{key}"),
            options: proposal_choice_options(key), selected: proposal.payload[key]) %>
    <% else %>
      <label class="flex flex-col gap-1 text-[12px] font-medium text-gray-500 dark:text-zinc-400"><%= t("member.assistant.proposals.fields.#{key}") %>
        <%= f.text_area key, value: proposal.payload[key], rows: key == "title" ? 1 : 3,
              class: "rounded-md border border-stone-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-2.5 py-1.5 text-[13.5px] text-zinc-900 dark:text-zinc-100" %>
      </label>
    <% end %>
  <% end %>
  <%= f.submit t("member.assistant.proposals.save"), class: "self-start h-8 px-3 rounded-md border border-stone-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-[12px] cursor-pointer" %>
<% end %>
