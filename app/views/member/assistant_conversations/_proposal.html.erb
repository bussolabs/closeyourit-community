<%# One proposed action. Pending/failed: confirm, edit, discard. Confirmed: done. Discarded: undo (CYRA-907). %>
<% p = proposal.payload %>
<% conversation = proposal.message.conversation %>
<div id="<%= dom_id(proposal) %>" data-test="assistant-proposal" data-status="<%= proposal.status %>"
     class="rounded-lg border bg-white dark:bg-zinc-900 px-3 py-2.5 flex flex-col gap-2 <%= proposal.status_confirmed? ? "border-green-200 dark:border-green-500/40" : "border-stone-200 dark:border-zinc-800" %>">
  <% if proposal.status_discarded? %>
    <div class="flex items-center justify-between gap-2 text-[12.5px] text-gray-400 dark:text-zinc-500">
      <span><s><%= t("member.assistant.proposals.kinds.#{proposal.kind}") %>: <%= p["title"] || p["ticket_code"] %></s></span>
      <%= button_to t("member.assistant.proposals.restore"), restore_member_assistant_conversation_proposal_path(conversation, proposal),
            class: "text-[12px] text-indigo-600 dark:text-indigo-400 px-1 min-h-8" %>
    </div>
  <% elsif proposal.status_confirmed? %>
    <div class="flex items-center gap-2 text-[13px]">
      <%= render Ui::IconComponent.new(name: "check", class: "text-green-600 dark:text-green-400") %>
      <span class="font-semibold"><%= t("member.assistant.proposals.done.#{proposal.kind}") %></span>
      <span class="text-gray-500 dark:text-zinc-400 truncate"><%= p["title"] || p["ticket_title"] %></span>
    </div>
  <% else %>
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="font-mono text-[10px] uppercase tracking-widest text-indigo-600 dark:text-indigo-400"><%= t("member.assistant.proposals.kinds.#{proposal.kind}") %></span>
      <% [ p["project_key"], p["ticket_code"], p["priority_label"], p["list_name"] ].compact.each do |chip| %>
        <span class="px-2 rounded-md bg-gray-100 dark:bg-zinc-800 text-[12px] leading-5 text-zinc-800 dark:text-zinc-200"><%= chip %></span>
      <% end %>
    </div>
    <div class="text-[13.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= p["title"] || p["ticket_title"] %></div>
    <div class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= proposal_detail(proposal) %></div>
    <% if p["similar"].present? %>
      <div class="rounded-md bg-amber-50 dark:bg-amber-500/15 px-2.5 py-1.5 text-[12.5px] text-amber-900 dark:text-amber-200" data-test="assistant-proposal-similar">
        <%= t("member.assistant.proposals.similar") %> <%= p["similar"].map { |s| [ s["code"], s["title"] ].compact.join(" ") }.join(" · ") %>
      </div>
    <% end %>
    <% problem = error || (proposal.status_failed? && t("member.assistant.proposals.failed")) %>
    <% if problem %>
      <p class="text-[12.5px] text-red-700 dark:text-red-300" data-test="assistant-proposal-error"><%= problem %></p>
    <% end %>
    <details>
      <summary class="list-none inline-flex h-8 items-center px-3 rounded-md border border-stone-300 dark:border-zinc-700 text-[12px] cursor-pointer"><%= t("member.assistant.proposals.edit") %></summary>
      <%= render "member/assistant_conversations/proposal_form", proposal: proposal %>
    </details>
    <div class="flex flex-wrap gap-2">
      <%= button_to t("member.assistant.proposals.confirm"), confirm_member_assistant_conversation_proposal_path(conversation, proposal),
            class: "h-8 px-3 rounded-md bg-indigo-600 text-white text-[12px] font-medium hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400",
            data: { test: "assistant-proposal-confirm" } %>
      <%= button_to t("member.assistant.proposals.discard"), discard_member_assistant_conversation_proposal_path(conversation, proposal),
            class: "h-8 px-3 rounded-md text-gray-500 dark:text-zinc-400 text-[12px] font-medium hover:bg-stone-50 dark:hover:bg-zinc-800" %>
    </div>
  <% end %>
</div>
