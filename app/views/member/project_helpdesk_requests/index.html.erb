<% content_for :title, t("member.helpdesk.title") %>

<div class="p-7 space-y-6" data-test="project-helpdesk">
  <%= render "member/projects/overview_header", project: @project, stats: @stats, active_tab: "helpdesk" %>

  <% if @status_counts.empty? && @project.helpdesk_enabled? %>
    <%# Nothing has ever arrived: the site is not connected yet, so the page is the way to connect it.
        "No requests" would read as an inbox that is working and empty. %>
    <%= render "member/project_helpdesk_requests/connect", project: @project, public_key: @public_key, can_read_tokens: @can_read_tokens, collapsed: false %>
  <% elsif @status_counts.empty? %>
    <%= render Ui::EmptyStateComponent.new(title: t("member.helpdesk.project.empty_off_title"), body: t("member.helpdesk.project.empty_off_body"),
          icon: "inbox", framed: true, test_id: "project-helpdesk-empty") do |empty| %>
      <% if can?("projects.edit", scope: @project) %>
        <% empty.with_action do %>
          <%= render Ui::ButtonComponent.new(label: t("member.helpdesk.project.open_settings"), href: member_project_settings_path(@project),
                variant: :primary, size: :sm, icon: "sliders", test_id: "project-helpdesk-settings") %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%# Title and count are the first row of the table's own panel: nothing sits on the page ground
        (T1), and the count stays beside the section title (C63). %>
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="project-helpdesk-table">
      <div class="flex items-baseline gap-2 min-w-0 px-4 py-3 border-b border-stone-200 dark:border-zinc-800" data-test="project-helpdesk-heading">
        <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.helpdesk.title") %></h2>
        <span class="font-mono text-[11px] text-gray-500 dark:text-zinc-400 whitespace-nowrap" data-test="project-helpdesk-count"><%= count_label("member.helpdesk.project.count", @status_counts.fetch("received", 0)) %></span>
      </div>
      <%= render(Ui::TableToolbarComponent.new(framed: true,
            url: member_project_helpdesk_requests_path(@project), query: params[:q],
            search_placeholder: t("member.helpdesk.search_placeholder"),
            search_test_id: "project-helpdesk-search", apply_test_id: "project-helpdesk-filter", test_id: "project-helpdesk-toolbar")) do |toolbar| %>
        <% toolbar.with_filter(key: "status", label: t("member.helpdesk.filter_status")) do %>
          <div class="w-36"><%= render Ui::SelectComponent.new(name: "status", multiple: true, summary: true,
            options: Helpdesk::Request.statuses.keys.map { |status| [ t("member.helpdesk.status.#{status}"), status ] },
            selected: params[:status], placeholder: t("member.helpdesk.filter_status"), test_id: "project-helpdesk-filter-status") %></div>
        <% end %>
      <% end %>
      <% if @requests.empty? %>
        <%= render Ui::NoResultsComponent.new(query: params[:q].presence, reset_href: member_project_helpdesk_requests_path(@project),
              body: (@filtering ? t("member.helpdesk.no_results_body", count: @status_counts.values.sum) : t("member.helpdesk.inbox_clear")),
              icon: "inbox", test_id: "project-helpdesk-no-results", reset_test_id: "project-helpdesk-reset") %>
      <% else %>
        <%= render(Ui::TableComponent.new(stacked: true, label: t("member.helpdesk.title"))) do |table| %>
          <% table.with_head do %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.helpdesk.col_request"), sort: "request") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.helpdesk.col_project"), visible: false) %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.helpdesk.col_status"), sort: "status", classes: "w-28") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.helpdesk.col_received"), sort: "received",
                  initial: :desc, align: :right, classes: "w-28") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("ui.table.open_column"), label_hidden: true) %>
          <% end %>
          <%= render partial: "member/helpdesk_requests/row", collection: @requests, as: :helpdesk_request, locals: { project_column: false } %>
        <% end %>
        <%= render Ui::PaginationComponent.new(pagination: @pagination, test_id: "project-helpdesk-pagination") %>
      <% end %>
    </div>
    <%= render "member/project_helpdesk_requests/connect", project: @project, public_key: @public_key, can_read_tokens: @can_read_tokens, collapsed: true %>
  <% end %>
</div>
