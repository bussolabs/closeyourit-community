<%# locals: references, add_path, reorder_path, edit_path (lambda ref→url), delete_path (lambda ref→url) %>
<%# Sezione CRUD dei riferimenti LOCALI di un livello (org/gruppo/progetto). Gli url per-record arrivano
    come lambda dal caller: il markup è identico ai tre livelli, cambiano solo i path (idioma tab_class). %>
<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="guidance-references">
  <div class="flex items-start justify-between gap-4 px-4 py-3 border-b border-stone-200 dark:border-zinc-800">
    <div class="min-w-0">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guidance.reference.section_title") %></h2>
      <p class="mt-0.5 text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.guidance.reference.section_help") %></p>
    </div>
    <%= render Ui::ButtonComponent.new(label: t("member.guidance.reference.add"), href: add_path,
          variant: :secondary_muted, size: :sm, icon: "plus", test_id: "guidance-reference-add") %>
  </div>

  <% if references.empty? %>
    <%= render Ui::EmptyNoteComponent.new(text: t("member.guidance.reference.empty"), inset: true, test_id: "guidance-references-empty") %>
  <% else %>
    <div class="divide-y divide-stone-100 dark:divide-zinc-800" data-controller="guidance-reorder" data-guidance-reorder-url-value="<%= reorder_path %>">
      <% references.each do |reference| %>
        <div class="flex items-center gap-2.5 px-4 py-2.5" data-test="guidance-reference-row-<%= reference.id %>"
             data-guidance-reorder-target="item" data-id="<%= reference.id %>" draggable="true">
          <%= render Ui::IconComponent.new(name: "grip-vertical", class: "text-[11px] text-gray-300 dark:text-zinc-600 cursor-grab shrink-0") %>
          <span class="font-mono text-[12px] font-semibold text-zinc-900 dark:text-zinc-100 shrink-0"><%= reference.key %></span>
          <%= render Ui::BadgeComponent.new(label: t("member.guidance.reference.kinds.#{reference.kind}"), color: :gray, size: :sm) %>
          <span class="font-mono text-[11px] text-gray-500 dark:text-zinc-400 truncate"><%= reference.location %></span>
          <div class="ml-auto flex items-center gap-1.5 shrink-0">
            <% if reference.required? %>
              <%= render Ui::BadgeComponent.new(label: t("member.guidance.reference.required"), color: :amber, size: :sm) %>
            <% end %>
            <% unless reference.enabled? %>
              <%= render Ui::BadgeComponent.new(label: t("member.guidance.status.disabled"), color: :gray, size: :sm, dot: true) %>
            <% end %>
            <%= render Ui::RowMenuComponent.new(test_id: "guidance-reference-menu-#{reference.id}") do %>
              <%= link_to t("member.guidance.reference.edit"), edit_path.call(reference),
                    class: Ui::RowMenuComponent.item_class(:default), data: { test: "guidance-reference-edit-#{reference.id}" } %>
              <div class="my-1 border-t border-stone-200 dark:border-zinc-800"></div>
              <%= button_to t("member.guidance.reference.delete"), delete_path.call(reference), method: :delete, params: { confirm: 1 },
                    form_class: "contents", class: Ui::RowMenuComponent.item_class(:danger),
                    data: { test: "guidance-reference-delete-#{reference.id}", turbo_confirm: t("member.guidance.reference.delete_confirm") } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
