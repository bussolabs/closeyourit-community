<%# Form condiviso dei riferimenti (new/edit) reso da GuidanceReferenceActions ai tre livelli via
    `render template:`. Usa @reference, @form_url (submit), @back_url (annulla/hub), @errors e
    @guidance_level/@guidance_scope_name (CYRA-576: livello e nome di ciò a cui il riferimento si applica —
    senza, la pagina era identica ai tre livelli e l'unico indizio era l'indirizzo). %>
<% title = @reference.persisted? ? t("member.guidance.reference.edit_title") : t("member.guidance.reference.new_title") %>
<% content_for :title, "#{@guidance_scope_name} · #{title}" %>

<div class="p-7">
  <%= form_with url: @form_url, method: (@reference.persisted? ? :patch : :post), class: "space-y-6 max-w-2xl", data: { test: "guidance-reference-form" } do %>
    <%= render Ui::PageHeaderComponent.new(title: title,
          subtitle: t("member.guidance.applies_to.#{@guidance_level}", name: @guidance_scope_name),
          breadcrumb: [ { label: t("member.guidance.home.#{@guidance_level}", name: @guidance_scope_name), href: @back_url }, { label: title } ]) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.guidance.reference.cancel"), href: @back_url, variant: :secondary_muted, size: :sm, test_id: "guidance-reference-cancel") %>
        <%= render Ui::ButtonComponent.new(label: (@reference.persisted? ? t("member.guidance.reference.save_edit") : t("member.guidance.reference.save_new")), type: "submit", size: :sm, test_id: "guidance-reference-submit") %>
      <% end %>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
        <%= render Ui::InputComponent.new(name: "key", label: t("member.guidance.reference.key"), required: true,
              value: @reference.key, hint: t("member.guidance.reference.key_hint"), test_id: "guidance-reference-key",
              error: @errors&.dig(:key)&.first) %>
        <%= render Ui::SelectComponent.new(name: "kind", label: t("member.guidance.reference.kind"),
              options: Guidance::Reference.kinds.keys.map { |k| [ t("member.guidance.reference.kinds.#{k}"), k ] },
              selected: @reference.kind, test_id: "guidance-reference-kind") %>
        <%= render Ui::InputComponent.new(name: "location", label: t("member.guidance.reference.location"), required: true,
              value: @reference.location, hint: t("member.guidance.reference.location_hint"), wrapper_class: "md:col-span-2",
              test_id: "guidance-reference-location", error: @errors&.dig(:location)&.first) %>

        <div class="md:col-span-2">
          <label for="instructions" class="block text-[12px] font-medium text-zinc-900 dark:text-zinc-100 mb-1.5"><%= t("member.guidance.reference.instructions") %></label>
          <textarea name="instructions" id="instructions" rows="3" data-test="guidance-reference-instructions" class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[12.5px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= @reference.instructions %></textarea>
          <p class="mt-1.5 text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.guidance.reference.instructions_hint") %></p>
        </div>

        <label class="inline-flex items-center gap-2 h-[34px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[12.5px] text-zinc-900 dark:text-zinc-100 cursor-pointer has-[:checked]:border-indigo-600 dark:has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50 dark:has-[:checked]:bg-indigo-500/15" data-test="guidance-reference-required">
          <%= hidden_field_tag "required", "0" %>
          <%= check_box_tag "required", "1", @reference.required?, class: "accent-indigo-600" %>
          <%= t("member.guidance.reference.required") %>
        </label>
        <label class="inline-flex items-center gap-2 h-[34px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[12.5px] text-zinc-900 dark:text-zinc-100 cursor-pointer has-[:checked]:border-indigo-600 dark:has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50 dark:has-[:checked]:bg-indigo-500/15" data-test="guidance-reference-enabled">
          <%= hidden_field_tag "enabled", "0" %>
          <%= check_box_tag "enabled", "1", @reference.enabled?, class: "accent-indigo-600" %>
          <%= t("member.guidance.reference.enabled") %>
        </label>
      </div>
    </div>
  <% end %>
</div>
