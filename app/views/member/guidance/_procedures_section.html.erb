<%# locals: procedures, add_path, reorder_path, edit_path (lambda proc→url), delete_path (lambda proc→url) %>
<%# Sezione CRUD delle procedure LOCALI di un livello. Gemella di _references_section. %>
<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="guidance-procedures">
  <div class="flex items-start justify-between gap-4 px-4 py-3 border-b border-stone-200 dark:border-zinc-800">
    <div class="min-w-0">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guidance.procedure.section_title") %></h2>
      <p class="mt-0.5 text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.guidance.procedure.section_help") %></p>
    </div>
    <%= render Ui::ButtonComponent.new(label: t("member.guidance.procedure.add"), href: add_path,
          variant: :secondary_muted, size: :sm, icon: "plus", test_id: "guidance-procedure-add") %>
  </div>

  <% if procedures.empty? %>
    <%= render Ui::EmptyNoteComponent.new(text: t("member.guidance.procedure.empty"), inset: true, test_id: "guidance-procedures-empty") %>
  <% else %>
    <div class="divide-y divide-stone-100 dark:divide-zinc-800" data-controller="guidance-reorder" data-guidance-reorder-url-value="<%= reorder_path %>">
      <% procedures.each do |procedure| %>
        <div class="flex items-center gap-2.5 px-4 py-2.5" data-test="guidance-procedure-row-<%= procedure.id %>"
             data-guidance-reorder-target="item" data-id="<%= procedure.id %>" draggable="true">
          <%= render Ui::IconComponent.new(name: "grip-vertical", class: "text-[11px] text-gray-300 dark:text-zinc-600 cursor-grab shrink-0") %>
          <span class="font-mono text-[12px] font-semibold text-zinc-900 dark:text-zinc-100 shrink-0"><%= procedure.key %></span>
          <%= render Ui::BadgeComponent.new(label: t("member.guidance.procedure.modes.#{procedure.application_mode}"), color: :gray, size: :sm) %>
          <span class="text-[11.5px] text-gray-500 dark:text-zinc-400 truncate"><%= truncate(procedure.content, length: 80) %></span>
          <div class="ml-auto flex items-center gap-1.5 shrink-0">
            <% unless procedure.enabled? %>
              <%= render Ui::BadgeComponent.new(label: t("member.guidance.status.disabled"), color: :gray, size: :sm, dot: true) %>
            <% end %>
            <%= render Ui::RowMenuComponent.new(test_id: "guidance-procedure-menu-#{procedure.id}") do %>
              <%= link_to t("member.guidance.procedure.edit"), edit_path.call(procedure),
                    class: Ui::RowMenuComponent.item_class(:default), data: { test: "guidance-procedure-edit-#{procedure.id}" } %>
              <div class="my-1 border-t border-stone-200 dark:border-zinc-800"></div>
              <%= button_to t("member.guidance.procedure.delete"), delete_path.call(procedure), method: :delete, params: { confirm: 1 },
                    form_class: "contents", class: Ui::RowMenuComponent.item_class(:danger),
                    data: { test: "guidance-procedure-delete-#{procedure.id}", turbo_confirm: t("member.guidance.procedure.delete_confirm") } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
