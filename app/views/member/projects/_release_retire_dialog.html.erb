<%# One dialog for every release row (CYRA-571): the row tells it the address and the version (CYRA-1161).
    The dialog is the confirmation gesture, so the form carries confirm=1. %>
<%= render Ui::ModalComponent.new(title: t("member.projects.release_retirement.dialog_title"), size: :sm, padded: false,
      test_id: "project-release-retire-modal",
      data: { "ui--shared-dialog-target": "dialog", dialog_name: "release-retire", action: "click->ui--shared-dialog#backdrop" }) do |modal| %>
  <% modal.with_actions do %>
    <%= render Ui::ButtonComponent.new(label: t("member.projects.release_retirement.cancel"), variant: :secondary_muted, size: :sm,
          data: { action: "ui--shared-dialog#close" }) %>
    <%= render Ui::ButtonComponent.new(label: t("member.projects.release_retirement.confirm"), type: "submit", variant: :danger, size: :sm,
          icon: "archive", form: "project-release-retire-form", test_id: "project-release-retire-submit") %>
  <% end %>
  <%= render Ui::RowActionsFormComponent.new(id: "project-release-retire-form", hidden: false) do %>
    <%= hidden_field_tag :confirm, 1, id: nil %>
    <div class="px-4 py-4 space-y-3">
      <p class="font-mono text-[13px] font-semibold text-zinc-900 dark:text-zinc-100" data-dialog-subject data-test="project-release-retire-version"></p>
      <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.projects.release_retirement.dialog_body") %></p>
      <div>
        <p class="font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 mb-1.5"><%= t("member.projects.release_retirement.message_label") %></p>
        <%= text_area_tag :message, nil, rows: 3, required: true, maxlength: 500,
              placeholder: t("member.projects.release_retirement.message_placeholder"),
              data: { test: "project-release-retire-message" },
              class: "w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400" %>
      </div>
    </div>
  <% end %>
<% end %>
