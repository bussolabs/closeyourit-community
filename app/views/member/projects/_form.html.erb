<%# locals: project, url, method, title, submit_label %>
<% content_for :title, title %>
<% breadcrumb = project.persisted? ?
     [ { label: t("member.projects.title"), href: member_projects_path }, { label: project.name, href: member_project_path(project) }, { label: t("member.breadcrumb.edit") } ] :
     [ { label: t("member.projects.title"), href: member_projects_path }, { label: t("member.breadcrumb.new") } ] %>

<div class="p-7">
  <%= form_with url: url, method: method, multipart: true, class: "space-y-6", data: { test: "project-form" } do %>
    <%= render Ui::PageHeaderComponent.new(title: title, breadcrumb: breadcrumb) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.projects.form.cancel"), href: member_projects_path, variant: :secondary_muted, size: :sm) %>
        <%= render Ui::ButtonComponent.new(label: submit_label, type: "submit", icon: "check", test_id: "project-submit", size: :sm) %>
      <% end %>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
          <%= render Ui::InputComponent.new(name: "name", label: t("member.projects.form.name"), required: true, value: project.name, placeholder: "Storefront", test_id: "project-name", error: @errors&.dig(:name)&.first) %>
          <%= render Ui::InputComponent.new(name: "key", label: t("member.projects.form.key"), required: true, value: project.key, placeholder: "STOR", hint: t("member.projects.form.key_hint"), test_id: "project-key", error: @errors&.dig(:key)&.first) %>

          <%= render "member/shared/color_field", record: project, prefix: "project", scope: "member.projects.form" %>

          <div data-test="project-group">
            <label class="block text-[12px] font-medium text-zinc-900 dark:text-zinc-100 mb-1.5"><%= t("member.projects.form.group") %></label>
            <div class="flex items-center gap-2">
              <div class="flex-1">
                <%= render Ui::SelectComponent.new(name: "group_id",
                      options: @groups.map { |g| [ g.name, g.id, g.color ] }, selected: project.group_id,
                      include_blank: true, placeholder: t("member.projects.form.group_none"), test_id: "project-group") %>
              </div>
              <% if can?("project_groups.manage") %>
                <%= link_to new_member_group_path, title: t("member.groups.new"), class: "inline-flex items-center justify-center h-[38px] w-[38px] rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-gray-500 dark:text-zinc-400 hover:border-indigo-300 dark:hover:border-indigo-500/50 hover:text-indigo-600 dark:hover:text-indigo-400 shrink-0", data: { test: "project-group-new", modal_stack: "group_id" } do %>
                  <%= render Ui::IconComponent.new(name: "plus", class: "text-[12px]") %>
                <% end %>
              <% end %>
            </div>
            <p class="mt-1.5 text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.projects.form.group_hint") %></p>
          </div>

          <%= render "member/shared/icon_field", record: project, prefix: "project", scope: "member.projects.form" %>

          <div class="md:col-span-2">
            <label for="description" class="block text-[12px] font-medium text-zinc-900 dark:text-zinc-100 mb-1.5"><%= t("member.projects.form.description") %></label>
            <textarea name="description" id="description" rows="3" data-test="project-description" class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= project.description %></textarea>
          </div>

          <div class="md:col-span-2" data-test="project-quick-bug-report-enabled">
            <input type="hidden" name="quick_bug_report_enabled" value="0">
            <label class="inline-flex items-center gap-2.5 cursor-pointer">
              <input type="checkbox" name="quick_bug_report_enabled" value="1" <%= "checked" if project.quick_bug_report_enabled? %> class="w-4 h-4 rounded border-stone-300 dark:border-zinc-700 accent-indigo-600">
              <span class="text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100"><%= t("member.projects.form.quick_bug_report_enabled") %></span>
              <span class="text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.projects.form.quick_bug_report_enabled_hint") %></span>
            </label>
          </div>

          <div class="md:col-span-2" data-test="project-secret-approval-enabled">
            <input type="hidden" name="secret_approval_enabled" value="0">
            <label class="inline-flex items-center gap-2.5 cursor-pointer">
              <input type="checkbox" name="secret_approval_enabled" value="1" <%= "checked" if project.secret_approval_enabled? %> class="w-4 h-4 rounded border-stone-300 dark:border-zinc-700 accent-indigo-600">
              <span class="text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100"><%= t("member.projects.form.secret_approval_enabled") %></span>
              <span class="text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.projects.form.secret_approval_enabled_hint") %></span>
            </label>
          </div>

          <div class="md:col-span-2" data-test="project-platforms">
            <input type="hidden" name="platform_ids[]" value="">
            <%= render Ui::SelectComponent.new(name: "platform_ids", multiple: true, label: t("member.projects.form.platforms"),
                  options: @platforms.map { |p| [ p.label, p.id, p.color ] }, selected: Array(project.platform_ids),
                  hint: t("member.projects.form.platforms_hint"), placeholder: t("member.projects.form.platforms"), test_id: "project-platforms") %>
          </div>

          <div class="md:col-span-2" data-test="project-environments">
            <input type="hidden" name="environment_ids[]" value="">
            <%= render Ui::SelectComponent.new(name: "environment_ids", multiple: true, label: t("member.projects.form.environments"),
                  options: @environments.map { |e| [ e.label, e.id, e.color ] }, selected: Array(project.environment_ids),
                  hint: t("member.projects.form.environments_hint"), placeholder: t("member.projects.form.environments"), test_id: "project-environments") %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
