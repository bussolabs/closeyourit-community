<%# locals: (release:) %>
<%# Retire opens the page's one dialog (message + confirm); Restore posts through the shared form (CYRA-1161). %>
<% if release.retired? %>
  <%= render Ui::ButtonComponent.new(label: t("member.projects.release_retirement.restore"), variant: :secondary_muted, size: :sm,
        icon: "rotate-ccw", href: member_project_release_retirement_path(release.project_id, release), method: :delete,
        form_id: "project-release-actions", confirm: t("member.projects.release_retirement.restore_confirm"),
        test_id: "project-release-restore-#{release.id}") %>
<% else %>
  <%= render Ui::ButtonComponent.new(label: t("member.projects.release_retirement.retire"), variant: :danger_outline, size: :sm,
        icon: "archive", test_id: "project-release-retire-#{release.id}",
        data: { action: "ui--shared-dialog#open", dialog: "release-retire",
                dialog_url: member_project_release_retirement_path(release.project_id, release),
                dialog_subject: release.display_version }) %>
<% end %>
