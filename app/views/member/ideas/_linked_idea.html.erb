<%# locals: idea, other, can_manage, test_prefix %>
<div class="px-4 py-3 flex items-center gap-3" data-test="<%= test_prefix %>-<%= other.id %>">
  <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-md bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 text-[12px]"><%= render Ui::IconComponent.new(name: "lightbulb") %></span>
  <div class="min-w-0 flex-1">
    <%= link_to other.title, member_idea_path(other), class: "block text-[13px] font-medium text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400 truncate", data: { test: "#{test_prefix}-title-#{other.id}" } %>
    <div class="mt-0.5 flex items-center gap-2 text-[11.5px] text-gray-500 dark:text-zinc-400">
      <%= render Ui::BadgeComponent.new(label: t("member.ideas.status.#{other.status}"), color: idea_status_color(other.status), dot: true, size: :sm) %>
      <span class="inline-flex items-center gap-1"><%= render Ui::IconComponent.new(name: "arrow-up", class: "text-[10px]") %><span class="font-mono"><%= other.votes_count %></span></span>
    </div>
  </div>
  <% if can_manage %>
    <%= button_to member_idea_link_path(idea, other), method: :delete, class: "shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-300 dark:text-zinc-600 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/15", title: t("member.ideas.links.unlink"), data: { test: "#{test_prefix}-unlink-#{other.id}", turbo_confirm: t("member.ideas.links.unlink_confirm") } do %>
      <%= render Ui::IconComponent.new(name: "unlink", class: "text-[11px]") %>
    <% end %>
  <% end %>
</div>
