<% content_for :title, t("member.ideas.title") %>

<div class="p-7 space-y-6" data-test="member-ideas">
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.ideas.title"),
        subtitle: t("member.ideas.help_title"),
        breadcrumb: [ { label: t("member.ideas.title") } ],
        counts_test_id: "ideas-counts") do |h| %>
    <% h.with_counts do %>
      <%= render Ui::StatLabelComponent.new(label: t("member.ideas.counts.total"), value: @status_counts.values.sum, test_id: "ideas-count-total") %>
      <%# A status chip is a filter: one click shows only that status, a second click clears it. %>
      <% { "open" => :emerald, "converted" => :indigo, "archived" => nil }.each do |status, color| %>
        <%= render Ui::StatLabelComponent.new(label: t("member.ideas.counts.#{status}"), value: @status_counts.fetch(status, 0),
              value_color: color, href: idea_status_chip_href(status), active: idea_status_chip_active?(status),
              test_id: "ideas-count-#{status}") %>
      <% end %>
    <% end %>
    <%# Every role can propose ideas %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.ideas.new"),
            href: new_member_idea_path, variant: :primary, size: :sm,
            icon: "plus", test_id: "ideas-new", data: { keyboard_new: "" }) %>
    <% end %>
  <% end %>

  <div data-test="ideas-table">
    <%# Search by meaning by default, switchable to exact words. CYRA-167 %>
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <%= render(Ui::TableToolbarComponent.new(framed: true,
            url: member_ideas_path, query: params[:q],
            search_placeholder: t("member.ideas.search_placeholder"),
            apply_label: t("member.ideas.apply"),
            search_test_id: "ideas-search", apply_test_id: "ideas-filter", test_id: "ideas-toolbar",
            semantic_search: true, semantic_selectable: true, search_submit_test_id: "ideas-search-submit",
            view_sections: ideas_view_sections(@ideas_view))) do |toolbar| %>
        <% toolbar.with_filter(key: "status", label: t("member.ideas.filter_status")) do %>
          <div class="w-36"><%= render Ui::SelectComponent.new(name: "status", multiple: true, summary: true, options: Ideas::Idea.statuses.keys.map { |s| [ t("member.ideas.status.#{s}"), s ] }, selected: params[:status], placeholder: t("member.ideas.filter_status"), test_id: "filter-status") %></div>
        <% end %>
        <% toolbar.with_filter(key: "project_id", label: t("member.ideas.filter_project")) do %>
          <div class="w-40"><%= render Ui::SelectComponent.new(name: "project_id", multiple: true, summary: true, options: @projects.map { |p| [ p.name, p.id ] }, selected: params[:project_id], placeholder: t("member.ideas.filter_project"), test_id: "filter-project") %></div>
        <% end %>
        <% toolbar.with_views do %>
          <%= render Ui::SavedViewsComponent.new(resource_type: "ideas", views: @saved_views,
                index_helper: :member_ideas_path, current_filters: params) %>
        <% end %>
      <% end %>
      <%= render "member/ideas/search_mode_banner" %>

      <%# No matches is not "no ideas yet": it shows the real total and a reset. CYRA-555 %>
      <% if @ideas.empty? && @filtering %>
        <%= render Ui::NoResultsComponent.new(query: @query.presence, reset_href: member_ideas_path,
              body: t("member.ideas.no_results_body", count: @total_ideas),
              icon: "lightbulb", test_id: "ideas-no-results", reset_test_id: "ideas-reset-search") %>
      <% elsif @ideas.empty? %>
        <%= render Ui::EmptyStateComponent.new(title: t("member.ideas.empty"), body: t("member.ideas.empty_body"),
              example: t("member.ideas.empty_example"), icon: "lightbulb", test_id: "ideas-empty") do |empty| %>
          <% empty.with_action do %>
            <%= render Ui::ButtonComponent.new(label: t("member.ideas.new"), href: new_member_idea_path,
                  variant: :primary, size: :sm, icon: "plus", test_id: "ideas-empty-new") %>
          <% end %>
        <% end %>
      <% elsif @ideas_view == "cards" %>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 p-4" data-test="ideas-cards">
          <%= render partial: "member/ideas/idea_card", collection: @ideas, as: :idea %>
        </div>
      <% else %>
        <%= render "member/ideas/table", ideas: @ideas %>
      <% end %>
      <% if @ideas.any? %>
        <%= render(Ui::PaginationComponent.new(pagination: @pagination, test_id: "ideas-pagination")) %>
      <% end %>
    </div>
  </div>
</div>
