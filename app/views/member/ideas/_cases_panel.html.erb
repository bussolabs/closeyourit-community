<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-idea-cases">
  <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800 flex items-center justify-between">
    <h2 class="font-display text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">
      <%= t("member.ideas.cases.title") %><span class="ml-1.5 font-mono text-[12px] text-gray-500 dark:text-zinc-400" data-test="idea-cases-count"><%= @cases.size %></span>
    </h2>
  </div>

  <div class="divide-y divide-stone-200 dark:divide-zinc-800" data-test="member-idea-cases-list">
    <% if @cases.empty? %>
      <p class="px-4 py-6 text-[12.5px] text-gray-500 dark:text-zinc-400" data-test="idea-cases-empty"><%= t("member.ideas.cases.empty") %></p>
    <% else %>
      <% @cases.each do |idea_case| %>
        <%= render "member/ideas/case", idea: @idea, idea_case: idea_case, can_manage: @can_edit %>
      <% end %>
    <% end %>
  </div>

  <%# The form opens from a button: native <details>, no JS. %>
  <% if @idea.status_open? && @can_edit %>
    <details class="group px-4 py-3 border-t border-stone-200 dark:border-zinc-800" data-test="idea-case-form-toggle">
      <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 h-[30px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-[12px] font-medium text-zinc-900 dark:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800 group-open:hidden"
               data-test="idea-case-form-open">
        <%= render Ui::IconComponent.new(name: "plus", class: "text-[10px]") %><%= t("member.ideas.cases.submit") %>
      </summary>
      <%= form_with url: member_idea_cases_path(@idea), method: :post, class: "space-y-2", data: { test: "member-idea-case-form" } do %>
        <%= text_field_tag "title", nil, placeholder: t("member.ideas.cases.title_placeholder"), data: { test: "member-idea-case-title" }, class: "w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-[13px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400" %>
        <%= text_area_tag "description", nil, rows: 2, placeholder: t("member.ideas.cases.description_placeholder"), data: { test: "member-idea-case-description" }, class: "w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-[13px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400" %>
        <div class="flex justify-end">
          <%= render Ui::ButtonComponent.new(label: t("member.ideas.cases.submit"), type: "submit", icon: "plus", test_id: "member-idea-case-submit") %>
        </div>
      <% end %>
    </details>
  <% end %>
</div>
