<%# Top referrer esterni per visitatori unici (il traffico diretto non è in lista). %>
<% max = top_referrers.map { |r| r[:visitors].to_i }.max.to_i %>
<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="analytics-referrers">
  <div class="flex items-center justify-between px-4 py-3 border-b border-stone-200 dark:border-zinc-800">
    <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.analytics.referrers_title") %></h2>
    <span class="font-mono text-[10.5px] uppercase tracking-wide text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.analytics.col_visitors") %></span>
  </div>
  <% if top_referrers.empty? %>
    <p class="px-4 py-8 text-center text-[12.5px] text-gray-500 dark:text-zinc-400" data-test="analytics-referrers-empty"><%= t("member.monitoring.analytics.no_data") %></p>
  <% else %>
    <ul class="divide-y divide-stone-100 dark:divide-zinc-800">
      <% top_referrers.each do |row| %>
        <li class="relative px-4 py-2" data-test="analytics-referrer-row">
          <span class="absolute inset-x-2 inset-y-1" aria-hidden="true"><span class="block h-full rounded-[3px] bg-sky-50 dark:bg-sky-500/15" style="width: <%= analytics_row_width(row[:visitors], max) %>%"></span></span>
          <span class="relative flex items-center justify-between gap-3">
            <span class="truncate font-mono text-[12px] text-zinc-900 dark:text-zinc-100"><%= link_to row[:referrer_host], analytics_filter_url("referrer_host", row[:referrer_host]), class: "hover:text-indigo-600 dark:hover:text-indigo-400", data: { test: "analytics-referrer-filter" } %></span>
            <span class="shrink-0 font-mono text-[12px] text-zinc-900 dark:text-zinc-100"><%= row[:visitors] %></span>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
