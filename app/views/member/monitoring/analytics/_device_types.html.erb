<%# Breakdown device type (mobile/tablet/desktop dall'UA) + screen size (viewport dal client). %>
<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="analytics-device-types">
  <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800">
    <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.analytics.device_types_title") %></h2>
  </div>
  <div class="grid grid-cols-2 divide-x divide-stone-100 dark:divide-zinc-800">
    <% [ [ t("member.monitoring.analytics.device_type"), device_types, "analytics-device-type-row", "device_type" ],
         [ t("member.monitoring.analytics.screen_size"), screens, "analytics-screen-row", "screen_class" ] ].each do |label, rows, test_id, column| %>
      <div class="p-4">
        <p class="font-mono text-[10.5px] uppercase tracking-wide text-gray-500 dark:text-zinc-400 mb-2"><%= label %></p>
        <% if rows.empty? %>
          <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.analytics.no_data") %></p>
        <% else %>
          <% total = rows.sum { |r| r[:visitors].to_i } %>
          <ul class="space-y-1.5">
            <% rows.each do |row| %>
              <li class="flex items-center justify-between gap-2" data-test="<%= test_id %>">
                <span class="truncate text-[12.5px] text-zinc-900 dark:text-zinc-100"><%= link_to t("member.monitoring.analytics.device_labels.#{row[:value]}", default: row[:value]), analytics_filter_url(column, row[:value]), class: "hover:text-indigo-600 dark:hover:text-indigo-400" %></span>
                <span class="shrink-0 font-mono text-[12px] text-gray-500 dark:text-zinc-400"><%= row[:visitors] %> <span class="text-gray-500 dark:text-zinc-400">(<%= (row[:visitors] * 100.0 / total).round %>%)</span></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
