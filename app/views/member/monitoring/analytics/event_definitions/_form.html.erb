<%# locals: project:, definition:, title: %>
<% list_path = member_monitoring_analytics_event_definitions_path(project_id: project.id) %>
<div class="p-7 space-y-6" data-test="member-analytics-event-definition-form">
  <%= render Ui::PageHeaderComponent.new(
        title: title,
        breadcrumb: [
          { label: t("member.monitoring.analytics.title"), href: member_monitoring_analytics_path(project_id: project.id) },
          { label: t("member.monitoring.analytics.event_definitions.title"), href: list_path },
          { label: title }
        ]) do |h| %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.monitoring.analytics.event_definitions.cancel"), href: list_path, variant: :secondary_muted, size: :sm) %>
      <%= render Ui::ButtonComponent.new(label: t("member.monitoring.analytics.event_definitions.save"), type: "submit", form: "analytics-event-definition-form", variant: :primary, size: :sm, test_id: "analytics-event-definition-submit") %>
    <% end %>
  <% end %>

  <%= form_with model: definition, scope: :analytics_event_definition,
        url: definition.persisted? ? member_monitoring_analytics_event_definition_path(definition, project_id: project.id) : list_path,
        id: "analytics-event-definition-form", data: { test: "analytics-event-definition-form" } do |f| %>
    <%= hidden_field_tag :project_id, project.id %>
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
      <% [ [ :name, "Signup" ], [ :property_names, "plan, seats" ] ].each do |field, placeholder| %>
        <div>
          <label class="block text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 mb-1.5"><%= t("member.monitoring.analytics.event_definitions.form.#{field}") %></label>
          <%= f.text_field field, value: (field == :property_names ? definition.property_names.join(", ") : definition.name), placeholder: placeholder,
                "aria-invalid": (true if definition.errors[field].any?),
                class: "w-full h-[36px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400",
                data: { test: "analytics-event-definition-#{field.to_s.dasherize}" } %>
          <% if (message = definition.errors.full_messages_for(field).first) %>
            <p class="mt-1 text-[11.5px] text-red-600 dark:text-red-400" data-test="analytics-event-definition-<%= field.to_s.dasherize %>-error"><%= message %></p>
          <% end %>
          <p class="mt-1 text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.analytics.event_definitions.form.#{field}_hint") %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
