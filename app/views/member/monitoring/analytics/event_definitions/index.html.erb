<% content_for :title, t("member.monitoring.analytics.event_definitions.title") %>

<div class="p-7 space-y-6" data-test="member-analytics-event-definitions">
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.monitoring.analytics.event_definitions.title"),
        subtitle: t("member.monitoring.analytics.event_definitions.subtitle"),
        breadcrumb: [
          { label: t("member.monitoring.analytics.title"), href: member_monitoring_analytics_path(project_id: @project.id) },
          { label: t("member.monitoring.analytics.event_definitions.title") }
        ],
        counts_test_id: "analytics-event-definitions-counts") do |h| %>
    <% h.with_counts do %>
      <%= render Ui::StatLabelComponent.new(label: t("member.monitoring.analytics.event_definitions.count"), value: @definitions.size, test_id: "analytics-event-definitions-count") %>
    <% end %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.monitoring.analytics.undeclared_events.title"), href: member_monitoring_analytics_undeclared_events_path(project_id: @project.id), variant: :secondary_muted, size: :sm, test_id: "analytics-event-definitions-undeclared") %>
      <%= render Ui::ButtonComponent.new(label: t("member.monitoring.analytics.event_definitions.new"), href: new_member_monitoring_analytics_event_definition_path(project_id: @project.id), variant: :primary, size: :sm, test_id: "analytics-event-definitions-new") %>
    <% end %>
  <% end %>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="analytics-event-definitions-list">
    <% if @definitions.empty? %>
      <div class="px-4 py-12 text-center">
        <p class="text-[13px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.analytics.event_definitions.empty") %></p>
      </div>
    <% else %>
      <%= render(Ui::TableComponent.new(stacked: true, label: t("member.monitoring.analytics.event_definitions.title"))) do |t| %>
        <% t.with_head do %>
          <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.analytics.event_definitions.col_name"), sort: "name") %>
          <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.analytics.event_definitions.col_properties")) %>
          <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.analytics.event_definitions.actions"), label_hidden: true) %>
        <% end %>
        <% @definitions.each do |definition| %>
          <%= render Ui::TableComponent::RowComponent.new(test_id: "analytics-event-definitions-row") do %>
            <%= render(Ui::TableComponent::CellComponent.new(header: true, mono: true)) { definition.name } %>
            <%= render(Ui::TableComponent::CellComponent.new(label: t("member.monitoring.analytics.event_definitions.col_properties"), mono: true, class: "text-gray-500 dark:text-zinc-400")) { definition.property_names.join(", ").presence || "—" } %>
            <%= render Ui::TableComponent::CellComponent.new(actions: true) do %>
              <%= render Ui::ButtonComponent.new(label: t("member.monitoring.analytics.event_definitions.edit"), href: edit_member_monitoring_analytics_event_definition_path(definition, project_id: @project.id), variant: :secondary_muted, size: :sm, test_id: "analytics-event-definitions-edit") %>
              <%= render Ui::ConfirmDialogComponent.new(title: t("member.monitoring.analytics.event_definitions.delete_dialog.title", name: definition.name),
                    url: member_monitoring_analytics_event_definition_path(definition, project_id: @project.id),
                    confirm_label: t("member.monitoring.analytics.event_definitions.delete"),
                    test_id: "analytics-event-definition-delete-dialog-#{definition.id}") do |dialog| %>
                <% dialog.with_body { t("member.monitoring.analytics.event_definitions.delete_dialog.body") } %>
                <%= dialog.button_trigger(label: t("member.monitoring.analytics.event_definitions.delete"), test_id: "analytics-event-definitions-delete") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
