<%= render Ui::PageHeaderComponent.new(title: title, subtitle: measurement_label("subtitle"), breadcrumb: (title == measurement_label("title") ? [{label: title}] : [{label: measurement_label("title"), href: member_monitoring_measurements_path}, {label: title}])) do |header| %>
  <% header.with_tab(label: measurement_label("series"), href: member_monitoring_measurements_path, active: controller_name == "measurements") %>
  <% header.with_tab(label: measurement_label("alerts"), href: member_monitoring_measurement_rules_path, active: controller_name == "measurement_rules") %>
  <% header.with_counts do %><%= render Ui::StatLabelComponent.new(label: count_label, value: stat_value) %><% end %>
  <% if can?("alerts.manage") %>
    <% header.with_actions do %><%= render Ui::ButtonComponent.new(label: measurement_label("new_alert"), href: new_member_monitoring_measurement_rule_path(project_id: project_id, measurement_series_id: series_id), size: :sm, icon: "plus", test_id: "measurement-new-alert") %><% end %>
  <% end %>
<% end %>
