<%# locals: monitor: — gestione del banner status page (uno per monitor): anteprima + form. Il pulsante
    "rimuovi" (button_to DELETE) sta FUORI dal form principale per non annidare i form. %>
<%
  announcement = monitor.announcement
  field = "w-full h-[34px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 bg-white dark:bg-zinc-900 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"
  label = "block font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 mb-1.5"
%>
<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="monitor-announcement">
  <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800">
    <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.uptime.announcement.title") %></h2>
    <p class="mt-0.5 text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.uptime.announcement.hint") %></p>
  </div>
  <div class="px-4 py-4 space-y-3">
    <% if announcement&.live? %>
      <div data-test="announcement-preview">
        <p class="<%= label %>"><%= t("member.uptime.announcement.preview") %></p>
        <%= render "shared/status_banner", announcement: announcement %>
      </div>
    <% end %>

    <%= form_with url: member_monitoring_monitor_announcement_path(monitor), method: announcement ? :patch : :post, class: "space-y-3" do %>
      <div>
        <label class="<%= label %>"><%= t("member.uptime.announcement.level") %></label>
        <select name="level" data-test="announcement-level" class="<%= field %>">
          <% Uptime::Announcement.levels.keys.each do |level| %>
            <option value="<%= level %>" <%= "selected" if announcement&.level == level %>><%= t("member.uptime.announcement.levels.#{level}") %></option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="<%= label %>"><%= t("member.uptime.announcement.message") %><span class="text-red-500 dark:text-red-400 ml-0.5">*</span></label>
        <textarea name="message" rows="2" required data-test="announcement-message"
                  placeholder="<%= t('member.uptime.announcement.message_placeholder') %>"
                  class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= announcement&.message %></textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="<%= label %>"><%= t("member.uptime.announcement.starts_at") %></label>
          <input type="datetime-local" name="starts_at" value="<%= announcement&.starts_at&.strftime('%Y-%m-%dT%H:%M') %>" data-test="announcement-starts" class="<%= field %>">
        </div>
        <div>
          <label class="<%= label %>"><%= t("member.uptime.announcement.ends_at") %></label>
          <input type="datetime-local" name="ends_at" value="<%= announcement&.ends_at&.strftime('%Y-%m-%dT%H:%M') %>" data-test="announcement-ends" class="<%= field %>">
        </div>
      </div>

      <label class="flex items-center gap-2 text-[12.5px] text-zinc-700 dark:text-zinc-300">
        <input type="hidden" name="active" value="0">
        <input type="checkbox" name="active" value="1" <%= "checked" if announcement.nil? || announcement.active? %> data-test="announcement-active"
               class="h-3.5 w-3.5 rounded border-stone-300 dark:border-zinc-700 text-indigo-600 dark:text-indigo-400 focus:ring-indigo-500 dark:focus:ring-indigo-400">
        <%= t("member.uptime.announcement.active") %>
      </label>

      <button type="submit" data-test="announcement-save"
              class="inline-flex items-center gap-1.5 h-[34px] px-3.5 rounded-md text-[12.5px] font-semibold bg-indigo-600 text-white hover:bg-indigo-700">
        <%= render Ui::IconComponent.new(name: "bookmark", class: "text-[11px]") %><%= t("member.uptime.announcement.save") %>
      </button>
    <% end %>

    <% if announcement %>
      <%= button_to t("member.uptime.announcement.clear"), member_monitoring_monitor_announcement_path(monitor),
            method: :delete, class: "inline-flex items-center gap-1.5 h-[30px] px-3 rounded-md text-[12px] font-medium text-gray-500 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800",
            data: { test: "announcement-clear" } %>
    <% end %>
  </div>
</div>
