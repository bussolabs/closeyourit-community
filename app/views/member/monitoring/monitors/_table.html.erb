<%# locals: monitors, range, uptime, buckets, pagination — vista flat paginata (?view=table).
    open_since: { monitor_id => started_at } del guasto in corso (CYRA-492).
    health_sorted: true quando l'ordinamento di default (non sani prima) è in vigore → lo dichiara l'header. %>
<div data-test="monitors-table">
  <%= render(Ui::TableComponent.new(stacked: true, label: t("member.uptime.title"))) do |t| %>
    <% t.with_head do %>
      <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.uptime.col_monitor"), sort: "monitor") %>
      <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.uptime.col_status"), sort: "status", classes: "w-24",
            hint: (health_sorted ? t("member.uptime.sort_health_hint") : nil)) %>
      <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.uptime.col_uptime", range: range), sort: "uptime", initial: :desc, align: :right, classes: "w-52") %>
      <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.uptime.col_response"), sort: "response", initial: :desc, align: :right, classes: "w-24") %>
      <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.uptime.col_last_check"), sort: "last_check", initial: :desc, align: :right, classes: "w-28") %>
      <%= render Ui::TableComponent::HeaderComponent.new(label: t("ui.table.open_column"), label_hidden: true) %>
    <% end %>
    <% monitors.each do |monitor| %>
      <%= render "member/monitoring/monitors/monitor_row", monitor: monitor, range: range,
            uptime: uptime[monitor.id], buckets: (buckets[monitor.id] || []), open_since: open_since, causes: @down_causes %>
    <% end %>
  <% end %>
  <%= render(Ui::PaginationComponent.new(pagination: pagination, test_id: "monitors-pagination")) %>
</div>
