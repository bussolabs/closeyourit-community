<%# locals: () %>
<%# T10 — the panel footer explains the colours of the availability strip: a block is one slice of
    the range, and grey means no check ran, not that the site was up. %>
<p class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-stone-200 dark:border-zinc-800 px-4 py-2 text-[11px] text-gray-500 dark:text-zinc-400" data-test="monitors-strip-legend">
  <% [ [ :up, "up" ], [ :partial, "partial" ], [ :down, "down" ], [ :empty, "no_data" ] ].each do |status, key| %>
    <span class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-sm <%= uptime_bucket_class(status) %>" aria-hidden="true"></span><%= t("member.uptime.bucket.#{key}") %>
    </span>
  <% end %>
</p>
