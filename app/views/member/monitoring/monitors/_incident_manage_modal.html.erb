<%# locals: monitor:, incident:, can_manage: — modale di gestione di UN incident: cronologia (timeline con
    aggiungi/elimina step) + eliminazione definitiva dell'incident. Aperto dal trigger ⋮ della riga; il
    <dialog> vive nello scope `ui--dialog` della cella azioni. Form add-step = endpoint updates#create
    esistente; elimina incident = incidents#destroy. <select> nativo → niente overflow-visible sul dialog. %>
<% window = if incident.window_ongoing?
              t("member.uptime.incident.window_ongoing", started: incident.window_started_at.strftime("%d/%m %H:%M"))
            else
              t("member.uptime.incident.window", started: incident.window_started_at.strftime("%d/%m %H:%M"), resolved: incident.window_resolved_at.strftime("%d/%m %H:%M"))
            end %>
<%= render Ui::ModalComponent.new(title: t("member.uptime.incident.manage"), subtitle: window,
      test_id: "incident-manage-dialog-#{incident.id}",
      data: { "ui--dialog-target": "dialog", action: "click->ui--dialog#backdrop" }) do |modal| %>
  <% modal.with_actions do %>
    <%= render Ui::ButtonComponent.new(label: t("member.uptime.incident.delete"),
          href: member_monitoring_monitor_incident_path(monitor, incident), method: :delete, variant: :danger_outline, size: :sm,
          icon: "trash", confirm: t("member.uptime.incident.delete_confirm"), test_id: "incident-delete-#{incident.id}") %>
    <%= render Ui::ButtonComponent.new(label: t("member.uptime.incident.close"), variant: :secondary_muted, size: :sm,
          data: { action: "ui--dialog#close" }) %>
  <% end %>
  <div class="space-y-4">
    <%= render "member/monitoring/monitors/incident_timeline", monitor:, incident:, can_manage: %>

    <%= form_with url: member_monitoring_monitor_incident_updates_path(monitor, incident), method: :post,
                  data: { controller: "incident-update" }, class: "space-y-3 pt-1" do %>
      <p class="font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400"><%= t("member.uptime.incident.add_step") %></p>

      <div>
        <label class="block font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 mb-1.5"><%= t("member.uptime.incident.phase") %></label>
        <select name="phase" required data-incident-update-target="phase" data-action="change->incident-update#fill"
                data-test="incident-manage-phase-<%= incident.id %>"
                class="w-full h-[34px] px-3 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 bg-white dark:bg-zinc-900 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400">
          <% Uptime::IncidentUpdate.phases.keys.each do |phase| %>
            <option value="<%= phase %>" data-body="<%= t("member.uptime.incident.default_body.#{phase}") %>"><%= uptime_phase_label(phase) %></option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="block font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 mb-1.5"><%= t("member.uptime.incident.message") %></label>
        <textarea name="body" rows="3" data-incident-update-target="body" data-test="incident-manage-body-<%= incident.id %>"
                  placeholder="<%= t('member.uptime.incident.message_placeholder') %>"
                  class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= t("member.uptime.incident.default_body.detected") %></textarea>
      </div>

      <div class="flex justify-end">
        <button type="submit" data-test="incident-manage-post-<%= incident.id %>"
                class="inline-flex items-center gap-1.5 h-[34px] px-3.5 rounded-md text-[12.5px] font-semibold bg-indigo-600 text-white hover:bg-indigo-700">
          <%= render Ui::IconComponent.new(name: "send", class: "text-[11px]") %><%= t("member.uptime.incident.post") %>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
