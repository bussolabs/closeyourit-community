<%# locals: check — Uptime::Check. Riga di un singolo tentativo/check (anche broadcast prepend via
    Turbo su #monitor_checks_<monitor_id> nella show). %>
<div id="<%= dom_id(check) %>" class="flex items-center gap-3 px-4 py-2.5" data-test="monitor-check-row">
  <%= render Ui::BadgeComponent.new(
        label: check.up? ? t("member.uptime.check_up") : t("member.uptime.check_down"),
        color: check.up? ? :emerald : :red, dot: true, size: :sm) %>
  <span class="font-mono text-[11.5px] text-zinc-900 dark:text-zinc-100 w-12 shrink-0"><%= check.status_code || "—" %></span>
  <span class="font-mono text-[11.5px] text-gray-600 dark:text-zinc-400 w-16 shrink-0"><%= check.response_time_ms ? "#{check.response_time_ms}ms" : "—" %></span>
  <span class="font-mono text-[11px] text-red-600 dark:text-red-400 truncate min-w-0 flex-1"><%= check.error %></span>
  <span class="font-mono text-[11px] text-gray-500 dark:text-zinc-400 shrink-0 ml-auto"><%= check.checked_at.strftime("%d/%m %H:%M:%S") %></span>
</div>
