<% content_for :title, t("member.monitoring.seo.titles.issues") %>

<div class="p-7 space-y-6" data-test="member-seo">
  <%= render "member/monitoring/seo/header", title: t("member.monitoring.seo.titles.issues"),
        total_count: @total_count, critical_count: @critical_count, high_count: @high_count,
        ignored_count: @ignored_count, pages_count: @pages_count, sites_count: @sites_count %>

  <% filtering = params[:q].present? || params[:severity].present? || params[:status].present? || params[:project_id].present? || params[:area].present? %>
  <% if @issues.empty? && !filtering %>
    <%= render Ui::EmptyStateComponent.new(title: t("member.monitoring.seo.empty"), body: t("member.monitoring.seo.empty_hint"), icon: "file-search", framed: true, test_id: "seo-empty") do |empty| %>
      <% empty.with_action do %>
        <%= render Ui::ButtonComponent.new(label: t("member.monitoring.seo_sites.new"), href: new_member_monitoring_seo_site_path,
              icon: "plus", variant: :primary, size: :sm, test_id: "seo-empty-new-site") %>
      <% end %>
    <% end %>
  <% else %>
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="seo-table">
      <%= render(Ui::TableToolbarComponent.new(framed: true,
            url: member_monitoring_seo_index_path, query: params[:q],
            search_placeholder: t("member.monitoring.seo.columns.url"),
            search_test_id: "seo-search", apply_test_id: "seo-filter",
            test_id: "seo-toolbar")) do |toolbar| %>
        <% toolbar.with_filter(key: "severity", label: t("member.monitoring.seo.columns.severity")) do %>
          <div class="w-36"><%= render Ui::SelectComponent.new(name: "severity", multiple: true, summary: true,
            options: Seo::Issue.severities.keys.reverse.map { |s| [ t("member.monitoring.seo.severity.#{s}"), s ] },
            selected: params[:severity], placeholder: t("member.monitoring.seo.columns.severity"), test_id: "filter-severity") %></div>
        <% end %>
        <% toolbar.with_filter(key: "status", label: t("member.monitoring.seo.columns.status")) do %>
          <div class="w-32"><%= render Ui::SelectComponent.new(name: "status", multiple: true, summary: true,
            options: Seo::Issue.statuses.keys.map { |s| [ t("member.monitoring.seo.status.#{s}"), s ] },
            selected: params[:status], placeholder: t("member.monitoring.seo.columns.status"), test_id: "filter-status") %></div>
        <% end %>
        <% toolbar.with_filter(key: "area", label: t("member.monitoring.seo.columns.area")) do %>
          <div class="w-40"><%= render Ui::SelectComponent.new(name: "area", multiple: true, summary: true,
            options: Seo::Check::AREAS.map { |a| [ seo_area_label(a), a ] },
            selected: params[:area], placeholder: t("member.monitoring.seo.columns.area"), test_id: "filter-area") %></div>
        <% end %>
        <% toolbar.with_filter(key: "project_id", label: t("member.monitoring.seo.columns.project")) do %>
          <div class="w-40"><%= render Ui::SelectComponent.new(name: "project_id", multiple: true, summary: true,
            options: @projects.map { |p| [ p.name, p.id, p.color ] }, selected: params[:project_id],
            placeholder: t("member.monitoring.seo.columns.project"), test_id: "filter-project") %></div>
        <% end %>
        <% toolbar.with_views do %>
          <%= render Ui::SavedViewsComponent.new(resource_type: "seo_issues", views: @saved_views,
                index_helper: :member_monitoring_seo_index_path, current_filters: params) %>
        <% end %>
      <% end %>

        <% if @issues.empty? %>
          <div class="px-4 py-10 text-center" data-test="seo-no-match">
            <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.empty") %></p>
          </div>
        <% else %>
          <%= render(Ui::TableComponent.new(stacked: true, label: t("member.monitoring.seo.title"))) do |t| %>
            <% t.with_head do %>
              <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.seo.columns.check"), sort: "check") %>
              <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.seo.columns.url")) %>
              <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.seo.columns.severity"), sort: "severity", initial: :desc, classes: "w-32") %>
              <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.seo.columns.area"), classes: "w-32") %>
              <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.seo.columns.project"), classes: "w-24") %>
              <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.monitoring.seo.columns.last_seen"), sort: "seen", classes: "w-28") %>
              <%= render Ui::TableComponent::HeaderComponent.new(label: t("ui.table.open_column"), label_hidden: true) %>
            <% end %>
            <%= render partial: "member/monitoring/seo/issue", collection: @issues, as: :issue %>
          <% end %>
          <%= render(Ui::PaginationComponent.new(pagination: @pagination, test_id: "seo-pagination")) %>
        <% end %>
    </div>
  <% end %>
</div>
