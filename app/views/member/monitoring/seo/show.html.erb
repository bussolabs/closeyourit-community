<% content_for :title, @issue.label %>
<% can_triage = can?("seo.triage", scope: @site.project) %>

<div class="p-7 space-y-6" data-test="member-seo-show">
  <%= render Ui::PageHeaderComponent.new(
        title: @issue.label,
        breadcrumb: [
          { label: t("member.monitoring.seo.titles.issues"), href: member_monitoring_seo_index_path },
          { label: @issue.label }
        ],
        counts_test_id: "seo-show-counts") do |h| %>
    <% h.with_counts do %>
      <%= render Ui::StatLabelComponent.new(label: t("member.monitoring.seo.columns.severity"),
            value: t("member.monitoring.seo.severity.#{@issue.severity}"),
            value_color: (@issue.severity_critical? || @issue.severity_high? ? :rose : nil), test_id: "seo-stat-issue-severity") %>
      <%= render Ui::StatLabelComponent.new(label: t("member.monitoring.seo.columns.status"),
            value: t("member.monitoring.seo.status.#{@issue.status}"), test_id: "seo-stat-issue-status") %>
      <%= render Ui::StatLabelComponent.new(label: t("member.monitoring.seo.columns.area"),
            value: seo_area_label(@issue.area), test_id: "seo-stat-issue-area") %>
    <% end %>
    <% if can_triage %>
      <% h.with_actions do %>
        <% if @issue.status_ignored? %>
          <%= button_to t("member.monitoring.seo.actions.reopen"), reopen_member_monitoring_seo_path(@issue),
                method: :patch, class: "inline-flex items-center h-7 px-2.5 rounded-md border border-stone-200 dark:border-zinc-800 text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800",
                data: { test: "seo-reopen" } %>
        <% else %>
          <%= button_to t("member.monitoring.seo.actions.ignore"), ignore_member_monitoring_seo_path(@issue),
                method: :patch, class: "inline-flex items-center h-7 px-2.5 rounded-md border border-stone-200 dark:border-zinc-800 text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800",
                data: { test: "seo-ignore" } %>
        <% end %>
        <% if @issue.promoted? %>
          <%= render Ui::ButtonComponent.new(label: @issue.ticket.code, href: member_ticket_path(@issue.ticket),
                variant: :secondary_muted, size: :sm, icon: "ticket", test_id: "seo-ticket") %>
        <% else %>
          <%= button_to t("member.monitoring.seo.actions.promote"), promote_member_monitoring_seo_path(@issue),
                method: :post, class: "inline-flex items-center h-7 px-2.5 rounded-md bg-indigo-600 text-[12.5px] font-medium text-white hover:bg-indigo-700",
                data: { test: "seo-promote" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <div class="lg:col-span-2 space-y-5">
      <%# La PROVA per prima: un rilievo senza prova non si distingue da un'opinione. %>
      <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5" data-test="seo-evidence">
        <h2 class="font-display text-[13px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.seo.show.evidence") %></h2>
        <p class="mt-2 text-[13px] text-zinc-900 dark:text-zinc-100"><%= @issue.explanation.presence || @issue.label %></p>

        <dl class="mt-4 space-y-2 text-[12.5px]">
          <% if @issue.url.present? %>
            <div class="flex items-start gap-3">
              <dt class="w-32 shrink-0 text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.url") %></dt>
              <dd class="font-mono text-[11.5px] text-zinc-900 dark:text-zinc-100 break-all">
                <%= link_to @issue.url, @issue.url, class: "hover:text-indigo-600 dark:hover:text-indigo-400", rel: "noopener noreferrer nofollow", target: "_blank", data: { test: "seo-issue-url" } %>
              </dd>
            </div>
          <% end %>
          <% seo_evidence_rows(@issue).each do |label, value| %>
            <div class="flex items-start gap-3">
              <dt class="w-32 shrink-0 text-gray-500 dark:text-zinc-400"><%= label %></dt>
              <dd class="text-zinc-900 dark:text-zinc-100 break-words"><%= truncate(value, length: 400) %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <% if @issue.page.present? %>
        <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5" data-test="seo-page-snapshot">
          <h2 class="font-display text-[13px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.seo.show.page_state") %></h2>
          <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-[12.5px]">
            <div><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.status") %></dt>
              <dd class="font-mono text-zinc-900 dark:text-zinc-100"><%= @issue.page.status_code || "—" %></dd></div>
            <div><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.title_tag") %></dt>
              <dd class="text-zinc-900 dark:text-zinc-100"><%= @issue.page.title.presence || "—" %></dd></div>
            <div><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.h1") %></dt>
              <dd class="text-zinc-900 dark:text-zinc-100"><%= @issue.page.h1.presence || "—" %></dd></div>
            <div><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.words") %></dt>
              <dd class="font-mono text-zinc-900 dark:text-zinc-100"><%= @issue.page.word_count %></dd></div>
            <div><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.canonical") %></dt>
              <dd class="font-mono text-[11px] text-zinc-900 dark:text-zinc-100 break-all"><%= @issue.page.canonical_url.presence || "—" %></dd></div>
            <div><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.response_time") %></dt>
              <dd class="font-mono text-zinc-900 dark:text-zinc-100"><%= @issue.page.response_time_ms ? "#{@issue.page.response_time_ms} ms" : "—" %></dd></div>
          </dl>
        </div>
      <% end %>
    </div>

    <div class="space-y-5">
      <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 space-y-3" data-test="seo-issue-details">
        <h2 class="font-display text-[13px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.seo.show.details") %></h2>
        <dl class="space-y-2 text-[12.5px]">
          <div class="flex items-start gap-3">
            <dt class="w-28 shrink-0 text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.site") %></dt>
            <dd class="font-mono text-[11.5px] text-zinc-900 dark:text-zinc-100 break-all"><%= @site.base_url %></dd>
          </div>
          <div class="flex items-start gap-3">
            <dt class="w-28 shrink-0 text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.project") %></dt>
            <dd class="text-zinc-900 dark:text-zinc-100"><%= @site.project.name %> · <%= @site.environment.label %></dd>
          </div>
          <div class="flex items-start gap-3">
            <dt class="w-28 shrink-0 text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.first_seen") %></dt>
            <dd class="text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.seo_sites.checked_ago", duration: time_ago_in_words(@issue.first_seen_at)) %></dd>
          </div>
          <div class="flex items-start gap-3">
            <dt class="w-28 shrink-0 text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.last_seen") %></dt>
            <dd class="text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.seo_sites.checked_ago", duration: time_ago_in_words(@issue.last_seen_at)) %></dd>
          </div>
          <% if @issue.triage_note.present? %>
            <div class="flex items-start gap-3">
              <dt class="w-28 shrink-0 text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.triage_note") %></dt>
              <dd class="text-zinc-900 dark:text-zinc-100"><%= @issue.triage_note %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>
  </div>
</div>
