<% content_for :title, t("member.servers.edit_title") %>
<div class="p-7">
  <%= form_with url: member_monitoring_server_path(@host), method: :patch, id: "server-form", data: { test: "server-form" } do %>
    <%= render Ui::PageHeaderComponent.new(title: t("member.servers.edit_title"),
          breadcrumb: [ { label: t("member.servers.title"), href: member_monitoring_servers_path },
                        { label: @host.name, href: member_monitoring_server_path(@host) },
                        { label: t("member.breadcrumb.edit") } ]) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.servers.form.cancel"), href: member_monitoring_server_path(@host), variant: :secondary_muted, size: :sm) %>
        <%= render Ui::ButtonComponent.new(label: t("member.servers.form.save"), type: "submit", icon: "check", size: :sm, test_id: "server-form-submit") %>
      <% end %>
    <% end %>

    <% if @errors.present? %>
      <div class="mt-4 rounded-md border border-rose-200 dark:border-rose-500/40 bg-rose-50 dark:bg-rose-500/15 px-3.5 py-2.5" data-test="server-form-errors">
        <ul class="space-y-1">
          <% @errors.each_value do |messages| %>
            <% Array(messages).each do |message| %><li class="text-[11.5px] text-rose-700 dark:text-rose-300"><%= message %></li><% end %>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-6 rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-5 py-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= render Ui::InputComponent.new(name: "name", label: t("member.servers.form.name"), required: true,
              value: @host.name, test_id: "server-name", error: @errors&.dig(:name)&.first,
              hint: t("member.servers.form.name_hint")) %>
      </div>
    </div>

    <%# CYRA-470 — i gruppi con cui si organizza la flotta ("produzione", "staging", "CI"): uno o più
        per macchina, così l'elenco si filtra e si raggruppa e «come sta la produzione» diventa una
        domanda che si può fare. Testo semplice separato da virgola, come lo scrive una persona. %>
    <div class="mt-6 rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-5 py-5" data-test="server-groups">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.servers.form.groups_title") %></h2>
      <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.servers.form.groups_hint") %></p>
      <div class="mt-4">
        <%= render Ui::InputComponent.new(name: "groups", value: @host.groups.join(", "),
              placeholder: t("member.servers.form.groups_placeholder"), test_id: "server-groups-field",
              error: @errors&.dig(:groups)&.first) %>
      </div>
    </div>

    <%# CYRA-489 — quali container su questa macchina NON sono servizi: quelli di compilazione e test
        nascono e muoiono a ogni lavorazione, e senza questo elenco l'unica difesa era spegnere
        l'intero avviso, perdendo anche i guasti veri. %>
    <div class="mt-6 rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-5 py-5" data-test="server-ignored-containers">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.servers.form.ignored_containers_title") %></h2>
      <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.servers.form.ignored_containers_hint") %></p>
      <div class="mt-4">
        <%# Una riga per frammento: il campo è testo semplice, come lo scrive una persona. %>
        <textarea name="ignored_container_patterns" rows="4" data-test="server-ignored-containers-field"
                  placeholder="<%= t("member.servers.form.ignored_containers_placeholder") %>"
                  class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 bg-white dark:bg-zinc-900 font-mono text-[12.5px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus-visible:ring-2"><%= @host.ignored_container_patterns.join("\n") %></textarea>
        <% if @errors&.dig(:ignored_container_patterns)&.first %>
          <p class="mt-1 text-[11px] text-red-600 dark:text-red-400"><%= @errors[:ignored_container_patterns].first %></p>
        <% end %>
      </div>
    </div>

    <%# CYRA-678 — gemello del blocco container per le unit systemd: una unit rumorosa (oneshot che
        fallisce per design) si esclude dagli avvisi senza spegnere la regola. Il pannello continua
        a mostrarla: qui si tace solo l'avviso. %>
    <div class="mt-6 rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-5 py-5" data-test="server-ignored-services">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.servers.form.ignored_services_title") %></h2>
      <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.servers.form.ignored_services_hint") %></p>
      <div class="mt-4">
        <textarea name="ignored_service_patterns" rows="4" data-test="server-ignored-services-field"
                  placeholder="<%= t("member.servers.form.ignored_services_placeholder") %>"
                  class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400 bg-white dark:bg-zinc-900 font-mono text-[12.5px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus-visible:ring-2"><%= @host.ignored_service_patterns.join("\n") %></textarea>
        <% if @errors&.dig(:ignored_service_patterns)&.first %>
          <p class="mt-1 text-[11px] text-red-600 dark:text-red-400"><%= @errors[:ignored_service_patterns].first %></p>
        <% end %>
      </div>
    </div>

    <%# CYRA-458: la soglia d'allarme di QUESTA macchina per le metriche di occupazione — si vede e si
        cambia dove sta il numero. Vuoto = vale la regola generale dell'org (nessun override). %>
    <div class="mt-6 rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-5 py-5" data-test="server-thresholds">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.servers.form.thresholds_title") %></h2>
      <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.servers.form.thresholds_hint") %></p>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
        <% [ [ :cpu, "server-cpu-threshold" ], [ :mem, "server-mem-threshold" ], [ :disk, "server-disk-threshold" ] ].each do |metric, test_id| %>
          <%= render Ui::InputComponent.new(name: "#{metric}_threshold", type: "number",
                label: t("member.servers.form.#{metric}_threshold"), placeholder: t("member.servers.form.threshold_unit"),
                value: @host.public_send("#{metric}_threshold"), test_id: test_id,
                error: @errors&.dig(:"#{metric}_threshold")&.first, min: 0, max: 100, step: "0.01") %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
