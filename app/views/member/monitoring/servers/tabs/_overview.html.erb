<%# Reads @host, @buckets, @journal_count, @environment_links, @detected_projects.
    The quick overview: how the machine is doing right now and what needs doing. Each vital opens the
    Metrics tab; each item to fix opens the tab where it is fixed. The long blocks live in their tabs. %>
<% metrics_href = member_monitoring_server_path(@host, tab: "metrics") %>
<% vitals = [
     [ :cpu, t("member.servers.overview.vital_cpu"), server_pct_text(@host.cpu_pct), server_pct_color(@host.cpu_pct) ],
     [ :mem, t("member.servers.overview.vital_mem"), server_pct_text(@host.mem_pct), server_pct_color(@host.mem_pct) ],
     [ :disk, t("member.servers.overview.vital_disk"), server_pct_text(@host.disk_pct), server_pct_color(@host.disk_pct) ],
     [ :load, t("member.servers.overview.vital_load"), @host.load_1.nil? ? "—" : format("%.2f", @host.load_1), "text-zinc-900 dark:text-zinc-100" ]
   ] %>
<% vitals << [ :temp, t("member.servers.overview.vital_temp"), server_temp_text(@host.temp_max), @host.temp_max.to_f >= 80 ? "text-red-600 dark:text-red-400" : "text-zinc-900 dark:text-zinc-100" ] if @host.temp_max %>

<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 grid grid-cols-2 <%= vitals.size == 5 ? "md:grid-cols-5" : "md:grid-cols-4" %> divide-x divide-y md:divide-y-0 divide-stone-200 dark:divide-zinc-800" data-test="server-vitals">
  <% vitals.each do |metric, label, value, color| %>
    <%= link_to metrics_href, class: "block px-5 py-4 hover:bg-stone-50 dark:hover:bg-zinc-800", data: { test: "server-vital-#{metric}" } do %>
      <span class="block font-mono text-[10.5px] uppercase tracking-[0.12em] text-gray-500 dark:text-zinc-400"><%= label %></span>
      <span class="mt-1 block font-mono text-[20px] font-semibold <%= color %>"><%= value %></span>
      <% if metric != :load %>
        <span class="mt-1.5 block"><%= render Ui::SparklineComponent.new(points: @buckets.map { |b| server_metric_value(b, metric) }.compact, label: label) %></span>
      <% end %>
    <% end %>
  <% end %>
</div>

<% attention = [] %>
<% attention << [ t("member.servers.overview.reboot"), "operations" ] if @host.reboot_required? %>
<% attention << [ t("member.servers.overview.updates", count: @host.security_updates_available), "operations" ] if @host.security_updates_available.to_i.positive? %>
<% attention << [ t("member.servers.overview.services_failed", count: @host.services_failed), "workloads" ] if @host.services_failed.to_i.positive? %>
<% attention << [ t("member.servers.overview.journal", count: @journal_count), "log" ] if @journal_count.positive? %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%= render Ui::SectionComponent.new(title: t("member.servers.overview.attention_title"), body_class: "") do %>
    <div data-test="server-attention">
      <% if attention.any? %>
        <ul class="divide-y divide-stone-100 dark:divide-zinc-800">
          <% attention.each do |label, tab| %>
            <li>
              <%= link_to member_monitoring_server_path(@host, tab: tab), class: "flex items-center gap-2.5 px-5 py-3 text-[13px] text-zinc-900 dark:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800" do %>
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500 shrink-0" aria-hidden="true"></span>
                <span class="flex-1"><%= label %></span>
                <span class="text-[12px] text-indigo-600 dark:text-indigo-400"><%= t("member.servers.tabs.#{tab}") %></span>
                <%= render Ui::IconComponent.new(name: "chevron-right", class: "text-[12px] text-gray-400 dark:text-zinc-500") %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 py-4 flex items-center gap-2 text-[13px] text-emerald-700 dark:text-emerald-300">
          <%= render Ui::IconComponent.new(name: "circle-check") %>
          <%= t("member.servers.overview.all_fine") %>
        </p>
      <% end %>
    </div>
  <% end %>

  <%= render "member/monitoring/servers/labels", host: @host, temp_reported: @temp_reported %>

  <div class="space-y-6">
    <%= render "member/monitoring/servers/projects", links: @environment_links, detected: @detected_projects %>

    <%# CYRA-460 — «e adesso?»: aprire un ticket su questa macchina, già intitolato e con i valori di
        adesso, e vedere cosa è scattato qui. Il corpo NON contiene righe di journal: un prefill che si
        porta dietro un segreto è peggio del copia-incolla a mano. %>
    <%= render Ui::SectionComponent.new(title: t("member.servers.show.next_steps")) do %>
      <div class="flex items-center flex-wrap gap-2" data-test="server-next-steps">
        <%= render Ui::ButtonComponent.new(label: t("member.servers.show.open_ticket"),
              href: new_member_ticket_path(title: t("member.servers.show.ticket_title", host: @host.name),
                                           description: server_ticket_description(@host)),
              variant: :primary, size: :sm, icon: "ticket", test_id: "server-open-ticket") %>
        <%# CYRA-813 — il filtro è la MACCHINA, non i suoi progetti: gli avvisi di una macchina nascono senza progetto. %>
        <%= render Ui::ButtonComponent.new(label: t("member.servers.show.see_alerts"),
              href: member_alerting_notifications_path(host_id: @host.id),
              variant: :secondary_muted, size: :sm, icon: "bell", test_id: "server-see-alerts") %>
      </div>
    <% end %>
  </div>
</div>
