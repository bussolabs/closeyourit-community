<% content_for :title, t("member.monitoring.replays.session_label") %>
<%# CSS del player rrweb-player (come la show errori). %>
<% content_for :head do %><%= stylesheet_link_tag "rrweb-player", "data-turbo-track": "reload" %><% end %>

<div class="p-7 space-y-6" data-test="member-replay-show">
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.monitoring.replays.session_label"),
        breadcrumb: [ { label: t("member.monitoring.replays.title"), href: member_monitoring_replays_path },
                      { label: @session.replay_session_id.truncate(16) } ],
        test_id: "replay-show-header") %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Player (2/3). Riusa errors--replay-player: carica gli eventi da url-value e monta rrweb-player. %>
    <div class="lg:col-span-2 rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900"
         data-test="replay-player"
         data-controller="errors--replay-player"
         data-errors--replay-player-url-value="<%= player_member_monitoring_replay_path(@session) %>"
         data-errors--replay-player-loading-value="<%= t("member.monitoring.replay.loading") %>"
         data-errors--replay-player-error-value="<%= t("member.monitoring.replay.error") %>"
         data-errors--replay-player-empty-value="<%= t("member.monitoring.replay.empty") %>">
      <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800 flex items-center justify-between">
        <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.replay.title") %></h2>
        <span class="text-[12px] text-stone-500 dark:text-zinc-400" data-errors--replay-player-target="status"></span>
      </div>
      <div class="p-4"><div class="flex justify-center" data-errors--replay-player-target="mount"></div></div>
    </div>

    <%# Dettagli sessione (1/3). %>
    <div class="space-y-6">
      <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="replay-details">
        <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.replays.details") %></h2></div>
        <dl class="px-4 py-3 space-y-2 text-[12.5px]">
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.replays.col_project") %></dt><dd class="text-zinc-900 dark:text-zinc-100"><%= @session.project.name %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.replays.col_user") %></dt><dd class="font-mono text-[11px] text-zinc-900 dark:text-zinc-100"><%= @session.user_hash.presence || "—" %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.replays.col_entry") %></dt><dd class="font-mono text-[11px] text-zinc-900 dark:text-zinc-100 truncate max-w-[180px]"><%= @session.entry_path.presence || "—" %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.replays.env") %></dt><dd class="text-zinc-900 dark:text-zinc-100"><%= @session.environment.presence || "—" %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.replays.col_duration") %></dt><dd class="font-mono text-zinc-900 dark:text-zinc-100"><%= @session.duration_ms ? format("%d:%02d", @session.duration_ms / 60_000, (@session.duration_ms / 1000) % 60) : "—" %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.replays.col_started") %></dt><dd class="text-zinc-900 dark:text-zinc-100"><%= l(@session.started_at, format: :long) rescue @session.started_at %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.replays.col_errors") %></dt><dd class="text-zinc-900 dark:text-zinc-100"><%= @errors_count %></dd></div>
        </dl>
      </div>

      <%# Pagine visitate. %>
      <% if @session.pages.present? %>
        <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="replay-pages">
          <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.replays.pages") %></h2></div>
          <ul class="px-4 py-3 space-y-1">
            <% @session.pages.each do |path| %>
              <li class="font-mono text-[12px] text-gray-700 dark:text-zinc-300 truncate"><%= path %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Errori nella sessione (link al gruppo). %>
      <% if @error_groups.any? %>
        <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="replay-errors">
          <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.replays.errors_in_session") %></h2></div>
          <ul class="divide-y divide-stone-100 dark:divide-zinc-800">
            <% @error_groups.each do |group| %>
              <li><%= link_to member_monitoring_error_group_path(group, rid: @session.replay_session_id),
                    class: "block px-4 py-2.5 hover:bg-stone-50 dark:hover:bg-zinc-800 text-[12.5px] text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400 truncate" do %>
                <%= render Ui::IconComponent.new(name: "bug", class: "text-[10px] text-red-500 dark:text-red-400 mr-1") %><%= group.title %>
              <% end %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</div>
