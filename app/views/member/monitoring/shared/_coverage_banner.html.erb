<%# locals: report: (Alerting::Coverage::Report), i18n_scope:, new_rule_href: (String|nil), test_id:, area:
    CYRA-477: dichiara sull'index quanti monitor sono coperti da una regola di avviso e quanti no. Il
    prodotto prometteva un avviso che, senza una regola, non poteva arrivare — qui il buco si vede e si
    chiude col link (mostrato solo a chi può gestire gli avvisi). It floats over the frame and closes
    for good; its key carries the state, so a change in coverage brings it back. %>
<% if report.total.positive? %>
  <% uncovered = report.any_uncovered? %>
  <% content_for :floating_notice do %>
    <%= render Ui::FloatingNoticeComponent.new(
          key: "coverage_#{area}:#{uncovered ? "uncovered-#{report.uncovered}" : 'covered'}",
          title: (uncovered ? t("#{i18n_scope}.uncovered_title", count: report.uncovered, total: report.total) : t("#{i18n_scope}.covered_title")),
          tone: (uncovered ? :warning : :success), test_id: test_id) do %>
      <% if uncovered %>
        <%= t("#{i18n_scope}.uncovered_body") %><% if new_rule_href %> <%= link_to t("#{i18n_scope}.uncovered_link"), new_rule_href, class: "font-medium text-amber-700 dark:text-amber-300 underline underline-offset-2 hover:text-amber-800 dark:hover:text-amber-200", data: { test: "#{test_id}-link" } %><% end %>
      <% else %>
        <%= t("#{i18n_scope}.covered_body") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
