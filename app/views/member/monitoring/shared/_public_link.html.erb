<%# locals: public_url:, badge_url:, test_prefix: — pannello della status page pubblicata, unico per
    monitor e gruppo (prima era duplicato identico nelle due show). Link pubblico + apri + copia, più
    "Incorpora" che apre gli snippet da incollare sul sito monitorato.

    Gli scope Stimulus sono TRE clipboard separati (banner, badge, pagina) e non uno solo: il
    controller ha target singoli `source`/`label`, quindi due snippet nello stesso scope si
    copierebbero a vicenda. Stimulus assegna ogni target al controller antenato più vicino, perciò
    l'annidamento dentro `ui--dialog` è corretto. %>
<%
  # Solo gli snippet portano la lingua (status_embed_url): il link pubblico qui sopra si copia e si
  # condivide, e resta l'URL pulito di sempre.
  frame_title   = t("member.uptime.embed_frame_title")
  badge_src     = status_embed_url(badge_url)
  badge_snippet = status_embed_snippet(badge_src, width: 280, height: 36, title: frame_title)
  page_snippet  = status_embed_snippet(status_embed_url(public_url), width: "100%", height: 800, title: frame_title)
%>
<div data-controller="ui--dialog">
  <div class="rounded-lg border border-indigo-200 dark:border-indigo-500/40 bg-indigo-50/40 dark:bg-indigo-500/10 px-4 py-3 flex items-center gap-2.5 flex-wrap" data-controller="clipboard" data-clipboard-copied-value="<%= t('member.uptime.public_link_copied') %>" data-test="<%= test_prefix %>-public-link">
    <%= render Ui::IconComponent.new(name: "globe", class: "text-indigo-600 dark:text-indigo-400 text-[13px]") %>
    <span class="text-[12.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.uptime.public_link_label") %></span>
    <code data-clipboard-target="source" class="flex-1 min-w-0 truncate rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 py-1.5 font-mono text-[12px] text-zinc-800 dark:text-zinc-200"><%= public_url %></code>
    <%= link_to public_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 h-[32px] px-3 rounded-md text-[12px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800 shrink-0", data: { test: "#{test_prefix}-public-open" } do %>
      <%= render Ui::IconComponent.new(name: "arrow-up-right-from-square", class: "text-[11px] text-gray-400 dark:text-zinc-500") %><%= t("member.uptime.public_link_open") %>
    <% end %>
    <button type="button" data-action="clipboard#copy" class="inline-flex items-center gap-1.5 h-[32px] px-3 rounded-md text-[12px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800 shrink-0">
      <%= render Ui::IconComponent.new(name: "copy", class: "text-[12px] text-gray-400 dark:text-zinc-500") %><span data-clipboard-target="label"><%= t("member.uptime.public_link_copy") %></span>
    </button>
    <%# Stessa forma dei due bottoni accanto (h-[32px] scritti a mano) invece di Ui::ButtonComponent:
        nella stessa riga altezze diverse si vedrebbero. %>
    <button type="button" data-action="ui--dialog#open" data-test="<%= test_prefix %>-embed"
            class="inline-flex items-center gap-1.5 h-[32px] px-3 rounded-md text-[12px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800 shrink-0">
      <%= render Ui::IconComponent.new(name: "code", class: "text-[11px] text-gray-400 dark:text-zinc-500") %><%= t("member.uptime.embed") %>
    </button>
  </div>

  <%= render Ui::ModalComponent.new(title: t("member.uptime.embed_title"), test_id: "#{test_prefix}-embed-dialog",
        data: { "ui--dialog-target": "dialog", action: "click->ui--dialog#backdrop" }) do |modal| %>
    <% modal.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.uptime.embed_close"), variant: :secondary_muted, size: :sm,
            data: { action: "ui--dialog#close" }) %>
    <% end %>
    <div class="space-y-5">
      <div data-controller="clipboard" data-clipboard-copied-value="<%= t('member.uptime.public_link_copied') %>" data-test="<%= test_prefix %>-embed-badge">
        <p class="font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400"><%= t("member.uptime.embed_badge") %></p>
        <p class="mt-1 text-[12.5px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.uptime.embed_badge_hint") %></p>
        <%# Anteprima viva: è lo stesso URL dello snippet, servito dalla nostra origine, quindi qui si
            vede esattamente ciò che vedrà il visitatore del sito di destinazione. %>
        <iframe src="<%= badge_src %>" width="280" height="36" title="<%= t('member.uptime.embed_preview') %>"
                class="mt-3 block" style="border:0" loading="lazy"></iframe>
        <code data-clipboard-target="source" class="mt-3 block w-full rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 px-3 py-2 font-mono text-[11.5px] leading-relaxed text-zinc-800 dark:text-zinc-200 break-words"><%= badge_snippet %></code>
        <div class="mt-2 flex justify-end">
          <button type="button" data-action="clipboard#copy" class="inline-flex items-center gap-1.5 h-[30px] px-3 rounded-md text-[12px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800">
            <%= render Ui::IconComponent.new(name: "copy", class: "text-[12px] text-gray-400 dark:text-zinc-500") %><span data-clipboard-target="label"><%= t("member.uptime.public_link_copy") %></span>
          </button>
        </div>
      </div>

      <div class="pt-1 border-t border-stone-100 dark:border-zinc-800" data-controller="clipboard" data-clipboard-copied-value="<%= t('member.uptime.public_link_copied') %>" data-test="<%= test_prefix %>-embed-page">
        <p class="mt-4 font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400"><%= t("member.uptime.embed_page") %></p>
        <p class="mt-1 text-[12.5px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.uptime.embed_page_hint") %></p>
        <code data-clipboard-target="source" class="mt-3 block w-full rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 px-3 py-2 font-mono text-[11.5px] leading-relaxed text-zinc-800 dark:text-zinc-200 break-words"><%= page_snippet %></code>
        <div class="mt-2 flex justify-end">
          <button type="button" data-action="clipboard#copy" class="inline-flex items-center gap-1.5 h-[30px] px-3 rounded-md text-[12px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800">
            <%= render Ui::IconComponent.new(name: "copy", class: "text-[12px] text-gray-400 dark:text-zinc-500") %><span data-clipboard-target="label"><%= t("member.uptime.public_link_copy") %></span>
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>
