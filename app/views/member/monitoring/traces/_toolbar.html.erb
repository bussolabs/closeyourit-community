<% range = trace_window %>
<%= render Ui::TableToolbarComponent.new(framed: true, url: member_monitoring_traces_path, query: params[:q], search_placeholder: t("member.traces.search"), test_id: "traces-toolbar") do |toolbar| %>
  <% toolbar.with_filter(key: "project_id", label: t("member.traces.project")) do %>
    <%= render Ui::SelectComponent.new(name: "project_id", options: [[t("member.traces.all_projects"), ""]] + @projects.map { |project| [project.name, project.id] }, selected: params[:project_id], test_id: "traces-project") %>
  <% end %>
  <% toolbar.with_filter(key: "project_query", label: t("member.traces.project_search")) do %>
    <%= render Ui::InputComponent.new(name: "project_query", value: params[:project_query], placeholder: t("member.traces.project_search"), maxlength: 128, data: { filter_bar_value: "", action: "change->ui--filter-bar#submit" }) %>
  <% end %>
  <% %w[service environment version min_duration_ms max_duration_ms].each do |key| %>
    <% toolbar.with_filter(key: key, label: t("member.traces.#{key}"), active: !params[key].nil?) do %>
      <%= render Ui::InputComponent.new(name: key, value: params[key], disabled: (%w[service environment version].include?(key) && params[key].nil?), placeholder: t("member.traces.#{key}"), maxlength: 256, data: { filter_bar_value: "", filter_bar_exact: (%w[service environment version].include?(key) ? "" : nil), action: "change->ui--filter-bar#submit" }) %>
    <% end %>
  <% end %>
  <% toolbar.with_filter(key: "status", label: t("member.traces.status")) do %>
    <%= render Ui::SelectComponent.new(name: "status", options: [[t("member.traces.all_statuses"), ""]] + %w[error ok unset mixed unknown].map { |value| [t("member.traces.statuses.#{value}"), value] }, selected: params[:status]) %>
  <% end %>
  <% toolbar.with_filter(key: "range", label: t("shared.time_range.label"), active: range.custom? || range.key != "24h") do %>
    <%= render "member/monitoring/range_filter", range: range, range_set: range.custom? || range.key != "24h", test_prefix: "traces-range" %>
  <% end %>
  <% toolbar.with_views do %><%= render Ui::SavedViewsComponent.new(resource_type: "traces", views: @saved_views, index_helper: :member_monitoring_traces_path, current_filters: params) %><% end %>
<% end %>
