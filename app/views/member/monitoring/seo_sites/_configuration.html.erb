<%# locals: site — com'è configurato il controllo: a quale indirizzo si bussa, ogni quanto, fin dove.
    Sono le stesse scelte del form, in sola lettura: chi apre la scheda deve poter capire perché il
    sito viene visitato così senza aprire la modifica. %>
<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="seo-site-configuration">
  <div class="px-5 py-3.5 border-b border-stone-200 dark:border-zinc-800">
    <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.seo_sites.show.configuration") %></h2>
  </div>
  <dl class="px-5 py-4 grid grid-cols-2 gap-x-4 gap-y-3">
    <div class="col-span-2">
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo.columns.site") %></dt>
      <dd class="mt-0.5 font-mono text-[11.5px] text-zinc-900 dark:text-zinc-100 break-all" data-test="seo-site-base-url"><%= site.base_url %></dd>
    </div>
    <div>
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo_sites.columns.frequency") %></dt>
      <dd class="mt-0.5 text-[12px] text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.seo_sites.frequency.#{site.frequency}") %></dd>
    </div>
    <div>
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo_sites.fields.max_pages") %></dt>
      <dd class="mt-0.5 font-mono text-[12px] text-zinc-900 dark:text-zinc-100"><%= site.max_pages %></dd>
    </div>
    <div>
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo_sites.fields.follow_sitemap") %></dt>
      <dd class="mt-0.5 text-[12px] text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.seo_sites.show.#{site.follow_sitemap? ? 'sitemap_on' : 'sitemap_off'}") %></dd>
    </div>
    <div>
      <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo_sites.show.state") %></dt>
      <dd class="mt-0.5 text-[12px] <%= site.enabled? ? 'text-zinc-900 dark:text-zinc-100' : 'text-amber-600 dark:text-amber-400' %>" data-test="seo-site-state">
        <%= t("member.monitoring.seo_sites.show.#{site.enabled? ? 'enabled' : 'paused'}") %>
      </dd>
    </div>
    <% if site.enabled? && site.next_audit_at.present? %>
      <div class="col-span-2">
        <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.seo_sites.show.next_audit") %></dt>
        <dd class="mt-0.5 text-[12px] text-zinc-900 dark:text-zinc-100" data-test="seo-site-next-audit">
          <%= t("member.monitoring.seo_sites.show.in_time", duration: distance_of_time_in_words(Time.current, site.next_audit_at)) %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>
