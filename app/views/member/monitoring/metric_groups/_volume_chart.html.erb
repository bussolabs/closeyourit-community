<% buckets = Array(@buckets) %>
<% max = buckets.map { |b| b[:count].to_i }.max.to_i %>
<%= render Ui::SectionComponent.new(title: t("member.metrics.chart_title"), header_class: "flex items-center gap-2",
      body_class: nil, test_id: "duration-chart") do %>
  <div class="px-4 pt-3 font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.metrics.timeline_sub", range: @range, count: buckets.size) %><% if max.positive? %> · <%= t("member.metrics.chart_peak", count: max) %><% end %></div>
  <%# Barre cliccabili: cliccare un blocco filtra i campioni alla sua finestra (from/to); il
      blocco attivo si evidenzia (@bucket_from). CYRA-46. %>
  <%= render Ui::HistogramComponent.new(
        bars: metric_chart_bars(buckets, max, @range,
                bucket_href: ->(from, to) { member_monitoring_metric_group_path(@group, range: @range, chart_at: @chart_anchor.iso8601(6), from: from.iso8601(6), to: to.iso8601(6)) },
                active_from: @bucket_from, active_to: @bucket_to),
        gridlines: chart_gridlines(max),
        xticks: chart_xticks(buckets, @range),
        buckets_test_id: "duration-buckets",
        summary: t("member.metrics.chart_summary", count: max, range: @range),
        empty_label: t("member.metrics.chart_empty")) %>
<% end %>
