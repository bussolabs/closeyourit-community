<% content_for :title, t("member.metrics.title") %>

<div class="p-7 space-y-6" data-test="member-metric-groups">
  <%# Live: ogni nuovo campione (Metrics::Ingest::Record) manda un page-refresh Turbo throttlato sullo
      stream metrics dell'org; il browser ri-fetcha QUESTO URL (filtri/paginazione per-viewer) e morpha
      il DOM, così righe e pill si aggiornano senza aggregazioni org-wide nel path caldo (CYRA-41). Stream
      org-prefissato (Realtime::Streams.metrics) → niente leak cross-tenant. %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
  <%# CYRA-822 — con un filtro di progetto attivo il segnale arriva dai soli progetti osservati, non
      più da tutta l'organizzazione: un campione di un progetto che non si sta guardando non fa più
      ri-chiedere questa pagina. %>
  <% if @live_projects.any? %>
    <% @live_projects.each do |stream_project| %>
      <%= turbo_stream_from Realtime::Streams.project_metrics_list(stream_project) %>
    <% end %>
  <% else %>
    <%= turbo_stream_from Realtime::Streams.metrics(current_organization) %>
  <% end %>
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.metrics.title"),
        subtitle: t("member.metrics.help_title"),
        breadcrumb: [ { label: t("member.metrics.title") } ],
        counts_test_id: "metrics-stats") do |h| %>
    <% h.with_counts do %>
      <%# CYRA-815 — il totale è quello delle pill (l'insieme filtrato senza la categoria), non più
          quello della paginazione: con un filtro di categoria acceso i due numeri sono diversi, e
          quello della paginazione contraddiceva la somma delle tre voci accanto. Quante righe si
          stanno guardando lo dice già il contatore della toolbar. %>
      <%= render "member/monitoring/metric_groups/stats",
            total: @counts_total, slow_query: @slow_query_count, slow_method: @slow_method_count,
            performance_issue: @performance_issue_count, total_duration: @total_duration,
            active_kind: @active_kind, kinds_unfiltered: @kinds_unfiltered %>
    <% end %>
  <% end %>

  <%# CYRA-340: il periodo restringe SEMPRE (predefinito: ultime 24 ore), quindi un elenco vuoto non
      vuol più dire «non è ancora arrivato niente» — quella domanda la risponde @has_records, che
      guarda oltre il periodo. %>
  <% filtering = params[:q].present? || params[:kind].present? || params[:subtype].present? || params[:status].present? || params[:project_id].present? %>
  <% if @metric_groups.empty? && !filtering && !@has_records %>
    <%= render Ui::EmptyStateComponent.new(title: t("member.metrics.empty"), body: t("member.metrics.empty_body"), icon: "gauge", framed: true, test_id: "metrics-empty") %>
  <% else %>
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="metric-groups-table">
      <%= render(Ui::TableToolbarComponent.new(framed: true,
            url: member_monitoring_metric_groups_path, query: params[:q],
            search_placeholder: t("member.metrics.search_placeholder"),
            search_test_id: "metrics-search", apply_test_id: "metrics-filter",
            test_id: "metrics-toolbar")) do |toolbar| %>
        <%# CYRA-340, CYRA-924: the period, a Filters chip identical to Errors and Logs (C61). %>
        <% range = current_time_range %>
        <% range_set = range.custom? || range.key != Monitoring::TimeRange::DEFAULT %>
        <% toolbar.with_filter(key: "range", label: t("shared.time_range.label"), active: range_set) do %>
          <%= render "member/monitoring/range_filter", range:, range_set:, test_prefix: "metrics" %>
        <% end %>
        <% toolbar.with_filter(key: "kind", label: t("member.metrics.filter_kind")) do %>
          <div class="w-36"><%= render Ui::SelectComponent.new(name: "kind", multiple: true, summary: true,
            options: Metrics::Group.kinds.keys.map { |k| [ metric_kind_label(k), k ] },
            descriptions: Metrics::Group.kinds.keys.index_with { |k| metric_kind_hint(k) },
            selected: params[:kind], placeholder: t("member.metrics.filter_kind"),
            aria_label: t("member.metrics.filter_kind"), test_id: "filter-kind") %></div>
        <% end %>
        <% toolbar.with_filter(key: "subtype", label: t("member.metrics.filter_subtype")) do %>
          <div class="w-44"><%= render Ui::SelectComponent.new(name: "subtype", multiple: true, summary: true,
            options: Metrics::Group::PERFORMANCE_SUBTYPES.map { |s| [ perf_subtype_label(s), s ] },
            descriptions: Metrics::Group::PERFORMANCE_SUBTYPES.index_with { |s| perf_subtype_hint(s) },
            selected: params[:subtype], placeholder: t("member.metrics.filter_subtype"),
            aria_label: t("member.metrics.filter_subtype"), test_id: "filter-subtype") %></div>
        <% end %>
        <% toolbar.with_filter(key: "status", label: t("member.metrics.filter_status")) do %>
          <div class="w-36"><%= render Ui::SelectComponent.new(name: "status", multiple: true, summary: true,
            options: Metrics::Group.statuses.keys.map { |s| [ t("member.metrics.status.#{s}"), s ] },
            selected: params[:status], placeholder: t("member.metrics.filter_status"), test_id: "filter-status") %></div>
        <% end %>
        <% toolbar.with_filter(key: "project_id", label: t("member.metrics.filter_project")) do %>
          <div class="w-40"><%= render Ui::SelectComponent.new(name: "project_id", multiple: true, summary: true,
            options: @projects.map { |p| [ p.name, p.id, p.color ] }, selected: params[:project_id],
            placeholder: t("member.metrics.filter_project"), test_id: "filter-project") %></div>
        <% end %>
        <% toolbar.with_views do %>
          <%= render Ui::SavedViewsComponent.new(resource_type: "metric_groups", views: @saved_views,
                index_helper: :member_monitoring_metric_groups_path, current_filters: params,
                presets: @saved_view_presets) %>
        <% end %>
      <% end %>

        <%# CYRA-821 — i risultati vivono in un frame proprio: sfogliare e riordinare aggiornano
            soltanto lui, la barra qui sopra e le pill in cima restano quelle. %>
        <%= render "member/monitoring/metric_groups/results" %>
    </div>
  <% end %>
</div>
