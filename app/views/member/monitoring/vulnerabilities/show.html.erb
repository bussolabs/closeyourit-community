<% content_for :title, @finding.package_coordinates %>
<% can_triage = can?("vulnerabilities.triage", scope: @finding.project) %>

<div class="p-7 space-y-6" data-test="member-vulnerability-show">
  <%= render Ui::PageHeaderComponent.new(
        title: @finding.package_coordinates,
        breadcrumb: [
          { label: t("member.monitoring.vulnerabilities.title"), href: member_monitoring_vulnerabilities_path },
          { label: @finding.display_id }
        ],
        counts_test_id: "vulnerability-show-counts") do |h| %>
    <% h.with_counts do %>
      <%= render Ui::StatLabelComponent.new(label: t("member.monitoring.vulnerabilities.columns.severity"),
            value: t("member.monitoring.vulnerabilities.severity.#{@finding.severity}"),
            value_color: (@finding.promotable? ? :rose : nil), test_id: "vulnerability-stat-severity") %>
      <%= render Ui::StatLabelComponent.new(label: t("member.monitoring.vulnerabilities.status.open"),
            value: t("member.monitoring.vulnerabilities.status.#{@finding.status}"), test_id: "vulnerability-stat-status") %>
      <%= render Ui::StatLabelComponent.new(label: t("member.monitoring.vulnerabilities.columns.fixed_version"),
            value: @finding.fixed_version.presence || t("member.monitoring.vulnerabilities.fixed_version_none"),
            value_color: (@finding.fixable? ? :emerald : nil), test_id: "vulnerability-stat-fixed") %>
    <% end %>
    <% if can_triage %>
      <% h.with_actions do %>
        <% if @finding.status_ignored? %>
          <%= button_to t("member.monitoring.vulnerabilities.actions.reopen"), reopen_member_monitoring_vulnerability_path(@finding),
                method: :patch, class: "inline-flex items-center h-7 px-2.5 rounded-md border border-stone-200 dark:border-zinc-800 text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800",
                data: { test: "vulnerability-reopen" } %>
        <% else %>
          <%= button_to t("member.monitoring.vulnerabilities.actions.ignore"), ignore_member_monitoring_vulnerability_path(@finding),
                method: :patch, class: "inline-flex items-center h-7 px-2.5 rounded-md border border-stone-200 dark:border-zinc-800 text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800",
                data: { test: "vulnerability-ignore" } %>
        <% end %>
        <% if @finding.promoted? %>
          <%= render Ui::ButtonComponent.new(label: @finding.ticket.code, href: member_ticket_path(@finding.ticket),
                variant: :secondary_muted, size: :sm, icon: "ticket", test_id: "vulnerability-ticket") %>
        <% else %>
          <%= button_to t("member.monitoring.vulnerabilities.actions.promote"), promote_member_monitoring_vulnerability_path(@finding),
                method: :post, class: "inline-flex items-center h-7 px-2.5 rounded-md bg-indigo-600 text-[12.5px] font-medium text-white hover:bg-indigo-700",
                data: { test: "vulnerability-promote" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <div class="lg:col-span-2 space-y-5">
      <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5" data-test="vulnerability-summary">
        <h2 class="font-display text-[13px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.vulnerabilities.show.summary") %></h2>
        <p class="mt-2 text-[13px] text-zinc-900 dark:text-zinc-100"><%= @finding.advisory.summary.presence || t("member.monitoring.vulnerabilities.show.no_summary") %></p>
        <% unless @finding.fixable? %>
          <p class="mt-3 text-[12.5px] text-gray-500 dark:text-zinc-400" data-test="vulnerability-no-fix-note"><%= t("member.monitoring.vulnerabilities.no_fix_hint") %></p>
        <% end %>
        <% if @finding.advisory.details.present? && @finding.advisory.details.strip != @finding.advisory.summary.to_s.strip %>
          <%# Testo di un database esterno: reso come testo semplice, mai come HTML. %>
          <p class="mt-3 text-[12.5px] text-gray-500 dark:text-zinc-400 whitespace-pre-line"><%= @finding.advisory.details.truncate(2000) %></p>
        <% end %>
      </div>
    </div>

    <div class="space-y-5">
      <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 space-y-3" data-test="vulnerability-details">
        <h2 class="font-display text-[13px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.vulnerabilities.show.details") %></h2>
        <dl class="space-y-2 text-[12.5px]">
          <div class="flex justify-between gap-3">
            <dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.vulnerabilities.show.affected_package") %></dt>
            <dd class="font-mono text-zinc-900 dark:text-zinc-100"><%= @finding.package_coordinates %></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.vulnerabilities.columns.project") %></dt>
            <dd class="font-mono text-zinc-900 dark:text-zinc-100"><%= @finding.project.key %></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.vulnerabilities.columns.manifest") %></dt>
            <dd class="font-mono text-[11px] text-gray-500 dark:text-zinc-400 text-right"><%= @manifest.path %></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.vulnerabilities.columns.last_seen") %></dt>
            <dd class="text-zinc-900 dark:text-zinc-100"><%= l(@finding.last_seen_at, format: :long) %></dd>
          </div>
          <% if @finding.advisory.cvss.present? %>
            <div class="flex justify-between gap-3">
              <dt class="text-gray-500 dark:text-zinc-400">CVSS</dt>
              <dd class="font-mono text-[10.5px] text-gray-500 dark:text-zinc-400 text-right break-all"><%= @finding.advisory.cvss %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5" data-test="vulnerability-references">
        <h2 class="font-display text-[13px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.vulnerabilities.show.references") %></h2>
        <ul class="mt-2 space-y-1.5">
          <li>
            <%= link_to @finding.advisory.osv_url, target: "_blank", rel: "noopener noreferrer",
                  class: "font-mono text-[12px] text-indigo-600 dark:text-indigo-400 hover:underline", data: { test: "vulnerability-advisory-link" } do %>
              <%= @finding.advisory.osv_id %> <%= render Ui::IconComponent.new(name: "arrow-up-right-from-square", class: "text-[9px]") %>
            <% end %>
          </li>
          <% @finding.advisory.aliases.each do |alias_id| %>
            <li><span class="font-mono text-[12px] text-gray-500 dark:text-zinc-400"><%= alias_id %></span></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
