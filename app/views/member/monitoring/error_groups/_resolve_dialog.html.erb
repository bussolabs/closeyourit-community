<%# CYRA-192 · locals: group — Errors::Group. La chiusura di un errore porta con sé la spiegazione.
    Due campi separati e non una nota unica: a mesi di distanza «era il lock di SQLite» e «abbiamo
    escluso l'eccezione nell'SDK» rispondono a domande diverse, e un campo solo le mescola. Entrambi
    facoltativi — chi ha fretta chiude e basta, e il service non cancella la spiegazione di prima.
    <dialog> nativo pilotato da ui--dialog, come l'anteprima della promozione a ticket. %>
<%= render Ui::ModalComponent.new(title: t("member.monitoring.resolution.dialog_title"), subtitle: t("member.monitoring.resolution.dialog_hint"),
      form: { url: resolve_member_monitoring_error_group_path(group), method: :patch, data: { test: "resolve-form" } },
      test_id: "resolve-dialog", data: { "ui--dialog-target": "dialog", action: "click->ui--dialog#backdrop" }) do |modal| %>
  <% modal.with_actions do %>
    <%= render Ui::ButtonComponent.new(label: t("shared.actions_cancel"), variant: :secondary_muted, size: :sm,
          data: { action: "ui--dialog#close" }) %>
    <%= render Ui::ButtonComponent.new(label: t("member.monitoring.resolve"), type: "submit", variant: :success, size: :sm,
          icon: "check", test_id: "resolve-confirm") %>
  <% end %>
  <div class="space-y-3">
    <div>
      <label for="resolution_cause" class="block font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 mb-1.5"><%= t("member.monitoring.resolution.cause") %></label>
      <textarea name="cause" id="resolution_cause" rows="2" data-test="resolve-cause"
                placeholder="<%= t('member.monitoring.resolution.cause_placeholder') %>"
                class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= group.resolution_cause %></textarea>
    </div>
    <div>
      <label for="resolution_fix" class="block font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 mb-1.5"><%= t("member.monitoring.resolution.fix") %></label>
      <textarea name="fix" id="resolution_fix" rows="2" data-test="resolve-fix"
                placeholder="<%= t('member.monitoring.resolution.fix_placeholder') %>"
                class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= group.resolution_fix %></textarea>
    </div>
  </div>
<% end %>
