<%# locals: project:, release:, test_id: — un rilascio scritto per essere letto (CYRA-394): SHA a
    sette caratteri, copiabile con un gesto, e collegato al commit quando il repository è noto.
    Assente → trattino, senza gesti che non fanno niente. %>
<% if release.blank? %>
  <span class="font-mono text-[12px] text-gray-400 dark:text-zinc-500" data-test="<%= test_id %>">—</span>
<% else %>
  <span class="inline-flex items-center gap-1.5" data-controller="clipboard"
        data-clipboard-copied-value="<%= t("member.monitoring.release_copied") %>">
    <% url = release_commit_url(project, release) %>
    <% if url %>
      <%= link_to release_label(release), url, target: "_blank", rel: "noopener",
            class: "font-mono text-[12px] text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 underline decoration-indigo-200 dark:decoration-indigo-500/60 underline-offset-2",
            title: t("member.monitoring.release_commit_title"), data: { test: test_id } %>
    <% else %>
      <span class="font-mono text-[12px] text-zinc-900 dark:text-zinc-100" data-test="<%= test_id %>"><%= release_label(release) %></span>
    <% end %>
    <%# Il valore COMPLETO sta nel target di copia: si legge corto, si incolla intero. %>
    <span class="hidden" data-clipboard-target="source"><%= release %></span>
    <button type="button" data-action="clipboard#copy" data-test="<%= test_id %>-copy"
            class="inline-flex items-center text-gray-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100"
            title="<%= t("member.monitoring.release_copy") %>" aria-label="<%= t("member.monitoring.release_copy") %>">
      <%= render Ui::IconComponent.new(name: "copy", class: "text-[10px]") %><span class="sr-only" data-clipboard-target="label"></span>
    </button>
  </span>
<% end %>
