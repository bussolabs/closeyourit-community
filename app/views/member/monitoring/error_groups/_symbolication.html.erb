<div class="mt-4 min-w-0" data-controller="stack-view" data-action="turbo:morph@document->stack-view#render turbo:render@document->stack-view#render" data-test="symbolication">
  <%= render Ui::ButtonGroupComponent.new(test_id: "stack-view-choices", role: "group", aria: { label: t("member.symbolication.view") }, class: "border border-stone-200 dark:border-zinc-800 divide-x divide-stone-200 dark:divide-zinc-800 max-w-full") do |group| %>
    <% [ ["derived", t("member.symbolication.#{presentation.java? ? 'reconstructed' : 'source'}")], ["received", t("member.symbolication.received")] ].each do |view, label| %>
      <% group.with_button(label: label, variant: :ghost, size: :sm, test_id: "stack-view-#{view}",
        class: "aria-pressed:bg-indigo-50 dark:aria-pressed:bg-indigo-500/15 aria-pressed:text-indigo-700 dark:aria-pressed:text-indigo-300",
        aria: { pressed: view == "derived", controls: "stack-#{event.id}-#{view}" },
        data: { "stack-view-target": "choice", action: "stack-view#select", "stack-view-view-param": view }) %>
    <% end %>
  <% end %>

  <div id="stack-<%= event.id %>-derived" data-stack-view-target="panel" data-stack-view="derived" data-test="derived-stack">
    <div class="flex flex-wrap items-center gap-2 py-3">
      <p class="text-[12.5px] text-gray-600 dark:text-zinc-400" data-test="symbolication-status"><%= t("member.symbolication.status.#{presentation.status}", default: t("member.symbolication.status.unresolved")) %></p>
      <% if presentation.status == "pending" || presentation.reason == "processing_unavailable" %>
        <%= render Ui::ButtonComponent.new(label: t("member.symbolication.refresh"), href: request.fullpath, variant: :ghost, size: :sm, icon: "refresh-cw", test_id: "symbolication-refresh") %>
      <% end %>
    </div>
    <% if presentation.reason.present? %>
      <%= render Ui::EmptyNoteComponent.new(text: t("member.symbolication.reason.#{presentation.reason}", default: t("member.symbolication.reason.unavailable")), test_id: "symbolication-reason", class: "pb-3") %>
    <% end %>
    <% if presentation.rows.any? %>
      <div class="divide-y divide-stone-200 dark:divide-zinc-800" data-test="derived-frames">
        <% presentation.rows.first(::Monitoring::Constants::STACKTRACE_COLLAPSED).each do |row| %>
          <%= render "member/monitoring/error_groups/symbolication_row", row: row, java: presentation.java? %>
        <% end %>
        <% remaining = presentation.rows.drop(::Monitoring::Constants::STACKTRACE_COLLAPSED) %>
        <% if remaining.any? %>
          <details data-test="derived-frames-more" class="py-3">
            <summary class="cursor-pointer text-[12.5px] text-indigo-700 dark:text-indigo-300 focus-visible:outline-indigo-500"><%= t("member.symbolication.more", count: remaining.size) %></summary>
            <% remaining.each do |row| %>
              <%= render "member/monitoring/error_groups/symbolication_row", row: row, java: presentation.java? %>
            <% end %>
          </details>
        <% end %>
      </div>
    <% elsif presentation.reason.blank? && presentation.status != "pending" %>
      <%= render Ui::EmptyNoteComponent.new(text: t("member.symbolication.no_frames")) %>
    <% end %>
  </div>

  <div id="stack-<%= event.id %>-received" data-stack-view-target="panel" data-stack-view="received" data-test="received-stack">
    <% if presentation.received_java.any? %>
      <div data-test="frames"><pre class="py-3 whitespace-pre-wrap break-all font-mono text-[12px] text-zinc-900 dark:text-zinc-100" data-test="received-java-stack"><%= presentation.received_java.map { |row| row["line"] }.join("\n") %></pre></div>
    <% else %>
      <%= render "member/monitoring/error_groups/received_stack", event: event %>
      <% presentation.exceptions.each do |exception| %>
        <% next if exception.empty? %>
        <details class="py-2" data-test="received-exception">
          <summary class="cursor-pointer text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 focus-visible:outline-indigo-500"><%= exception["type"] %></summary>
          <% presentation.exception_frames(exception).reverse_each do |frame| %>
            <%= render "member/monitoring/error_groups/stacktrace_frame", frame: frame %>
          <% end %>
        </details>
      <% end %>
    <% end %>
  </div>

  <p class="mt-3 border-t border-stone-200 dark:border-zinc-800 pt-3 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.symbolication.immutable") %></p>
  <% if can?("artifacts.manage", scope: @group.project) %>
    <details class="mt-3 text-[12.5px]" data-test="symbolication-upload-help">
      <summary class="cursor-pointer text-indigo-700 dark:text-indigo-300 focus-visible:outline-indigo-500"><%= t("member.symbolication.upload_help") %></summary>
      <p class="mt-2 text-gray-600 dark:text-zinc-400"><%= t("member.symbolication.build_hint") %></p>
      <code class="mt-2 block break-all font-mono text-[12px] text-zinc-900 dark:text-zinc-100"><%= presentation.command %></code>
    </details>
  <% end %>
</div>
