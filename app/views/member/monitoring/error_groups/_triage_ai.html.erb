<%= render Ui::SectionComponent.new(body_class: "px-4 py-4 space-y-3", test_id: "triage-ai",
      data: { controller: "monitoring-triage",
              monitoring_triage_triage_url_value: triage_ai_member_monitoring_error_group_path(@group),
              monitoring_triage_similar_url_value: similar_member_monitoring_error_group_path(@group),
              monitoring_triage_poll_url_value: member_ai_request_path(":id"),
              monitoring_triage_failed_value: t("member.monitoring.triage_ai.failed"),
              monitoring_triage_analyzing_value: t("member.monitoring.triage_ai.analyzing"),
              monitoring_triage_similar_analyzing_value: t("member.monitoring.triage_ai.similar.analyzing"),
              monitoring_triage_similar_empty_value: t("member.monitoring.triage_ai.similar.empty") }) do |section| %>
  <% section.with_title do %>
    <%= render Ui::IconComponent.new(name: "wand-sparkles", class: "text-indigo-500 dark:text-indigo-400 text-[12px] mr-1.5") %><%= t("member.monitoring.triage_ai.title") %>
  <% end %>
    <p class="text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.triage_ai.hint") %></p>
    <div class="flex flex-wrap gap-2">
      <button type="button" data-action="monitoring-triage#suggest" data-monitoring-triage-target="suggestButton" class="inline-flex items-center gap-1.5 h-[34px] px-3.5 rounded-md text-[12.5px] font-semibold text-white bg-indigo-600 hover:bg-indigo-700 disabled:opacity-60" data-test="triage-ai-suggest">
        <%= render Ui::IconComponent.new(name: "wand-sparkles", class: "text-[11px]") %><%= t("member.monitoring.triage_ai.suggest") %>
      </button>
      <button type="button" data-action="monitoring-triage#findSimilar" data-monitoring-triage-target="similarButton" class="inline-flex items-center gap-1.5 h-[34px] px-3 rounded-md text-[12.5px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800 disabled:opacity-60" data-test="triage-ai-similar">
        <%= render Ui::IconComponent.new(name: "workflow", class: "text-[11px]") %><%= t("member.monitoring.triage_ai.similar.button") %>
      </button>
    </div>
    <p class="hidden text-[12px]" data-monitoring-triage-target="status" data-test="triage-ai-status"></p>

    <div class="hidden space-y-2.5 pt-1" data-monitoring-triage-target="result" data-test="triage-ai-result">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="inline-flex items-center gap-1 rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 px-2 py-0.5 text-[11.5px]"><span class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.triage_ai.category") %>:</span><span class="font-semibold text-zinc-900 dark:text-zinc-100" data-monitoring-triage-target="category"></span></span>
        <span class="inline-flex items-center gap-1 rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 px-2 py-0.5 text-[11.5px]"><span class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.triage_ai.severity") %>:</span><span class="font-semibold text-zinc-900 dark:text-zinc-100" data-monitoring-triage-target="severity"></span></span>
        <span class="inline-flex items-center gap-1 rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 px-2 py-0.5 text-[11.5px]"><span class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.triage_ai.confidence") %>:</span><span class="font-semibold text-zinc-900 dark:text-zinc-100" data-monitoring-triage-target="confidence"></span></span>
      </div>
      <div data-test="triage-ai-root-cause"><p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.triage_ai.root_cause") %></p><p class="mt-0.5 text-[12.5px] text-zinc-700 dark:text-zinc-300" data-monitoring-triage-target="rootCause"></p></div>
      <div><p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.triage_ai.summary") %></p><p class="mt-0.5 text-[12.5px] text-zinc-700 dark:text-zinc-300" data-monitoring-triage-target="summary"></p></div>

      <div class="pt-1">
        <p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400 mb-1.5"><%= t("member.monitoring.triage_ai.action") %></p>
        <div class="flex flex-wrap gap-2">
          <% if @group.status_unresolved? %>
            <%= button_to resolve_member_monitoring_error_group_path(@group), method: :patch, class: "hidden inline-flex items-center gap-1.5 h-[32px] px-3 rounded-md text-[12px] font-medium text-emerald-700 dark:text-emerald-300 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-emerald-50 dark:hover:bg-emerald-500/15", data: { monitoring_triage_target: "action", action_kind: "resolve", test: "triage-ai-action-resolve" } do %><%= render Ui::IconComponent.new(name: "check", class: "text-[10px]") %><%= t("member.monitoring.triage_ai.actions.resolve") %><% end %>
            <%= button_to ignore_member_monitoring_error_group_path(@group), method: :patch, class: "hidden inline-flex items-center gap-1.5 h-[32px] px-3 rounded-md text-[12px] font-medium text-gray-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800", data: { monitoring_triage_target: "action", action_kind: "ignore", test: "triage-ai-action-ignore" } do %><%= render Ui::IconComponent.new(name: "volume-x", class: "text-[10px]") %><%= t("member.monitoring.triage_ai.actions.ignore") %><% end %>
          <% end %>
          <% unless @group.promoted? %>
            <%= button_to promote_member_monitoring_error_group_path(@group), method: :post, class: "hidden inline-flex items-center gap-1.5 h-[32px] px-3 rounded-md text-[12px] font-semibold text-white bg-indigo-600 hover:bg-indigo-700", data: { monitoring_triage_target: "action", action_kind: "promote", turbo_confirm: t("member.monitoring.promote_confirm"), test: "triage-ai-action-promote" } do %><%= render Ui::IconComponent.new(name: "ticket", class: "text-[10px]") %><%= t("member.monitoring.triage_ai.actions.promote") %><% end %>
          <% end %>
          <span class="hidden text-[12px] text-gray-500 dark:text-zinc-400" data-monitoring-triage-target="actionNone" data-test="triage-ai-action-none"><%= t("member.monitoring.triage_ai.actions.none") %></span>
        </div>
      </div>
    </div>

    <div class="hidden pt-2 border-t border-stone-100 dark:border-zinc-800" data-monitoring-triage-target="similarResult" data-test="triage-ai-similar-result">
      <p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400 mb-1.5"><%= t("member.monitoring.triage_ai.similar.title") %></p>
      <p class="hidden text-[12px] text-gray-500 dark:text-zinc-400" data-monitoring-triage-target="similarEmpty" data-test="triage-ai-similar-empty"></p>
      <ul class="space-y-1.5" data-monitoring-triage-target="similarList" data-test="triage-ai-similar-list"></ul>
    </div>
<% end %>
