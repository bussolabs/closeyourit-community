<%# Tab of one occurrence: transaction, server, runtime, SDK. %>
<% occurrence_rows = error_occurrence_rows(event) %>
<div class="px-4 py-3" data-test="error-environment">
  <div class="rounded-md border border-stone-200 dark:border-zinc-800 divide-y divide-stone-200 dark:divide-zinc-800">
    <% occurrence_rows.each do |label, value| %>
      <div class="flex px-3 py-1.5"><span class="font-mono text-[11px] text-gray-500 dark:text-zinc-400 w-28 shrink-0"><%= label %></span><span class="font-mono text-[11.5px] text-zinc-900 dark:text-zinc-100 break-all"><%= error_value(value) %></span></div>
    <% end %>
  </div>
  <% if any_scrubbed?(occurrence_rows.values) %><%= render "member/monitoring/error_groups/scrubbed_hint" %><% end %>
</div>
