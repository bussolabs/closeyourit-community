<details class="relative inline-block" id="<%= dom_id(@group) %>_assignee" data-test="error-assignee">
  <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 h-7 px-2.5 rounded-md text-[12.5px] bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:bg-stone-50 dark:hover:bg-zinc-800">
    <%= render Ui::IconComponent.new(name: "user", class: "text-[11px] text-gray-400 dark:text-zinc-500") %>
    <% if @group.assignee %><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 text-[9px] font-semibold"><%= avatar_initials(@group.assignee.name) %></span><span class="font-medium text-zinc-900 dark:text-zinc-100"><%= @group.assignee.name %></span><% else %><span class="text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.unassigned") %></span><% end %>
    <%= render Ui::IconComponent.new(name: "chevron-down", class: "text-[9px] text-gray-400 dark:text-zinc-500") %>
  </summary>
  <div class="absolute right-0 z-10 mt-1 w-56 max-h-72 overflow-auto rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1 shadow-sm">
    <% @assignees.each do |a| %>
      <%= button_to assign_member_monitoring_error_group_path(@group, assignee_id: a.id), method: :patch, class: "w-full text-left flex items-center gap-2 px-3 h-8 text-[12.5px] hover:bg-stone-50 dark:hover:bg-zinc-800", data: { test: "error-assignee-#{a.id}" } do %>
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 text-[9px] font-semibold"><%= avatar_initials(a.name) %></span><%= a.name %>
      <% end %>
    <% end %>
    <%= button_to assign_member_monitoring_error_group_path(@group, assignee_id: ""), method: :patch, class: "w-full text-left flex items-center gap-2 px-3 h-8 text-[12.5px] text-gray-500 dark:text-zinc-400 hover:bg-stone-50 dark:hover:bg-zinc-800 border-t border-stone-100 dark:border-zinc-800 mt-1", data: { test: "error-unassign" } do %>
      <%= render Ui::IconComponent.new(name: "circle-x", class: "text-[11px]") %><%= t("member.monitoring.unassign") %>
    <% end %>
  </div>
</details>
