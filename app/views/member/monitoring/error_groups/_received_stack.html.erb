<% frames = Member::Monitoring::SymbolicationPresenter.frames(event.stacktrace).reverse %>
<% if frames.any? %>
  <% if frames_scrubbed?(frames) %><%= render "member/monitoring/error_groups/scrubbed_hint" %><% end %>
  <% hidden = frames.drop(Monitoring::Constants::STACKTRACE_COLLAPSED) %>
  <div class="mt-3 rounded-md border border-stone-200 dark:border-zinc-800 overflow-hidden divide-y divide-stone-200 dark:divide-zinc-800" data-test="frames">
    <% frames.first(Monitoring::Constants::STACKTRACE_COLLAPSED).each do |frame| %>
      <%= render "member/monitoring/error_groups/stacktrace_frame", frame: frame %>
    <% end %>
    <% if hidden.any? %>
      <details class="group" data-test="frames-more">
        <summary class="flex items-center gap-2 px-3 py-2 bg-white dark:bg-zinc-900 cursor-pointer list-none [&::-webkit-details-marker]:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-400">
          <span class="font-mono text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.frames_hidden", count: hidden.size) %></span>
          <%= render Ui::IconComponent.new(name: "chevron-down", class: "ml-auto text-[11px] text-gray-400 dark:text-zinc-500 transition-transform group-open:rotate-180") %>
        </summary>
        <div class="divide-y divide-stone-200 dark:divide-zinc-800 border-t border-stone-200 dark:border-zinc-800">
          <% hidden.each do |frame| %>
            <%= render "member/monitoring/error_groups/stacktrace_frame", frame: frame %>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
<% end %>
