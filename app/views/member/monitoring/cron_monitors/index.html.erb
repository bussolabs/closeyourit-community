<% content_for :title, t("member.crons.title") %>

<div class="p-7 space-y-6" data-test="member-cron-monitors">
  <%# Live: check-in (Crons::RecordCheckIn) e missed (EvaluateJob) fanno replace della riga monitor
      e mandano un page-refresh per le pill — che NON viaggiano più renderizzate, erano conteggi
      org-wide leggibili anche da chi vede solo alcuni progetti (CYRA-257): col morph è questa GET
      a ri-calcolarle sullo scope di chi guarda. Stream org-prefissato (Realtime::Streams.crons).
      Monitor nuovi (nati al primo check-in) compaiono al reload, come negli altri index Monitor. %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
  <%= turbo_stream_from Realtime::Streams.crons(current_organization) %>
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.crons.title"),
        subtitle: t("member.crons.help_title"),
        breadcrumb: [ { label: t("member.crons.title") } ],
        counts_test_id: "crons-stats") do |h| %>
    <% h.with_counts do %>
      <%= render "member/monitoring/cron_monitors/stats",
            total: @pagination.total, ok_count: @ok_count, missed_count: @missed_count,
            failing_count: @failing_count %>
    <% end %>
    <%# CYRA-485 — il comando per aggiungerne uno, visibile anche a lista piena: non essendoci una
        creazione da qui, senza questo pulsante la funzione restava invisibile a chi non aveva già
        configurato i job da fuori. %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.crons.setup_cta"), href: setup_member_monitoring_cron_monitors_path, variant: :primary, size: :sm, icon: "plus", test_id: "crons-setup-cta") %>
    <% end %>
  <% end %>

  <%= render "member/monitoring/shared/coverage_banner", area: "crons",
        report: @alert_coverage, i18n_scope: "member.crons.coverage", test_id: "crons-coverage",
        new_rule_href: (can?("alerts.manage") ? new_member_alerting_rule_path(event_type: :cron_missed) : nil) %>

  <% filtering = params[:q].present? || params[:status].present? || params[:project_id].present? %>
  <% if @monitors.empty? && !filtering %>
    <%= render Ui::EmptyStateComponent.new(title: t("member.crons.empty"), body: t("member.crons.empty_body"),
          icon: "history", framed: true, test_id: "crons-empty") do |empty| %>
      <% empty.with_action do %>
        <%= render Ui::ButtonComponent.new(label: t("member.crons.setup_cta"), href: setup_member_monitoring_cron_monitors_path, variant: :primary, size: :sm, icon: "plus", test_id: "crons-empty-setup") %>
      <% end %>
    <% end %>
  <% else %>
    <div data-test="cron-monitors-table">
      <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
        <%= render(Ui::TableToolbarComponent.new(framed: true,
              url: member_monitoring_cron_monitors_path, query: params[:q],
              search_placeholder: t("member.crons.search_placeholder"),
              search_test_id: "crons-search", apply_test_id: "crons-filter", test_id: "crons-toolbar")) do |toolbar| %>
          <% toolbar.with_filter(key: "status", label: t("member.crons.filter_status")) do %>
            <div class="w-36"><%= render Ui::SelectComponent.new(name: "status", multiple: true, summary: true,
              options: Crons::Monitor.statuses.keys.map { |k| [ t("member.crons.status.#{k}"), k ] },
              selected: params[:status], placeholder: t("member.crons.filter_status"), test_id: "filter-status") %></div>
          <% end %>
          <% toolbar.with_filter(key: "project_id", label: t("member.crons.filter_project")) do %>
            <div class="w-40"><%= render Ui::SelectComponent.new(name: "project_id", multiple: true, summary: true,
              options: @projects.map { |p| [ p.name, p.id, p.color ] }, selected: params[:project_id],
              placeholder: t("member.crons.filter_project"), test_id: "filter-project") %></div>
          <% end %>
          <% toolbar.with_views do %>
            <%= render Ui::SavedViewsComponent.new(resource_type: "cron_monitors", views: @saved_views,
                  index_helper: :member_monitoring_cron_monitors_path, current_filters: params) %>
          <% end %>
        <% end %>

        <% if @monitors.empty? %>
          <p class="px-4 py-10 text-center text-[12.5px] text-gray-500 dark:text-zinc-400" data-test="crons-no-match"><%= t("member.crons.no_match") %></p>
        <% else %>
        <%= render(Ui::TableComponent.new(stacked: true, label: t("member.crons.title"))) do |t| %>
          <% t.with_head do %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.crons.col_name"), sort: "name") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.crons.col_project"), sort: "project", classes: "w-28") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.crons.col_interval"), sort: "interval", align: :right, classes: "w-28") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.crons.col_status"), sort: "status", classes: "w-28") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.crons.col_last_check_in"), sort: "last_check_in", initial: :desc, align: :right, classes: "w-32") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("ui.table.open_column"), label_hidden: true) %>
          <% end %>
          <%= render partial: "member/monitoring/cron_monitors/monitor_row", collection: @monitors, as: :monitor %>
        <% end %>
        <%= render(Ui::PaginationComponent.new(pagination: @pagination, test_id: "crons-pagination")) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
