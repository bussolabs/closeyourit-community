<%# locals: group, url, method, title, submit_label %>
<% content_for :title, title %>
<% group_breadcrumb = [ { label: t("member.uptime.title"), href: member_monitoring_monitors_path }, { label: t("member.uptime_groups.title"), href: member_monitoring_uptime_groups_path } ]
   group_breadcrumb += group.persisted? ? [ { label: group.name, href: member_monitoring_uptime_group_path(group) }, { label: t("member.breadcrumb.edit") } ] : [ { label: t("member.breadcrumb.new") } ] %>

<div class="p-7">
  <%= form_with url: url, method: method, multipart: true, class: "space-y-6", data: { test: "uptime-group-form" } do %>
    <%= render Ui::PageHeaderComponent.new(title: title, breadcrumb: group_breadcrumb) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.uptime_groups.form.cancel"), href: member_monitoring_uptime_groups_path, variant: :secondary_muted, size: :sm) %>
        <%= render Ui::ButtonComponent.new(label: submit_label, type: "submit", icon: "check", size: :sm, test_id: "uptime-group-submit") %>
      <% end %>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
          <%= render Ui::InputComponent.new(name: "name", label: t("member.uptime_groups.form.name"), required: true, value: group.name, placeholder: t("member.uptime_groups.form.name_placeholder"), test_id: "uptime-group-name", error: @errors&.dig(:name)&.first) %>

          <%= render "member/shared/color_field", record: group, prefix: "uptime-group", scope: "member.uptime_groups.form" %>

          <%= render "member/shared/icon_field", record: group, prefix: "uptime-group", scope: "member.uptime_groups.form" %>

          <div class="md:col-span-2" data-test="uptime-group-description-field">
            <label for="uptime-group-description" class="block text-[11.5px] font-medium text-zinc-900 dark:text-zinc-100 mb-1.5"><%= t("member.uptime_groups.form.description") %></label>
            <textarea id="uptime-group-description" name="description" rows="3" placeholder="<%= t('member.uptime_groups.form.description_placeholder') %>"
                      class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400" data-test="uptime-group-description"><%= group.description %></textarea>
            <p class="mt-1 text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.uptime_groups.form.description_hint") %></p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
