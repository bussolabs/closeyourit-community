<%# CYRA-78 — il confine sugli ambienti dei segreti: la riga generale valida su tutta
    l'organizzazione e, sotto, l'eccezione per singolo progetto che la vince. Usa gli ivar del
    controller: @grantable_environments, @secret_environment_codes, @secret_environment_projects,
    @project_secret_environments (CYRA-802). %>
<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden" data-test="member-secret-environments">
  <div class="px-5 py-3 border-b border-stone-200 dark:border-zinc-800">
    <p class="text-[12px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.members.access.secret_environments_title") %></p>
    <p class="text-[11px] text-gray-500 dark:text-zinc-400 mt-0.5"><%= t("member.members.access.secret_environments_hint") %></p>
  </div>
  <% environment_options = @grantable_environments.map { |env| [ env.label.presence || env.code, env.code, env.color ] } %>
  <div class="px-5 py-4">
    <input type="hidden" name="secret_environment_codes[]" value="">
    <%= render Ui::SelectComponent.new(name: "secret_environment_codes", multiple: true,
          label: t("member.members.access.secret_environments_org_wide"),
          options: environment_options, selected: @secret_environment_codes,
          hint: t("member.members.access.secret_environments_org_wide_hint"),
          placeholder: t("member.members.access.secret_environments_all"),
          test_id: "member-secret-environments-org") %>
  </div>
  <div class="px-5 py-4 border-t border-stone-200 dark:border-zinc-800">
    <p class="text-[11.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.members.access.secret_environments_per_project") %></p>
    <p class="text-[11px] text-gray-500 dark:text-zinc-400 mt-0.5"><%= t("member.members.access.secret_environments_per_project_hint") %></p>
    <% if @secret_environment_projects.any? %>
      <div class="mt-3 space-y-3">
        <% @secret_environment_projects.each do |project| %>
          <div data-test="member-secret-environments-project-<%= project.id %>">
            <input type="hidden" name="project_secret_environments[<%= project.id %>][]" value="">
            <%= render Ui::SelectComponent.new(name: "project_secret_environments[#{project.id}]", multiple: true,
                  label: project.name, options: environment_options,
                  selected: @project_secret_environments[project.id] || [],
                  placeholder: t("member.members.access.secret_environments_inherit"),
                  test_id: "member-secret-environments-project") %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-[11.5px] text-gray-500 dark:text-zinc-400" data-test="member-secret-environments-empty"><%= t("member.members.access.secret_environments_no_projects") %></p>
    <% end %>
  </div>
</div>
