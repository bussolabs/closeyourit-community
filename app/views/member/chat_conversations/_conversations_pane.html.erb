<%# Pane sinistro del layout chat (locals: active_id — nil sull'index). Su mobile: visibile
    sull'index (unica colonna), nascosto sulla show (il thread prende tutto, back link nel thread).
    CYRA-447 — qui la lista è solo lista: il caso «nessuna conversazione» lo tiene l'index, che al suo
    posto rende un unico stato vuoto a tutta larghezza. Sulla show l'elenco non è mai vuoto (contiene
    almeno la conversazione aperta: stesso scope visible_to). The Unread chip can still empty it. %>
<% kind_icons = { "direct" => "user", "project" => "folder", "team" => "users" } %>
<aside data-test="chat-conversations-pane" data-controller="chat-pane-search"
       class="<%= active_id ? "hidden md:flex" : "flex" %> w-full md:w-72 shrink-0 md:border-r border-stone-200 dark:border-zinc-800 flex-col">
  <%# The page has no header: the panel carries the title, the counts and the New action. %>
  <div class="px-3.5 pt-3 pb-2 border-b border-stone-100 dark:border-zinc-800" data-test="chat-pane-header">
    <div class="flex items-center justify-between gap-2">
      <h1 class="font-display text-[15px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.chat.title") %></h1>
      <%= render Ui::ButtonComponent.new(label: t("member.chat.new_conversation.short"), type: "button", variant: :primary, size: :sm, icon: "plus",
            test_id: "chat-new-button", title: t("member.chat.new_conversation.button"), data: { action: "ui--dialog#open" }) %>
    </div>
    <div class="mt-1 flex flex-wrap items-center gap-x-1.5" data-test="chat-counts">
      <%= render Ui::StatLabelComponent.new(label: t("stats.conversations", count: @conversations_total), value: @conversations_total, test_id: "chat-count-conversations") %>
      <%= render Ui::StatLabelComponent.new(label: t("stats.unread"), value: @unread_total, value_color: :amber, test_id: "chat-count-unread",
            href: (@unread_only ? member_chat_conversations_path : member_chat_conversations_path(unread: 1)), active: @unread_only) %>
    </div>
  </div>
  <%# Filters the rows already on the page; data-keyboard-search lets the "/" key reach it. %>
  <div class="relative px-3 py-2.5 border-b border-stone-100 dark:border-zinc-800">
    <%= render Ui::IconComponent.new(name: "search", class: "text-gray-400 dark:text-zinc-500 text-[12px] absolute left-6 top-1/2 -translate-y-1/2") %>
    <input type="search" autocomplete="off" placeholder="<%= t("member.chat.search_placeholder") %>"
           aria-label="<%= t("member.chat.search_placeholder") %>"
           data-test="chat-pane-search" data-keyboard-search
           data-chat-pane-search-target="input" data-action="input->chat-pane-search#filter"
           class="w-full h-[32px] pl-8 pr-2 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-[13px] placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400">
  </div>
  <div class="flex-1 overflow-y-auto divide-y divide-stone-100 dark:divide-zinc-800">
    <% @conversations.each do |conversation| %>
      <% unread = @unread_by_conversation[conversation.id] %>
      <% kind_label = t("member.chat.kinds.#{conversation.kind}") %>
      <% title = conversation.title_for(Current.account).presence || kind_label %>
      <% last_message = @last_messages[conversation.id] %>
      <% preview = last_message && [ last_message.author&.name, last_message.body.to_s.squish ].compact.join(": ") %>
      <div data-test="chat-conversation-row" data-chat-pane-search-target="row"
           data-search="<%= [ title, kind_label, preview ].compact.join(" ").downcase %>">
        <%= link_to member_chat_conversation_path(conversation),
                    "aria-current": (conversation.id == active_id ? "page" : nil),
                    data: { test: "chat-conversation-link-#{conversation.id}" },
                    class: "flex items-start gap-2.5 px-3.5 py-2.5 hover:bg-stone-50 dark:hover:bg-zinc-800 #{"bg-stone-100 dark:bg-zinc-800" if conversation.id == active_id}" do %>
          <span data-test="chat-kind-icon" title="<%= kind_label %>"
                class="mt-0.5 shrink-0 inline-flex items-center justify-center w-6 h-6 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-500 dark:text-zinc-400">
            <%= render Ui::IconComponent.new(name: kind_icons.fetch(conversation.kind, "messages-square"), class: "text-[10.5px]") %>
            <span class="sr-only"><%= kind_label %></span>
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-2">
              <span class="flex-1 truncate text-[13px] font-medium text-zinc-900 dark:text-zinc-100"><%= title %></span>
              <% if conversation.last_message_at %>
                <span class="shrink-0 text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.chat.last_activity", time: time_ago_in_words(conversation.last_message_at)) %></span>
              <% end %>
              <% if unread %>
                <span data-test="chat-unread-badge-<%= conversation.id %>"
                      class="shrink-0 inline-flex items-center justify-center min-w-[16px] h-4 px-1 rounded-full bg-indigo-600 text-white font-mono text-[9.5px] font-semibold"><%= unread %></span>
              <% end %>
            </span>
            <% if preview %>
              <span data-test="chat-conversation-preview" class="mt-0.5 block truncate text-[12px] text-gray-500 dark:text-zinc-400"><%= preview %></span>
            <% end %>
          </span>
        <% end %>
      </div>
    <% end %>
    <p data-test="chat-pane-search-empty" data-chat-pane-search-target="empty"
       class="<%= "hidden" if @conversations.any? %> px-3.5 py-4 text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.chat.search_empty") %></p>
  </div>
</aside>
