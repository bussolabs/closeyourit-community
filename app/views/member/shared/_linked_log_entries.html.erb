<%# locals: (entries:, framed: true, collapse_empty: false)
    Pannello "Log collegati": log agganciati manualmente (Logs::Link) a QUESTO ticket/errore — distinto
    dalla correlazione automatica per trace_id (che vive nei rispettivi pannelli occurrence_logs).
    Condiviso da show ticket e show gruppo errori (CYRA-163), server-rendered: nessuna query aggiuntiva,
    la collection arriva già caricata dal controller chiamante. %>
<%# `framed: false` (CYRA-883): a part of the ticket Context section, sub-heading and no card. %>
<%# `collapse_empty` (CYRA-986, T9): with nothing linked the panel is one closed row that says so on opening. %>
<% if local_assigns[:collapse_empty] && entries.empty? %>
  <details class="group rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="linked-log-entries">
    <summary class="flex items-center gap-2 px-4 py-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-400">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.logs.linked.title") %></h2>
      <%= render Ui::IconComponent.new(name: "chevron-down", class: "ml-auto text-[11px] text-gray-400 dark:text-zinc-500 transition-transform group-open:rotate-180") %>
    </summary>
    <div class="border-t border-stone-200 dark:border-zinc-800">
      <%= render Ui::EmptyNoteComponent.new(text: t("member.monitoring.logs.linked.empty"), inset: true, test_id: "linked-log-entries-empty") %>
    </div>
  </details>
<% else %>
<div class="<%= "rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" if framed %>" data-test="linked-log-entries">
  <% if framed %>
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.monitoring.logs.linked.title") %></h2></div>
  <% else %>
    <div class="px-4 pt-3 pb-1"><h3 class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.monitoring.logs.linked.title") %></h3></div>
  <% end %>
  <% if entries.empty? %>
    <%= render Ui::EmptyNoteComponent.new(text: t("member.monitoring.logs.linked.empty"), inset: true, test_id: "linked-log-entries-empty") %>
  <% else %>
    <ul class="divide-y divide-stone-100 dark:divide-zinc-800">
      <% entries.each do |entry| %>
        <li>
          <%# Il data-test sta sul LINK, non sulla riga: è il link che naviga, e un click sul <li> non
              porta da nessuna parte (come log-entry-link-* nell'elenco dei log). %>
          <%= link_to member_monitoring_log_entry_path(entry), class: "flex items-center gap-2.5 px-4 py-2 hover:bg-stone-50 dark:hover:bg-zinc-800", data: { test: "linked-log-entry-#{entry.id}" } do %>
            <%= render Ui::BadgeComponent.new(label: entry.level, color: log_level_color(entry.level), dot: true) %>
            <span class="font-mono text-[12px] text-gray-700 dark:text-zinc-300 truncate"><%= entry.message %></span>
            <span class="ml-auto font-mono text-[10.5px] text-gray-500 dark:text-zinc-400 shrink-0"><%= entry.occurred_at.strftime("%d/%m %H:%M") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
<% end %>
