<%# locals: nessuno — il dialog è UNO per pagina, non uno per riga %>
<%# Rifiuto della richiesta di modifica (CYRA-138, Fase 4 pezzo C2b): <dialog> nativo col motivo
    OBBLIGATORIO — pattern gemello di member/tickets/_review_reject_modal. Il submit POSTa a reject
    (Secrets::ChangeRequests::Reject: motivo blank → R422, la CR resta pending; il secret non cambia
    mai in questo ramo).

    CYRA-571 — stava DENTRO ogni riga: cinquanta richieste erano cinquanta copie dello stesso dialog,
    ognuna col suo modulo e il suo token (tutti diversi fra loro, quindi peso non comprimibile). Ora
    sta in pagina una volta sola e la riga, aprendolo, gli passa l'indirizzo e il nome della
    variabile (ui--shared-dialog). Per questo l'indirizzo NON è scritto qui e il token dev'essere
    quello globale (Ui::RowActionsFormComponent). %>
<%# F24 — the standard shell. Submit sits in the header, outside the shared form: `form:` ties it to it. %>
<%= render Ui::ModalComponent.new(title: t("member.vault_change_requests.reject_title"), size: :sm, padded: false,
      test_id: "vault-change-request-reject-modal",
      data: { "ui--shared-dialog-target": "dialog", dialog_name: "change-request-reject", action: "click->ui--shared-dialog#backdrop" }) do |modal| %>
  <% modal.with_actions do %>
    <%= render Ui::ButtonComponent.new(label: t("member.vault_change_requests.reject_dialog_cancel"), variant: :secondary_muted, size: :sm,
          data: { action: "ui--shared-dialog#close" }) %>
    <%= render Ui::ButtonComponent.new(label: t("member.vault_change_requests.reject_confirm"), type: "submit", variant: :danger, size: :sm,
          icon: "x", form: "vault-change-request-reject-form", test_id: "vault-change-request-reject-submit") %>
  <% end %>
  <%= render Ui::RowActionsFormComponent.new(id: "vault-change-request-reject-form", hidden: false) do %>
    <div class="px-4 py-4 space-y-3">
      <div>
        <p class="font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 mb-1"><%= t("member.vault_change_requests.col_variable") %></p>
        <p class="font-mono text-[13px] text-zinc-900 dark:text-zinc-100" data-dialog-subject data-test="vault-change-request-reject-name"></p>
      </div>
      <div>
        <p class="font-mono text-[9px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 mb-1.5"><%= t("member.vault_change_requests.reason_label") %></p>
        <%= text_area_tag :reason, nil, rows: 4, required: true,
              placeholder: t("member.vault_change_requests.reason_placeholder"),
              data: { test: "vault-change-request-reject-reason" },
              class: "w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400" %>
      </div>
    </div>
  <% end %>
<% end %>
