<%# locals: rows %>
<%# Le assenze dichiarate volute: non sono cose da sistemare — per questo stanno SOTTO la lista e non
    dentro — ma restano consultabili con chi l'ha deciso, quando e perché, e si possono rimettere in
    lista. Sezione ereditata dalla pagina «Cosa non torna» (CYRA-409). %>
<section class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="vault-attention-acknowledged">
  <div class="px-4 py-3 border-b border-stone-100 dark:border-zinc-800">
    <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.vault_health.acknowledged_section.title") %></h2>
    <p class="mt-0.5 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.vault_health.acknowledged_section.body") %></p>
  </div>
  <% rows.each do |row| %>
    <div class="flex items-start justify-between gap-3 px-4 py-2.5 border-t border-stone-100 dark:border-zinc-800" data-test="vault-attention-acknowledged-row">
      <div class="min-w-0 space-y-0.5">
        <div class="flex items-center flex-wrap gap-2">
          <span class="text-[12.5px] font-mono text-zinc-900 dark:text-zinc-100"><%= row.secret_name.presence || "—" %></span>
          <%= link_to row.project.name, member_project_secrets_path(row.project), class: "text-[12px] text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300" %>
          <span class="text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.vault_health.detail.#{row.kind}", environment: row.environment.label) %></span>
        </div>
        <p class="text-[12px] text-gray-600 dark:text-zinc-400">“<%= row.acknowledgement_reason %>”</p>
        <p class="text-[11px] text-gray-400 dark:text-zinc-500">
          <% if row.acknowledged_by %>
            <%= t("member.vault_health.acknowledged_section.attribution", who: row.acknowledged_by.name, time: time_ago_in_words(row.acknowledged_at)) %>
          <% else %>
            <%= t("member.vault_health.acknowledged_section.attribution_unknown", time: time_ago_in_words(row.acknowledged_at)) %>
          <% end %>
        </p>
      </div>
      <%# CYRA-571 — punta il modulo unico della pagina invece di costruirne uno per riga. %>
      <%= render Ui::ButtonComponent.new(label: t("member.vault_health.restore_button"),
            href: member_restore_vault_health_anomaly_path(row.id), method: :delete,
            form_id: "row-actions", size: :sm, variant: :secondary_muted,
            test_id: "vault-attention-restore-#{row.id}") %>
    </div>
  <% end %>
</section>
