<%= link_to local_assigns[:href], class: "flex items-center gap-2.5 px-3 h-9 rounded-md text-[13px] font-medium text-gray-600 dark:text-zinc-400 border border-stone-200 dark:border-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800", data: { test: local_assigns[:test] } do %>
  <%= render Ui::IconComponent.new(name: local_assigns[:icon], class: "w-[1.25em] text-[13px] text-gray-400 dark:text-zinc-500") %>
  <span class="truncate"><%= local_assigns[:label] %></span>
  <%= render Ui::IconComponent.new(name: "chevron-right", class: "ml-auto text-[11px] text-gray-300 dark:text-zinc-600") %>
<% end %>
