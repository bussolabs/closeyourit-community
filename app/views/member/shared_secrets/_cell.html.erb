<%# locals: variable, environment, value (Secrets::Shared::Value | nil), projects, form_id, can_manage %>
<%# Cella della matrice (env × nome). Il valore è mascherato finché non si sblocca la riga (Stimulus
    secret-matrix-row): l'input value[env.id] si aggancia al form-riga via l'attributo HTML `form=`.
    Le deleghe (feature esclusiva shared) restano visibili sotto il valore con i loro form dedicati. %>
<%= render Ui::TableComponent::CellComponent.new(label: environment.label, class: "align-top min-w-64") do %>
  <% if value %>
    <%# CYRA-202: il valore NON è più nel sorgente. Copia (data-clipboard-url-value) e sblocco riga
        (data-secret-reveal-url) lo recuperano on-demand dall'endpoint reveal, che registra l'accesso. %>
    <div class="flex items-start gap-1.5" data-controller="clipboard" data-clipboard-copied-value="<%= t('member.shared_secrets.copied') %>"
         data-clipboard-error-value="<%= t('member.shared_secrets.copy_failed') %>"
         data-clipboard-url-value="<%= reveal_member_shared_secret_path(variable, value_id: value.id) %>">
      <div class="min-w-0 flex-1">
        <span data-secret-matrix-row-target="masked" class="block font-mono text-[12px] text-gray-400 dark:text-zinc-500 select-none"><%= t("member.shared_secrets.masked") %></span>
        <textarea name="values[<%= environment.id %>]" form="<%= form_id %>" data-secret-matrix-row-target="input"
                  rows="1" hidden readonly data-test="shared-secret-input-<%= value.id %>"
                  data-secret-reveal-url="<%= reveal_member_shared_secret_path(variable, value_id: value.id) %>"
                  class="w-full resize-none rounded border border-stone-200 dark:border-zinc-800 px-2 py-1 font-mono text-xs focus:border-indigo-600 dark:focus:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-600"></textarea>
      </div>
      <button type="button" data-action="clipboard#copy" data-test="shared-secret-copy-<%= value.id %>" aria-label="<%= t('member.shared_secrets.copy') %>"
              class="mt-0.5 text-gray-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100"><%= render Ui::IconComponent.new(name: "copy", class: "text-[11px]") %><span data-clipboard-target="label" class="sr-only"></span></button>
    </div>

    <div class="mt-2 space-y-1 border-t border-stone-100 dark:border-zinc-800 pt-2" data-test="shared-secret-delegations-<%= value.id %>">
      <% value.delegations.each do |delegation| %>
        <div class="flex items-center justify-between text-[11px]"><span><%= delegation.project.name %></span>
          <% unlink_impact = ::Secrets::Shared::Impact.call(shared_value: value, effect: :unlink).value %>
          <%# CYRA-416: revoca reversibile → colore neutro; conferma che nomina progetto, segreto ed effetto immediato (mai il valore). %>
          <%= render Ui::ConfirmDialogComponent.new(title: t("member.shared_secrets.unlink_dialog.title", project: delegation.project.name, secret: variable.name),
                url: member_shared_secret_delegation_path(variable, delegation), params: { confirmation_digest: unlink_impact["digest"] },
                confirm_label: t("member.shared_secrets.unlink"), test_id: "shared-secret-unlink-dialog-#{delegation.id}") do |dialog| %>
            <% dialog.with_body { t("member.shared_secrets.unlink_effect") } %>
            <%= dialog.button_trigger(label: t("member.shared_secrets.unlink"), variant: :ghost, test_id: "shared-secret-unlink-#{delegation.id}") %>
          <% end %>
        </div>
      <% end %>
      <% if can_manage %>
        <%= form_with url: member_shared_secret_delegations_path(variable), class: "flex gap-1" do |f| %>
          <%= hidden_field_tag :value_id, value.id %>
          <%= select_tag :project_id, options_from_collection_for_select(projects, :id, :name), include_blank: t("member.shared_secrets.choose_project"), class: "h-7 min-w-0 flex-1 rounded border border-stone-200 dark:border-zinc-800 text-[11px]" %>
          <%# CYRA-777 — l'alias: vuoto = il progetto legge il valore col nome che ha qui. Serve quando
              il progetto chiama quella cosa in un altro modo e non si vuole toccare il suo codice. %>
          <%= text_field_tag :local_name, nil, placeholder: variable.name, class: "h-7 w-24 min-w-0 rounded border border-stone-200 dark:border-zinc-800 px-1 font-mono text-[11px]", data: { test: "shared-secret-local-name-#{value.id}" } %>
          <%= f.submit t("member.shared_secrets.delegate"), class: "text-[11px] font-semibold text-indigo-600 dark:text-indigo-400" %>
        <% end %>
      <% end %>
    </div>
  <% elsif can_manage %>
    <span data-secret-matrix-row-target="masked" class="block text-gray-300 dark:text-zinc-600 select-none"><%= t("member.shared_secrets.cell_empty") %></span>
    <textarea name="values[<%= environment.id %>]" form="<%= form_id %>" data-secret-matrix-row-target="input"
              rows="1" hidden placeholder="<%= t('member.shared_secrets.value') %>" data-test="shared-secret-input-empty-<%= environment.code %>"
              class="w-full resize-none rounded border border-stone-200 dark:border-zinc-800 px-2 py-1 font-mono text-xs focus:border-indigo-600 dark:focus:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-600"></textarea>
  <% else %>
    <span class="block text-gray-300 dark:text-zinc-600 select-none"><%= t("member.shared_secrets.cell_empty") %></span>
  <% end %>
<% end %>
