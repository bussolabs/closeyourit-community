<%# locals: environments, errors (Hash | nil) %>
<%# Riga di creazione: nome + una cella valore per OGNI ambiente dell'org (tutte opzionali; le celle
    blank sono saltate dal service). Nessun select di ambiente. Sempre "sbloccata". %>
<% form_id = "shared-secret-new-row" %>
<%= render Ui::TableComponent::RowComponent.new(hidden: errors.blank?, class: "bg-indigo-50/40 dark:bg-indigo-500/10", test_id: "shared-secret-new-row",
      data: { secret_new_row_target: "row", controller: "secret-row-validation",
              action: "submit->secret-row-validation#validate input->secret-row-validation#clear",
              secret_row_validation_message_value: t("member.review_fixes.secret_value_required") }) do %>
  <%= render Ui::TableComponent::CellComponent.new(header: true, class: "align-top") do %>
    <%= form_with url: member_shared_secrets_path, method: :post, id: form_id do %><% end %>
    <input type="text" name="name" form="<%= form_id %>" value="<%= params[:name] %>" placeholder="<%= t('member.shared_secrets.new_name') %>"
           required pattern="[A-Za-z_][A-Za-z0-9_]*" title="<%= t("member.review_fixes.secret_name_hint") %>" data-test="shared-secret-new-name" data-secret-new-row-target="field" autocomplete="off"
           class="h-8 w-40 rounded border px-2 font-mono text-xs focus:outline-none focus:ring-1 focus:ring-indigo-600 <%= errors.present? ? 'border-rose-300 dark:border-rose-500/50' : 'border-stone-300 dark:border-zinc-700' %>">
    <% if errors.present? %>
      <p class="mt-1 text-[11px] text-rose-600 dark:text-rose-400" data-test="shared-secret-new-error"><%= errors.values.flatten.first %></p>
    <% end %>
  <% end %>

  <% environments.each do |environment| %>
    <%= render Ui::TableComponent::CellComponent.new(label: environment.label, class: "align-top") do %>
      <textarea name="values[<%= environment.id %>]" form="<%= form_id %>" rows="1" autocomplete="off"
                data-test="shared-secret-new-value-<%= environment.code %>" data-secret-new-row-target="field" placeholder="<%= t('member.shared_secrets.value') %>"
                class="w-full min-w-40 resize-none rounded border border-stone-200 dark:border-zinc-800 px-2 py-1 font-mono text-xs focus:border-indigo-600 dark:focus:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-600"><%= params.dig(:values, environment.id.to_s) %></textarea>
    <% end %>
  <% end %>

  <%= render Ui::TableComponent::CellComponent.new(actions: true, class: "align-top") do %>
    <div class="inline-flex items-center gap-2">
      <button type="button" data-action="secret-new-row#cancel" data-test="shared-secret-cancel-row"
              class="inline-flex items-center h-8 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 text-xs font-medium text-gray-500 dark:text-zinc-400 hover:bg-stone-50 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100">
        <%= t("member.shared_secrets.cancel_edit") %>
      </button>
      <button type="submit" form="<%= form_id %>" data-test="shared-secret-add-row"
              class="inline-flex items-center gap-1 h-8 rounded-md bg-indigo-600 px-3 text-xs font-semibold text-white hover:bg-indigo-700">
        <%= render Ui::IconComponent.new(name: "plus", class: "text-[10px]") %><%= t("member.shared_secrets.create") %>
      </button>
    </div>
  <% end %>
<% end %>
