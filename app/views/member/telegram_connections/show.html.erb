<% content_for :title, t("member.preferences.title") %>
<% telegram_connected = Current.account.connected_telegram? %>
<% telegram_bot = Settings::Integrations.value(:telegram_bot_username).to_s %>
<%# Deep-link col CODICE corto monouso (@telegram_start_code dal controller): il parametro `start` di
    Telegram accetta max 64 char [A-Za-z0-9_-], dove il vecchio token firmato (238 char) non entrava. %>
<% telegram_link = (telegram_bot.present? && @telegram_start_code.present?) ? "https://t.me/#{telegram_bot}?start=#{@telegram_start_code}" : nil %>
<%# CYRA-444 — i comandi del bot sono le stesse parole nelle due lingue (li digita l'utente in chat):
    letterali qui, tradotta solo la spiegazione. %>
<% telegram_commands = [
     [ "/nuovo-ticket", t("member.notifications.telegram.commands.new_ticket") ],
     [ "/miei-ticket", t("member.notifications.telegram.commands.my_tickets") ],
     [ "/commenta", t("member.notifications.telegram.commands.comment") ],
     [ "/aiuto", t("member.notifications.telegram.commands.help") ]
   ] %>

<div class="p-7 space-y-6">
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.preferences.title"),
        breadcrumb: [ { label: t("member.preferences.title") } ]) do |h| %>
    <%= render "member/preferences/tabs", header: h, active_tab: "telegram" %>
  <% end %>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-5 py-4 border-b border-stone-200 dark:border-zinc-800">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.notifications.channels.telegram") %></h2>
      <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.telegram.guide_title") %></p>
    </div>
    <div class="px-5 py-4" data-test="pref-telegram-connection">
      <% if telegram_connected %>
        <p class="text-[12.5px] text-zinc-900 dark:text-zinc-100">
          <%= render Ui::IconComponent.new(name: "circle-check", class: "text-emerald-600 dark:text-emerald-400 mr-1.5") %>
          <%= Current.account.telegram_username.present? ? t("member.notifications.telegram.connected", username: Current.account.telegram_username) : t("member.notifications.telegram.connected_generic") %>
        </p>
        <% if Current.account.telegram_linked_at.present? %>
          <p class="mt-1 text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.telegram.connected_since", date: l(Current.account.telegram_linked_at.to_date, format: :long)) %></p>
        <% end %>
      <% elsif telegram_link %>
        <ol class="space-y-1.5 text-[12px] text-gray-600 dark:text-zinc-400 list-decimal list-inside" data-test="telegram-connect-steps">
          <li><%= t("member.notifications.telegram.guide_step_1") %></li>
          <li><%= t("member.notifications.telegram.guide_step_2") %></li>
          <li><%= t("member.notifications.telegram.guide_step_3") %></li>
        </ol>
        <p class="mt-2.5 text-[11.5px] text-gray-500 dark:text-zinc-400" data-test="telegram-bot-handle">
          <%= t("member.notifications.telegram.bot_label") %>
          <span class="font-mono text-zinc-900 dark:text-zinc-100">@<%= telegram_bot %></span> —
          <%= t("member.notifications.telegram.bot_note") %>
        </p>
        <a href="<%= telegram_link %>" target="_blank" rel="noopener" data-test="pref-telegram-connect"
           class="mt-3 inline-flex items-center gap-2 h-[32px] px-3.5 rounded-md text-[12px] font-semibold text-white bg-sky-500 hover:bg-sky-600">
          <%= render Ui::IconComponent.new(name: "send", class: "text-[14px]") %><%= t("member.notifications.telegram.connect") %>
        </a>
      <% else %>
        <p class="text-[11.5px] text-amber-700 dark:text-amber-300"><%= render Ui::IconComponent.new(name: "triangle-alert", class: "mr-1") %><%= t("member.notifications.telegram.not_configured") %></p>
      <% end %>
    </div>
  </div>

  <% if @telegram_group_code %>
    <%= render "member/telegram_connections/group", group: @telegram_group, code: @telegram_group_code, bot: telegram_bot %>
  <% end %>

  <%= render Ui::GridComponent.new(cols: 1, lg: 2, gap: 6, class: "items-start", test_id: "secondary-panels") do %>
    <%# CYRA-444 — la pagina era il nome dell'account collegato e un pulsante per scollegarsi: non
        diceva cosa arriva su questo canale, dove si sceglie, né come ci si collega la prima volta.
        The connection comes first; what arrives and the bot commands are secondary and sit side by side
        (DESIGN.md T13). «Scollega» stays at the bottom as a secondary action. Fra le guide non ce n'è una su Telegram: insegna questa pagina. %>
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="telegram-what">
      <div class="px-5 py-4 border-b border-stone-200 dark:border-zinc-800">
        <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.notifications.telegram.what_heading") %></h2>
        <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.channels.telegram_hint") %></p>
      </div>
      <div class="px-5 py-4">
        <p class="text-[12.5px] text-zinc-900 dark:text-zinc-100"><%= t("member.notifications.telegram.what_body_1") %></p>
        <p class="mt-1.5 text-[12.5px] text-gray-600 dark:text-zinc-400"><%= t("member.notifications.telegram.what_body_2") %></p>
        <%= link_to member_notification_preferences_path(highlight: "telegram"),
              class: "mt-3 inline-flex items-center gap-1.5 h-[30px] px-3 rounded-md text-[12px] font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200 dark:border-indigo-500/40 hover:bg-indigo-100 dark:hover:bg-indigo-500/25",
              data: { test: "telegram-choose-alerts" } do %>
          <%= render Ui::IconComponent.new(name: "sliders", class: "text-[11px]") %><%= t("member.notifications.telegram.choose_alerts") %><%= render Ui::IconComponent.new(name: "arrow-right", class: "text-[10px]") %>
        <% end %>
      </div>
    </div>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="telegram-commands">
      <div class="px-5 py-4 border-b border-stone-200 dark:border-zinc-800">
        <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.notifications.telegram.commands_heading") %></h2>
        <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.telegram.commands_hint") %></p>
      </div>
      <div class="divide-y divide-stone-100 dark:divide-zinc-800">
        <% telegram_commands.each do |command, description| %>
          <div class="flex items-baseline gap-3 px-5 py-2.5">
            <code class="font-mono text-[12px] text-zinc-900 dark:text-zinc-100 shrink-0 w-32"><%= command %></code>
            <span class="text-[12px] text-gray-600 dark:text-zinc-400"><%= description %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# «Scollega» in fondo, testuale: è l'uscita dal canale, non il contenuto della pagina. %>
  <% if telegram_connected %>
    <div class="flex items-center justify-between gap-3 pt-1">
      <p class="text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.telegram.disconnect_hint") %></p>
      <%= link_to t("member.notifications.telegram.disconnect"), member_telegram_connection_path,
            data: { turbo_method: :delete, turbo_confirm: t("member.notifications.telegram.disconnect_confirm"), test: "pref-telegram-disconnect" },
            class: "text-[12px] font-medium text-gray-500 dark:text-zinc-400 hover:text-rose-600 dark:hover:text-rose-400 hover:underline shrink-0" %>
    </div>
  <% end %>
</div>
