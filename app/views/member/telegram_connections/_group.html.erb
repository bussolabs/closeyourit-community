<%# locals: (group:, code:, bot:) %>
<%# CYRA-852 — solo per l'owner: il gruppo con argomenti dove riceve i suoi avvisi. `startgroup` fa
    scegliere il gruppo e chiede per il bot il permesso di gestire gli argomenti. %>
<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="telegram-group">
  <div class="px-5 py-4 border-b border-stone-200 dark:border-zinc-800">
    <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.notifications.telegram.group.heading") %></h2>
    <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.telegram.group.hint") %></p>
  </div>
  <div class="px-5 py-4">
    <p class="text-[12.5px] text-gray-600 dark:text-zinc-400"><%= t("member.notifications.telegram.group.body") %></p>
    <% if group %>
      <div class="mt-3 flex items-center justify-between gap-3">
        <p class="text-[12.5px] text-zinc-900 dark:text-zinc-100" data-test="telegram-group-connected">
          <%= render Ui::IconComponent.new(name: "circle-check", class: "text-emerald-600 dark:text-emerald-400 mr-1.5") %>
          <%= group.title.present? ? t("member.notifications.telegram.group.connected", title: group.title) : t("member.notifications.telegram.group.connected_generic") %>
        </p>
        <%= link_to t("member.notifications.telegram.group.disconnect"), member_telegram_group_path,
              data: { turbo_method: :delete, turbo_confirm: t("member.notifications.telegram.group.disconnect_confirm"), test: "telegram-group-disconnect" },
              class: "text-[12px] font-medium text-gray-500 dark:text-zinc-400 hover:text-rose-600 dark:hover:text-rose-400 hover:underline shrink-0" %>
      </div>
    <% else %>
      <ol class="mt-3 space-y-1.5 text-[12px] text-gray-600 dark:text-zinc-400 list-decimal list-inside">
        <li><%= t("member.notifications.telegram.group.step_1") %></li>
        <li><%= t("member.notifications.telegram.group.step_2") %></li>
        <li><%= t("member.notifications.telegram.group.step_3") %></li>
      </ol>
      <a href="<%= "https://t.me/#{bot}?startgroup=#{code}&admin=manage_topics" %>" target="_blank" rel="noopener" data-test="telegram-group-connect"
         class="mt-3 inline-flex items-center gap-2 h-[32px] px-3.5 rounded-md text-[12px] font-semibold text-white bg-sky-500 hover:bg-sky-600">
        <%= render Ui::IconComponent.new(name: "send", class: "text-[14px]") %><%= t("member.notifications.telegram.group.connect") %>
      </a>
    <% end %>
  </div>
</div>
