<%# locals: (host:, can_manage:) %>
<%# CYRA-1175 — how many tickets the machine works at once. %>
<% choices = Agents::Host::PARALLEL_CHOICES.to_a %>
<div class="px-4 py-4 space-y-3 border-t border-stone-100 dark:border-zinc-800" data-test="host-parallel">
  <h3 class="text-[12.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.agents.parallel.title") %></h3>
  <p class="text-[12.5px] text-gray-500 dark:text-zinc-400 max-w-[70ch]"><%= t("member.agents.parallel.hint") %></p>
  <% if can_manage %>
    <%= form_with url: parallel_member_agent_path(host), method: :patch, class: "flex flex-wrap items-end gap-3" do %>
      <%= render Ui::SelectComponent.new(name: "max_parallel", label: t("member.agents.parallel.label"), test_id: "host-parallel-select",
            options: choices.map { |count| [ count.to_s, count ] },
            selected: host.max_parallel || 1, wrapper_class: "min-w-0 w-40") %>
      <%= render Ui::ButtonComponent.new(label: t("member.agents.parallel.save"), type: "submit", size: :sm, test_id: "host-parallel-save") %>
    <% end %>
  <% else %>
    <p class="text-[13px] font-mono text-zinc-900 dark:text-zinc-100"><%= host.max_parallel || 1 %></p>
  <% end %>
</div>
