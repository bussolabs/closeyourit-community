<%# locals: (host:, secret_options:) %>
<%# CYRA-1052 — this machine's own Claude credential, pasted or linked from a vault secret. Served before the
    organization's; without it the machine uses the organization's, then its own login. Owner only. %>
<% scope = "member.agents.claude" %>
<% credential = host.claude_credential %>
<% source = credential ? "own" : (host.organization.claude_credential ? "organization" : "local") %>
<%= render Ui::SectionComponent.new(title: t("#{scope}.title"), header_padding: :wide, body_class: "px-5 py-5 space-y-4",
                                     test_id: "host-claude-credential") do %>
  <p class="text-[12.5px] text-gray-600 dark:text-zinc-400" data-test="host-claude-source"><%= t("#{scope}.source.#{source}") %></p>
  <% if credential %>
    <p class="text-[11.5px] text-gray-500 dark:text-zinc-400" data-test="host-claude-set-by">
      <%= t("member.claude_credential.set_by", who: credential.set_by&.name || t("member.claude_credential.someone"),
                                               when: l(credential.updated_at, format: :short)) %>
      <% if credential.linked? %>
        <%= t("member.claude_credential.linked_to", name: credential.personal_variable&.name || credential.shared_value&.name) %>
      <% end %>
    </p>
  <% end %>
  <%= form_with url: member_agent_claude_credential_path(host), method: :patch, class: "space-y-4",
        data: { test: "host-claude-form", turbo_confirm: t("#{scope}.save_confirm") } do %>
    <%= hidden_field_tag Authorization::DangerousAction::CONFIRM_PARAM, "1", id: nil %>
    <%= render Ui::InputComponent.new(name: "token", type: "password", value: "", label: t("member.claude_credential.token_label"),
          autocomplete: "off", spellcheck: false,
          placeholder: t("member.claude_credential.token_placeholder_#{credential ? 'set' : 'missing'}"),
          hint: t("member.claude_credential.token_hint"), test_id: "host-claude-token") %>
    <% if secret_options.any? %>
      <%= render Ui::SelectComponent.new(name: "secret", label: t("member.claude_credential.secret_label"), options: secret_options,
            include_blank: true, placeholder: t("member.claude_credential.secret_none"), selected: credential&.secret_ref,
            hint: t("member.claude_credential.secret_hint"), test_id: "host-claude-secret") %>
    <% end %>
    <div class="flex flex-wrap items-center gap-3">
      <%= render Ui::ButtonComponent.new(label: t("#{scope}.#{credential ? 'replace' : 'save'}"), type: "submit", size: :sm,
            variant: :primary, icon: "check", test_id: "host-claude-save") %>
    </div>
  <% end %>
  <% if credential %>
    <%= render Ui::ConfirmDialogComponent.new(title: t("#{scope}.remove_dialog.title"), url: member_agent_claude_credential_path(host),
          confirm_label: t("#{scope}.remove"), test_id: "host-claude-remove-dialog") do |dialog| %>
      <% dialog.with_body { t("#{scope}.remove_dialog.body") } %>
      <%= render Ui::RowMenuComponent.new(test_id: "host-claude-menu", aria_label: t("member.claude_credential.more_menu")) do %>
        <%= dialog.menu_trigger(label: t("#{scope}.remove"), icon: "trash", test_id: "host-claude-remove") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
