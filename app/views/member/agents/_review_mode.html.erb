<%# locals: (host:, can_manage:) %>
<%# CYAU-226 — the engine that reads the work again before delivery, by name. The work engine itself is
    for a machine with one engine; the server accepts only the reviewer chosen here. %>
<% reviewers = Agents::Host::REVIEWERS %>
<div class="px-4 py-4 space-y-3" data-test="host-review-mode">
  <h3 class="text-[12.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.agents.review.title") %></h3>
  <p class="text-[12.5px] text-gray-500 dark:text-zinc-400 max-w-[70ch]"><%= t("member.agents.review.hint") %></p>
  <% if can_manage %>
    <%= form_with url: review_member_agent_path(host), method: :patch, class: "flex flex-wrap items-end gap-3" do %>
      <%= render Ui::SelectComponent.new(name: "reviewer", label: t("member.agents.review.label"), test_id: "host-review-select",
            options: reviewers.map { |engine| [ t("member.agents.engine.engines.#{engine}"), engine ] },
            descriptions: reviewers.index_with { |engine| t("member.agents.review.descriptions.#{Agents::Host::REVIEW_ONLY_ENGINES.include?(engine) ? engine : (engine == host.effective_work_engine ? 'same' : 'other')}") },
            selected: host.effective_reviewer, wrapper_class: "min-w-0 flex-1") %>
      <%= render Ui::ButtonComponent.new(label: t("member.agents.review.save"), type: "submit", size: :sm, test_id: "host-review-save") %>
    <% end %>
  <% else %>
    <p class="text-[13px] text-zinc-900 dark:text-zinc-100"><%= t("member.agents.engine.engines.#{host.effective_reviewer}") %></p>
  <% end %>
</div>
