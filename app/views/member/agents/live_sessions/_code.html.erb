<%# locals: entry:, code_available:, code_view: — the file on show, its changes in review style: removed lines
    struck through, new lines below them, whole. No typing effect: the agent changes a block at once; a fresh one's lines only enter in turn. %>
<div class="flex min-w-0 flex-col md:min-h-0 md:overflow-y-auto md:overflow-x-hidden bg-white dark:bg-zinc-900 md:rounded-lg md:border md:border-stone-200 dark:md:border-zinc-800" data-test="automator-live-code">
  <% if entry.nil? %>
    <%= render Ui::EmptyNoteComponent.new(text: t("member.automator_live.no_file"), inset: true) %>
  <% else %>
    <h2 class="sticky top-0 z-10 border-b border-stone-200 bg-white px-4 py-2 font-mono text-[12px] font-semibold text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100"><%= entry.path %></h2>
    <% if !entry.changed? %>
      <%= render Ui::EmptyNoteComponent.new(text: t("member.automator_live.file_only_read"), inset: true) %>
    <% elsif !code_view %>
      <%= render Ui::EmptyNoteComponent.new(text: t(code_available ? "member.automator_live.files_only_body" : "member.automator_live.code_off_title"),
            hint: (t("member.automator_live.code_off_body") unless code_available), inset: true, test_id: (code_available ? nil : "automator-live-code-off")) %>
    <% else %>
      <% latest = entry.changes.last %>
      <% cursor = { label: "#{automator_live_engine(@attempt.runtime)} · #{@ticket.code}", color: @colors[@attempt.id] } if @following && @attempt.status_running? && @colors[@attempt.id] %>
      <% entry.changes.each do |change| %>
        <%= render "member/agents/live_sessions/change", change:, follow: @following && change.equal?(latest),
              fresh: change.equal?(latest) && automator_live_fresh?(change.at), cursor: (cursor if change.equal?(latest)) %>
      <% end %>
    <% end %>
  <% end %>
</div>
