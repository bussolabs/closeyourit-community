<%# locals: (dir:, depth:) %>
<%# One level of the whole project (from GitHub). Folders the agent works in stay open; the others load when opened. %>
<% @tree_index.folders(dir).each do |folder| %>
  <% if @open_dirs.include?(folder) %>
    <li class="flex items-center gap-1.5 py-1 pr-2 font-mono text-[11px] text-gray-600 dark:text-zinc-300" style="<%= automator_live_indent(depth) %>" data-test="automator-live-folder">
      <%= render Ui::IconComponent.new(name: "folder-open", class: "text-[11px]") %><span class="truncate" title="<%= folder %>"><%= File.basename(folder) %></span>
    </li>
    <%= render "member/agents/live_sessions/tree_level", dir: folder, depth: depth + 1 %>
  <% else %>
    <li>
      <details data-dir="<%= folder %>" data-automator-live-tree-target="folder" data-action="toggle->automator-live-tree#remember">
        <summary class="flex min-h-8 cursor-pointer list-none items-center gap-1.5 rounded-md py-1 pr-2 font-mono text-[11px] text-gray-500 hover:bg-stone-50 dark:text-zinc-400 dark:hover:bg-zinc-800/60" style="<%= automator_live_indent(depth) %>">
          <%= render Ui::IconComponent.new(name: "folder", class: "text-[11px]") %><span class="truncate" title="<%= folder %>"><%= File.basename(folder) %></span>
        </summary>
        <ul><%= turbo_frame_tag automator_live_tree_frame(folder), src: tree_member_agents_live_session_path(@attempt, dir: folder, depth: depth + 1), loading: :lazy, target: "_top" %></ul>
      </details>
    </li>
  <% end %>
<% end %>
<% @tree_index.files(dir).each do |path| %>
  <% if (entry = @session.file(path)) %>
    <%= render "member/agents/live_sessions/file_row", entry:, session: @session, current_path: @current_path, depth: %>
  <% else %>
    <li class="flex min-h-8 items-center gap-2 py-1 pr-2 text-[12px]" style="<%= automator_live_indent(depth) %>" data-test="automator-live-tree-file">
      <span class="size-1.5 shrink-0"></span>
      <span class="min-w-0 flex-1 truncate font-mono text-gray-500 dark:text-zinc-400" title="<%= path %>"><%= File.basename(path) %></span>
    </li>
  <% end %>
<% end %>
