<%# locals: session: — the latest steps, newest first. %>
<section class="flex flex-col border-t border-stone-200 dark:border-zinc-800 md:col-span-2 xl:col-span-1 xl:min-h-0 xl:overflow-y-auto bg-white dark:bg-zinc-900 md:rounded-lg md:border md:border-stone-200 dark:md:border-zinc-800" aria-labelledby="automator-live-timeline-title">
  <h2 id="automator-live-timeline-title" class="px-4 pt-3 pb-1.5 text-[12px] font-semibold text-gray-600 dark:text-zinc-300"><%= t("member.automator_live.timeline") %></h2>
  <% if session.truncated? %>
    <p class="mx-4 mb-2 text-[11.5px] text-amber-800 dark:text-amber-300" data-test="automator-live-truncated"><%= t("member.automator_live.truncated") %></p>
  <% end %>
  <ol class="space-y-2 px-4 pb-4">
    <%= render partial: "member/agents/live_sessions/step", collection: session.timeline, as: :step %>
  </ol>
</section>
