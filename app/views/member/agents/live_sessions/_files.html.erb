<%# CYRA-1172 — the whole project from GitHub with the files the agents change lit up, or only those files under their
    folders when the project has no GitHub tree. %>
<nav class="flex flex-col border-b border-stone-200 dark:border-zinc-800 md:min-h-0 md:overflow-y-auto bg-white dark:bg-zinc-900 md:rounded-lg md:border md:border-stone-200 dark:md:border-zinc-800" aria-label="<%= t("member.automator_live.files") %>">
  <div class="flex items-center justify-between gap-2 px-4 pt-3 pb-1.5">
    <h2 class="text-[12px] font-semibold text-gray-600 dark:text-zinc-300"><%= t(@tree_index ? "member.automator_live.project_files" : "member.automator_live.files") %></h2>
    <% unless @following %>
      <%= render Ui::ButtonComponent.new(label: t("member.automator_live.follow"), icon: "locate-fixed", variant: :ghost, size: :sm,
            href: automator_live_path(file: nil), test_id: "automator-live-follow") %>
    <% end %>
  </div>
  <% if @tree_index %>
    <ul class="px-2 pb-3" data-controller="automator-live-tree">
      <%= render "member/agents/live_sessions/tree_level", dir: "", depth: 0 %>
    </ul>
    <% if @tree.partial? %>
      <p class="px-4 pb-3 text-[11px] text-gray-500 dark:text-zinc-400" data-test="automator-live-tree-partial"><%= t("member.automator_live.tree_partial") %></p>
    <% end %>
  <% else %>
    <ul class="px-2 pb-3">
      <% @files.group_by { ::Agents::LiveEvents::ProjectTree::Index.parent_of(it.path) }.sort.each do |folder, files| %>
        <%= render "member/agents/live_sessions/folder", folder: %>
        <%= render partial: "member/agents/live_sessions/file_row", collection: files, as: :file %>
      <% end %>
    </ul>
  <% end %>
</nav>
