<%# CYRA-1172 — which project, who works on it, and what to show. With one agent filtered: its ticket, engine and time at work. %>
<header class="border-b border-stone-200 bg-white dark:border-zinc-800 dark:bg-zinc-900" data-test="automator-live-header">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2.5">
    <div class="flex min-w-0 flex-col gap-0.5">
      <h2 class="truncate text-[15px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.automator_live.project_title", project: @project.name) %></h2>
      <% if @agent %>
        <p class="text-[12px] text-gray-500 dark:text-zinc-400" data-test="automator-live-filtered">
          <%= link_to @agent.name, member_ticket_path(@agent.ticket), class: "font-mono font-semibold hover:underline #{automator_live_color(@agent, :text)}" %>
          · <span data-test="automator-live-engine"><%= automator_live_engine(@agent.attempt.runtime) %></span>
          · <span class="font-mono"><%= @agent.attempt.host.hostname %></span>
          · <%= automation_execution_phase_label(@agent.attempt.phase) %>
          <% if @agent.attempt.status_running? %>
            · <span class="font-mono tabular-nums" title="<%= t("member.automator_live.elapsed") %>" data-controller="automator-live-elapsed"
                    data-automator-live-elapsed-since-value="<%= @agent.attempt.started_at.iso8601 %>" data-test="automator-live-elapsed"><%= automator_live_elapsed(@agent.attempt.started_at) %></span>
          <% else %>
            · <%= t("member.automator_live.over") %>
          <% end %>
        </p>
      <% else %>
        <p class="text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.automator_live.project_hint") %></p>
      <% end %>
    </div>
    <% if @code_available %>
      <%= render Ui::ButtonGroupComponent.new(test_id: "automator-live-view-switch", class: "border border-stone-200 dark:border-zinc-800 divide-x divide-stone-200 dark:divide-zinc-800",
            aria: { label: t("member.automator_live.view_switch") }) do |group| %>
        <% [ [ nil, "view_code", @code_view ], [ "files", "view_files", !@code_view ] ].each do |value, key, current| %>
          <% group.with_button(label: t("member.automator_live.#{key}"), href: automator_live_path(view: value),
                variant: current ? :secondary : :ghost, size: :sm, aria: { current: current.to_s }) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <p class="border-t border-stone-100 px-4 py-1.5 text-right text-[12px] text-gray-600 dark:border-zinc-800 dark:text-zinc-300" data-test="automator-live-counts">
    <%= safe_join({ agents: @shown.size, hosts: @shown.map { it.attempt.host_id }.uniq.size, files: @files.size }.map { |key, count|
          safe_join([ tag.strong(count, class: "font-mono"), t("member.automator_live.counts.#{key}", count:) ], " ") }, " · ") %>
    <% if @conflicts.any? %>
      · <strong class="font-mono text-red-700 dark:text-red-400"><%= @conflicts.size %></strong> <%= t("member.automator_live.conflicts", count: @conflicts.size) %>
    <% end %>
  </p>
</header>
