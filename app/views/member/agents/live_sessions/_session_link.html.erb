<%# locals: attempt:, current: — one session in the sidebar: a dot in its agent's colour (the same on every
    live page, @colors), pulsing while the agent works, grey once it is over; the machine and the engine under it. %>
<% ticket = attempt.workflow.ticket %>
<% color = @colors&.dig(attempt.id) %>
<%= render Ui::NavLinkComponent.new(label: "#{ticket.code} · #{ticket.title}", path: member_agents_live_session_path(attempt),
      active: current&.id == attempt.id, size: :top, detail: "#{attempt.host.hostname} · #{automator_live_engine(attempt.runtime)}",
      class: "h-12! min-w-0", test_id: "automator-live-session") do %>
  <span class="size-2 shrink-0 rounded-full <%= attempt.status_running? ? "#{color ? automator_live_paint(color, :dot) : "bg-emerald-500"} motion-safe:animate-pulse" : "bg-stone-300 dark:bg-zinc-600" %>"
        data-color="<%= color %>"
        title="<%= t(attempt.status_running? ? "member.automator_live.running" : "member.automator_live.over") %>"></span>
<% end %>
