<%# The header and the write-only form of a secret the organization lends to its machines (CYAU-224/228).
  The field is never filled back; the browser confirmation is the gesture CYRA-728 asks for. %>
<% scope = "member.#{name}" %>
<% prefix = name.dasherize %>
<%= render Ui::PageHeaderComponent.new(
      title: t("#{scope}.title"),
      subtitle: t("#{scope}.subtitle"),
      breadcrumb: [ { label: t("member.nav.section_automation") }, { label: t("member.agents.title"), href: member_agents_path }, { label: t("#{scope}.title") } ],
      counts_test_id: "#{prefix}-counts",
      test_id: "#{prefix}-header") do |h| %>
  <% h.with_counts do %>
    <% if credential %>
      <%= render Ui::BadgeComponent.new(label: t("#{scope}.state_set"), color: :emerald, dot: true, test_id: "#{prefix}-status") %>
      <% if credential.respond_to?(:kind) %>
        <%= render Ui::StatLabelComponent.new(label: t("#{scope}.kind_label"), value: t("#{scope}.kinds.#{credential.kind}"), value_color: :indigo, test_id: "#{prefix}-kind") %>
      <% end %>
    <% else %>
      <%= render Ui::BadgeComponent.new(label: t("#{scope}.state_missing"), color: :gray, dot: true, test_id: "#{prefix}-status") %>
    <% end %>
  <% end %>
  <% h.with_actions do %>
    <%= render Ui::ButtonComponent.new(label: t("#{scope}.#{credential ? 'replace' : 'save'}"), type: "submit", form: "#{prefix}-form",
          variant: :primary, size: :sm, icon: "check", test_id: "#{prefix}-save") %>
    <% if credential %>
      <%= render Ui::ConfirmDialogComponent.new(title: t("#{scope}.remove_dialog.title"), url: path,
            confirm_label: t("#{scope}.remove"), test_id: "#{prefix}-remove-dialog") do |dialog| %>
        <% dialog.with_body { t("#{scope}.remove_dialog.body") } %>
        <%= render Ui::RowMenuComponent.new(test_id: "#{prefix}-menu", aria_label: t("#{scope}.more_menu")) do %>
          <%= dialog.menu_trigger(label: t("#{scope}.remove"), icon: "trash", test_id: "#{prefix}-remove") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render Ui::SectionComponent.new(title: t("#{scope}.form_title"), header_padding: :wide, body_class: "px-5 py-5", test_id: "#{prefix}-panel") do |section| %>
  <% section.with_subtitle do %>
    <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("#{scope}.form_hint") %></p>
  <% end %>
  <%= form_with url: path, method: :patch, id: "#{prefix}-form",
        data: { test: "#{prefix}-form", turbo_confirm: t("#{scope}.save_confirm") } do %>
    <%= hidden_field_tag Authorization::DangerousAction::CONFIRM_PARAM, "1", id: nil %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
      <%= render Ui::InputComponent.new(name: "token", type: "password", value: "", required: credential.nil?,
            label: t("#{scope}.token_label"), autocomplete: "off", spellcheck: false,
            placeholder: t("#{scope}.token_placeholder_#{credential ? 'set' : 'missing'}"),
            hint: t("#{scope}.token_hint"), error: error, wrapper_class: "md:col-span-2", test_id: "#{prefix}-token") %>
    </div>
    <p class="mt-3 text-[12px] text-gray-500 dark:text-zinc-400" data-test="#{prefix}-after-save"><%= t("#{scope}.after_save") %></p>
  <% end %>
  <% if credential %>
    <p class="mt-4 text-[11.5px] text-gray-500 dark:text-zinc-400" data-test="#{prefix}-set-by">
      <%= t("#{scope}.set_by", who: credential.set_by&.name || t("#{scope}.someone"), when: l(credential.updated_at, format: :short)) %>
    </p>
  <% end %>
<% end %>
