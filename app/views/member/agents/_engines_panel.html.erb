<%# locals: (host:, can_manage:) %>
<%# CYRA-1032 — the engines in one panel: whether the machine follows the organization on top, then one
    column per role: who works, who reviews, who answers (CYAU-235). The columns stack below lg. %>
<%= render Ui::SectionComponent.new(title: t("member.agents.choice.title"), body_class: nil, test_id: "host-engines") do %>
  <%= render "member/agents/engine_choice", host:, can_manage: %>
  <div class="grid grid-cols-1 lg:grid-cols-3 border-t border-stone-100 dark:border-zinc-800 divide-y lg:divide-y-0 lg:divide-x divide-stone-100 dark:divide-zinc-800">
    <%= render "member/agents/work_engine", host:, can_manage: %>
    <%= render "member/agents/review_mode", host:, can_manage: %>
    <%= render "member/agents/supporter", host:, can_manage: %>
  </div>
<% end %>
