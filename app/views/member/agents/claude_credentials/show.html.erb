<% content_for :title, t("member.claude_credential.title") %>
<% scope = "member.claude_credential" %>

<div class="p-7 space-y-6" data-test="claude-credential">
  <%= render "member/agents/lent_credential", name: "claude_credential", credential: @credential, error: @error,
                                               path: member_agents_claude_credential_path,
                                               secret_options: @secret_options %>

  <%= render Ui::SectionComponent.new(title: t("#{scope}.kinds_title"), header_padding: :wide, body_class: "px-5 py-5", test_id: "claude-credential-kinds") do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5 text-[12.5px] text-gray-600 dark:text-zinc-400">
      <div data-test="claude-credential-kind-api-key">
        <h3 class="font-semibold text-zinc-900 dark:text-zinc-100"><%= t("#{scope}.api_key_title") %></h3>
        <p class="mt-1 leading-relaxed"><%= t("#{scope}.api_key_body") %></p>
      </div>
      <div class="space-y-3" data-test="claude-credential-kind-oauth">
        <h3 class="font-semibold text-zinc-900 dark:text-zinc-100"><%= t("#{scope}.oauth_title") %></h3>
        <p class="leading-relaxed"><%= t("#{scope}.oauth_body") %></p>
        <%= render(Ui::AlertComponent.new(variant: :warning, title: t("#{scope}.oauth_warning_title"), test_id: "claude-credential-oauth-warning")) { t("#{scope}.oauth_warning") } %>
      </div>
    </div>
  <% end %>
</div>
