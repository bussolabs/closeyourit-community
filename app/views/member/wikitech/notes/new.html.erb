<% content_for :title, t("member.wikitech.notes.title") %>

<div class="p-7" data-test="wikitech-note-new">
  <%= form_with url: member_wikitech_notes_path, method: :post, class: "space-y-6", data: { test: "wikitech-note-form" } do %>
    <%= render Ui::PageHeaderComponent.new(
          title: t("member.wikitech.notes.title"),
          breadcrumb: [ { label: t("member.wikitech.title"), href: member_wikitech_root_path }, { label: t("member.wikitech.notes.title") } ]) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.wikitech.notes.cancel"), href: member_wikitech_root_path, variant: :secondary_muted, size: :sm) %>
        <%= render Ui::ButtonComponent.new(label: t("member.wikitech.notes.submit"), type: "submit", icon: "check", size: :sm, test_id: "wikitech-note-submit") %>
      <% end %>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
          <%= render Ui::InputComponent.new(name: "body", type: "textarea", rows: 10, required: true, label: t("member.wikitech.notes.body"),
                value: params[:body], hint: t("member.wikitech.notes.body_hint"), error: @error,
                wrapper_class: "md:col-span-2", test_id: "wikitech-note-body") %>
          <%= render Ui::InputComponent.new(name: "source_label", label: t("member.wikitech.notes.source_label"), value: params[:source_label],
                placeholder: t("member.wikitech.notes.source_label_placeholder"), autocomplete: "off", test_id: "wikitech-note-source-label") %>
          <%= render Ui::InputComponent.new(name: "source_url", type: "url", label: t("member.wikitech.notes.source_url"), value: params[:source_url],
                inputmode: "url", autocomplete: "url", test_id: "wikitech-note-source-url") %>
          <%= render Ui::InputComponent.new(name: "links", type: "textarea", rows: 3, label: t("member.wikitech.notes.links"), value: params[:links],
                hint: t("member.wikitech.notes.links_hint"), wrapper_class: "md:col-span-2", test_id: "wikitech-note-links") %>
        </div>
      </div>
    </div>
  <% end %>
</div>
