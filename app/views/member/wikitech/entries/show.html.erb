<% content_for :title, @entry.name %>

<div class="p-7 space-y-6" data-test="wikitech-entry">
  <%= render Ui::PageHeaderComponent.new(
        title: @entry.name,
        breadcrumb: [ { label: t("member.wikitech.title"), href: member_wikitech_root_path }, { label: @entry.name } ]) do |h| %>
    <% if @entry.repo_url %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.wikitech.show.open_repo"), href: @entry.repo_url, variant: :secondary_muted,
              size: :sm, icon: "external-link", test_id: "wikitech-open-repo", target: "_blank", rel: "noopener") %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Ui::GridComponent.new(cols: 1, lg: 3, gap: 6) do %>
    <%= render Ui::StackComponent.new(gap: 6, class: "lg:col-span-2") do %>
      <%= render Ui::SectionComponent.new(title: t("member.wikitech.show.summary"), test_id: "wikitech-summary") do %>
        <p class="max-w-prose text-[13.5px] leading-relaxed text-zinc-900 dark:text-zinc-100"><%= @entry.summary.presence || t("member.wikitech.show.no_summary") %></p>
      <% end %>
      <% if @entry.facts.any? %>
        <%= render Ui::SectionComponent.new(title: t("member.wikitech.show.facts"), test_id: "wikitech-facts") do %>
          <ul class="max-w-prose list-disc space-y-1.5 pl-5 text-[13px] leading-relaxed text-zinc-900 dark:text-zinc-100">
            <% @entry.facts.each do |fact| %>
              <li><%= fact %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
      <%= render "member/wikitech/entries/sources", entry: @entry %>
    <% end %>

    <%= render Ui::StackComponent.new(gap: 6) do %>
      <%= render "member/wikitech/entries/details", entry: @entry %>
      <% links = [ @entry.repo_url, *@entry.links ].compact %>
      <% if links.any? %>
        <%= render Ui::SectionComponent.new(title: t("member.wikitech.show.links"), test_id: "wikitech-links") do %>
          <ul class="space-y-1">
            <% links.each do |link| %>
              <li><%= link_to link.delete_prefix("https://"), link, target: "_blank", rel: "noopener",
                    class: "break-all font-mono text-[12px] text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300" %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
