<%= render Ui::DetailsComponent.new(title: t("member.wikitech.show.details"), test_id: "wikitech-details") do |details| %>
  <% details.with_row(label: t("member.wikitech.col_state")) do %>
    <%= render "member/wikitech/entries/state", entry: entry %>
  <% end %>
  <% if entry.categories.any? %>
    <% details.with_row(label: t("member.wikitech.col_categories")) do %>
      <% entry.categories.each do |category| %>
        <%= render Ui::BadgeComponent.new(label: category, color: :violet, size: :sm) %>
      <% end %>
    <% end %>
  <% end %>
  <% details.with_row(label: t("member.wikitech.col_stars"), value: (number_with_delimiter(entry.stars) if entry.stars)) %>
  <% details.with_row(label: t("member.wikitech.show.license"), value: entry.license) %>
  <% details.with_row(label: t("member.wikitech.show.language"), value: entry.language) %>
  <% pushed_at = entry.repo_meta&.dig("pushed_at") %>
  <% if pushed_at %>
    <% details.with_row(label: t("member.wikitech.show.pushed_at")) do %>
      <span class="font-mono text-[12px]" title="<%= l(Time.zone.parse(pushed_at), format: :long) %>"><%= error_time_ago(Time.zone.parse(pushed_at)) %></span>
    <% end %>
  <% end %>
<% end %>
