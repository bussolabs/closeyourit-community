<%= render Ui::TableComponent::RowComponent.new(href: member_wikitech_entry_path(entry), link_label: entry.name, test_id: "wikitech-entry-#{entry.id}") do %>
  <%= render Ui::TableComponent::CellComponent.new(header: true) do %>
    <div class="min-w-0">
      <span class="block text-[13px] font-semibold text-zinc-900 dark:text-zinc-100"><%= entry.name %></span>
      <span class="block truncate text-[12px] text-gray-500 dark:text-zinc-400"><%= entry.summary %></span>
    </div>
  <% end %>
  <%= render Ui::TableComponent::CellComponent.new(label: t("member.wikitech.col_categories")) do %>
    <% entry.categories.first(3).each do |category| %>
      <%= render Ui::BadgeComponent.new(label: category, color: :violet, size: :sm) %>
    <% end %>
  <% end %>
  <%= render Ui::TableComponent::CellComponent.new(label: t("member.wikitech.col_sources"), mono: true, align: :right) do %>
    <%= entry.sources_count %>
  <% end %>
  <%= render Ui::TableComponent::CellComponent.new(label: t("member.wikitech.col_stars"), mono: true, align: :right) do %>
    <% if entry.stars %><%= number_with_delimiter(entry.stars) %><% else %><span class="text-gray-500 dark:text-zinc-400">—</span><% end %>
  <% end %>
  <%= render Ui::TableComponent::CellComponent.new(label: t("member.wikitech.col_state")) do %>
    <%= render "member/wikitech/entries/state", entry: entry %>
  <% end %>
<% end %>
