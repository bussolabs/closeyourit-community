<%= render Ui::SectionComponent.new(title: t("member.wikitech.show.sources", count: entry.sources.size), test_id: "wikitech-sources") do %>
  <ul class="divide-y divide-stone-100 dark:divide-zinc-800">
    <% entry.sources.each do |source| %>
      <% note = source.note %>
      <li class="py-2.5 first:pt-0 last:pb-0" data-test="wikitech-source">
        <div class="flex items-baseline justify-between gap-3">
          <% label = note.source_label.presence || t("member.wikitech.show.manual_source") %>
          <% if note.source_url %>
            <%= link_to label, note.source_url, target: "_blank", rel: "noopener", class: "text-[13px] font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300" %>
          <% else %>
            <span class="text-[13px] font-medium text-zinc-900 dark:text-zinc-100"><%= label %></span>
          <% end %>
          <% date = note.source_published_at || note.created_at %>
          <span class="shrink-0 font-mono text-[12px] text-gray-500 dark:text-zinc-400"><%= l(date.to_date, format: :long) %></span>
        </div>
        <% if source.quote %>
          <p class="mt-1 max-w-prose text-[12.5px] italic text-gray-500 dark:text-zinc-400">«<%= source.quote %>»</p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
