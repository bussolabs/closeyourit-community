<% content_for :title, t("member.knowledge.books.title") %>

<div class="p-7 space-y-6" data-test="member-knowledge-books">
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.knowledge.books.title"),
        subtitle: t("member.knowledge.books.help_title"),
        breadcrumb: [ { label: t("member.knowledge.title"), href: member_knowledge_pages_path },
                      { label: t("member.knowledge.books.title") } ],
        counts_test_id: "knowledge-books-counts") do |h| %>
    <% h.with_counts do %>
      <%= render Ui::StatLabelComponent.new(label: t("member.knowledge.books.stats.books"), value: @pagination.total, test_id: "knowledge-books-count-total") %>
    <% end %>
    <%# Creare = baseline di chi vede lo scope (come le pagine): nessun gate qui. %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.knowledge.books.pages_link"), href: member_knowledge_pages_path, variant: :secondary_muted, size: :sm, icon: "file-text", test_id: "knowledge-books-pages-link") %>
      <%= render Ui::ButtonComponent.new(label: t("member.knowledge.books.new"), href: new_member_knowledge_book_path, variant: :primary, size: :sm, icon: "plus", test_id: "knowledge-books-new") %>
    <% end %>
  <% end %>

  <div data-test="knowledge-books-table">
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <%= render(Ui::TableToolbarComponent.new(framed: true,
            url: member_knowledge_books_path, query: params[:q],
            search_placeholder: t("member.knowledge.books.search_placeholder"),
            apply_label: t("member.knowledge.apply"),
            search_test_id: "knowledge-books-search", apply_test_id: "knowledge-books-filter",
            test_id: "knowledge-books-toolbar")) do |toolbar| %>
        <% toolbar.with_filter(key: "project_id", label: t("member.knowledge.filter_project")) do %>
          <div class="w-40"><%= render Ui::SelectComponent.new(name: "project_id", multiple: true, summary: true, options: @filter_projects.map { |p| [ p.name, p.id ] }, selected: params[:project_id], placeholder: t("member.knowledge.filter_project"), test_id: "filter-project") %></div>
        <% end %>
      <% end %>

      <%# CYRA-555 — ricerca o filtro senza corrispondenze: le raccolte ci sono, non le sta mostrando
          il filtro. Il messaggio lo dice e offre di toglierlo. %>
      <% if @books.empty? && @filtering %>
        <%= render Ui::NoResultsComponent.new(query: params[:q].presence, reset_href: member_knowledge_books_path,
              body: t("member.knowledge.books.no_results_body", count: @total_books),
              icon: "book", test_id: "knowledge-books-no-results", reset_test_id: "knowledge-books-reset-search") %>
      <% elsif @books.empty? %>
        <%= render Ui::EmptyStateComponent.new(title: t("member.knowledge.books.empty"), body: t("member.knowledge.books.empty_body"),
              icon: "book", test_id: "knowledge-books-empty") do |empty| %>
          <% empty.with_action do %>
            <%= render Ui::ButtonComponent.new(label: t("member.knowledge.books.new"), href: new_member_knowledge_book_path,
                  variant: :primary, size: :sm, icon: "plus", test_id: "knowledge-books-empty-new") %>
          <% end %>
        <% end %>
      <% else %>
        <%= render(Ui::TableComponent.new(stacked: true, label: t("member.knowledge.books.title"))) do |table| %>
          <% table.with_head do %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.knowledge.books.col_title"), sort: "title") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.knowledge.books.col_projects")) %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.knowledge.books.col_pages"), sort: "pages", initial: :desc, align: :right) %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.knowledge.col_author"), sort: "author") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.knowledge.col_updated"), sort: "updated", initial: :desc, align: :right) %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("ui.table.open_column"), label_hidden: true) %>
          <% end %>
          <% @books.each do |book| %>
            <%= render Ui::TableComponent::RowComponent.new(href: member_knowledge_book_path(book), link_label: book.title, test_id: "knowledge-books-row") do %>
              <%= render Ui::TableComponent::CellComponent.new(header: true) do %>
                <%= link_to book.title, member_knowledge_book_path(book), class: "text-[13px] font-medium text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400 max-w-[320px] truncate block" %>
              <% end %>
              <% visible_projects = (book.projects.to_a + book.groups.flat_map(&:projects)).uniq(&:id).select { |p| @visible_project_ids.include?(p.id) }.sort_by(&:name) %>
              <%= render Ui::TableComponent::CellComponent.new(label: t("member.knowledge.books.col_projects")) do %>
                <div class="flex flex-wrap gap-1" data-test="knowledge-book-projects"><% visible_projects.each do |project| %><%= render Ui::BadgeComponent.new(label: project.name, color: project.color || "gray", size: :sm) %><% end %></div>
              <% end %>
              <%= render(Ui::TableComponent::CellComponent.new(label: t("member.knowledge.books.col_pages"), align: :right, mono: true, class: "text-gray-500 dark:text-zinc-400")) { @page_counts[book.id].to_i.to_s } %>
              <%= render Ui::TableComponent::CellComponent.new(label: t("member.knowledge.col_author")) do %>
                <span class="inline-flex items-center gap-1.5 text-gray-500 dark:text-zinc-400"><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-teal-50 dark:bg-teal-500/15 text-teal-600 dark:text-teal-400 text-[9px] font-semibold"><%= avatar_initials(book.created_by.name) %></span><%= book.created_by.name %></span>
              <% end %>
              <%= render(Ui::TableComponent::CellComponent.new(label: t("member.knowledge.col_updated"), align: :right, mono: true, class: "text-gray-500 dark:text-zinc-400")) { l(book.updated_at.to_date) } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= render(Ui::PaginationComponent.new(pagination: @pagination, test_id: "knowledge-books-pagination")) %>
    </div>
  </div>
</div>
