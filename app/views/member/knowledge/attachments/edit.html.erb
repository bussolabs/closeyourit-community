<% title = t("member.knowledge.attachments.form.title_edit") %>
<% content_for :title, title %>
<% breadcrumb = [ { label: t("member.knowledge.title"), href: member_knowledge_pages_path },
                  { label: @page.title, href: member_knowledge_page_path(@page) },
                  { label: t("member.breadcrumb.edit") } ] %>

<div class="p-7">
  <%= form_with url: member_knowledge_page_attachment_path(@page, @attachment), method: :patch, class: "space-y-6", data: { test: "attachment-form" } do %>
    <%= render Ui::PageHeaderComponent.new(title: title, breadcrumb: breadcrumb) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.knowledge.attachments.form.cancel"), href: member_knowledge_page_path(@page), variant: :secondary_muted, size: :sm) %>
        <%= render Ui::ButtonComponent.new(label: t("member.knowledge.attachments.form.save"), type: "submit", icon: "check", test_id: "attachment-submit", size: :sm) %>
      <% end %>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
          <%= render Ui::InputComponent.new(name: "title", label: t("member.knowledge.attachments.form.name"), required: true,
                value: @attachment.title, test_id: "attachment-title",
                error: @errors&.dig(:title)&.first) %>

          <div class="md:col-span-2" data-test="attachment-description">
            <label for="description" class="block text-[12px] font-medium text-zinc-900 dark:text-zinc-100 mb-1.5"><%= t("member.knowledge.attachments.form.description") %></label>
            <textarea name="description" id="description" rows="3"
                      class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= @attachment.description %></textarea>
          </div>

          <%# Il file non si sostituisce dalla rinomina: si elimina e si ricarica, così ogni binario
              passa sempre dallo sniff del service di upload. %>
          <div class="md:col-span-2 flex items-center gap-3 px-3 h-[44px] rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50/60 dark:bg-zinc-800/60" data-test="attachment-file-info">
            <%= render Ui::IconComponent.new(name: knowledge_attachment_icon(@attachment.file.blob.content_type), class: "text-[15px] text-gray-400 dark:text-zinc-500") %>
            <span class="min-w-0 flex-1 font-mono text-[12px] text-zinc-700 dark:text-zinc-300 truncate"><%= @attachment.file.blob.filename %></span>
            <span class="font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= number_to_human_size(@attachment.file.blob.byte_size) %></span>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
