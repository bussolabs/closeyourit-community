<%# locals: (levels:, hours:, zones:, quiet_on:) %>
<%= render Ui::SectionComponent.new(title: t("member.alerting.preferences.quiet_hours"), header_padding: :wide,
      body_class: "divide-y divide-stone-100 dark:divide-zinc-800") do |section| %>
  <% section.with_subtitle do %>
    <p class="mt-1 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.alerting.preferences.quiet_hours_hint") %></p>
  <% end %>
    <div class="flex items-center gap-3 px-5 py-3.5">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-500 dark:text-zinc-400 shrink-0"><%= render Ui::IconComponent.new(name: "signal", class: "text-[13px]") %></span>
      <div class="min-w-0 flex-1"><p class="text-[13px] font-medium text-zinc-900 dark:text-zinc-100"><%= t("member.alerting.preferences.min_level") %></p><p class="text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.alerting.preferences.min_level_hint") %></p></div>
      <div class="w-40 shrink-0"><%= render Ui::SelectComponent.new(name: "min_level",
            options: [ [ t("member.alerting.preferences.min_level_any"), "" ] ] + levels,
            selected: @preference.min_level, test_id: "pref-min-level") %></div>
    </div>
    <div class="px-5 py-5">
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="hidden" name="quiet_hours_enabled" value="0">
        <input type="checkbox" name="quiet_hours_enabled" value="1" <%= "checked" if quiet_on %> data-test="pref-quiet-hours" class="w-4 h-4 rounded accent-indigo-600">
        <span class="text-[12.5px] text-zinc-900 dark:text-zinc-100"><%= t("member.alerting.preferences.enable_quiet") %></span>
      </label>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div><%= render Ui::SelectComponent.new(name: "quiet_hours_start", label: t("member.alerting.preferences.from"),
              options: hours, selected: @preference.quiet_hours_start, include_blank: true, test_id: "pref-quiet-from") %></div>
        <div><%= render Ui::SelectComponent.new(name: "quiet_hours_end", label: t("member.alerting.preferences.to"),
              options: hours, selected: @preference.quiet_hours_end, include_blank: true, test_id: "pref-quiet-to") %></div>
        <div><%= render Ui::SelectComponent.new(name: "quiet_hours_tz", label: t("member.alerting.preferences.timezone"),
              options: zones, selected: @preference.quiet_hours_tz || "Europe/Rome", test_id: "pref-quiet-tz") %></div>
      </div>
      <p class="mt-3 text-[11px] text-gray-500 dark:text-zinc-400"><%= render Ui::IconComponent.new(name: "moon", class: "mr-1") %><%= t("member.alerting.preferences.quiet_note") %></p>
    </div>
<% end %>
