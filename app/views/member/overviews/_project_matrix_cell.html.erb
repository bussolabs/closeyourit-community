<%# locals: (cell:, matrix:, prefix:) %>
<%# CYRA-927/930 — one signal of one project: the number, its caption and the link to the filtered
    list. `off` = never set up (dashed, leads to setting it up); `na` = this row cannot have it. %>
<% shared = "member.overviews.matrix" %>
<% data = { test: "#{prefix}-cell-#{cell.key}", state: cell.state, rising: cell.rising } %>
<% case cell.state %>
<% when :na %>
  <span class="block px-3 py-2.5 font-mono text-[13px] text-stone-300 dark:text-zinc-600" title="<%= t("#{shared}.not_available") %>" data-test="<%= prefix %>-cell-<%= cell.key %>" data-state="na">—<span class="sr-only"><%= t("#{shared}.not_available") %></span></span>
<% when :off %>
  <%= link_to t("#{matrix.i18n_scope}.#{cell.key}.set_up", default: t("#{shared}.set_up")), cell.href, data:,
        class: "m-1.5 flex min-h-[46px] items-center justify-center rounded-md border border-dashed border-stone-300 dark:border-zinc-700 px-3 text-[11.5px] font-medium text-indigo-600 dark:text-indigo-400 hover:border-indigo-300 dark:hover:border-indigo-500/50 hover:bg-indigo-50 dark:hover:bg-indigo-500/15" %>
<% else %>
  <%= link_to cell.href, data:, title: (t("#{matrix.i18n_scope}.matrix.rising") if cell.rising),
        class: "flex h-full min-h-[58px] flex-col gap-0.5 px-3 py-2.5 hover:bg-indigo-50 dark:hover:bg-indigo-500/20 #{'bg-red-50 dark:bg-red-500/15 hover:bg-red-100 dark:hover:bg-red-500/25' if cell.rising}" do %>
    <span class="font-mono text-[15px] font-semibold <%= cell.value.zero? ? 'text-stone-400 dark:text-zinc-500' : (cell.alert ? 'text-red-600 dark:text-red-400' : 'text-zinc-900 dark:text-zinc-100') %>" data-test="<%= prefix %>-cell-value"><%= cell.value %></span>
    <% if cell.trend %>
      <%= render Ui::SparklineComponent.new(points: cell.trend, tone: (cell.value.positive? ? :red : :gray), label: t("#{matrix.i18n_scope}.matrix.trend")) %>
    <% end %>
    <span class="text-[11px] text-gray-500 dark:text-zinc-400"><%= cell.caption %></span>
  <% end %>
<% end %>
