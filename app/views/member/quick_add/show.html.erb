<% content_for :title, t("member.quick_add.title") %>

<div class="p-7 space-y-6" data-test="member-quick-add">
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.quick_add.title"),
        subtitle: t("member.quick_add.subtitle"),
        breadcrumb: [ { label: t("member.quick_add.title") } ],
        test_id: "quick-add-header") %>

  <%# Quattro scelte, ognuna con la riga che dice QUANDO si usa e cosa NON ci va: il problema non è
      la mancanza di contenitori, è l'assenza di un criterio per sceglierli. %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% [ { key: "ticket", href: new_member_ticket_path, icon: "ticket" },
         { key: "idea",   href: new_member_idea_path,   icon: "lightbulb" },
         { key: "todo",   href: new_member_todo_list_path, icon: "list-check" },
         { key: "action", href: new_member_workload_action_path, icon: "workflow" } ].each do |choice| %>
      <%= link_to choice[:href], class: "group flex flex-col rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 hover:border-indigo-300 dark:hover:border-indigo-500/50",
            data: { test: "quick-add-#{choice[:key]}" } do %>
        <span class="inline-flex items-center gap-2 font-display text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">
          <%= render Ui::IconComponent.new(name: choice[:icon], class: "w-[1.25em] text-[14px] text-gray-400 dark:text-zinc-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400") %>
          <%= t("member.quick_add.#{choice[:key]}.title") %>
        </span>
        <span class="mt-1.5 text-[12.5px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.quick_add.#{choice[:key]}.when") %></span>
        <span class="mt-3 text-[11.5px] text-gray-400 dark:text-zinc-500"><%= t("member.quick_add.#{choice[:key]}.not_here") %></span>
      <% end %>
    <% end %>
  </div>
</div>
