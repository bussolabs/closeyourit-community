<%# CYRA-401 — blocco comando copiabile della sezione «Usa questo segreto». `lines` è un array di righe
    shell; il valore copiato è il testo completo (più righe). Nessun valore di secret qui: solo comandi
    `cyi` con nome progetto/ambiente e segnaposto. La copia legge il target `source` (nessun endpoint). %>
<div class="rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800" data-controller="clipboard"
     data-clipboard-copied-value="<%= t('member.secret_usage.copied') %>"
     data-clipboard-error-value="<%= t('member.secret_usage.copy_failed') %>">
  <div class="flex items-center justify-between gap-2 px-3 py-1.5 border-b border-stone-100 dark:border-zinc-800">
    <span class="font-mono text-[10px] uppercase tracking-[1px] text-gray-400 dark:text-zinc-500"><%= label %></span>
    <button type="button" data-action="clipboard#copy" class="shrink-0 text-[11px] font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300">
      <span data-clipboard-target="label"><%= t("member.secret_usage.copy") %></span>
    </button>
  </div>
  <pre class="overflow-x-auto px-3 py-2.5"><code data-clipboard-target="source" class="font-mono text-[12px] leading-relaxed text-zinc-800 dark:text-zinc-200"><%= Array(lines).join("\n") %></code></pre>
</div>
