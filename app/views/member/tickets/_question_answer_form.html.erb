<%# locals: (ticket:, question:, can_manage:) %>
<div class="mt-3 flex items-start gap-2 flex-wrap">
  <%= form_with url: member_ticket_question_answers_path(ticket, question), method: :post, class: "flex-1 min-w-[240px] flex items-center gap-2" do %>
    <%= text_field_tag :body, nil, placeholder: t("member.tickets.questions.answer_placeholder"), maxlength: Ticketing::Constants::ANSWER_MAX_CHARS,
          class: "flex-1 h-[32px] rounded-md border border-stone-200 dark:border-zinc-800 px-3 text-[12.5px] placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-400",
          data: { test: "ticket-answer-body-#{question.id}" } %>
    <%= render Ui::ButtonComponent.new(label: t("member.tickets.questions.answer_submit"), type: "submit",
          variant: :secondary, size: :sm, test_id: "ticket-answer-submit-#{question.id}") %>
  <% end %>
  <%# Ritirare una domanda è l'unica uscita quando è bloccante e superata dai fatti: senza, si sarebbe
      costretti a inventare una risposta pur di sbloccare il ticket. %>
  <% if can_manage %>
    <%= button_to member_ticket_question_closure_path(ticket, question), method: :patch, params: { confirm: 1 },
          class: "inline-flex items-center gap-1.5 h-[32px] px-2.5 rounded-md border border-stone-200 dark:border-zinc-800 text-[12px] text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800",
          data: { test: "ticket-question-close-#{question.id}", turbo_confirm: t("member.tickets.questions.close_confirm") } do %>
      <%= render Ui::IconComponent.new(name: "circle-x", class: "text-[11px]") %><%= t("member.tickets.questions.close") %>
    <% end %>
  <% end %>
</div>
