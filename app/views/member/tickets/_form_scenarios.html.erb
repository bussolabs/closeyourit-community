<%# locals: (ticket:) %>
<%# CYRA-1318 — one section for the acceptance items: what must be true at the end, written as a plain
    sentence or as a Given/When/Then case. Both formats are the same list on the ticket; each keeps its own
    repeater so the AI assistants can still fill one format at a time. %>
<% add_class = "inline-flex items-center gap-1.5 text-[12px] font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300" %>
<section class="space-y-3" data-test="ticket-acceptance-items">
  <div class="flex items-center gap-1">
    <p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.tickets.form.acceptance_items") %></p>
    <%= render Ui::TooltipComponent.new(text: t("member.tickets.form.acceptance_items_hint"), test_id: "help-acceptance-items") %>
  </div>

  <div data-controller="nested-fields" data-nested-kind="conditions" data-test="ticket-conditions" class="space-y-2">
    <div data-nested-fields-target="container" class="space-y-2">
      <% ticket.conditions.each_with_index do |condition, i| %>
        <%= render "member/tickets/condition_fields", index: i, condition: condition %>
      <% end %>
    </div>
    <template data-nested-fields-target="template"><%= render "member/tickets/condition_fields", index: "NEW_RECORD", condition: nil %></template>
    <button type="button" data-action="nested-fields#add" data-test="ticket-condition-add" class="<%= add_class %>">
      <%= render Ui::IconComponent.new(name: "plus", class: "text-[10px]") %><%= t("member.tickets.form.condition_add") %>
    </button>
  </div>

  <%# No case until the person adds one; existing rows (edit) start with their id and values. %>
  <div data-controller="nested-fields" data-nested-kind="scenarios" data-test="ticket-scenarios" class="space-y-3">
    <div data-nested-fields-target="container" class="space-y-3 [counter-reset:scenario]">
      <% ticket.scenarios.each_with_index do |scenario, i| %>
        <%= render "member/tickets/scenario_fields", index: i, scenario: scenario %>
      <% end %>
    </div>
    <template data-nested-fields-target="template"><%= render "member/tickets/scenario_fields", index: "NEW_RECORD", scenario: nil %></template>
    <button type="button" data-action="nested-fields#add" data-test="ticket-scenario-add" class="<%= add_class %>">
      <%= render Ui::IconComponent.new(name: "plus", class: "text-[10px]") %><%= t("member.tickets.form.scenario_add") %>
    </button>
  </div>
</section>
