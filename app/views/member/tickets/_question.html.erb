<%# locals: (ticket:, question:, can_manage:, return_tab: nil) %>
<%# CYRA-883 — an open question carries an amber line on its left edge. %>
<div class="px-4 py-4 <%= "shadow-[inset_3px_0_0_var(--color-amber-400)]" if question.open? %>" data-test="ticket-question-<%= question.id %>">
  <div class="flex items-start gap-3">
    <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-<%= question.origin_agent? ? "md bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400" : "full bg-teal-50 dark:bg-teal-500/15 text-teal-600 dark:text-teal-400 text-[11px] font-semibold" %>">
      <% if question.origin_agent? %>
        <%= render Ui::IconComponent.new(name: "bot", class: "text-[11px]") %>
      <% else %>
        <%= avatar_initials(question.author.name) %>
      <% end %>
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[12.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= question.author.name %></span>
        <% if question.origin_agent? %>
          <%= render Ui::BadgeComponent.new(label: t("member.tickets.questions.from_work"), color: :indigo, icon: "bot", size: :sm,
                test_id: "ticket-question-from-work") %>
        <% end %>
        <% if question.blocking && question.open? %>
          <%= render Ui::BadgeComponent.new(label: t("member.tickets.questions.blocking"), color: :amber, icon: "hand", size: :sm) %>
        <% end %>
        <% if question.audience_shared? %>
          <%= render Ui::BadgeComponent.new(label: t("member.tickets.questions.shared"), color: :sky, icon: "eye", size: :sm) %>
        <% end %>
        <% if question.closed_at? %>
          <%= render Ui::BadgeComponent.new(label: t("member.tickets.questions.withdrawn"), color: :gray, icon: "circle-x", size: :sm) %>
        <% end %>
        <span class="font-mono text-[10.5px] text-gray-500 dark:text-zinc-400"><%= question.created_at.strftime("%d/%m · %H:%M") %></span>
        <% if question.author_id == Current.account&.id || can_manage %>
          <%= button_to member_ticket_question_path(ticket, question), method: :delete, params: { confirm: 1 },
                class: "ml-auto inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-300 dark:text-zinc-600 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/15",
                data: { test: "ticket-question-delete-#{question.id}", turbo_confirm: t("member.tickets.questions.delete_confirm") } do %>
            <%= render Ui::IconComponent.new(name: "trash", class: "text-[11px]") %>
          <% end %>
        <% end %>
      </div>
      <%= render Ui::MarkdownComponent.new(text: question.body, class: "mt-1 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed font-medium") %>

      <% question.answers.each do |answer| %>
        <div class="mt-3 pl-3 border-l-2 border-stone-200 dark:border-zinc-800" data-test="ticket-answer-<%= answer.id %>">
          <div class="flex items-center gap-2">
            <span class="text-[12px] font-semibold text-zinc-900 dark:text-zinc-100"><%= answer.author.name %></span>
            <% if answer.covers_round %>
              <span class="font-mono uppercase text-[9px] tracking-[1px] text-gray-500 dark:text-zinc-400 border border-stone-200 dark:border-zinc-800 rounded px-1 py-0.5"><%= t("member.tickets.questions.covers_round") %></span>
            <% end %>
            <span class="font-mono text-[10.5px] text-gray-500 dark:text-zinc-400"><%= answer.created_at.strftime("%d/%m · %H:%M") %></span>
          </div>
          <%= render Ui::MarkdownComponent.new(text: answer.body, class: "mt-1 text-[13px] text-zinc-700 dark:text-zinc-300 leading-relaxed") %>
        </div>
      <% end %>

      <% if question.open? %>
        <%= render "member/tickets/question_answer_form", ticket: ticket, question: question, can_manage: can_manage, return_tab: return_tab %>
      <% end %>
    </div>
  </div>
</div>
