<%# locals: ticket, timeline, comments_count, visible_ticket_ids, can_manage %>
<%# Timeline unificata: commenti (bolle) + eventi di sistema (righe), fusi per created_at. %>
<%# CYRA-883 — no title (the tab carries the count). A comments-only filter, done with a radio and CSS
    so it needs no JavaScript; system events in a row fold into one line. %>
<div class="group/timeline rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-ticket-comments">
  <% if timeline.any? %>
    <div class="px-4 pt-3 pb-1 flex items-center gap-1" role="radiogroup" aria-label="<%= t("member.tickets.comments.filter_label") %>"
         data-test="member-ticket-timeline-filter">
      <% [ [ "all", true ], [ "only-comments", false ] ].each do |key, checked| %>
        <label class="cursor-pointer">
          <input type="radio" name="timeline-filter" id="timeline-<%= key %>" class="peer sr-only" <%= "checked" if checked %>>
          <span class="inline-flex items-center h-6 px-2.5 rounded-md border border-stone-200 dark:border-zinc-800 text-[11.5px] text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 peer-checked:bg-zinc-900 dark:peer-checked:bg-zinc-100 peer-checked:border-zinc-900 dark:peer-checked:border-zinc-100 peer-checked:text-white dark:peer-checked:text-zinc-900 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-500 dark:peer-focus-visible:ring-indigo-400"><%= t("member.tickets.comments.filter.#{key.underscore}") %></span>
        </label>
      <% end %>
    </div>
  <% end %>

  <%# Container stabile = target degli append realtime (commenti via AddComment, eventi via
      RecordActivity). Esiste SEMPRE (anche a timeline vuota) così l'append ha sempre un bersaglio. %>
  <div id="ticket_timeline_<%= ticket.id %>" data-test="member-ticket-timeline">
    <% timeline.chunk_while { |left, right| left[1] == :event && right[1] == :event }.each do |run| %>
      <% if run.first[1] == :comment %>
        <%= render "member/tickets/comment", comment: run.first[2], ticket: ticket, can_manage: can_manage %>
      <% elsif run.size == 1 %>
        <%= render "member/tickets/event", event: run.first[2], ticket: ticket, visible_ticket_ids: visible_ticket_ids, compact: true %>
      <% else %>
        <%= render "member/tickets/event_group", events: run.map(&:last), ticket: ticket, visible_ticket_ids: visible_ticket_ids %>
      <% end %>
    <% end %>
  </div>
  <% if timeline.empty? %>
    <%= render Ui::EmptyNoteComponent.new(text: t("member.tickets.comments.empty"), inset: true, test_id: "member-ticket-comments-empty") %>
  <% end %>

  <%= render "member/tickets/comment_form", ticket: ticket %>
</div>
