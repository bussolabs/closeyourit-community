<%# locals: ticket, can_manage
    Pannello dell'eleggibilità agenti (CYRA-184): the verdict and its reason live in _agent_eligibility,
    the broadcast target (Ticketing::SetAgentEligibility), title included. The switch stays OUTSIDE that
    target: it is per-viewer, and a broadcast (which does not know who is looking) would wipe it.
    Who works the ticket is a two-way choice, not a destructive action: no red. %>
<section class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden" data-test="ticket-agent-eligibility-panel">
  <%= render "member/tickets/agent_eligibility", ticket: ticket %>
  <% if can_manage %>
    <div class="px-4 py-2.5 border-t border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800/40 flex flex-wrap items-center justify-between gap-2">
      <span class="text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.tickets.agent_eligibility.switch.label") %></span>
      <%= render Ui::ButtonGroupComponent.new(class: "border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900", role: "group",
            aria: { label: t("member.tickets.agent_eligibility.switch.label") }, test_id: "agent-eligibility-switch") do |group| %>
        <% allowed = ticket.agent_eligibility_allowed? %>
        <% blocked = ticket.agent_eligibility_blocked? %>
        <%# The chosen side is a plain pressed button with no action; the other one sends the change. %>
        <% if allowed %>
          <% group.with_button(label: t("member.tickets.agent_eligibility.switch.agents"), variant: :tinted, size: :sm, aria: { pressed: "true" }) %>
        <% else %>
          <% group.with_button(label: t("member.tickets.agent_eligibility.switch.agents"), href: member_ticket_eligibility_path(ticket),
               method: :patch, params: { eligibility: "allowed" }, confirm: t("member.tickets.agent_eligibility.actions.allow_confirm"),
               variant: :ghost, size: :sm, aria: { pressed: "false" }, test_id: "agent-eligibility-allow") %>
        <% end %>
        <% if blocked %>
          <% group.with_button(label: t("member.tickets.agent_eligibility.switch.person"), variant: :tinted, size: :sm, aria: { pressed: "true" }) %>
        <% else %>
          <% group.with_button(label: t("member.tickets.agent_eligibility.switch.person"), href: member_ticket_eligibility_path(ticket),
               method: :patch, params: { eligibility: "blocked" }, variant: :ghost, size: :sm, aria: { pressed: "false" },
               test_id: "agent-eligibility-block") %>
        <% end %>
      <% end %>
    </div>
    <% if ticket.agent_eligibility_source_human? %>
      <div class="px-4 py-2 border-t border-stone-200 dark:border-zinc-800 flex justify-end">
        <%= render Ui::ButtonComponent.new(label: t("member.tickets.agent_eligibility.actions.reset"), href: member_ticket_eligibility_path(ticket),
              method: :patch, params: { eligibility: "auto" }, variant: :ghost, size: :sm, icon: "rotate-ccw",
              test_id: "agent-eligibility-reset") %>
      </div>
    <% end %>
  <% end %>
</section>
