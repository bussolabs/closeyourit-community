<%# locals: ticket
    Display read-only dell'assegnatario (avatar + nome, oppure "non assegnato"). È il target del
    broadcast realtime (replace) quando l'assegnazione cambia: viewer-agnostico (niente dropdown di
    gestione, che è per-viewer e lo riottiene chi gestisce col proprio redirect). id stabile =
    contratto write↔read-side. Riusato anche nel ramo non-manager della show. %>
<div id="<%= dom_id(ticket) %>_assignee" data-test="member-ticket-assignee-display">
  <% if ticket.assignee %>
    <div class="inline-flex items-center gap-2 text-[12.5px] text-zinc-900 dark:text-zinc-100"><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 text-[10px] font-semibold"><%= avatar_initials(ticket.assignee.name) %></span><%= ticket.assignee.name %></div>
  <% else %>
    <span class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.tickets.show.unassigned") %></span>
  <% end %>
</div>
