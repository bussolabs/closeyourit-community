<%# locals: (ticket:, previews:) %>
<%# CYRA-1163 — the image comes from our own route, never from the other site: no request leaves the reader's browser. %>
<ul class="mt-3 grid gap-2 sm:grid-cols-2" aria-label="<%= t("member.tickets.link_previews.label") %>" data-test="ticket-link-previews">
  <% previews.each do |preview| %>
    <li>
      <%= link_to preview.url, target: "_blank", rel: "noopener noreferrer nofollow",
            class: "flex items-stretch gap-3 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-indigo-300 dark:hover:border-indigo-500/60 overflow-hidden",
            data: { test: "ticket-link-preview" } do %>
        <% if preview.image.attached? %>
          <%= image_tag image_member_ticket_link_preview_path(ticket, preview), alt: "", loading: "lazy",
                class: "w-24 shrink-0 object-cover bg-stone-100 dark:bg-zinc-800", data: { test: "ticket-link-preview-image" } %>
        <% end %>
        <span class="min-w-0 py-2 pr-3 <%= preview.image.attached? ? "" : "pl-3" %> flex flex-col gap-0.5">
          <span class="text-[11.5px] text-zinc-500 dark:text-zinc-400 truncate" data-test="ticket-link-preview-site"><%= preview.site_name %></span>
          <span class="text-[13px] font-medium text-zinc-900 dark:text-zinc-100 line-clamp-2" data-test="ticket-link-preview-title"><%= preview.title %></span>
          <% if preview.description.present? %>
            <span class="text-[12px] text-zinc-600 dark:text-zinc-400 line-clamp-2"><%= preview.description %></span>
          <% end %>
        </span>
      <% end %>
    </li>
  <% end %>
</ul>
