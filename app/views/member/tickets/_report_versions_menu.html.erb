<%# locals: (report:, reports:, ticket:) %>
<%# CYRA-883 — earlier versions in a menu next to the version being read. Fixed-positioned by
    ui--row-menu, like the row menus, so no panel around it clips it. %>
<details class="relative" data-controller="ui--row-menu" data-action="toggle->ui--row-menu#onToggle" data-test="ticket-report-versions-menu">
  <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 h-6 px-2 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 font-mono text-[11.5px] text-zinc-900 dark:text-zinc-100 hover:bg-stone-50 dark:hover:bg-zinc-800"
           data-ui--row-menu-target="trigger" aria-haspopup="menu">
    <%= t("member.tickets.show.report_version", version: report.version) %>
    <%= render Ui::IconComponent.new(name: "chevron-down", class: "text-[9px] text-gray-400 dark:text-zinc-500") %>
  </summary>
  <div data-ui--row-menu-target="panel" class="absolute left-0 top-8 z-30 w-60 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1" data-test="ticket-report-versions">
    <p class="px-3 py-1 font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.tickets.show.report_versions") %></p>
    <% reports.drop(1).each do |version| %>
      <%= link_to member_ticket_report_version_path(ticket, version.version), class: Ui::RowMenuComponent.item_class(:default),
            data: { test: "ticket-report-version-link" } do %>
        <span data-test="ticket-report-version"><%= t("member.tickets.show.report_version", version: version.version) %></span>
        <% if version.source_review_rejection? %>
          <span class="inline-flex items-center rounded-md bg-red-50 dark:bg-red-500/15 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.5px] text-red-600 dark:text-red-400"
                data-test="ticket-report-version-rejection"><%= t("member.tickets.show.report_rejection") %></span>
        <% end %>
        <span class="ml-auto truncate text-gray-500 dark:text-zinc-400"><%= version.author_name.presence || t("member.tickets.show.report_unknown_author") %></span>
      <% end %>
    <% end %>
  </div>
</details>
