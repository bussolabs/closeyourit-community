<%# locals: (can_manage:) %>
<%# CYRA-883 — the links between tickets in one section: prerequisites, linked tickets, an epic's
    children. Each part keeps its own rule for when it appears; the section appears if one does. %>
<% epic = @ticket.kind_epic? %>
<% show_dependencies = @dependencies.any? || can_manage %>
<% if epic || show_dependencies || @links.any? %>
  <%= render Ui::SectionComponent.new(title: t("member.tickets.connections.title"), body_class: "divide-y divide-stone-100 dark:divide-zinc-800",
        test_id: "ticket-connections") do %>
    <%= render "member/tickets/dependencies", ticket: @ticket, dependencies: @dependencies, candidates: @dependency_candidates, visible_blocker_ids: @visible_blocker_ids, can_manage: can_manage %>
    <%= render "member/tickets/links", ticket: @ticket, links: @links, visible_linked_ticket_ids: @visible_linked_ticket_ids, can_manage: can_manage %>
    <%= render "member/tickets/children", ticket: @ticket, children: @children %>
  <% end %>
<% end %>
