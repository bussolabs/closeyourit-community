<%# CYRA-883 — where the problem comes from and what is already known: origin error, logs linked by
    hand, related knowledge. Empty linked logs are left out. With neither origin nor linked logs,
    related knowledge keeps its own card, which hides itself when nothing is related (CYRA-391). %>
<% knowledge_url = knowledge_member_ticket_path(@ticket) %>
<% if @ticket.error_group || @ticket.metric_group || @linked_log_entries.any? %>
  <%= render Ui::SectionComponent.new(title: t("member.tickets.context.title"), body_class: "divide-y divide-stone-100 dark:divide-zinc-800",
        test_id: "ticket-context") do %>
    <%= render "member/tickets/error_origin", ticket: @ticket %>
    <%= render "member/tickets/performance_origin", ticket: @ticket %>
    <% if @linked_log_entries.any? %>
      <%= render "member/shared/linked_log_entries", entries: @linked_log_entries, framed: false %>
    <% end %>
    <%= render "member/shared/knowledge_related", url: knowledge_url, framed: false %>
  <% end %>
<% else %>
  <%= render "member/shared/knowledge_related", url: knowledge_url %>
<% end %>
