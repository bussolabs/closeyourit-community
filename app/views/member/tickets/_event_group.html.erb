<%# locals: (events:, ticket:, visible_ticket_ids:) %>
<%# CYRA-883 — system events in a row, folded into one line that opens on click. %>
<details class="group group-has-[#timeline-only-comments:checked]/timeline:hidden" data-test="member-ticket-event-group">
  <summary class="list-none cursor-pointer pl-[60px] pr-4 py-1.5 flex items-center gap-2 text-[11.5px] text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 [&::-webkit-details-marker]:hidden">
    <%= render Ui::IconComponent.new(name: "chevron-right", class: "text-[9px] motion-safe:transition-transform group-open:rotate-90") %>
    <%= t("member.tickets.comments.event_group", count: events.size) %>
    <span class="font-mono text-[10.5px] text-gray-400 dark:text-zinc-500" title="<%= events.last.created_at.strftime("%d/%m · %H:%M") %>"><%= card_time(events.last.created_at) %></span>
  </summary>
  <% events.each do |event| %>
    <%= render "member/tickets/event", event:, ticket:, visible_ticket_ids:, compact: true %>
  <% end %>
</details>
