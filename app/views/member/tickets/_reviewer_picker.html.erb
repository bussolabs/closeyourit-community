<%# locals: (can_manage:) %>
<div class="mt-1">
  <% if can_manage %>
    <details class="relative inline-block" id="<%= dom_id(@ticket) %>_reviewer" data-test="ticket-reviewer">
      <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 text-[12.5px] text-zinc-900 dark:text-zinc-100">
        <% if @ticket.reviewer %><span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 text-[9px] font-semibold"><%= avatar_initials(@ticket.reviewer.name) %></span><span class="font-medium"><%= @ticket.reviewer.name %></span><% else %><span class="text-gray-500 dark:text-zinc-400"><%= t("member.tickets.show.no_reviewer") %></span><% end %><%= render Ui::IconComponent.new(name: "chevron-down", class: "text-[9px] text-gray-400 dark:text-zinc-500") %>
      </summary>
      <div class="absolute left-0 top-7 z-10 w-52 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1">
        <% @assignees.each do |a| %>
          <%= button_to reviewer_member_ticket_path(@ticket, reviewer_id: a.id), method: :patch, class: "w-full text-left flex items-center gap-2 px-3 h-8 text-[12.5px] hover:bg-stone-50 dark:hover:bg-zinc-800", data: { test: "ticket-reviewer-#{a.id}" } do %>
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 text-[9px] font-semibold"><%= avatar_initials(a.name) %></span><%= a.name %>
          <% end %>
        <% end %>
        <div class="my-1 border-t border-stone-200 dark:border-zinc-800"></div>
        <%= button_to reviewer_member_ticket_path(@ticket, reviewer_id: ""), method: :patch, class: "w-full text-left flex items-center gap-2 px-3 h-8 text-[12.5px] text-gray-500 dark:text-zinc-400 hover:bg-stone-50 dark:hover:bg-zinc-800", data: { test: "ticket-remove-reviewer" } do %>
          <%= render Ui::IconComponent.new(name: "user-x", class: "text-[11px] text-gray-400 dark:text-zinc-500") %><%= t("member.tickets.show.no_reviewer") %>
        <% end %>
      </div>
    </details>
  <% else %>
    <%= render "member/tickets/reviewer", ticket: @ticket %>
  <% end %>
</div>
