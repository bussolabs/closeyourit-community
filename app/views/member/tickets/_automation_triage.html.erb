<%# locals: (ticket:, triage:) %>
<%# The assessment laid out: what to do first (an answer), then area, risk and skills, then the
    machine's reasons as a list, in the machine's own words and language. %>
<% if triage[:clarification] %>
  <div class="flex items-start gap-2.5 rounded-md border border-amber-200 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-500/10 px-3 py-2"
       data-test="automation-triage-clarification">
    <%= render Ui::IconComponent.new(name: "circle-question-mark", class: "mt-0.5 text-[12px] text-amber-600 dark:text-amber-400") %>
    <p class="min-w-0 flex-1 text-[12.5px] text-zinc-800 dark:text-zinc-200">
      <strong class="text-amber-700 dark:text-amber-300"><%= t("member.tickets.automation.steps.state.needs_clarification").upcase_first %>.</strong>
      <%= t("member.tickets.automation.steps.state_hint.needs_clarification") %>
    </p>
    <%= link_to member_ticket_path(ticket, tab: "questions"), class: "shrink-0 text-[12px] font-semibold text-indigo-600 dark:text-indigo-400 hover:underline underline-offset-2" do %>
      <%= t("member.tickets.automation.steps.triage.answer") %> →
    <% end %>
  </div>
<% end %>

<% facts = [ [ "area", triage[:area] ], [ "risk", triage[:risk] ], [ "capabilities", triage[:capabilities].presence ] ] %>
<% if facts.any? { |_key, value| value.present? } %>
  <dl class="grid grid-cols-1 sm:grid-cols-3 rounded-md border border-stone-200 dark:border-zinc-800 divide-y sm:divide-y-0 sm:divide-x divide-stone-200 dark:divide-zinc-800"
      data-test="automation-triage-facts">
    <% facts.each do |key, value| %>
      <div class="min-w-0 px-3 py-2 space-y-1">
        <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-400 dark:text-zinc-500"><%= t("member.tickets.automation.steps.triage.#{key}") %></dt>
        <dd class="m-0 flex flex-wrap items-center gap-1.5 text-[12.5px] text-zinc-900 dark:text-zinc-100">
          <% if value.blank? %>
            <span class="text-gray-400 dark:text-zinc-500">—</span>
          <% elsif key == "capabilities" %>
            <% value.each do |capability| %><%= render Ui::BadgeComponent.new(label: capability, color: :gray, size: :sm) %><% end %>
          <% elsif key == "risk" %>
            <%= render Ui::BadgeComponent.new(label: value, color: :gray, size: :sm) %>
            <% if triage[:human_approval] %>
              <%= render Ui::BadgeComponent.new(label: t("member.tickets.automation.steps.human_approval"), color: :amber, size: :sm) %>
            <% end %>
          <% else %>
            <%= value %>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
<% end %>

<% if triage[:reasons].any? %>
  <div class="space-y-1">
    <p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-400 dark:text-zinc-500"><%= t("member.tickets.automation.steps.triage.reasons") %></p>
    <ul class="list-disc pl-4 space-y-0.5 text-[12.5px] text-zinc-700 dark:text-zinc-300" data-test="automation-triage-reasons">
      <% triage[:reasons].each do |reason| %><li><%= reason %></li><% end %>
    </ul>
  </div>
<% end %>
