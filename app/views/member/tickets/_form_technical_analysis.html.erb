<%# locals: (ticket:) %>
<%# Bersaglio proprio invece della quota del tetto (CYRA-263): l'80% sarebbe 1.200 su
    1.500, un avviso che arriva a testo già scritto. %>
<div data-controller="char-counter"
     data-char-counter-max-value="<%= ::Ticketing::Constants::TECHNICAL_ANALYSIS_MAX_CHARS %>"
     data-char-counter-warn-at-value="<%= ::Ticketing::Constants::TECHNICAL_ANALYSIS_TARGET_CHARS %>"
     data-char-counter-unit-value="<%= t("shared.char_counter.unit") %>">
  <div class="flex items-center gap-1 mb-1.5">
    <label for="technical_analysis" class="text-[12px] font-medium text-zinc-900 dark:text-zinc-100"><%= t("member.tickets.form.technical_analysis") %></label>
    <%= render Ui::TooltipComponent.new(text: t("member.tickets.form.technical_analysis_hint"), test_id: "help-technical-analysis") %>
  </div>
  <textarea name="technical_analysis" id="technical_analysis" rows="3" data-test="ticket-technical-analysis"
            data-char-counter-target="field" data-action="input->char-counter#update"
            placeholder="<%= t("member.tickets.form.technical_analysis_placeholder", default: "") %>"
            class="w-full px-3 py-2 rounded-md border <%= @errors&.dig(:technical_analysis)&.any? ? 'border-red-400 focus:border-red-500 focus-visible:ring-red-500' : 'border-stone-200 dark:border-zinc-800 focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400' %> bg-white dark:bg-zinc-900 text-[13px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus-visible:ring-2"><%= ticket.technical_analysis %></textarea>
  <p class="mt-1.5 text-right font-mono text-[11px] text-gray-500 dark:text-zinc-400 tabular-nums"
     data-char-counter-target="output" data-test="ticket-technical-analysis-counter"></p>
  <% if @errors&.dig(:technical_analysis)&.any? %>
    <p class="mt-1 text-[11px] text-red-600 dark:text-red-400" data-test="ticket-technical-analysis-error"><%= @errors.dig(:technical_analysis).first %></p>
  <% end %>
</div>
