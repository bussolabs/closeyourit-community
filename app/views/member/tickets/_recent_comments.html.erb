<%# locals: (comments:) %>
<%= render Ui::SectionComponent.new(title: t("member.tickets.recent_comments.title"), heading_size: :md, header_layout: :row,
      body_class: "divide-y divide-stone-100 dark:divide-zinc-800", test_id: "ticket-recent-comments") do |section| %>
  <% section.with_actions do %>
    <%= link_to t("member.tickets.recent_comments.view_all"), member_ticket_path(@ticket, tab: "discussion"),
          class: "ml-auto text-[11.5px] font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300", data: { test: "ticket-recent-comments-all" } %>
  <% end %>
  <% comments.each do |comment| %>
    <div class="px-4 py-2.5" data-test="ticket-recent-comment">
      <p class="text-[12px] text-gray-500 dark:text-zinc-400"><span class="font-semibold text-zinc-900 dark:text-zinc-100"><%= comment.author&.name %></span> · <%= t("member.tickets.recent_comments.ago", time: time_ago_in_words(comment.created_at)) %></p>
      <%= render Ui::MarkdownComponent.new(text: comment.body, class: "mt-0.5 text-[13px] text-zinc-700 dark:text-zinc-300 leading-relaxed") %>
    </div>
  <% end %>
<% end %>
