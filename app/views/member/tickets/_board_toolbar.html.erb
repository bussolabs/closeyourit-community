<%# Toolbar filtri board: GET full-page verso member_tickets_path (no results_frame → compatibile %>
<%# con realtime + drag&drop, che si re-inizializzano al reload). Filtri = quelli della list %>
<%# senza status (è l'asse colonne); condividono le stesse chiavi param (SavedView non incluso). %>
<%# K9 — the bar is the toolbar of the board panel (framed), not a bar on the page ground. %>
    <%= render(Ui::TableToolbarComponent.new(framed: true,
          url: member_tickets_path, query: params[:q],
          search_placeholder: t("member.tickets.search_placeholder"),
          apply_label: t("member.tickets.apply"),
            search_test_id: "board-search", apply_test_id: "board-filter", test_id: "board-toolbar",
            view_sections: ticket_view_sections("board"))) do |toolbar| %>
      <% toolbar.with_filter(key: "kind", label: t("member.tickets.filter_kind")) do %>
        <div class="w-36"><%= render Ui::SelectComponent.new(name: "kind", multiple: true, summary: true, options: Ticketing::Ticket.kinds.keys.map { |k| [ t("member.tickets.kind.#{k}"), k ] }, selected: params[:kind], placeholder: t("member.tickets.filter_kind"), test_id: "filter-kind") %></div>
      <% end %>
      <% toolbar.with_filter(key: "project_id", label: t("member.tickets.filter_project")) do %>
        <div class="w-40"><%= render Ui::SelectComponent.new(name: "project_id", multiple: true, summary: true, options: @projects.map { |project| [ project.name, project.id ] }, selected: params[:project_id], placeholder: t("member.tickets.filter_project"), test_id: "filter-project") %></div>
      <% end %>
    <%# CYRA-866 — un Gruppo porta con sé tutti i suoi progetti. %>
    <% if ticket_filter_groups.any? %>
      <% toolbar.with_filter(key: "group_id", label: t("member.tickets.filter_group")) do %>
        <div class="w-40"><%= render Ui::SelectComponent.new(name: "group_id", multiple: true, summary: true, options: ticket_filter_groups.map { |group| [ group.name, group.id ] }, selected: params[:group_id], placeholder: t("member.tickets.filter_group"), test_id: "filter-group") %></div>
      <% end %>
    <% end %>
      <% toolbar.with_filter(key: "priority_id", label: t("member.tickets.filter_priority")) do %>
        <div class="w-36"><%= render Ui::SelectComponent.new(name: "priority_id", multiple: true, summary: true, options: @priorities.map { |priority| [ priority.display_label, priority.id, priority.color ] }, selected: params[:priority_id], placeholder: t("member.tickets.filter_priority"), test_id: "filter-priority") %></div>
      <% end %>
      <% toolbar.with_filter(key: "assignee_id", label: t("member.tickets.filter_assignee")) do %>
        <div class="w-40"><%= render Ui::SelectComponent.new(name: "assignee_id", multiple: true, summary: true, options: @assignees.map { |assignee| [ assignee.name, assignee.id ] }, selected: params[:assignee_id], placeholder: t("member.tickets.filter_assignee"), test_id: "filter-assignee") %></div>
      <% end %>
      <%# CYRA-374 — chi deve revisionare, come sulla lista. %>
      <% toolbar.with_filter(key: "reviewer_id", label: t("member.tickets.filter_reviewer")) do %>
        <div class="w-40"><%= render Ui::SelectComponent.new(name: "reviewer_id", multiple: true, summary: true, options: @reviewers.map { |reviewer| [ reviewer.name, reviewer.id ] }, selected: params[:reviewer_id], placeholder: t("member.tickets.filter_reviewer"), test_id: "filter-reviewer") %></div>
      <% end %>
      <%# Il gate agenti serve anche qui: il `where` è già in apply_ticket_filters, condiviso con la
          lista. Lo STATO invece resta fuori: le colonne della board SONO gli stati. %>
      <% toolbar.with_filter(key: "agent_eligibility", label: t("member.tickets.filter_agent_eligibility")) do %>
        <div class="w-44"><%= render Ui::SelectComponent.new(name: "agent_eligibility", multiple: true, summary: true, options: Ticketing::Ticket.agent_eligibilities.keys.map { |value| [ t("member.tickets.agent_eligibility.#{value}"), value ] }, selected: params[:agent_eligibility], placeholder: t("member.tickets.filter_agent_eligibility"), test_id: "filter-agent-eligibility") %></div>
      <% end %>
    <% end %>
