<%# La sintesi in testa alla scheda Automazione (CYRA-384). La scheda apriva su decine di tentativi
    quasi identici e su un testo lungo, a volte in inglese: chi doveva approvare o rifiutare non
    trovava mai la riga che dice cosa è successo, perché il lavoro si è fermato e cosa serve da lui.

    Le tre righe nascono da campi strutturati (Member::AutomationSummary), mai da euristiche sul testo
    libero della macchina — una sintesi ricavata a naso può dire il falso proprio dove si decide.

    La decisione sta QUI e in nessun altro posto: i pulsanti del piano sono saliti dalla scheda del
    piano a questa card. Sono approva e rifiuta soltanto (decisione del cliente, 2026-08-17): un
    bottone che cambia significato riga per riga si preme per sbaglio. Le altre uscite — riprova,
    ferma la lavorazione — restano dove sono già, col loro peso. %>
<%# CYRA-883 — same shape as the decision card on the home: the passages first, then one line with who
    decides and where it runs, then the three rows. No title: it opens the tab. %>
<section class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="automation-summary">
  <div class="px-4 pt-3.5 flex items-start justify-between gap-3 flex-wrap">
    <%= render "member/home/approvals/phase_strip", card: automation_pipeline_source(workflow) %>
    <%# CYRA-877 — a step being redone by itself is still work in progress, not «Bloccato». %>
    <%= render Ui::BadgeComponent.new(label: summary.retrying? ? t("member.tickets.automation.stage.in_progress") : automation_phase_label(workflow.phase), color: :indigo) %>
  </div>
  <%= render "member/tickets/automation_summary_strip", attempts:, cto: %>

  <dl class="px-4 py-3.5 space-y-2.5">
    <% [ [ "done", summary.done, "circle-check" ],
         [ "stopped", summary.stopped, "circle-pause" ],
         [ "needs", summary.needs, "pointer" ] ].each do |key, line, icon| %>
      <div class="grid grid-cols-[112px_1fr] gap-x-3 items-baseline">
        <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.tickets.automation.summary.#{key}.label") %></dt>
        <dd class="flex items-start gap-2 text-[13px] text-zinc-800 dark:text-zinc-200 leading-relaxed" data-test="automation-summary-<%= key %>">
          <%= render Ui::IconComponent.new(name: icon, class: "text-gray-400 dark:text-zinc-500 text-[11px] mt-1") %>
          <span><%= line %></span>
        </dd>
      </div>
    <% end %>
  </dl>

  <%# La frase che spiega la sigla dello stato (CYRA-384): «Lavorazione ferma» dice come si chiama lo
      stato, non cosa comporta né chi si deve muovere. Nessuna riga dove la fase non ha una frase:
      meglio niente che il nome della fase ripetuto come se fosse una spiegazione. %>
  <% if (phase_hint = summary.retrying? ? t("member.tickets.automation.summary.retrying_hint") : automation_phase_hint(workflow.phase)) %>
    <p class="px-4 pb-3.5 -mt-0.5 text-[11.5px] text-gray-500 dark:text-zinc-400 leading-relaxed" data-test="automation-phase-hint">
      <%= phase_hint %>
    </p>
  <% end %>

  <% if summary.decision == :plan %>
    <div class="px-4 py-3.5 border-t border-stone-200 dark:border-zinc-800 flex flex-wrap items-center gap-2">
      <%= render Ui::ButtonComponent.new(label: t("member.tickets.automation.plan.approve"),
            href: member_ticket_automation_approval_path(ticket), method: :post,
            variant: :primary, size: :sm, icon: "check", test_id: "automation-approve") %>
      <%# basis + grow, non flex-1: sotto i 280px il gruppo va a capo invece di schiacciare il campo
          a una scheggia illeggibile. %>
      <%= form_with url: member_ticket_automation_change_request_path(ticket), method: :post,
            class: "flex items-center gap-2 grow basis-[280px]" do %>
        <input name="reason" required placeholder="<%= t("member.tickets.automation.plan.change_reason") %>"
               class="min-w-0 flex-1 h-[34px] rounded-md border border-stone-200 dark:border-zinc-800 px-3 text-[12.5px] placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-400">
        <%= render Ui::ButtonComponent.new(label: t("member.tickets.automation.plan.request_changes"), type: "submit",
              variant: :secondary_muted, size: :sm, test_id: "automation-change-request") %>
      <% end %>
    </div>
  <% end %>
</section>
