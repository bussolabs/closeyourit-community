<%# locals: (requests:) %>
<%# CYRA-941 — the help desk requests behind this ticket: how many people wrote, one click to each. %>
<% if requests.any? %>
  <%= render Ui::SectionComponent.new(title: t("member.helpdesk.on_ticket", count: requests.size),
        body_class: "divide-y divide-stone-100 dark:divide-zinc-800", test_id: "ticket-helpdesk-requests") do %>
    <% requests.each do |request| %>
      <%= link_to member_helpdesk_request_path(request), class: "flex items-center justify-between gap-3 px-4 py-2.5 text-[12.5px] text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400", data: { test: "ticket-helpdesk-request" } do %>
        <span class="truncate"><%= request.summary %></span>
        <span class="shrink-0 font-mono text-[11.5px] text-gray-500 dark:text-zinc-400"><%= l(request.created_at.to_date, format: :day_month) %></span>
      <% end %>
    <% end %>
  <% end %>
<% end %>
