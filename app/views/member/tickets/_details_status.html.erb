<%# locals: (can_manage:) %>
<%# The sentence that explained each status left the panel: the ticket lifecycle guide keeps it. %>
<div class="mt-1">
  <% if can_manage %>
    <details class="relative inline-block" id="<%= dom_id(@ticket) %>_status" data-test="ticket-status">
      <summary class="list-none cursor-pointer inline-flex items-center gap-1.5">
        <span data-test="ticket-status-badge"><%= render Ui::BadgeComponent.new(label: @ticket.status.display_label, color: @ticket.status.color, dot: true) %></span><%= render Ui::IconComponent.new(name: "chevron-down", class: "text-[9px] text-gray-400 dark:text-zinc-500") %>
      </summary>
      <div class="absolute right-0 top-7 z-10 w-52 text-left rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1">
        <% @statuses.each do |s| %>
          <%= button_to status_member_ticket_path(@ticket, status_id: s.id, inline: 1), method: :patch, class: "w-full text-left flex items-center gap-2 px-3 h-8 text-[12.5px] hover:bg-stone-50 dark:hover:bg-zinc-800", data: { test: "ticket-status-#{s.id}" } do %>
            <%= render Ui::BadgeComponent.new(label: s.display_label, color: s.color, dot: true) %>
          <% end %>
        <% end %>
      </div>
    </details>
  <% else %>
    <%= render "member/tickets/status_badge", ticket: @ticket %>
  <% end %>
</div>
