<%# locals: comment, ticket, can_manage %>
<%# CYRA-385 — attore automatico (agente/host = service account): avatar robot indigo (forma e colore
    diversi dall'umano) + etichetta "Automazione"; niente chip di ruolo umano (reporter/assignee). %>
<% automated = comment.automated? %>
<% role = automated ? nil : (comment.author_id == ticket.reporter_id ? "reporter" : (comment.author_id == ticket.assignee_id ? "assignee" : nil)) %>
<%# The avatar sits on the discussion's timeline line (its centre is the line), the text in a box. %>
<div id="<%= dom_id(comment) %>" class="relative px-4 py-3 flex gap-3" data-test="member-ticket-comment-<%= comment.id %>">
  <% if automated %>
    <span class="relative shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-md ring-4 ring-white dark:ring-zinc-900 bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400" data-test="member-ticket-comment-automation-<%= comment.id %>" aria-label="<%= t("member.tickets.comments.automation") %>">
      <%= render Ui::IconComponent.new(name: "bot", class: "text-[11px]") %>
    </span>
  <% else %>
    <span class="relative shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-full ring-4 ring-white dark:ring-zinc-900 bg-teal-50 dark:bg-teal-500/15 text-teal-600 dark:text-teal-400 text-[11px] font-semibold"><%= avatar_initials(comment.author.name) %></span>
  <% end %>
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2 min-h-8">
      <span class="text-[12.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= comment.author.name %></span>
      <% if automated %>
        <%= render Ui::BadgeComponent.new(label: t("member.tickets.comments.automation"), color: :indigo, icon: "bot", size: :sm) %>
      <% elsif role %>
        <span class="font-mono uppercase text-[9px] tracking-[1px] text-gray-500 dark:text-zinc-400 border border-stone-200 dark:border-zinc-800 rounded px-1 py-0.5"><%= t("member.tickets.comments.role.#{role}") %></span>
      <% end %>
      <%# The exact time on the right (the day separator above gives the date), the relative one on hover. %>
      <span class="ml-auto font-mono text-[10.5px] text-gray-500 dark:text-zinc-400" title="<%= card_time(comment.created_at) %>"
            data-test="member-ticket-comment-time"><%= comment.created_at.strftime("%H:%M") %></span>
      <%# Current.account&.id: il delete è per-viewer e in un render via broadcast (append realtime)
          Current è nil → nessun pulsante (viewer-agnostico); l'autore lo riottiene col redirect. %>
      <% if comment.author_id == Current.account&.id || can_manage %>
        <%= button_to member_ticket_comment_path(ticket, comment), method: :delete, params: { confirm: 1 }, class: "inline-flex items-center justify-center w-7 h-7 rounded-md text-gray-300 dark:text-zinc-600 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/15", data: { test: "member-ticket-comment-delete-#{comment.id}", turbo_confirm: t("member.tickets.comments.delete_confirm") } do %>
          <%= render Ui::IconComponent.new(name: "trash", class: "text-[11px]") %>
        <% end %>
      <% end %>
    </div>
    <%# Il commento lo scrivono anche gli agenti, in markdown (CYRA-261). %>
    <%= render Ui::MarkdownComponent.new(text: comment.body, class: "mt-1 rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800/50 px-3 py-2 text-[13px] text-zinc-700 dark:text-zinc-300 leading-relaxed") %>
    <% if comment.files.attached? %>
      <div class="mt-2 flex flex-wrap gap-2">
        <% comment.files.each do |file| %>
          <% image = file.content_type.to_s.start_with?("image/") %>
          <% video = file.content_type.to_s.start_with?("video/") %>
          <%= link_to rails_blob_path(file, disposition: (image || video ? :inline : :attachment)), target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 pl-2 pr-2.5 h-7 rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 hover:bg-stone-100 dark:hover:bg-zinc-800 text-[11.5px] text-zinc-700 dark:text-zinc-300" do %>
            <%= render Ui::IconComponent.new(name: image ? "image" : (video ? "video" : "file-text"), class: "text-[11px] text-gray-400 dark:text-zinc-500") %><%= file.filename %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
