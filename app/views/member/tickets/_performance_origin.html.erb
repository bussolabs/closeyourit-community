<%# locals: (ticket:) %>
<%# The slow operation linked to this ticket, next to the origin error: same shape. %>
<% if ticket.metric_group %>
  <div data-test="ticket-performance-origin">
    <div class="px-4 pt-3 pb-1"><h3 class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.tickets.show.origin_performance") %></h3></div>
    <div class="px-4 pb-3">
      <%= link_to member_monitoring_metric_group_path(ticket.metric_group), class: "inline-flex items-center gap-1.5 text-[12.5px] text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300", data: { test: "ticket-performance-origin-link" } do %>
        <%= render Ui::IconComponent.new(name: "gauge", class: "text-[10px] text-orange-500") %><%= ticket.metric_group.title.truncate(120) %>
      <% end %>
    </div>
  </div>
<% end %>
