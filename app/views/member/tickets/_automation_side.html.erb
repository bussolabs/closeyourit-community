<%# locals: (ticket:, workflow:, summary:, attempts:, questions:, can_manage:) %>
<%# The Automation tab's fixed column: what holds for the whole workflow, whichever step tab is open on
    the left. The summary first, then the open questions, then the workflow-wide actions. %>
<% cto = ticket.project.effective_cto %>
<% decides = cto.present? && cto == Current.account %>
<%= render "member/tickets/automation_summary", ticket:, workflow:, summary:, attempts:, cto: %>

<% if questions.any? %>
  <%= render Ui::SectionComponent.new(title: t("member.tickets.questions.open_title"), body_class: "", test_id: "automation-questions-panel") do %>
    <div class="divide-y divide-stone-200 dark:divide-zinc-800" data-test="automation-questions">
      <% questions.each do |question| %>
        <%= render "member/tickets/question", ticket:, question:, can_manage:, return_tab: "automation" %>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= render "member/tickets/automation_actions", ticket:, workflow:, decides:, can_manage: %>
