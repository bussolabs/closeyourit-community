<%# locals: (can_manage:) %>
<%# CYRA-399 — lo stesso titolo su altri progetti: quasi sempre è un guasto solo, visto da più
    applicazioni. Si dice, con i ticket accanto, invece di lasciarlo scoprire per caso. %>
<% if @same_incident.present? %>
  <%= render Ui::AlertComponent.new(variant: :warning,
        title: t("member.tickets.same_incident.title", count: @same_incident.size),
        test_id: "ticket-same-incident") do %>
    <span><%= t("member.tickets.same_incident.body") %></span>
    <span class="inline-flex items-center flex-wrap gap-2 mt-1.5">
      <% @same_incident.each do |other| %>
        <%= link_to member_ticket_path(other), class: "inline-flex items-center gap-1.5 h-[24px] px-2 rounded-md border border-amber-300 dark:border-amber-500/50 bg-white dark:bg-zinc-900 text-[11.5px] text-amber-900 dark:text-amber-200 hover:bg-amber-50 dark:hover:bg-amber-500/15", data: { test: "ticket-same-incident-link" } do %>
          <span class="font-mono"><%= other.code %></span><span class="text-amber-700 dark:text-amber-300"><%= other.project.name %></span>
        <% end %>
      <% end %>
    </span>
  <% end %>
<% end %>

<%# Descrizione libera: corpo primario, mostrata se presente (bug da testo semplice + story/task/epic). %>
<% if @ticket.description.present? %>
  <%= render Ui::SectionComponent.new(title: t("member.tickets.form.description"), heading_size: :md,
        body_class: "px-4 py-3.5", test_id: "ticket-body") do %>
    <%= render Ui::MarkdownComponent.new(text: @ticket.description,
          class: "text-[13px] text-zinc-700 dark:text-zinc-300 leading-relaxed", test_id: "ticket-description") %>
  <% end %>
<% end %>

<%# BDD scenarios, written like in the form: one block each, number and title on top, the four
    clauses as rows split by hairlines. Expected is the wanted outcome, Then what happens today: the
    tint tells them apart. Empty clauses are skipped. %>
<% if @ticket.scenarios.any? %>
  <%= render Ui::SectionComponent.new(title: t("member.tickets.show.scenarios"), heading_size: :md,
        body_class: "space-y-3 px-4 py-3.5", test_id: "ticket-scenarios") do %>
    <% @ticket.scenarios.each_with_index do |scenario, i| %>
      <div class="overflow-hidden rounded-md border border-stone-200 dark:border-zinc-800" data-test="ticket-scenario">
        <p class="flex items-baseline gap-2.5 border-b border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 px-3 py-2">
          <span class="font-mono text-[11px] tabular-nums text-gray-400 dark:text-zinc-500" data-test="ticket-scenario-number"><%= i + 1 %></span>
          <span class="text-[13px] font-medium text-zinc-900 dark:text-zinc-100"><%= scenario.title.presence || t("member.tickets.show.scenario_n", n: i + 1) %></span>
        </p>
        <dl class="divide-y divide-stone-200 dark:divide-zinc-800">
          <% [ %w[given step_given], %w[when step_when], %w[then step_then], %w[expected step_expected] ].each do |key, field| %>
            <% next if scenario.public_send(field).blank? %>
            <% expected = key == "expected" %>
            <div class="grid grid-cols-[92px_minmax(0,1fr)] items-baseline px-3 py-2 <%= "bg-indigo-50 dark:bg-indigo-500/15" if expected %>" data-test="ticket-scenario-step-<%= key %>">
              <dt class="font-mono uppercase text-[9.5px] tracking-[1.2px] <%= expected ? "text-indigo-600 dark:text-indigo-400" : "text-gray-500 dark:text-zinc-400" %>"><%= t("member.tickets.show.steps.#{key}") %></dt>
              <dd class="text-[13px] leading-relaxed text-zinc-700 dark:text-zinc-300"><%= render Ui::MarkdownComponent.new(text: scenario.public_send(field), inline: true) %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  <% end %>
<% end %>

<%# Definition of Done — checklist testuale, mostrata se presente. %>
<% if @ticket.conditions.any? %>
  <%= render Ui::SectionComponent.new(title: t("member.tickets.show.conditions"), heading_size: :md,
        body_class: nil, test_id: "ticket-conditions") do %>
    <ul class="px-4 py-3.5 space-y-2">
      <% @ticket.conditions.each do |condition| %>
        <li class="flex items-start gap-2 text-[13px] text-zinc-700 dark:text-zinc-300" data-test="ticket-condition">
          <%# CYRA-627 — era una spunta VERDE, disegnata su ogni criterio di ogni ticket, sempre: un
              semaforo verde attaccato a un filo staccato. Nessuno aveva verificato niente, e non
              esisteva nessun modo per verificarlo. Adesso è un punto neutro: non afferma niente,
              perché non c'è niente da affermare. Quello che il sistema ha guardato davvero sta
              nel verbale di consegna, più sotto. %>
          <span class="shrink-0 mt-0.5 text-gray-300 dark:text-zinc-600"><%= render Ui::IconComponent.new(name: "minus", class: "text-[11px]") %></span>
          <%= render Ui::MarkdownComponent.new(text: condition.text, inline: true, class: "leading-relaxed") %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%# Consigli (CYRA-264): quel che si è notato lavorando ma non riguarda questo ticket. Qui e non
    sepolto in fondo all'analisi, perché ogni riga è lavoro da aprire — e il link lo apre. %>
<% if @advice.any? %>
  <%= render Ui::SectionComponent.new(title: t("member.tickets.show.advice"), heading_size: :md,
        body_class: nil, test_id: "ticket-advice") do %>
    <ul class="divide-y divide-stone-200 dark:divide-zinc-800">
      <% @advice.each do |line| %>
        <li class="px-4 py-3 flex items-start justify-between gap-3" data-test="ticket-advice-line">
          <%= render Ui::MarkdownComponent.new(text: line, inline: true, class: "text-[13px] text-zinc-700 dark:text-zinc-300 leading-relaxed") %>
          <%# Precompila, non crea: scenari e DoD li mette chi apre il ticket, e una riga di
              consiglio non può contenerli. %>
          <%= render Ui::ButtonComponent.new(label: t("member.tickets.show.advice_create"), variant: :secondary_muted, size: :sm, class: "shrink-0",
                href: new_member_ticket_path(project_id: @ticket.project_id, title: line, description: line, source_ticket_id: @ticket.id),
                test_id: "ticket-advice-create") %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%# L'analisi tecnica non vive più qui (CYRA-259): in coda a descrizione, scenari e DoD faceva
    muro di testo, col markdown mostrato coi suoi simboli. Ora è la scheda "analysis". %>
<%= render "member/tickets/attachments", ticket: @ticket, can_manage: can_manage %>

<%# CYRA-883 — the last comments, so the conversation shows without opening its tab. %>
<% if @recent_comments.any? %>
  <%= render "member/tickets/recent_comments", comments: @recent_comments %>
<% end %>
