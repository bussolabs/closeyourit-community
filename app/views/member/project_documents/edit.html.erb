<% title = t("member.documents.form.title_edit") %>
<% content_for :title, title %>
<% breadcrumb = [ { label: t("member.projects.title"), href: member_projects_path },
                  { label: @project.name, href: member_project_path(@project) },
                  { label: t("member.documents.title"), href: member_project_documents_path(@project) },
                  { label: t("member.breadcrumb.edit") } ] %>

<div class="p-7">
  <%= form_with url: member_project_document_path(@project, @document), method: :patch, class: "space-y-6", data: { test: "document-form" } do %>
    <%= render Ui::PageHeaderComponent.new(title: title, breadcrumb: breadcrumb) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("member.documents.form.cancel"), href: member_project_documents_path(@project), variant: :secondary_muted, size: :sm) %>
        <%= render Ui::ButtonComponent.new(label: t("member.documents.form.save"), type: "submit", icon: "check", test_id: "document-submit", size: :sm) %>
      <% end %>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
          <%= render Ui::InputComponent.new(name: "title", label: t("member.documents.form.name"), required: true,
                value: @document.title, test_id: "document-title",
                error: @errors&.dig(:title)&.first) %>

          <%= render Ui::InputComponent.new(name: "tags", label: t("member.documents.form.tags"),
                value: @document.tags.join(", "), test_id: "document-tags",
                hint: t("member.documents.form.tags_hint"), placeholder: "legal, q3, spec") %>

          <div class="md:col-span-2" data-test="document-description">
            <label for="description" class="block text-[12px] font-medium text-zinc-900 dark:text-zinc-100 mb-1.5"><%= t("member.documents.form.description") %></label>
            <textarea name="description" id="description" rows="3"
                      class="w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 text-[13px] text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400"><%= @document.description %></textarea>
          </div>

          <div class="md:col-span-2 flex items-center gap-3 px-3 h-[44px] rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50/60 dark:bg-zinc-800/60" data-test="document-file-info">
            <%= render Ui::IconComponent.new(name: "file-text", class: "text-[15px] text-gray-400 dark:text-zinc-500") %>
            <span class="min-w-0 flex-1 font-mono text-[12px] text-zinc-700 dark:text-zinc-300 truncate"><%= @document.file.blob.filename %></span>
            <span class="font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= number_to_human_size(@document.file.blob.byte_size) %></span>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Audit: Created/Updated dall'activity-log + cronologia completa nel modale %>
  <div class="mt-6 rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-4 py-2.5" data-test="document-audit">
    <%= render Ui::AuditMetaComponent.new(
          created_at: @document.created_at,
          created_by: @document.created_by&.name,
          updated_at: (@last_activity&.created_at || @document.updated_at),
          updated_by: activity_actor_name(@last_activity),
          test_id: "document-audit-meta",
          data: { controller: "ui--dialog" }
        ) do |c| %>
      <% c.with_action do %>
        <button type="button" data-action="ui--dialog#open" data-test="document-history" class="inline-flex items-center gap-1.5 text-[12px] font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300">
          <%= render Ui::IconComponent.new(name: "history", class: "text-[11px]") %><%= t("ui.audit.view_history") %>
        </button>
        <%= render "member/shared/activity_modal", subtitle: @document.title, events: @activity_events %>
      <% end %>
    <% end %>
  </div>
</div>
