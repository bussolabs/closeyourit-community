<%# locals: project, document, can_manage %>
<%# blob (preloaded by with_attached_file), not document.file: Attached::One resolves the attachment at
    runtime, one query per row. %>
<% blob = document.file.blob %>
<% download_path = rails_blob_path(blob, disposition: :attachment) %>
<%= render Ui::TableComponent::RowComponent.new(test_id: "document-row-#{document.id}") do %>
  <%= render Ui::TableComponent::CellComponent.new(header: true) do %>
    <div class="flex items-start gap-2.5">
      <%= render Ui::IconComponent.new(name: document_type_icon(blob.content_type), class: "#{document_type_icon_color(blob.content_type)} w-4 shrink-0 mt-0.5 text-center text-[15px]", test_id: "document-icon-#{document.id}") %>
      <div class="min-w-0">
        <%= link_to document.title, download_path, title: t("member.documents.download"),
              class: "block truncate max-w-[26rem] text-[13px] font-semibold text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline",
              data: { test: "document-title-link-#{document.id}" } %>
        <p class="mt-0.5 font-mono text-[11px] text-gray-500 dark:text-zinc-400 truncate max-w-[26rem]" title="<%= blob.filename %>"><%= blob.filename %></p>
        <% if document.description.present? %>
          <p class="mt-1 text-[12px] text-gray-600 dark:text-zinc-400 line-clamp-2 max-w-[26rem]" data-test="document-description-<%= document.id %>"><%= document.description %></p>
        <% end %>
      </div>
    </div>
  <% end %>
  <%= render(Ui::TableComponent::CellComponent.new(label: t("member.documents.col_type"), class: "font-mono text-[11px] text-gray-500 dark:text-zinc-400")) { document_type_label(blob.content_type) } %>
  <%= render(Ui::TableComponent::CellComponent.new(label: t("member.documents.col_size"), mono: true, class: "text-gray-500 dark:text-zinc-400")) { number_to_human_size(blob.byte_size) } %>
  <%= render Ui::TableComponent::CellComponent.new(label: t("member.documents.col_tags")) do %>
    <% if document.tags.any? %>
      <span class="inline-flex items-center flex-wrap gap-1">
        <% document.tags.each do |tag| %>
          <%= link_to tag, member_project_documents_path(project, tag: [ tag ]),
                class: "inline-flex items-center px-1.5 h-5 rounded bg-stone-100 dark:bg-zinc-800 font-mono text-[10.5px] text-zinc-600 dark:text-zinc-400 whitespace-nowrap hover:bg-indigo-50 dark:hover:bg-indigo-500/15 hover:text-indigo-700 dark:hover:text-indigo-300",
                data: { test: "document-tag-#{document.id}-#{tag}" } %>
        <% end %>
      </span>
    <% else %>
      <span class="text-gray-400 dark:text-zinc-500">—</span>
    <% end %>
  <% end %>
  <%= render Ui::TableComponent::CellComponent.new(label: t("member.documents.col_uploaded")) do %>
    <p class="text-[12.5px] text-zinc-700 dark:text-zinc-300 truncate"><%= document.created_by&.name || "—" %></p>
    <p class="mt-0.5 font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= l(document.created_at.to_date, format: :day_month_year) %></p>
  <% end %>
  <%= render Ui::TableComponent::CellComponent.new(actions: true) do %>
    <% icon_link = "inline-flex items-center justify-center h-7 w-7 rounded-md text-gray-400 dark:text-zinc-500 hover:bg-stone-100 dark:hover:bg-zinc-800 hover:text-indigo-600 dark:hover:text-indigo-400" %>
    <% if document_viewable_inline?(blob.content_type) %>
      <%= link_to rails_blob_path(blob, disposition: :inline), target: "_blank", rel: "noopener", class: icon_link,
            title: t("member.documents.open_title"), "aria-label": t("member.documents.open_title"),
            data: { test: "document-open-#{document.id}" } do %>
        <%= render Ui::IconComponent.new(name: "arrow-up-right-from-square", class: "text-[12px]") %>
      <% end %>
    <% end %>
    <%= link_to download_path, class: icon_link, title: t("member.documents.download"), "aria-label": t("member.documents.download"),
          data: { test: "document-download-#{document.id}" } do %>
      <%= render Ui::IconComponent.new(name: "download", class: "text-[13px]") %>
    <% end %>
    <% if can_manage %>
      <%= render Ui::ConfirmDialogComponent.new(title: t("member.documents.delete_dialog.title", title: document.title),
            url: member_project_document_path(project, document), confirm_label: t("member.documents.delete"),
            test_id: "document-delete-dialog-#{document.id}") do |dialog| %>
        <% dialog.with_body { t("member.documents.delete_dialog.body") } %>
        <%= render Ui::RowMenuComponent.new(test_id: "document-menu-#{document.id}") do %>
          <%= link_to edit_member_project_document_path(project, document), class: Ui::RowMenuComponent.item_class, data: { test: "document-edit-#{document.id}" } do %><%= render Ui::IconComponent.new(name: "pen", class: "w-[1.25em] text-gray-400 dark:text-zinc-500 text-[12px]") %><%= t("member.documents.edit") %><% end %>
          <div class="my-1 border-t border-stone-200 dark:border-zinc-800"></div>
          <%= dialog.menu_trigger(label: t("member.documents.delete"), icon: "trash", test_id: "document-delete-#{document.id}") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
