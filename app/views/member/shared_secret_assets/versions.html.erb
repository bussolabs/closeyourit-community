<% content_for :title, t("member.secret_assets.versions") %>

<div class="p-7 space-y-6" data-test="shared-secret-asset-versions">
  <%= render Ui::PageHeaderComponent.new(
        title: "#{@asset.name} — #{t("member.secret_assets.versions")}",
        breadcrumb: [ { label: t("member.shared_secrets.title"), href: member_shared_secret_assets_path }, { label: @asset.name } ],
        test_id: "shared-secret-asset-versions-header") %>

  <ul class="divide-y rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <% @versions.each do |version| %>
      <li class="flex items-center gap-3 p-4" data-test="shared-secret-asset-version">
        <span class="font-mono text-xs">v<%= version.number %></span>
        <span class="text-sm text-zinc-900 dark:text-zinc-100"><%= version.original_filename %></span>
        <span class="ml-auto text-xs text-gray-500 dark:text-zinc-400"><%= l(version.created_at, format: :short) %></span>
        <% if can?("shared_secret_files.manage") %>
          <%= button_to t("member.secret_assets.rollback"), rollback_member_shared_secret_asset_path(@asset),
                params: { version: version.number }, method: :post, class: "text-xs font-semibold text-amber-700 dark:text-amber-300" %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
