<% content_for :title, @milestone.label %>
<% can_manage = can?("projects.edit", scope: @project) %>

<div class="p-7 space-y-6" data-test="member-milestone">
  <%= render "member/projects/overview_header", project: @project, stats: @stats, active_tab: "milestones" %>

  <div class="space-y-4">
    <%= link_to member_project_milestones_path(@project), class: "inline-flex items-center gap-1.5 text-[12px] font-medium text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100", data: { test: "milestone-back" } do %>
      <%= render Ui::IconComponent.new(name: "chevron-left", class: "text-[11px]") %><%= t("member.milestones.show.back") %>
    <% end %>

    <div class="flex items-start justify-between gap-4 flex-wrap" data-test="milestone-header">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="w-3 h-3 rounded-full <%= Ui::Colors.swatch(@milestone.color) %> shrink-0"></span>
        <h2 class="font-display text-[20px] font-semibold text-zinc-900 dark:text-zinc-100 truncate"><%= @milestone.label %></h2>
      </div>
      <% if can_manage %>
        <div class="flex items-center gap-2 shrink-0" data-test="milestone-actions">
          <%= render Ui::ButtonComponent.new(label: t("member.milestones.show.edit"), href: edit_member_project_milestone_path(@project, @milestone),
                icon: "pen", variant: :secondary_muted, size: :sm, test_id: "milestone-edit") %>
          <%= render Ui::RowMenuComponent.new(test_id: "milestone-more-menu", aria_label: t("member.milestones.show.more_menu")) do %>
            <%= button_to member_project_milestone_path(@project, @milestone), method: :delete,
                  form: { class: "block", data: { turbo_confirm: t("member.milestones.delete_confirm") } },
                  class: Ui::RowMenuComponent.item_class(:danger), data: { test: "milestone-delete" } do %>
              <%= render Ui::IconComponent.new(name: "trash", class: "w-[1.25em] text-[12px]") %><%= t("member.milestones.delete") %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render Ui::GridComponent.new(cols: 1, lg: 3, gap: 6) do %>
    <%= render Ui::StackComponent.new(gap: 6, class: "lg:col-span-2 min-w-0") do %>
      <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5" data-test="milestone-progress">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-1.5">
          <span class="inline-flex items-center gap-1.5">
            <span class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("member.milestones.show.completion") %></span>
            <%= render Ui::TooltipComponent.new(text: t("member.milestones.show.rollup_note"), placement: :bottom, test_id: "milestone-rollup-tip") %>
          </span>
          <span class="text-[12.5px] text-zinc-600 dark:text-zinc-400">
            <span class="font-mono font-semibold text-zinc-900 dark:text-zinc-100" data-test="milestone-percent"><%= @progress[:percent] %>%</span>
            <span class="text-gray-300 dark:text-zinc-600">·</span> <%= t("member.milestones.show.tickets_closed", done: @progress[:done_count], total: @progress[:total_count]) %>
            <span class="text-gray-300 dark:text-zinc-600">·</span> <%= t("member.milestones.show.points", done: @progress[:done_weight], total: @progress[:total_weight]) %>
          </span>
        </div>
        <div class="h-2.5 rounded-full bg-stone-200 dark:bg-zinc-700 overflow-hidden">
          <div class="h-full rounded-full bg-emerald-500" style="width: <%= @progress[:percent] %>%"></div>
        </div>
      </div>

      <%= render "member/project_milestones/tickets", tickets: @tickets, pagination: @tickets_pagination, closed_count: @progress[:done_count] %>
    <% end %>

    <%= render "member/project_milestones/details", milestone: @milestone, can_manage: can_manage %>
  <% end %>

  <%# The audit strip closes the page, full width (E22). %>
  <%= render Ui::SectionComponent.new(body_class: "px-4 py-2.5", test_id: "milestone-audit") do %>
    <%= render Ui::AuditMetaComponent.new(
          created_at: @milestone.created_at,
          created_by: @milestone.created_by&.name,
          updated_at: (@last_activity&.created_at || @milestone.updated_at),
          updated_by: activity_actor_name(@last_activity),
          test_id: "milestone-audit-meta",
          data: { controller: "ui--dialog" }
        ) do |c| %>
      <% c.with_action do %>
        <%= render Ui::ButtonComponent.new(label: t("ui.audit.view_history"), variant: :link, icon: "history",
              test_id: "milestone-history", data: { action: "ui--dialog#open" }) %>
        <%= render "member/shared/activity_modal", subtitle: @milestone.label, events: @activity_events %>
      <% end %>
    <% end %>
  <% end %>
</div>
