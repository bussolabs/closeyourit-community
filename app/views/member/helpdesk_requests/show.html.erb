<% content_for :title, @request_record.summary %>

<div class="p-7 space-y-6" data-test="member-helpdesk-request">
  <%= render Ui::PageHeaderComponent.new(
        title: @request_record.summary,
        breadcrumb: [ { label: t("member.helpdesk.title"), href: member_helpdesk_requests_path }, { label: @request_record.summary } ]) do |h| %>
    <% h.with_actions do %>
      <% if @request_record.status_discarded? %>
        <%= render Ui::ButtonComponent.new(label: t("member.helpdesk.restore"), href: member_helpdesk_request_discard_path(@request_record),
              method: :delete, variant: :secondary_muted, size: :sm, icon: "undo-2", test_id: "helpdesk-restore") %>
      <% elsif @request_record.open? %>
        <%= render Ui::ButtonComponent.new(label: t("member.helpdesk.discard"), href: member_helpdesk_request_discard_path(@request_record),
              method: :put, variant: :secondary_muted, size: :sm, icon: "archive", test_id: "helpdesk-discard") %>
        <%= render Ui::ButtonComponent.new(label: t("member.helpdesk.convert.action"), href: new_member_helpdesk_request_conversion_path(@request_record),
              size: :sm, icon: "ticket", test_id: "helpdesk-convert") %>
      <% end %>
      <% if @request_record.email.present? %>
        <%= render Ui::ConfirmDialogComponent.new(title: t("member.helpdesk.erase_dialog.title", email: @request_record.email),
              url: member_helpdesk_request_email_path(@request_record), confirm_label: t("member.helpdesk.erase_email"),
              test_id: "helpdesk-erase-dialog") do |dialog| %>
          <% dialog.with_body { t("member.helpdesk.erase_dialog.body") } %>
          <%= render Ui::RowMenuComponent.new(test_id: "helpdesk-menu", aria_label: t("member.helpdesk.more_menu")) do %>
            <%= dialog.menu_trigger(label: t("member.helpdesk.erase_email"), icon: "trash", test_id: "helpdesk-erase-email") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Ui::GridComponent.new(cols: 1, lg: 3, gap: 6) do %>
    <%= render Ui::StackComponent.new(gap: 6, class: "lg:col-span-2") do %>
      <%= render Ui::SectionComponent.new(title: t("member.helpdesk.messages"), body_class: "divide-y divide-stone-100 dark:divide-zinc-800",
            test_id: "helpdesk-messages") do %>
        <% @messages.each do |message| %>
          <div class="px-4 py-3" data-test="helpdesk-message">
            <p class="text-[11.5px] text-gray-500 dark:text-zinc-400">
              <%= message.direction_inbound? ? t("member.helpdesk.from_visitor") : message.author&.name %>
              · <span class="font-mono" title="<%= l(message.created_at, format: :long) %>"><%= l(message.created_at.to_date, format: :day_month) %></span>
            </p>
            <p class="mt-1 whitespace-pre-line text-[13px] text-zinc-900 dark:text-zinc-100"><%= message.body %></p>
          </div>
        <% end %>
      <% end %>

      <% unless @request_record.status_discarded? %>
        <%= render Ui::SectionComponent.new(title: t("member.helpdesk.reply.title"), body_class: "px-4 py-3", test_id: "helpdesk-reply") do %>
          <% if @request_record.email.present? %>
            <%= form_with url: member_helpdesk_request_reply_path(@request_record), method: :post, class: "space-y-2", data: { test: "helpdesk-reply-form" } do %>
              <label for="body" class="sr-only"><%= t("member.helpdesk.reply.title") %></label>
              <%= text_area_tag "body", nil, rows: 5, required: true, maxlength: Helpdesk::Constants::BODY_MAX_CHARS,
                    placeholder: t("member.helpdesk.reply.placeholder"), data: { test: "helpdesk-reply-body" },
                    class: "w-full px-3 py-2 rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-[13px] text-zinc-900 dark:text-zinc-100 leading-relaxed placeholder:text-gray-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-indigo-400" %>
              <div class="flex items-center justify-between gap-3">
                <p class="text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.helpdesk.reply.hint", email: @request_record.email) %></p>
                <%= render Ui::ButtonComponent.new(label: t("member.helpdesk.reply.submit"), type: "submit", size: :sm, icon: "send", test_id: "helpdesk-reply-submit") %>
              </div>
            <% end %>
          <% else %>
            <p class="text-[12.5px] text-gray-500 dark:text-zinc-400" data-test="helpdesk-reply-nobody"><%= t("member.helpdesk.reply.nobody") %></p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render Ui::StackComponent.new(gap: 6) do %>
      <% unless @request_record.status_discarded? %>
        <%= render Ui::SectionComponent.new(title: t("member.helpdesk.ticket.title"), body_class: "px-4 py-3 space-y-2", test_id: "helpdesk-ticket") do %>
          <% if @request_record.ticket %>
            <%= link_to member_ticket_path(@request_record.ticket), class: "flex min-w-0 items-center gap-1.5 text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400", data: { test: "helpdesk-ticket-link" } do %><span class="font-mono text-[11.5px] text-gray-500 dark:text-zinc-400"><%= @request_record.ticket.code %></span><span class="truncate"><%= @request_record.ticket.title %></span><% end %>
            <% if @request_record.status_linked? %>
              <%= render Ui::ButtonComponent.new(label: t("member.helpdesk.ticket.unlink"), href: member_helpdesk_request_ticket_link_path(@request_record),
                    method: :delete, variant: :secondary_muted, size: :sm, icon: "unlink", test_id: "helpdesk-unlink") %>
            <% end %>
          <% elsif @request_record.open? %>
            <%= form_with url: member_helpdesk_request_ticket_link_path(@request_record), method: :post, class: "space-y-2", data: { test: "helpdesk-link-form" } do %>
              <%= hidden_field_tag :helpdesk_project_id, @request_record.project_id, id: "helpdesk_project_id" %>
              <%= render Ui::SelectComponent.new(name: "ticket_id", aria_label: t("member.helpdesk.ticket.select"),
                    options: @linkable_tickets.map { |ticket| [ "#{ticket.code} · #{ticket.title}", ticket.id ] },
                    include_blank: true, placeholder: t("member.helpdesk.ticket.select"), required: true, test_id: "helpdesk-link-ticket",
                    remote: { url: linkable_member_tickets_path, scope_field: "#helpdesk_project_id", scope_param: "project_id" }) %>
              <%= render Ui::ButtonComponent.new(label: t("member.helpdesk.ticket.link_submit"), type: "submit", variant: :secondary_muted, size: :sm, icon: "link", test_id: "helpdesk-link-submit") %>
              <p class="text-[11.5px] text-gray-500 dark:text-zinc-400"><%= t("member.helpdesk.ticket.hint") %></p>
            <% end %>
          <% else %>
            <p class="text-[12.5px] text-gray-500 dark:text-zinc-400" data-test="helpdesk-ticket-gone"><%= t("member.helpdesk.ticket.gone") %></p>
          <% end %>
        <% end %>
      <% end %>
      <% if @similar.any? %>
        <%= render Ui::SectionComponent.new(title: t("member.helpdesk.similar.title", count: @similar.size),
              body_class: "divide-y divide-stone-100 dark:divide-zinc-800", test_id: "helpdesk-similar") do %>
          <% @similar.each do |other| %>
            <div class="px-4 py-2.5 space-y-1.5" data-test="helpdesk-similar-row">
              <%= link_to other.summary, member_helpdesk_request_path(other),
                    class: "block truncate text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400" %>
              <div class="flex items-center justify-between gap-2">
                <%= render Ui::BadgeComponent.new(label: t("member.helpdesk.status.#{other.status}"), color: helpdesk_status_color(other.status), dot: true) %>
                <% if @request_record.ticket && other.open? %>
                  <%= form_with url: member_helpdesk_request_ticket_link_path(other), method: :post do %>
                    <%= hidden_field_tag :ticket_id, @request_record.ticket_id, id: nil %>
                    <%= hidden_field_tag :back_to, @request_record.id, id: nil %>
                    <%= render Ui::ButtonComponent.new(label: t("member.helpdesk.similar.link_same"), type: "submit", variant: :secondary_muted, size: :sm, icon: "link", test_id: "helpdesk-similar-link") %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
      <% if @visit_errors.any? %>
        <%= render Ui::SectionComponent.new(title: t("member.helpdesk.visit_errors.title"), body_class: "divide-y divide-stone-100 dark:divide-zinc-800",
              test_id: "helpdesk-visit-errors") do %>
          <% @visit_errors.each do |group| %>
            <%= link_to group.title, member_monitoring_error_group_path(group),
                  class: "block truncate px-4 py-2.5 text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400",
                  data: { test: "helpdesk-visit-error" } %>
          <% end %>
        <% end %>
      <% end %>
      <%= render Ui::DetailsComponent.new(title: t("member.helpdesk.details"), test_id: "helpdesk-details") do |details| %>
        <% details.with_row(label: t("member.helpdesk.col_status"), test_id: "helpdesk-status") do %>
          <%= render Ui::BadgeComponent.new(label: t("member.helpdesk.status.#{@request_record.status}"),
                color: helpdesk_status_color(@request_record.status), dot: true) %>
        <% end %>
        <% details.with_row(label: t("member.helpdesk.col_project")) do %>
          <%= link_to @request_record.project.name, member_project_path(@request_record.project),
                class: "truncate text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400" %>
        <% end %>
        <% details.with_row(label: t("member.helpdesk.email"), test_id: "helpdesk-email",
              value: (@request_record.email.presence || (@request_record.email_erased? ? t("member.helpdesk.email_erased_value") : nil))) %>
        <% details.with_row(label: t("member.helpdesk.page"), value: @request_record.page_url, test_id: "helpdesk-page") %>
        <% details.with_row(label: t("member.helpdesk.browser"),
              value: [ @request_record.browser, @request_record.os ].compact_blank.join(" · ").presence, test_id: "helpdesk-browser") %>
        <% details.with_row(label: t("member.helpdesk.col_received"), value: l(@request_record.created_at, format: :long)) %>
      <% end %>
    <% end %>
  <% end %>
</div>
