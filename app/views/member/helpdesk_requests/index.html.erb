<% content_for :title, t("member.helpdesk.title") %>

<div class="p-7 space-y-6" data-test="member-helpdesk">
  <%= render Ui::PageHeaderComponent.new(
        title: t("member.helpdesk.title"),
        subtitle: t("member.helpdesk.subtitle"),
        breadcrumb: [ { label: t("member.helpdesk.title") } ],
        counts_test_id: "helpdesk-counts") do |h| %>
    <% h.with_counts do %>
      <%= render Ui::StatLabelComponent.new(label: t("member.helpdesk.counts.received"), value: @status_counts.fetch("received", 0),
            value_color: :indigo, test_id: "helpdesk-count-received") %>
      <%= render Ui::StatLabelComponent.new(label: t("member.helpdesk.counts.discarded"), value: @status_counts.fetch("discarded", 0),
            href: member_helpdesk_requests_path(status: [ "discarded" ]), active: params[:status] == [ "discarded" ],
            test_id: "helpdesk-count-discarded") %>
    <% end %>
  <% end %>

  <% if @status_counts.empty? %>
    <%= render Ui::EmptyStateComponent.new(title: t("member.helpdesk.empty"), body: t("member.helpdesk.empty_body"),
          example: t("member.helpdesk.empty_example"), icon: "inbox", framed: true, test_id: "helpdesk-empty") %>
  <% else %>
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="helpdesk-table">
      <%= render(Ui::TableToolbarComponent.new(framed: true,
            url: member_helpdesk_requests_path, query: params[:q],
            search_placeholder: t("member.helpdesk.search_placeholder"),
            search_test_id: "helpdesk-search", apply_test_id: "helpdesk-filter", test_id: "helpdesk-toolbar")) do |toolbar| %>
        <% toolbar.with_filter(key: "status", label: t("member.helpdesk.filter_status")) do %>
          <div class="w-36"><%= render Ui::SelectComponent.new(name: "status", multiple: true, summary: true,
            options: Helpdesk::Request.statuses.keys.map { |status| [ t("member.helpdesk.status.#{status}"), status ] },
            selected: params[:status], placeholder: t("member.helpdesk.filter_status"), test_id: "helpdesk-filter-status") %></div>
        <% end %>
        <% toolbar.with_filter(key: "project_id", label: t("member.helpdesk.filter_project")) do %>
          <div class="w-40"><%= render Ui::SelectComponent.new(name: "project_id", multiple: true, summary: true,
            options: @projects.map { |project| [ project.name, project.id, project.color ] },
            selected: params[:project_id], placeholder: t("member.helpdesk.filter_project"), test_id: "helpdesk-filter-project") %></div>
        <% end %>
      <% end %>
      <% if @requests.empty? %>
        <%= render Ui::NoResultsComponent.new(query: params[:q].presence, reset_href: member_helpdesk_requests_path,
              body: (@filtering ? t("member.helpdesk.no_results_body", count: @status_counts.values.sum) : t("member.helpdesk.inbox_clear")),
              icon: "inbox", test_id: "helpdesk-no-results", reset_test_id: "helpdesk-reset") %>
      <% else %>
        <%= render(Ui::TableComponent.new(stacked: true, label: t("member.helpdesk.title"))) do |table| %>
          <% table.with_head do %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.helpdesk.col_request"), sort: "request") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.helpdesk.col_project"), sort: "project") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.helpdesk.col_status"), sort: "status", classes: "w-28") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("member.helpdesk.col_received"), sort: "received",
                  initial: :desc, align: :right, classes: "w-28") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("ui.table.open_column"), label_hidden: true) %>
          <% end %>
          <%= render partial: "member/helpdesk_requests/row", collection: @requests, as: :helpdesk_request %>
        <% end %>
        <%= render Ui::PaginationComponent.new(pagination: @pagination, test_id: "helpdesk-pagination") %>
      <% end %>
    </div>
  <% end %>
</div>
