<%# locals: () %>
<nav data-test="member-bottom-nav" aria-label="<%= t("member.nav.bottom_bar") %>"
     class="fixed inset-x-0 bottom-0 z-30 flex h-[calc(4rem+env(safe-area-inset-bottom))] items-start justify-between border-t border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-2 pb-[env(safe-area-inset-bottom)] md:static md:ml-auto md:h-[34px] md:w-auto md:items-center md:justify-end md:border-0 md:bg-transparent dark:md:bg-transparent md:p-0 md:z-auto">
  <% if current_organization %>
    <% on_quick_add = controller_path == "member/quick_add" %>
    <% on_todos = controller_path.start_with?("member/todo_lists") %>
    <% on_chat = controller_path.start_with?("member/chat") %>
    <%= link_to member_todo_lists_path,
          class: "order-1 flex h-16 flex-1 flex-col items-center justify-center gap-1 text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 md:order-3 md:-ml-px md:h-[34px] md:min-w-[34px] md:flex-none md:flex-row md:gap-0 md:px-2 md:rounded-none md:border md:border-stone-200 dark:md:border-zinc-800 md:bg-white dark:md:bg-zinc-900 md:hover:bg-stone-50 dark:md:hover:bg-zinc-800 #{'text-indigo-600 dark:text-indigo-400 md:bg-stone-100 dark:md:bg-zinc-800 md:text-zinc-900 dark:md:text-zinc-100' if on_todos}",
          title: t("member.nav.todos"), "aria-label": t("member.nav.todos"), data: { test: "member-nav-todos" } do %>
      <%= render Ui::IconComponent.new(name: "list-check", class: "text-lg md:text-[14px]") %>
      <span class="text-[10px] font-medium md:hidden"><%= t("member.nav.lists") %></span>
      <% todos_open = todos_open_count %>
      <%= render "shared/notification_counter", count: todos_open, label: t("member.nav.todos_open", count: todos_open), test_id: "member-nav-todos-badge" %>
    <% end %>

    <%= turbo_stream_from "alerting:notifications:#{Current.account.id}", class: "hidden" %>
    <%# CYRA-898 — the bell opens the latest five; the frame loads only when the panel opens. %>
    <details class="order-2 relative flex flex-1 md:order-5 md:-ml-px md:flex-none" data-controller="ui--dismissable" data-test="notification-bell-menu">
      <summary class="list-none cursor-pointer relative flex h-16 w-full flex-col items-center justify-center gap-1 text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 md:h-[34px] md:min-w-[34px] md:flex-row md:gap-0 md:rounded-r-md md:border md:border-l md:border-stone-200 dark:md:border-zinc-800 md:bg-white dark:md:bg-zinc-900 md:px-2 md:hover:bg-stone-50 dark:md:hover:bg-zinc-800"
               title="<%= t("member.nav.alerts") %>" aria-label="<%= t("member.nav.alerts") %>" data-test="notification-bell">
        <%= render Ui::IconComponent.new(name: "bell", class: "text-lg md:text-[14px]") %>
        <span class="text-[10px] font-medium md:hidden"><%= t("member.nav.bottom_notifications") %></span>
        <%= render "member/alerting_notifications/badge", count: unread_alerts_count %>
      </summary>
      <div class="absolute right-0 bottom-full z-50 mb-2 w-80 max-w-[calc(100vw-1rem)] overflow-hidden rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-left md:bottom-auto md:top-10 md:mb-0"
           data-test="notifications-preview-panel">
        <%= turbo_frame_tag "notifications_preview", src: preview_member_alerting_notifications_path, loading: :lazy do %>
          <p class="px-3 py-4 text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.alerting.notifications.preview_loading") %></p>
        <% end %>
      </div>
    </details>

    <%= link_to member_quick_add_path,
          class: "order-3 flex h-16 flex-1 items-center justify-center md:order-1 md:mr-2.5 md:h-[34px] md:flex-none md:gap-2 md:rounded-md md:bg-indigo-600 md:px-3.5 md:text-[12.5px] md:font-medium md:text-white md:hover:bg-indigo-700 #{'md:bg-indigo-700' if on_quick_add}",
          title: t("member.quick_add.nav_button"), "aria-label": t("member.quick_add.nav_button"),
          data: { test: "member-nav-quick-add" } do %>
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-indigo-600 text-white md:h-auto md:w-auto md:bg-transparent">
        <%= render Ui::IconComponent.new(name: "plus", class: "text-xl md:text-[12px]") %>
      </span>
      <span class="hidden @min-[810px]:inline"><%= t("member.quick_add.nav_button") %></span>
    <% end %>

    <%= link_to member_chat_conversations_path,
          class: "order-4 relative flex h-16 flex-1 flex-col items-center justify-center gap-1 text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 md:order-4 md:-ml-px md:h-[34px] md:min-w-[34px] md:flex-none md:flex-row md:gap-0 md:rounded-none md:border md:border-l md:border-stone-200 dark:md:border-zinc-800 md:bg-white dark:md:bg-zinc-900 md:px-2 md:hover:bg-stone-50 dark:md:hover:bg-zinc-800 #{'text-indigo-600 dark:text-indigo-400 md:bg-stone-100 dark:md:bg-zinc-800 md:text-zinc-900 dark:md:text-zinc-100' if on_chat}",
          title: t("member.nav.chat"), "aria-label": t("member.nav.chat"), data: { test: "member-nav-chat" } do %>
      <%= render Ui::IconComponent.new(name: "messages-square", class: "text-lg md:text-[14px]") %>
      <span class="text-[10px] font-medium md:hidden"><%= t("member.nav.chat") %></span>
      <% chat_unread = chat_unread_count %>
      <%= render "shared/notification_counter", count: chat_unread, label: t("member.nav.chat_unread", count: chat_unread), test_id: "member-nav-chat-badge" %>
    <% end %>
  <% end %>

  <button type="button" data-ui--mobile-nav-target="toggle" data-action="ui--mobile-nav#toggle"
          data-test="member-nav-toggle" aria-controls="member-sidebar" aria-expanded="false"
          aria-label="<%= t('member.nav.toggle') %>"
          class="order-5 flex h-16 flex-1 flex-col items-center justify-center gap-1 text-gray-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 md:hidden">
    <%= render Ui::IconComponent.new(name: "menu", class: "text-lg") %>
    <span class="text-[10px] font-medium"><%= t("member.nav.menu") %></span>
  </button>

  <% if current_organization %>
    <button type="button"
            class="order-6 hidden h-[34px] w-[34px] items-center justify-center gap-2 @min-[980px]:w-[200px] @min-[980px]:justify-start @min-[980px]:px-2.5 rounded-l-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-gray-500 dark:text-zinc-400 hover:bg-stone-50 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-600 md:order-2 md:inline-flex"
            title="<%= t('member.search.open') %>" aria-label="<%= t('member.search.open') %>"
            aria-haspopup="dialog" aria-controls="member-global-search" aria-expanded="false"
            data-ui--global-search-target="trigger" data-action="ui--global-search#open"
            data-test="global-search-trigger-desktop">
      <%= render Ui::IconComponent.new(name: "search", class: "text-[14px]") %>
      <%# CYRA-898 — on wide screens it reads as a field and tells the shortcut that already works. %>
      <span class="hidden text-[12.5px] text-gray-400 dark:text-zinc-500 @min-[980px]:inline" data-test="global-search-trigger-label"><%= t("member.search.trigger") %></span>
      <kbd class="ml-auto hidden rounded border border-stone-200 dark:border-zinc-800 px-1 font-mono text-[10.5px] text-gray-500 dark:text-zinc-400 @min-[980px]:inline"><%= t("member.search.shortcut") %></kbd>
    </button>
  <% end %>
</nav>
