<div class="contents" data-controller="ui--dialog">
  <%# F24: the standard modal shell; the form wraps header and panel so Save in the header submits it. %>
  <%= render Ui::ModalComponent.new(title: t("member.coworkers.edit_puck", name: puck.name), padded: false, test_id: "coworkers-edit-dialog",
        form: { url: member_coworker_path(puck), method: :patch, data: { test: "coworkers-edit-form" } },
        id: "coworker-edit-#{puck.id}", aria: { label: t("member.coworkers.edit_puck", name: puck.name) },
        data: { "ui--dialog-target": "dialog", action: "click->ui--dialog#backdrop" }) do |modal| %>
    <% modal.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.coworkers.cancel"), variant: :secondary_muted, size: :sm, class: "max-md:min-h-11", data: { action: "ui--dialog#close" }) %>
      <%# Enable once the update endpoint accepts name and instructions as well as memory. %>
      <%= render Ui::ButtonComponent.new(label: t("member.coworkers.save_puck"), type: "submit", icon: "check", disabled: true, size: :sm, class: "max-md:min-h-11", test_id: "coworkers-save-puck") %>
    <% end %>
    <%= hidden_field_tag "puck[lock_version]", puck.lock_version, id: "coworker-edit-lock-#{puck.id}" %>
    <div class="grid grid-cols-1 gap-5 p-4 md:grid-cols-2 md:p-5">
      <p class="text-[13px] text-amber-800 dark:text-amber-300 md:col-span-2"><%= t("member.coworkers.edit_pending") %></p>
      <div class="md:col-span-2"><%= render "member/coworkers/mascot_picker", puck: puck %></div>
      <%= render Ui::InputComponent.new(name: "puck[name]", id: "coworker-edit-name-#{puck.id}", label: t("member.coworkers.name"), value: puck.name, required: true, maxlength: 80, autocomplete: "off", test_id: "coworkers-edit-name") %>
      <%= render Ui::InputComponent.new(name: "puck[instructions]", id: "coworker-edit-instructions-#{puck.id}", type: "textarea", label: t("member.coworkers.instructions"), value: puck.instructions, required: true, maxlength: 8000, rows: 5, wrapper_class: "md:col-span-2", test_id: "coworkers-edit-instructions") %>
      <%= render Ui::InputComponent.new(name: "puck[memory]", id: "coworker-edit-memory-#{puck.id}", type: "textarea", label: t("member.coworkers.memory"), value: puck.memory, maxlength: 8000, rows: 5, hint: t("member.coworkers.memory_hint"), wrapper_class: "md:col-span-2", test_id: "coworkers-edit-memory") %>
    </div>
  <% end %>
</div>
