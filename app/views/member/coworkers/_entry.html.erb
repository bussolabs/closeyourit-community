<%= render Ui::ButtonComponent.new(href: member_coworkers_path, variant: :secondary, test_id: "coworkers-entry", aria: { label: "Coworkers" }, title: "Coworkers", class: "shrink-0 max-md:min-h-11 max-md:min-w-11 max-md:px-2!", data: { controller: "coworker-mascot-cycle", action: "visibilitychange@document->coworker-mascot-cycle#schedule" }) do %>
