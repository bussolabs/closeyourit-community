<div class="contents" data-controller="ui--dialog" data-ui--dialog-open-value="<%= params[:new].present? || @puck.nil? %>">
  <%# F24: the standard modal shell; the form wraps header and panel so Create in the header submits it.
      Wide size: the presets browser sits beside the form (CYRA-992). %>
  <%= render Ui::ModalComponent.new(title: t("member.coworkers.new_puck"), size: :lg, padded: false, test_id: "coworkers-new-dialog",
        form: { url: member_coworkers_path, data: { test: "coworkers-new-form" } },
        id: "coworker-new", aria: { label: t("member.coworkers.new_puck") },
        data: { "ui--dialog-target": "dialog", controller: "coworker-presets",
                "coworker-presets-base-path-value": member_coworkers_path,
                "coworker-presets-storage-prefix-value": "coworkers:mascot:#{current_organization.id}:#{Current.account.id}",
                "coworker-presets-pucks-value": @puckies.map { |puck| { id: puck.id, name: puck.name } }.to_json,
                "coworker-presets-used-by-value": t("member.coworkers.mascot.used_by"),
                action: "click->ui--dialog#backdrop turbo:submit-end->coworker-presets#created" }) do |modal| %>
    <% modal.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.coworkers.cancel"), variant: :secondary_muted, size: :sm, class: "max-md:min-h-11", data: { action: "ui--dialog#close" }) %>
      <%= render Ui::ButtonComponent.new(label: t("member.coworkers.create"), type: "submit", icon: "check", size: :sm, test_id: "coworkers-create", class: "max-md:min-h-11") %>
    <% end %>
    <div class="grid grid-cols-1 md:grid-cols-5">
      <fieldset class="grid min-w-0 content-start grid-cols-1 gap-5 p-4 md:col-span-3 md:grid-cols-2 md:p-5" data-test="coworkers-preset-form">
        <div class="md:col-span-2">
          <h3 class="text-[14px] font-semibold"><%= t("member.coworkers.presets.customize") %></h3>
          <%= render Ui::ButtonComponent.new(label: t("member.coworkers.presets.title"), variant: :secondary, class: "mt-3 min-h-11 md:hidden", data: { action: "coworker-presets#browse" }) %>
        </div>
        <%= render "member/coworkers/preset_mascot" %>
        <%= render Ui::InputComponent.new(name: "puck[name]", id: "coworker-new-name", label: t("member.coworkers.name"), required: true, maxlength: 80, autocomplete: "off", autofocus: true, wrapper_class: "md:col-span-2", test_id: "coworkers-name", data: { coworker_presets_target: "name" }) %>
        <%= render Ui::InputComponent.new(name: "puck[instructions]", id: "coworker-new-instructions", type: "textarea", label: t("member.coworkers.instructions"), required: true, maxlength: 8000, rows: 10, hint: t("member.coworkers.presets.hint"), wrapper_class: "md:col-span-2", test_id: "coworkers-instructions", data: { coworker_presets_target: "instructions" }) %>
        <p class="text-[12px] text-gray-500 dark:text-zinc-400 md:col-span-2"><%= t("member.coworkers.local") %></p>
      </fieldset>
      <%= render "member/coworkers/presets" %>
    </div>
  <% end %>
</div>
