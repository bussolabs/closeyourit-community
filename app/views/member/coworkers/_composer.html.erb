<%= form_with url: member_coworker_runs_path(puck), class: "shrink-0 border-t border-stone-200 px-4 py-2.5 dark:border-zinc-800", data: { controller: "chat-compose coworker-composer", action: "resize@window->coworker-composer#grow", test: "coworkers-composer" } do %>
  <%= hidden_field_tag :kind, "chat" %>
  <div class="flex items-start gap-2">
    <% dictation = dictation_available? %>
    <%= tag.div class: "relative min-w-0 flex-1", data: (dictation ? dictation_voice_data : {}) do %>
      <%= render Ui::InputComponent.new(name: "input", id: "coworkers-message", type: "textarea", rows: 1, required: true, maxlength: 8000,
            placeholder: t("member.coworkers.message_placeholder"), aria: { label: t("member.coworkers.message"), describedby: "coworkers-compose-hint" },
            class: "block min-h-11! max-h-32 resize-none! rounded-lg! bg-white py-2.5! leading-5 dark:bg-zinc-900 #{'pr-14!' if dictation}", test_id: "coworkers-message",
            data: { coworker_composer_target: "input", "ui--voice-inline-target": "input", action: "keydown->chat-compose#maybeSubmit input->coworker-composer#grow" }) %>
      <%= render "member/shared/dictation_controls", mic_class: "absolute top-1 right-1 h-9! w-9!", overlay: true if dictation %>
    <% end %>
    <%= render Ui::ButtonComponent.new(label: t("member.coworkers.send"), type: "submit", icon: "send", icon_only: true, class: "h-11! w-11! rounded-lg! [&_svg]:size-5", test_id: "coworkers-send") %>
  </div>
  <p id="coworkers-compose-hint" class="sr-only"><%= t("member.coworkers.keyboard") %></p>
<% end %>
