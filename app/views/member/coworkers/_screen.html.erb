<%# The task's browser as the Puck sees it; the person can take it, click and type, then give it back (CYRA-1016). %>
<% if run.screen.attached? || run.video.attached? %>
  <section class="mt-3 flex flex-col gap-2" data-test="coworkers-screen" data-control="<%= run.control || 'puck' %>">
    <% if run.screen.attached? %>
      <% held = run.control == "person" && run.active? %>
      <%= form_with url: control_point_member_coworker_run_path(puck, run), class: "contents", data: { controller: "coworker-screen", coworker_screen_active_value: held } do %>
        <%= hidden_field_tag :x, nil, data: { coworker_screen_target: "x" } %>
        <%= hidden_field_tag :y, nil, data: { coworker_screen_target: "y" } %>
        <%= image_tag rails_blob_path(run.screen, disposition: "inline"), alt: t("member.coworkers.screen.alt", name: puck.name),
              class: "w-full rounded-md border border-stone-200 dark:border-zinc-700 #{'cursor-crosshair ring-2 ring-indigo-500 dark:ring-indigo-400' if held}",
              data: { coworker_screen_target: "image", action: "click->coworker-screen#point" } %>
      <% end %>
      <p class="text-[11.5px] text-gray-500 dark:text-zinc-400"><%= run.runtime_state["screen_url"] %></p>
      <% if run.active? %>
        <div class="flex flex-wrap items-center gap-1">
          <% if held %>
            <%= form_with url: control_type_member_coworker_run_path(puck, run), class: "flex flex-1 gap-1" do %>
              <%= render Ui::InputComponent.new(name: "value", id: "coworkers-type-#{run.id}", label: t("member.coworkers.screen.type"), maxlength: 500, autocomplete: "off", wrapper_class: "flex-1") %>
              <%= render Ui::ButtonComponent.new(label: t("member.coworkers.screen.send"), type: "submit", size: :sm, class: "self-end max-md:min-h-11") %>
            <% end %>
            <%= render Ui::ButtonComponent.new(label: t("member.coworkers.screen.give"), href: control_give_member_coworker_run_path(puck, run), method: :post, authenticity_token: false, size: :sm, test_id: "coworkers-give", class: "max-md:min-h-11") %>
          <% else %>
            <%= render Ui::ButtonComponent.new(label: t("member.coworkers.screen.take"), href: control_take_member_coworker_run_path(puck, run), method: :post, authenticity_token: false, variant: :secondary, size: :sm, test_id: "coworkers-take", class: "max-md:min-h-11") %>
          <% end %>
        </div>
      <% elsif run.control_steps.any? { |step| step["done"] } && puck.managed_by?(Current.account) %>
        <%= render Ui::ButtonComponent.new(label: t("member.coworkers.procedures.save"), href: member_coworker_procedures_path(puck, run_id: run.id), method: :post, authenticity_token: false, variant: :secondary, size: :sm, test_id: "coworkers-save-procedure", class: "w-fit max-md:min-h-11") %>
      <% end %>
    <% end %>
    <% if run.video.attached? %>
      <video src="<%= rails_blob_path(run.video, disposition: "inline") %>" controls class="w-full rounded-md" data-test="coworkers-video"></video>
    <% end %>
  </section>
<% end %>
