<% content_for :title, t("member.guides.guidance.title") %>

<div class="p-7 space-y-6 max-w-3xl" data-test="member-guide-guidance">
  <%= render Ui::PageHeaderComponent.new(
        title: safe_join([ tag.span(render(Ui::IconComponent.new(name: "compass", class: "text-[17px]")), class: "inline-flex items-center justify-center w-10 h-10 rounded-md bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 shrink-0 align-middle mr-3"),
                           t("member.guides.guidance.title") ]),
        breadcrumb: [ { label: t("member.guides.index.title"), href: member_guides_path },
                      { label: t("member.guides.guidance.title") } ]) do |h| %>
    <% h.with_meta do %>
      <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.guides.guidance.subtitle") %></p>
    <% end %>
  <% end %>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.guidance.what_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.guidance.what_intro") %></p>
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "link", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.guidance.what_references") %></span></li>
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "list-check", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.guidance.what_procedures") %></span></li>
      </ul>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.guidance.levels_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.guidance.levels_intro") %></p>
      <div class="rounded-md border border-stone-200 dark:border-zinc-800 divide-y divide-stone-200 dark:divide-zinc-800 text-[12.5px]">
        <div class="flex items-start gap-3 px-3 py-2"><span class="w-28 shrink-0 font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.guidance.origin.organization") %></span><span class="text-gray-600 dark:text-zinc-400"><%= t("member.guides.guidance.level_org") %></span></div>
        <div class="flex items-start gap-3 px-3 py-2"><span class="w-28 shrink-0 font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.guidance.origin.group") %></span><span class="text-gray-600 dark:text-zinc-400"><%= t("member.guides.guidance.level_group") %></span></div>
        <div class="flex items-start gap-3 px-3 py-2"><span class="w-28 shrink-0 font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.guidance.origin.project") %></span><span class="text-gray-600 dark:text-zinc-400"><%= t("member.guides.guidance.level_project") %></span></div>
      </div>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.guidance.how_title") %></h2></div>
    <div class="px-4 py-4">
      <ol class="space-y-4">
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">1</span>
          <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.guidance.how_org") %></div>
        </li>
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">2</span>
          <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.guidance.how_group") %></div>
        </li>
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">3</span>
          <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.guidance.how_project") %></div>
        </li>
      </ol>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-guide-guidance-preview">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.guidance.preview_title") %></h2></div>
    <div class="px-4 py-4">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.guidance.preview_intro") %></p>
    </div>
  </div>
</div>
