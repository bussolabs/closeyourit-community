<% content_for :title, t("member.guides.vault.title") %>

<div class="p-7 space-y-6 max-w-3xl" data-test="member-guide-vault">
  <%= render Ui::PageHeaderComponent.new(
        title: safe_join([ tag.span(render(Ui::IconComponent.new(name: "vault", class: "text-[17px]")), class: "inline-flex items-center justify-center w-10 h-10 rounded-md bg-amber-50 dark:bg-amber-500/15 text-amber-600 dark:text-amber-400 shrink-0 align-middle mr-3"),
                           t("member.guides.vault.title") ]),
        breadcrumb: [ { label: t("member.guides.index.title"), href: member_guides_path },
                      { label: t("member.guides.vault.title") } ]) do |h| %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.guides.vault.cta"), href: member_vault_path, variant: :primary, size: :sm, icon: "vault", test_id: "member-guide-vault-cta") %>
    <% end %>
    <% h.with_meta do %>
      <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.guides.vault.subtitle") %></p>
    <% end %>
  <% end %>

  <%= render "member/guides/secrets_split", current: :vault %>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.vault.what_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.vault.what_intro") %></p>
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "user", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.vault.what_personal") %></span></li>
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "building", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.vault.what_organization") %></span></li>
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "folder", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.vault.what_project") %></span></li>
      </ul>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.vault.how_title") %></h2></div>
    <div class="px-4 py-4">
      <ol class="space-y-4">
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">1</span>
          <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.vault.how_step1") %></div>
        </li>
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">2</span>
          <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.vault.how_step2") %></div>
        </li>
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">3</span>
          <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.vault.how_step3") %></div>
        </li>
      </ol>
    </div>
  </div>
</div>
