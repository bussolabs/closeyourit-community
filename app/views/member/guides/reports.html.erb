<% content_for :title, t("member.guides.reports.title") %>

<div class="p-7 space-y-6 max-w-3xl" data-test="member-guide-reports">
  <%= render Ui::PageHeaderComponent.new(
        title: safe_join([ tag.span(render(Ui::IconComponent.new(name: "mail-open", class: "text-[17px]")), class: "inline-flex items-center justify-center w-10 h-10 rounded-md bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 shrink-0 align-middle mr-3"),
                           t("member.guides.reports.title") ]),
        breadcrumb: [ { label: t("member.guides.index.title"), href: member_guides_path },
                      { label: t("member.guides.reports.title") } ]) do |h| %>
    <% h.with_meta do %>
      <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.guides.reports.subtitle") %></p>
    <% end %>
  <% end %>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.reports.what_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.reports.what_intro") %></p>
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "chart-line", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.reports.what_traffic") %></span></li>
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "bug", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.reports.what_errors") %></span></li>
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "heart-pulse", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.reports.what_uptime") %></span></li>
      </ul>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.reports.setup_title") %></h2></div>
    <div class="px-4 py-4">
      <ol class="space-y-4">
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">1</span>
          <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.reports.setup_step1") %></div>
        </li>
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">2</span>
          <div class="flex-1 min-w-0">
            <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed mb-2"><%= t("member.guides.reports.setup_step2") %></p>
            <div class="rounded-md border border-stone-200 dark:border-zinc-800 divide-y divide-stone-200 dark:divide-zinc-800 text-[12.5px]">
              <div class="flex items-center gap-3 px-3 py-2"><span class="w-32 shrink-0 font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.report.cadences.daily") %></span><span class="text-gray-600 dark:text-zinc-400"><%= t("member.guides.reports.cadence_daily") %></span></div>
              <div class="flex items-center gap-3 px-3 py-2"><span class="w-32 shrink-0 font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.report.cadences.weekly") %></span><span class="text-gray-600 dark:text-zinc-400"><%= t("member.guides.reports.cadence_weekly") %></span></div>
              <div class="flex items-center gap-3 px-3 py-2"><span class="w-32 shrink-0 font-mono text-[11px] text-gray-500 dark:text-zinc-400"><%= t("member.notifications.report.cadences.monthly") %></span><span class="text-gray-600 dark:text-zinc-400"><%= t("member.guides.reports.cadence_monthly") %></span></div>
            </div>
          </div>
        </li>
        <li class="flex gap-3">
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5">3</span>
          <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.reports.setup_step3") %></div>
        </li>
      </ol>
      <div class="mt-4">
        <%= link_to t("member.guides.reports.open_preferences"), member_notification_preferences_path,
              class: "inline-flex items-center gap-1.5 h-7 px-3 rounded-md text-[12px] font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200 dark:border-indigo-500/40 hover:bg-indigo-100 dark:hover:bg-indigo-500/25",
              data: { test: "member-guide-reports-preferences" } %>
      </div>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.reports.notes_title") %></h2></div>
    <div class="px-4 py-4">
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "eye", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.reports.note_visibility") %></span></li>
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "inbox", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.reports.note_empty") %></span></li>
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "bell", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.reports.note_not_alerts") %></span></li>
        <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "mail", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.reports.note_email_off") %></span></li>
      </ul>
    </div>
  </div>
</div>
