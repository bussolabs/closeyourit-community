<% content_for :title, t("member.guides.wikitech.title") %>

<div class="p-7 space-y-6 max-w-3xl" data-test="member-guide-wikitech">
  <%= render Ui::PageHeaderComponent.new(
        title: safe_join([ tag.span(render(Ui::IconComponent.new(name: "cpu", class: "text-[17px]")), class: "inline-flex items-center justify-center w-10 h-10 rounded-md bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-400 shrink-0 align-middle mr-3"),
                           t("member.guides.wikitech.title") ]),
        breadcrumb: [ { label: t("member.guides.index.title"), href: member_guides_path },
                      { label: t("member.guides.wikitech.title") } ]) do |h| %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.guides.wikitech.open"), href: member_wikitech_root_path,
            variant: :primary, size: :sm, icon: "cpu", test_id: "member-guide-wikitech-open") %>
    <% end %>
    <% h.with_meta do %>
      <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.guides.wikitech.subtitle") %></p>
    <% end %>
  <% end %>

  <% [ %w[what what_b1 what_b2 what_b3], %w[steps step1 step2 step3], %w[terminal terminal_b1 terminal_b2 terminal_b3] ].each do |section, *points| %>
    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-guide-wikitech-<%= section %>">
      <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.wikitech.#{section}_title") %></h2></div>
      <div class="px-4 py-4 space-y-3">
        <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.wikitech.#{section}_intro") %></p>
        <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
          <% points.each do |point| %>
            <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "check", class: "text-violet-500 dark:text-violet-400 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.wikitech.#{point}") %></span></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>
