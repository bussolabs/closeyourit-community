<%# CYRA-446 — Vault e Secret dell'organizzazione: due guide vicine per un contenitore e uno dei suoi
    tre spazi. Chi arriva qui deve capire in una riga dove va la password che ha in mano, prima di
    leggere la pagina: un segreto messo nello spazio sbagliato è un segreto letto da chi non doveva.
    La differenza vive in questo partial, non copiata in due viste, e ogni guida rimanda all'altra. %>
<section class="rounded-lg border border-indigo-200 dark:border-indigo-500/40 bg-indigo-50/40 dark:bg-indigo-500/10" data-test="guides-secrets-split" data-current="<%= current %>">
  <div class="px-4 py-3 border-b border-indigo-100 dark:border-indigo-500/20">
    <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.secrets_split.title") %></h2>
    <p class="text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.guides.secrets_split.intro") %></p>
  </div>
  <div class="px-4 py-4 space-y-3">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-[12.5px]">
      <div class="rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 py-2.5" data-test="guides-secrets-split-vault">
        <dt class="font-medium text-zinc-900 dark:text-zinc-100"><%= t("member.guides.vault.title") %></dt>
        <dd class="mt-0.5 text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.secrets_split.vault_line") %></dd>
      </div>
      <div class="rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 py-2.5" data-test="guides-secrets-split-secrets">
        <dt class="font-medium text-zinc-900 dark:text-zinc-100"><%= t("member.guides.secrets.title") %></dt>
        <dd class="mt-0.5 text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.secrets_split.secrets_line") %></dd>
      </div>
    </dl>
    <p class="text-[12.5px] text-gray-600 dark:text-zinc-400 leading-relaxed" data-test="guides-secrets-split-rule"><%= t("member.guides.secrets_split.rule") %></p>
    <p class="text-[12.5px]">
      <%# Il rimando porta SEMPRE all'altra guida: da qui si confrontano le due senza tornare all'indice. %>
      <% other = current == :vault ? :secrets : :vault %>
      <%= link_to t("member.guides.secrets_split.open_#{other}"),
                  other == :secrets ? member_guides_secrets_path : member_guides_vault_path,
                  class: "font-medium text-indigo-600 dark:text-indigo-400 hover:underline",
                  data: { test: "guides-secrets-split-link" } %>
    </p>
  </div>
</section>
