<% content_for :title, t("member.guides.activity.title") %>

<%# CYRA-745 — la guida del registro: cosa unisce, cosa NON ci si trova e perché. Senza, «l'azione
    che cerco non c'è» resta una domanda senza risposta e sembra un guasto. %>
<div class="p-7 space-y-6 max-w-3xl" data-test="member-guide-activity">
  <%= render Ui::PageHeaderComponent.new(
        title: safe_join([ tag.span(render(Ui::IconComponent.new(name: "history", class: "text-[17px]")), class: "inline-flex items-center justify-center w-10 h-10 rounded-md bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 shrink-0 align-middle mr-3"),
                           t("member.guides.activity.title") ]),
        breadcrumb: [ { label: t("member.guides.index.title"), href: member_guides_path },
                      { label: t("member.guides.activity.title") } ]) do |h| %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.guides.activity.cta"), href: member_activity_path, variant: :primary, size: :sm, icon: "history", test_id: "member-guide-activity-cta") %>
    <% end %>
    <% h.with_meta do %>
      <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.guides.activity.subtitle") %></p>
    <% end %>
  <% end %>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.activity.what_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.activity.what_intro") %></p>
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <% Activity::AuditQuery::SOURCES.each do |source| %>
          <li class="flex items-start gap-2.5" data-test="guide-activity-source">
            <%= render Ui::IconComponent.new(name: activity_source_icon(source), class: "text-indigo-500 dark:text-indigo-400 text-[12px] mt-0.5 w-4 text-center") %>
            <span><strong class="font-medium text-zinc-900 dark:text-zinc-100"><%= activity_source_label(source) %></strong> — <%= t("member.guides.activity.sources.#{source}") %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="guide-activity-out">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.activity.out_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.activity.out_intro") %></p>
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <% 1.upto(3) do |i| %>
          <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "circle-minus", class: "text-gray-400 dark:text-zinc-500 text-[11px] mt-1 w-4 text-center") %><span><%= t("member.guides.activity.out_b#{i}") %></span></li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.activity.how_title") %></h2></div>
    <div class="px-4 py-4">
      <ol class="space-y-4">
        <% 1.upto(3) do |step| %>
          <li class="flex gap-3">
            <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5"><%= step %></span>
            <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.activity.how_step#{step}") %></div>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
</div>
