<% content_for :title, t("member.guides.datasets.title") %>

<div class="p-7 space-y-6 max-w-3xl" data-test="member-guide-datasets">
  <%= render Ui::PageHeaderComponent.new(
        title: safe_join([ tag.span(render(Ui::IconComponent.new(name: "wand-sparkles", class: "text-[17px]")), class: "inline-flex items-center justify-center w-10 h-10 rounded-md bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 shrink-0 align-middle mr-3"),
                           t("member.guides.datasets.title") ]),
        breadcrumb: [ { label: t("member.guides.index.title"), href: member_guides_path },
                      { label: t("member.guides.datasets.title") } ]) do |h| %>
    <% h.with_actions do %>
      <%= render Ui::ButtonComponent.new(label: t("member.guides.datasets.cta"), href: member_datasets_path,
            variant: :primary, size: :sm, icon: "arrow-right", test_id: "member-guide-datasets-cta") %>
    <% end %>
    <% h.with_meta do %>
      <p class="text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("member.guides.datasets.subtitle") %></p>
    <% end %>
  <% end %>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-guide-datasets-what">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.datasets.what_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.datasets.what_intro") %></p>
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <% %w[what_b1 what_b2 what_b3].each do |key| %>
          <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "check", class: "text-indigo-500 dark:text-indigo-400 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.datasets.#{key}") %></span></li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-guide-datasets-when">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.datasets.when_title") %></h2></div>
    <div class="px-4 py-4">
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <% %w[when_b1 when_b2 when_b3 when_b4].each do |key| %>
          <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "check", class: "text-indigo-500 dark:text-indigo-400 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.datasets.#{key}") %></span></li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-guide-datasets-how">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.datasets.how_title") %></h2></div>
    <div class="px-4 py-4">
      <ol class="space-y-4">
        <% %w[how_step1 how_step2 how_step3 how_step4 how_step5].each_with_index do |key, index| %>
          <li class="flex gap-3">
            <span class="shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 font-mono text-[11px] font-semibold mt-0.5"><%= index + 1 %></span>
            <div class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.datasets.#{key}") %></div>
          </li>
        <% end %>
      </ol>
    </div>
  </div>

  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-guide-datasets-trust">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.datasets.trust_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.datasets.trust_intro") %></p>
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <% %w[trust_b1 trust_b2 trust_b3].each do |key| %>
          <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "check", class: "text-indigo-500 dark:text-indigo-400 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.datasets.#{key}") %></span></li>
        <% end %>
      </ul>
    </div>
  </div>

  <%# CYRA-454 — la domanda che il testo vecchio lasciava senza risposta: «ha a che fare con gli
      agenti che lavorano i ticket?». No, e va detto qui, non lasciato indovinare. %>
  <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="member-guide-datasets-not">
    <div class="px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.guides.datasets.not_title") %></h2></div>
    <div class="px-4 py-4 space-y-3">
      <p class="text-[13px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.guides.datasets.not_intro") %></p>
      <ul class="space-y-2 text-[12.5px] text-gray-600 dark:text-zinc-400">
        <% %w[not_b1 not_b2 not_b3].each do |key| %>
          <li class="flex items-start gap-2.5"><%= render Ui::IconComponent.new(name: "x", class: "text-gray-400 dark:text-zinc-500 text-[12px] mt-0.5 w-4 text-center") %><span><%= t("member.guides.datasets.#{key}") %></span></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
