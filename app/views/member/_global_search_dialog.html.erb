<%# CYRA-900 — a modal in the middle of the page, with the page behind blurred; full screen on phones. %>
<dialog id="member-global-search"
        class="m-0 h-[100dvh] max-h-none w-screen max-w-none overflow-hidden border-0 bg-stone-100 dark:bg-zinc-800 p-0 text-zinc-900 dark:text-zinc-100 backdrop:bg-zinc-900/30 backdrop:backdrop-blur-sm md:mx-auto md:mt-[12vh] md:h-[min(76vh,36rem)] md:max-h-none md:w-[40rem] md:rounded-lg md:border md:border-stone-200 dark:md:border-zinc-800 md:bg-white dark:md:bg-zinc-900"
        aria-label="<%= t('member.search.label') %>"
        data-ui--global-search-target="dialog"
        data-test="global-search-dialog"
        data-recents-key="cyi-search-recents-<%= current_organization.id %>-<%= Current.account.id %>"
        data-action="cancel->ui--global-search#cancel click->ui--global-search#backdrop close->ui--global-search#closed">
  <%# A fixed height: the key legend sits on the bottom edge and only the results scroll. %>
  <div class="flex h-full flex-col">
    <div class="flex h-14 shrink-0 items-center gap-2 border-b border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 md:h-auto md:p-3">
      <button type="button"
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-gray-500 dark:text-zinc-400 hover:bg-stone-50 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 md:hidden"
              aria-label="<%= t('member.search.close') %>"
              data-test="global-search-close"
              data-action="ui--global-search#close">
        <%= render Ui::IconComponent.new(name: "arrow-left", class: "text-base") %>
      </button>
      <%= form_with url: member_search_path, method: :get, role: "search",
            class: "flex h-11 min-w-0 flex-1 items-center rounded-md border border-stone-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 focus-within:ring-2 focus-within:ring-indigo-600 md:h-9",
            data: { turbo_frame: "member-global-search-results", ui__global_search_target: "form" } do |form| %>
        <%= form.label :q, t("member.search.label"), class: "sr-only" %>
        <%= hidden_field_tag :type, nil, id: nil, data: { ui__global_search_target: "type" } %>
        <%= render Ui::IconComponent.new(name: "search", class: "ml-3 text-[14px] text-gray-400 dark:text-zinc-500") %>
        <%= form.search_field :q,
              placeholder: t("member.search.placeholder"), autocomplete: "off",
              class: "h-full min-w-0 flex-1 bg-transparent px-2 text-[14px] text-zinc-900 dark:text-zinc-100 placeholder:text-gray-400 dark:placeholder:text-zinc-500 outline-none md:text-[13px]",
              data: { test: "global-search-input", ui__global_search_target: "input",
                      action: "input->ui--global-search#search keydown->ui--global-search#inputKeydown" } %>
        <kbd class="mr-2 hidden rounded-sm border border-stone-200 dark:border-zinc-800 px-1.5 py-0.5 font-mono text-[10px] text-gray-500 dark:text-zinc-400 md:block"><%= t("member.search.shortcut") %></kbd>
      <% end %>
      <button type="button"
              class="hidden h-9 items-center justify-center rounded-md px-2.5 text-[12px] font-medium text-gray-500 dark:text-zinc-400 hover:bg-stone-50 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 md:inline-flex"
              data-action="ui--global-search#close"
              data-test="global-search-close-desktop"><%= t("member.search.close") %></button>
    </div>

    <div class="relative flex min-h-0 flex-1 flex-col overflow-y-auto bg-stone-100 dark:bg-zinc-800 md:bg-white dark:md:bg-zinc-900">
      <div class="absolute inset-x-0 top-0 h-0.5 overflow-hidden" data-ui--global-search-target="progress" hidden>
        <span class="block h-full w-1/3 bg-indigo-600 motion-safe:animate-pulse"></span>
      </div>
      <%# Filled by the controller from this browser's history of opened results (CYRA-900). %>
      <section class="py-2" hidden data-ui--global-search-target="recents" data-test="global-search-recents">
        <h2 class="px-3 pb-1 font-mono uppercase text-[9.5px] tracking-[1px] text-gray-400 dark:text-zinc-500"><%= t("member.search.recents") %></h2>
        <div data-ui--global-search-target="recentsList"></div>
      </section>
      <%= turbo_frame_tag "member-global-search-results", target: "_top", aria: { live: "polite" },
            data: { test: "global-search-results" } do %>
        <div class="flex flex-1 flex-col items-center justify-center px-8 py-12 text-center md:min-h-48"
             data-test="global-search-prompt">
          <%= render Ui::IconComponent.new(name: "search", class: "text-2xl text-gray-400 dark:text-zinc-500") %>
          <p class="mt-3 text-[14px] font-medium text-zinc-900 dark:text-zinc-100"><%= t("member.search.prompt_title") %></p>
          <p class="mt-1 max-w-72 text-[12px] leading-5 text-gray-500 dark:text-zinc-400"><%= t("member.search.prompt_body") %></p>
        </div>
      <% end %>
    </div>
    <div class="hidden shrink-0 items-center gap-4 border-t border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 py-2 text-[11px] text-gray-500 dark:text-zinc-400 md:flex" data-test="global-search-legend">
      <% [ [ "↑↓", "move" ], [ "↵", "open" ], [ "esc", "close" ] ].each do |keys, action| %>
        <span><kbd class="mr-1 rounded-sm border border-stone-200 dark:border-zinc-800 px-1 font-mono text-[10px]"><%= keys %></kbd><%= t("member.search.legend.#{action}") %></span>
      <% end %>
    </div>
  </div>
</dialog>
