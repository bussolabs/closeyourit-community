<%# Pannello-evidenza illustrativo: verdetto di triage AI applicabile con un click. %>
<div class="rounded-lg border border-stone-200 bg-white overflow-hidden" aria-hidden="true">
  <div class="flex items-center gap-2 px-4 h-9 border-b border-stone-200">
    <span class="font-mono text-[11px] text-gray-500">monitoring / AI triage · ERR-1284</span>
    <span class="ml-auto font-mono text-[10.5px] text-gray-500">confidence <span class="text-zinc-900">0.92</span></span>
  </div>
  <div class="px-4 py-3.5 space-y-2">
    <% {
      "category" => [ "regression", "text-amber-600" ],
      "severity" => [ "high — checkout blocked for carts with expired codes", "text-zinc-900" ],
      "cause"    => [ "nil discount lookup after v2.4.1 refactor", "text-zinc-900" ],
      "action"   => [ "guard the lookup, add boundary spec, reopen DRRA-321", "text-zinc-900" ]
    }.each do |field, (value, color)| %>
      <div class="flex items-baseline gap-3">
        <span class="font-mono text-[9.5px] uppercase tracking-[1.2px] text-gray-500 w-16 shrink-0"><%= field %></span>
        <span class="font-mono text-[11.5px] leading-relaxed <%= color %>"><%= value %></span>
      </div>
    <% end %>
    <div class="pt-2.5 border-t border-stone-100 flex items-center gap-2">
      <span class="h-7 px-2.5 inline-flex items-center rounded-md bg-indigo-50 font-mono text-[11px] font-medium text-indigo-600">apply verdict</span>
      <span class="font-mono text-[10.5px] text-gray-500">similar errors · 4 in cluster</span>
    </div>
  </div>
</div>
