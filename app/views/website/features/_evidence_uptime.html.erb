<%# Pannello-evidenza illustrativo: SLA + timeline a blocchi (stesso linguaggio della status page). %>
<div class="rounded-lg border border-stone-200 bg-white overflow-hidden" aria-hidden="true">
  <div class="flex items-center gap-2 px-4 h-9 border-b border-stone-200">
    <span class="font-mono text-[11px] text-gray-500">uptime / api · production</span>
    <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-[10.5px] font-medium text-green-600"><span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>operational</span>
  </div>
  <div class="px-4 py-3.5">
    <div class="grid grid-cols-4 divide-x divide-stone-100 text-center">
      <% { "24h" => "100%", "7d" => "99.98%", "30d" => "99.94%", "1y" => "99.90%" }.each do |range, value| %>
        <div class="px-2">
          <p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500"><%= range %></p>
          <p class="mt-1 font-mono text-[13.5px] font-semibold <%= range == "24h" ? "text-green-600" : "text-zinc-900" %>"><%= value %></p>
        </div>
      <% end %>
    </div>
    <div class="mt-4 flex items-stretch gap-[2px] h-9">
      <% 36.times do |i| %>
        <span class="flex-1 rounded-[2px] <%= [ 22, 23 ].include?(i) ? "bg-red-500" : (i == 24 ? "bg-amber-400" : "bg-green-500") %>"></span>
      <% end %>
    </div>
    <p class="mt-2 font-mono text-[10.5px] text-gray-500">incident · 12 May · 18 min · resolved</p>
  </div>
</div>
