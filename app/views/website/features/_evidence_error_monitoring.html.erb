<%# Pannello-evidenza illustrativo: vocabolario reale del prodotto (issue group + istogramma). %>
<div class="rounded-lg border border-stone-200 bg-white overflow-hidden" aria-hidden="true">
  <div class="flex items-center gap-2 px-4 h-9 border-b border-stone-200">
    <span class="font-mono text-[11px] text-gray-500">errors / ERR-1284</span>
    <span class="ml-auto inline-flex items-center gap-1.5 rounded-md bg-red-50 px-2 py-0.5 font-mono text-[10.5px] font-medium text-red-600"><span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>open</span>
  </div>
  <div class="px-4 py-3.5">
    <p class="font-mono text-[12px] text-zinc-900 truncate">NoMethodError: undefined method `total` for nil — OrdersController#create</p>
    <p class="mt-1 font-mono text-[11px] text-gray-500">47 occurrences · first v2.3.0 · <span class="text-amber-600">regression</span> after v2.4.1</p>
    <div class="mt-3 flex items-end gap-[3px] h-10">
      <% [ 3, 5, 4, 7, 6, 10, 8, 12, 9, 14, 11, 16, 13, 10, 15, 18, 14, 20, 17, 22 ].each do |h| %>
        <span class="flex-1 rounded-[2px] bg-indigo-200" style="height: <%= h * 4 %>%"></span>
      <% end %>
      <span class="flex-1 rounded-[2px] bg-indigo-600" style="height: 100%"></span>
    </div>
    <div class="mt-3 flex items-center gap-2">
      <span class="h-7 px-2.5 inline-flex items-center rounded-md bg-indigo-50 font-mono text-[11px] font-medium text-indigo-600">resolve</span>
      <span class="h-7 px-2.5 inline-flex items-center rounded-md border border-stone-200 font-mono text-[11px] text-gray-500">ignore</span>
      <span class="h-7 px-2.5 inline-flex items-center rounded-md border border-stone-200 font-mono text-[11px] text-gray-500">promote → ticket</span>
    </div>
  </div>
</div>
