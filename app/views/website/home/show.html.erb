<% content_for :title, t("website.home.title") %><% content_for :meta_description, t("website.home.meta_description") %>
<%= render "website/shared/header" %>
<main id="main-content" class="flex-1 w-full" data-test="website-home">
  <section class="bg-white border-b border-stone-200"><div class="max-w-5xl mx-auto px-4 py-14 md:py-20"><p class="font-mono text-[11px] text-gray-500"><%= t("website.home.guide.path") %></p><h1 class="mt-3 max-w-3xl font-display text-[clamp(2rem,5vw,3.25rem)] leading-[1.08] tracking-[-0.02em] font-semibold text-zinc-900 text-balance"><%= t("website.home.guide.heading") %></h1><p class="mt-5 max-w-[65ch] text-[15px] leading-relaxed text-gray-600"><%= t("website.home.guide.subheading") %></p><div class="mt-8 flex flex-wrap gap-3"><%= link_to t("website.home.guide.cta_access"), website_page_path(:access_request), class: "h-10 px-5 inline-flex items-center rounded-md bg-indigo-600 text-white text-[14px] font-medium hover:bg-indigo-700", data: { test: "website-cta-access" } %><%= link_to t("website.home.guide.cta_workflow"), "#workflow", class: "h-10 px-5 inline-flex items-center rounded-md border border-stone-300 bg-white text-zinc-900 text-[14px] font-medium" %></div></div></section>

  <section id="workflow" class="max-w-5xl mx-auto px-4 py-14 md:py-20 scroll-mt-16" data-test="website-workflow"><h2 class="font-display text-[24px] font-semibold"><%= t("website.home.workflow.heading") %></h2><p class="mt-3 max-w-2xl text-[13.5px] text-gray-600"><%= t("website.home.workflow.summary") %></p>
    <ol class="mt-10 space-y-10">
      <li class="grid md:grid-cols-[.75fr_1.25fr] gap-5 md:gap-10" data-test="workflow-step-signal"><div><p class="font-mono text-[11px] text-red-600"><%= t("website.home.workflow.signal.label") %></p><h3 class="mt-1.5 font-display text-[17px] font-semibold"><%= t("website.home.workflow.signal.heading") %></h3><p class="mt-2 text-[13px] text-gray-600"><%= t("website.home.workflow.signal.body") %></p></div><div class="rounded-lg bg-zinc-900 border border-zinc-800 overflow-hidden"><div class="px-4 h-9 flex items-center border-b border-zinc-800 font-mono text-[10.5px] text-stone-100/50">● &nbsp; errors / production</div><div class="p-4 font-mono text-[11.5px] leading-[1.8] text-stone-100/90"><p><span class="text-red-400">error</span> NoMethodError in OrdersController#create</p><p class="text-stone-100/50">ERR-1284 · 47 occurrences · <span class="text-amber-400">regression</span> after v2.4.1</p></div></div></li>
      <li class="grid md:grid-cols-[.75fr_1.25fr] gap-5 md:gap-10" data-test="workflow-step-evidence"><div><p class="font-mono text-[11px] text-indigo-600"><%= t("website.home.workflow.evidence.label") %></p><h3 class="mt-1.5 font-display text-[17px] font-semibold"><%= t("website.home.workflow.evidence.heading") %></h3><p class="mt-2 text-[13px] text-gray-600"><%= t("website.home.workflow.evidence.body") %></p></div><div class="rounded-lg border border-stone-200 bg-white overflow-hidden"><div class="px-4 h-9 flex items-center border-b border-stone-200 font-mono text-[10.5px] text-gray-500">trace / <span class="ml-1 text-indigo-600">a41f-9c02</span></div><div class="p-4 grid sm:grid-cols-3 gap-3 font-mono text-[11px]"><p>● ERR-1284</p><p>● N+1 · 840ms</p><p>● 3 logs</p></div></div></li>
      <li class="grid md:grid-cols-[.75fr_1.25fr] gap-5 md:gap-10" data-test="workflow-step-decision"><div><p class="font-mono text-[11px] text-zinc-700"><%= t("website.home.workflow.decision.label") %></p><h3 class="mt-1.5 font-display text-[17px] font-semibold"><%= t("website.home.workflow.decision.heading") %></h3><p class="mt-2 text-[13px] text-gray-600"><%= t("website.home.workflow.decision.body") %></p></div><div class="rounded-lg border border-stone-200 bg-white overflow-hidden"><div class="px-4 h-9 flex items-center border-b border-stone-200 font-mono text-[10.5px] text-gray-500">tickets / DRRA-321</div><div class="p-4 space-y-2 text-[12px]"><p><span class="font-mono text-gray-500 inline-block w-20">given</span><%= t("website.home.workflow.decision.given") %></p><p><span class="font-mono text-gray-500 inline-block w-20">when</span><%= t("website.home.workflow.decision.when") %></p><p><span class="font-mono text-gray-500 inline-block w-20">expected</span><%= t("website.home.workflow.decision.expected") %></p></div></div></li>
      <li class="grid md:grid-cols-[.75fr_1.25fr] gap-5 md:gap-10" data-test="workflow-step-resolution"><div><p class="font-mono text-[11px] text-emerald-700"><%= t("website.home.workflow.resolution.label") %></p><h3 class="mt-1.5 font-display text-[17px] font-semibold"><%= t("website.home.workflow.resolution.heading") %></h3><p class="mt-2 text-[13px] text-gray-600"><%= t("website.home.workflow.resolution.body") %></p></div><div class="rounded-lg bg-zinc-900 border border-zinc-800 p-4 font-mono text-[11.5px] leading-[1.8] text-stone-100/90"><p><span class="text-emerald-400">$</span> cyi errors resolve ERR-1284 --ticket DRRA-321</p><p class="text-stone-100/50">→ release v2.4.2 · <span class="text-emerald-400">resolved</span></p></div></li>
    </ol>
  </section>

  <section id="capabilities" class="bg-white border-y border-stone-200 scroll-mt-16" data-test="website-capabilities"><div class="max-w-5xl mx-auto px-4 py-14 md:py-16"><h2 class="font-display text-[22px] font-semibold"><%= t("website.home.capabilities.heading") %></h2><div class="mt-8 grid md:grid-cols-3 gap-8 md:gap-12"><% %i[detect understand resolve].each do |group| %><div><h3 class="font-display text-[15px] font-semibold"><%= t("website.home.capabilities.#{group}.heading") %></h3><p class="mt-2 text-[13px] text-gray-600"><%= t("website.home.capabilities.#{group}.body") %></p><ul class="mt-4 space-y-2"><% t("website.home.capabilities.#{group}.items").each do |item| %><li class="flex gap-2 text-[12.5px] text-gray-600"><span class="text-indigo-600">✓</span><%= item %></li><% end %></ul></div><% end %></div></div></section>

  <section id="integrations" class="max-w-5xl mx-auto px-4 py-14 md:py-16"><div class="grid md:grid-cols-[.9fr_1.1fr] gap-8 items-center"><div><h2 class="font-display text-[22px] font-semibold"><%= t("website.home.setup.heading") %></h2><p class="mt-3 text-[13.5px] text-gray-600"><%= t("website.home.setup.body") %></p><%= link_to "#{t("website.home.setup.link")} →", website_page_path(:integrations), class: "mt-5 inline-flex text-[13px] font-medium text-indigo-600" %></div><pre class="rounded-lg bg-zinc-900 border border-zinc-800 p-4 font-mono text-[11.5px] text-stone-100/90 overflow-x-auto"><code><span class="text-stone-100/40"># keep your SDK, change the DSN</span>
SENTRY_DSN=<span class="text-indigo-400">https://&lt;key&gt;@www.closeyour.it/&lt;project-id&gt;</span></code></pre></div></section>
  <section id="project" class="bg-white border-y border-stone-200" data-test="website-project"><div class="max-w-5xl mx-auto px-4 py-14 md:py-16 grid md:grid-cols-2 gap-8 items-center"><div><h2 class="font-display text-[22px] font-semibold"><%= t("website.home.project.heading") %></h2><p class="mt-3 text-[13.5px] text-gray-600"><%= t("website.home.project.body") %></p></div><div class="rounded-lg border border-stone-200 bg-stone-50 p-4 font-mono text-[11.5px] text-gray-600"><p><span class="text-indigo-600">CloseYourIt</span> monitors CloseYourIt</p><p><%= t("website.home.project.evidence") %></p></div></div></section>
  <section class="bg-zinc-900"><div class="max-w-5xl mx-auto px-4 py-16 text-center"><h2 class="font-display text-[28px] font-semibold text-white"><%= t("website.home.cta.heading") %></h2><p class="mt-3 text-[14px] text-stone-100/70 max-w-xl mx-auto"><%= t("website.home.cta.body") %></p><%= link_to t("website.home.cta.button"), website_page_path(:access_request), class: "mt-7 h-10 px-6 inline-flex items-center rounded-md bg-indigo-600 text-white text-[14px] font-medium", data: { test: "website-cta-bottom" } %></div></section>
</main>
<%= render "website/shared/footer" %>
