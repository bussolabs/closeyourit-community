<% content_for :title, "#{@group.name} — #{t('website.status_group.title')}" %>
<% content_for :meta_description, t("website.status_group.meta_description", group: @group.name) %>
<%
  # Classi Tailwind LETTERALI (mai interpolate col numero) così lo scanner non le purga.
  dot_class = { "operational" => "bg-emerald-500", "down" => "bg-red-500", "degraded" => "bg-amber-500", "unknown" => "bg-gray-400" }[@state]
%>

<main id="main-content" class="flex-1 w-full max-w-2xl mx-auto px-4 py-10 md:py-14">
<div class="space-y-6" data-test="public-group-status" data-state="<%= @state %>">
  <%# header: identità del gruppo + stato aggregato %>
  <div class="text-center">
    <h1 class="font-display text-[22px] font-semibold text-zinc-900"><%= @group.name %></h1>
    <% if @group.description.present? %>
      <p class="mt-1.5 text-[13px] text-gray-500 max-w-md mx-auto"><%= @group.description %></p>
    <% end %>
    <div class="mt-4 flex items-center justify-center gap-2.5">
      <span class="inline-block w-3 h-3 rounded-full <%= dot_class %>" data-test="status-dot" aria-hidden="true"></span>
      <p class="text-[16px] font-medium text-zinc-900"><%= t("website.status_group.headline.#{@state}") %></p>
    </div>
  </div>

  <%# servizi del gruppo (un monitor per riga) + timeline a blocchi con range selezionabile %>
  <div class="rounded-lg border border-stone-200 bg-white" data-test="status-services">
    <div class="flex items-center gap-2 px-4 py-3 border-b border-stone-200 flex-wrap">
      <h2 class="font-display text-[13px] font-semibold text-zinc-900"><%= t("website.status_group.services") %></h2>
      <div class="ml-auto inline-flex rounded-md border border-stone-200 p-0.5 bg-stone-50" data-test="range-selector">
        <% Uptime::Monitor::RANGES.keys.each do |r| %>
          <%= link_to (r == "1y" ? t("website.status.range_sla", range: r) : r),
                public_group_status_path(@org.slug, @group.slug, range: r),
                class: "h-[26px] px-2.5 inline-flex items-center rounded-[5px] text-[12px] font-medium #{@range == r ? 'bg-white text-zinc-900 border border-stone-200' : 'text-gray-500 hover:text-zinc-900'}",
                data: { test: "range-#{r}" } %>
        <% end %>
      </div>
    </div>
    <% if @monitors.any? %>
      <div class="divide-y divide-stone-100">
        <% @monitors.each do |monitor| %>
          <%= render "website/status_groups/service", monitor: monitor, range: @range,
                buckets: (@buckets[monitor.id] || []), sla: (@sla.dig(monitor.id, @range)) %>
        <% end %>
      </div>
    <% else %>
      <p class="px-4 py-8 text-center text-[12.5px] text-gray-500" data-test="status-services-empty"><%= t("website.status_group.no_services") %></p>
    <% end %>
    <div class="px-4 py-2.5 border-t border-stone-100 flex items-center justify-end gap-3 font-mono text-[10px] text-gray-500">
      <% { up: :up, partial: :partial, down: :down, empty: :no_data }.each do |status, key| %>
        <span class="inline-flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-[2px] <%= uptime_bucket_class(status) %>"></span><%= t("website.status.bucket.#{key}").downcase %></span>
      <% end %>
    </div>
  </div>

  <%# storico incidenti del gruppo (ogni riga porta il servizio di riferimento) %>
  <div class="rounded-lg border border-stone-200 bg-white" data-test="incident-history">
    <div class="px-4 py-3 border-b border-stone-200">
      <h2 class="font-display text-[13px] font-semibold text-zinc-900"><%= t("website.status.incidents") %></h2>
    </div>
    <% if @incidents.any? %>
      <div class="divide-y divide-stone-100">
        <%= render partial: "website/status_groups/incident", collection: @incidents, as: :incident %>
      </div>
    <% else %>
      <p class="px-4 py-8 text-center text-[12.5px] text-gray-500" data-test="incident-empty"><%= t("website.status.no_incidents") %></p>
    <% end %>
  </div>
</div>
</main>

<footer class="w-full max-w-2xl mx-auto px-4 py-6 mt-8 border-t border-stone-200">
  <div class="flex items-center justify-center gap-2 text-[12px] text-gray-500">
    <%= render "shared/brand_mark", size: "w-5 h-5" %>
    <span><%= t("website.status.powered_by") %></span>
  </div>
  <p class="px-4 py-4 text-center text-xs"><%= render "shared/publisher_credit" %></p>
</footer>
