<% content_for :title, "#{@project.name} · #{@environment.label} — #{t('website.status.title')}" %>
<% content_for :meta_description, t("website.status.meta_description", project: @project.name, environment: @environment.label) %>
<%
  # Classi Tailwind LETTERALI (mai interpolate col numero) così lo scanner non le purga.
  dot_class = { "operational" => "bg-emerald-500", "down" => "bg-red-500", "paused" => "bg-gray-400", "unknown" => "bg-gray-400" }[@state]
%>

<%# Container stretto + footer powered-by: erano nel layout website, ora shell neutra condivisa
    col sito marketing (che ha header/footer propri). %>
<main id="main-content" class="flex-1 w-full max-w-2xl mx-auto px-4 py-10 md:py-14">
<div class="space-y-6" data-test="public-status" data-state="<%= @state %>">
  <%# banner manutenzioni/avvisi (opt-in, mostrato solo se attivo e in finestra) %>
  <% if @announcement %>
    <%= render "shared/status_banner", announcement: @announcement %>
  <% end %>

  <%# header: identità del servizio + stato di sintesi %>
  <div class="text-center">
    <div class="inline-flex items-center gap-2.5 flex-wrap justify-center">
      <h1 class="font-display text-[22px] font-semibold text-zinc-900"><%= @project.name %></h1>
      <%= render Ui::BadgeComponent.new(label: @environment.label, color: @environment.color, dot: true) %>
    </div>
    <div class="mt-4 flex items-center justify-center gap-2.5">
      <span class="inline-block w-3 h-3 rounded-full <%= dot_class %>" data-test="status-dot" aria-hidden="true"></span>
      <p class="text-[16px] font-medium text-zinc-900"><%= t("website.status.headline.#{@state}") %></p>
    </div>
    <p class="mt-1 font-mono text-[11px] text-gray-500"><%= t("website.status.updated", time: uptime_time_ago(@monitor.last_checked_at)) %></p>
  </div>

  <% if @open_incident %>
    <div class="rounded-lg border border-red-200 bg-red-50/50 px-4 py-3 flex items-center gap-2.5 flex-wrap" data-test="open-incident">
      <%= render Ui::IconComponent.new(name: "triangle-alert", class: "text-red-600 text-[13px]") %>
      <span class="text-[13px] font-semibold text-zinc-900"><%= t("website.status.ongoing_incident") %></span>
      <span class="font-mono text-[12px] text-red-600"><%= t("website.status.started_ago", time: time_ago_in_words(@open_incident.started_at)) %></span>
    </div>
  <% end %>

  <%# SLA per finestra %>
  <div class="rounded-lg border border-stone-200 bg-white" data-test="sla-summary">
    <div class="px-4 py-3 border-b border-stone-200">
      <h2 class="font-display text-[13px] font-semibold text-zinc-900"><%= t("website.status.sla") %></h2>
    </div>
    <div class="grid grid-cols-4 divide-x divide-stone-100">
      <% %w[24h 7d 30d 1y].each do |r| %>
        <div class="px-3 py-4 text-center">
          <p class="font-mono uppercase text-[9.5px] tracking-[1.2px] text-gray-500"><%= r == "1y" ? t("website.status.sla_1y") : r %></p>
          <p class="mt-1.5 font-mono text-[15px] font-semibold <%= uptime_percent_color(@sla[r]) %>"><%= uptime_percent_text(@sla[r]) %></p>
        </div>
      <% end %>
    </div>
  </div>

  <%# timeline a blocchi (range selezionabile) %>
  <div class="rounded-lg border border-stone-200 bg-white" data-test="uptime-timeline">
    <div class="flex items-center gap-2 px-4 py-3 border-b border-stone-200 flex-wrap">
      <h2 class="font-display text-[13px] font-semibold text-zinc-900"><%= t("website.status.timeline") %></h2>
      <div class="ml-auto inline-flex rounded-md border border-stone-200 p-0.5 bg-stone-50" data-test="range-selector">
        <% Uptime::Monitor::RANGES.keys.each do |r| %>
          <%= link_to (r == "1y" ? t("website.status.range_sla", range: t("website.status.sla_1y")) : r),
                public_status_path(@org.slug, @project.key, @environment.code, range: r),
                class: "h-[26px] px-2.5 inline-flex items-center rounded-[5px] text-[12px] font-medium #{@range == r ? 'bg-white text-zinc-900 border border-stone-200' : 'text-gray-500 hover:text-zinc-900'}",
                data: { test: "range-#{r}" } %>
        <% end %>
      </div>
    </div>
    <div class="px-4 py-4">
      <%# Colore non da solo: la striscia è puramente visiva (aria-hidden) + un riassunto
          testuale sr-only col conteggio per stato. %>
      <% status_buckets = Array(@buckets) %>
      <% bucket_counts = status_buckets.group_by { |b| b[:status] }.transform_values(&:size) %>
      <div class="flex items-stretch gap-[2px] h-14 overflow-x-auto scrollbar-none" aria-hidden="true">
        <% status_buckets.each do |bucket| %>
          <span class="flex-1 min-w-[2px] rounded-[2px] <%= uptime_bucket_class(bucket[:status]) %>" title="<%= uptime_bucket_title(bucket) %>"></span>
        <% end %>
      </div>
      <p class="sr-only" data-test="uptime-timeline-summary"><%= t("website.status.timeline_summary",
            up: bucket_counts[:up].to_i, partial: t("website.status.timeline_partial", count: bucket_counts[:partial].to_i), down: bucket_counts[:down].to_i,
            empty: bucket_counts[:empty].to_i, total: status_buckets.size, range: @range) %></p>
      <div class="mt-2 flex items-center justify-between font-mono text-[10px] text-gray-500">
        <span>-<%= @range %></span>
        <span class="inline-flex items-center gap-3">
          <% { up: :up, partial: :partial, down: :down, empty: :no_data }.each do |status, key| %>
            <span class="inline-flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-[2px] <%= uptime_bucket_class(status) %>"></span><%= t("website.status.bucket.#{key}").downcase %></span>
          <% end %>
        </span>
      </div>
    </div>
  </div>

  <%# storico incidenti %>
  <div class="rounded-lg border border-stone-200 bg-white" data-test="incident-history">
    <div class="px-4 py-3 border-b border-stone-200">
      <h2 class="font-display text-[13px] font-semibold text-zinc-900"><%= t("website.status.incidents") %></h2>
    </div>
    <% if @incidents.any? %>
      <div class="divide-y divide-stone-100">
        <%= render partial: "website/status/incident", collection: @incidents, as: :incident %>
      </div>
    <% else %>
      <p class="px-4 py-8 text-center text-[12.5px] text-gray-500" data-test="incident-empty"><%= t("website.status.no_incidents") %></p>
    <% end %>
  </div>
</div>
</main>

<footer class="w-full max-w-2xl mx-auto px-4 py-6 mt-8 border-t border-stone-200">
  <div class="flex items-center justify-center gap-2 text-[12px] text-gray-500">
    <%= render "shared/brand_mark", size: "w-5 h-5" %>
    <span><%= t("website.status.powered_by") %></span>
  </div>
  <p class="px-4 py-4 text-center text-xs"><%= render "shared/publisher_credit" %></p>
</footer>
