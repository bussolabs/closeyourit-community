<% content_for :title, "#{t("website.integrations.title")} · CloseYourIt" %>
<% content_for :meta_description, t("website.integrations.meta_description") %>

<%= render "website/shared/header" %>

<main id="main-content" class="flex-1 w-full" data-test="website-integrations">
  <section class="bg-white border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 py-14 md:py-20">
      <p class="font-mono text-[11px] text-gray-500">integrations/</p>
      <h1 class="mt-3 font-display text-[clamp(1.75rem,4vw,2.5rem)] leading-[1.12] tracking-[-0.015em] font-semibold text-zinc-900"><%= t("website.integrations.heading") %></h1>
      <p class="mt-4 text-[14.5px] leading-relaxed text-gray-600 max-w-[52ch]"><%= t("website.integrations.summary") %></p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12 space-y-5">
    <%# Snippet = valori tecnici letterali (comandi/config), fuori i18n per regola. %>
    <div class="rounded-lg border border-stone-200 bg-white p-5 grid md:grid-cols-2 gap-6 items-center" data-test="website-integration-ruby">
      <div>
        <p class="font-mono text-[10.5px] text-gray-500">gem · rubygems.org</p>
        <h2 class="mt-1.5 font-display text-[16px] font-semibold text-zinc-900"><%= t("website.integrations.ruby.heading") %></h2>
        <p class="mt-2 text-[13px] leading-relaxed text-gray-500 max-w-[48ch]"><%= t("website.integrations.ruby.body") %></p>
      </div>
      <div class="rounded-lg bg-zinc-900 border border-zinc-800 overflow-hidden">
        <div class="flex items-center px-4 h-8 border-b border-zinc-800"><span class="font-mono text-[10.5px] text-stone-100/50">Gemfile → initializer</span></div>
        <pre class="p-4 font-mono text-[11.5px] leading-[1.75] text-stone-100/90 overflow-x-auto"><code><span class="text-emerald-400">$</span> bundle add closeyourit-ruby

<span class="text-stone-100/40"># config/initializers/closeyourit.rb</span>
CloseYourIt.init <span class="text-stone-100/40">do</span> |config|
  config.dsn = ENV[<span class="text-indigo-400">"CLOSEYOURIT_DSN"</span>]
<span class="text-stone-100/40">end</span></code></pre>
      </div>
    </div>

    <div class="rounded-lg border border-stone-200 bg-white p-5 grid md:grid-cols-2 gap-6 items-center" data-test="website-integration-dart">
      <div>
        <p class="font-mono text-[10.5px] text-gray-500">package · pub.dev</p>
        <h2 class="mt-1.5 font-display text-[16px] font-semibold text-zinc-900"><%= t("website.integrations.dart.heading") %></h2>
        <p class="mt-2 text-[13px] leading-relaxed text-gray-500 max-w-[48ch]"><%= t("website.integrations.dart.body") %></p>
      </div>
      <div class="rounded-lg bg-zinc-900 border border-zinc-800 overflow-hidden">
        <div class="flex items-center px-4 h-8 border-b border-zinc-800"><span class="font-mono text-[10.5px] text-stone-100/50">pubspec</span></div>
        <pre class="p-4 font-mono text-[11.5px] leading-[1.75] text-stone-100/90 overflow-x-auto"><code><span class="text-emerald-400">$</span> dart pub add closeyourit

<span class="text-stone-100/40">// main.dart</span>
<span class="text-stone-100/40">await</span> CloseYourIt.init(dsn: dsn);</code></pre>
      </div>
    </div>

    <div class="rounded-lg border border-stone-200 bg-white p-5 grid md:grid-cols-2 gap-6 items-center" data-test="website-integration-cli">
      <div>
        <p class="font-mono text-[10.5px] text-gray-500">cli · npm</p>
        <h2 class="mt-1.5 font-display text-[16px] font-semibold text-zinc-900"><%= t("website.integrations.cli.heading") %></h2>
        <p class="mt-2 text-[13px] leading-relaxed text-gray-500 max-w-[48ch]"><%= t("website.integrations.cli.body") %></p>
      </div>
      <div class="rounded-lg bg-zinc-900 border border-zinc-800 overflow-hidden">
        <div class="flex items-center px-4 h-8 border-b border-zinc-800"><span class="font-mono text-[10.5px] text-stone-100/50">terminal</span></div>
        <pre class="p-4 font-mono text-[11.5px] leading-[1.75] text-stone-100/90 overflow-x-auto"><code><span class="text-emerald-400">$</span> npm install -g @bussolabs/closeyourit-cli
<span class="text-emerald-400">$</span> cyi login   <span class="text-stone-100/40"># OAuth device flow</span>
<span class="text-emerald-400">$</span> cyi errors list --project DRRA</code></pre>
      </div>
    </div>

    <div class="rounded-lg border border-stone-200 bg-white p-5 grid md:grid-cols-2 gap-6 items-center" data-test="website-integration-ci">
      <div>
        <p class="font-mono text-[10.5px] text-gray-500">http · bearer token</p>
        <h2 class="mt-1.5 font-display text-[16px] font-semibold text-zinc-900"><%= t("website.integrations.ci.heading") %></h2>
        <p class="mt-2 text-[13px] leading-relaxed text-gray-500 max-w-[48ch]"><%= t("website.integrations.ci.body") %></p>
      </div>
      <div class="rounded-lg bg-zinc-900 border border-zinc-800 overflow-hidden">
        <div class="flex items-center px-4 h-8 border-b border-zinc-800"><span class="font-mono text-[10.5px] text-stone-100/50">ci.yml</span></div>
        <pre class="p-4 font-mono text-[11.5px] leading-[1.75] text-stone-100/90 overflow-x-auto"><code><span class="text-emerald-400">$</span> curl -X POST https://www.closeyour.it/api/v1/projects/&lt;id&gt;/events \
    -H <span class="text-indigo-400">"Authorization: Bearer $CLOSEYOURIT_TOKEN"</span></code></pre>
      </div>
    </div>

    <div class="rounded-lg border border-stone-200 bg-white p-5 grid md:grid-cols-2 gap-6 items-center" data-test="website-integration-sentry">
      <div>
        <p class="font-mono text-[10.5px] text-gray-500">drop-in · dsn</p>
        <h2 class="mt-1.5 font-display text-[16px] font-semibold text-zinc-900"><%= t("website.integrations.sentry.heading") %></h2>
        <p class="mt-2 text-[13px] leading-relaxed text-gray-500 max-w-[48ch]"><%= t("website.integrations.sentry.body") %></p>
        <p class="mt-2 text-[12px] leading-relaxed text-gray-500 max-w-[48ch]"><%= t("website.integrations.sentry.scope") %></p>
      </div>
      <div class="rounded-lg bg-zinc-900 border border-zinc-800 overflow-hidden">
        <div class="flex items-center px-4 h-8 border-b border-zinc-800"><span class="font-mono text-[10.5px] text-stone-100/50">.env</span></div>
        <pre class="p-4 font-mono text-[11.5px] leading-[1.75] text-stone-100/90 overflow-x-auto"><code><span class="text-stone-100/40"># keep your Sentry SDK — the DSN is on your project's token page</span>
SENTRY_DSN=<span class="text-indigo-400">https://&lt;public-key&gt;@www.closeyour.it/&lt;project-id&gt;</span></code></pre>
      </div>
    </div>
  </section>
</main>

<%= render "website/shared/footer" %>
