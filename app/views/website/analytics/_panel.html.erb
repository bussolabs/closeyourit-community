<%# Pannello read-only della dashboard pubblica: barra ∝ visitatori (nessun filtro/link). %>
<div class="rounded-lg border border-stone-200 bg-white" data-test="public-panel">
  <div class="px-4 py-3 border-b border-stone-200">
    <h2 class="font-display text-[14px] font-semibold text-zinc-900"><%= title %></h2>
  </div>
  <div class="p-4">
    <% if rows.blank? %>
      <p class="text-[12.5px] text-gray-500"><%= t("member.monitoring.analytics.no_data") %></p>
    <% else %>
      <% max = rows.map { |r| r[:visitors].to_i }.max.to_i %>
      <ul class="space-y-2">
        <% rows.each do |row| %>
          <li class="relative">
            <div class="absolute inset-y-0 left-0 rounded bg-indigo-50" style="width: <%= analytics_row_width(row[:visitors], max) %>%"></div>
            <div class="relative flex items-center justify-between gap-2 px-2 py-1">
              <span class="truncate text-[12.5px] text-zinc-900"><% if local_assigns[:flag] %><span class="mr-1.5"><%= analytics_country_flag(row[key]) %></span><% end %><%= local_assigns[:channel_labels] ? analytics_channel_label(row[key]) : row[key] %></span>
              <span class="shrink-0 font-mono text-[12px] text-gray-500"><%= row[:visitors] %></span>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
