<% content_for :title, t("website.analytics.password.title") %>

<main id="main-content" class="flex-1 w-full max-w-sm mx-auto px-4 py-16" data-test="public-analytics-password">
  <div class="rounded-lg border border-stone-200 bg-white p-6">
    <h1 class="font-display text-[16px] font-semibold text-zinc-900 mb-1"><%= t("website.analytics.password.title") %></h1>
    <p class="text-[12.5px] text-gray-500 mb-4"><%= t("website.analytics.password.body") %></p>

    <% if @failed %>
      <p class="mb-3 text-[12.5px] text-red-600" data-test="public-analytics-password-error"><%= t("website.analytics.password.error") %></p>
    <% end %>

    <%= form_with url: share_analytics_path(@slug), method: :post do %>
      <%= password_field_tag :password, nil,
            class: "w-full h-[36px] px-3 rounded-md border border-stone-200 text-[13px] focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400",
            placeholder: t("website.analytics.password.placeholder"), data: { test: "public-analytics-password-field" } %>
      <button type="submit" class="mt-3 w-full h-[36px] rounded-md bg-zinc-900 text-white text-[12.5px] font-medium hover:bg-zinc-800" data-test="public-analytics-password-submit"><%= t("website.analytics.password.submit") %></button>
    <% end %>
  </div>
</main>
