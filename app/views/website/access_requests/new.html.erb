<% content_for :title, "#{t("website.access_request.title")} · CloseYourIt" %><% content_for :meta_description, t("website.access_request.meta_description") %>
<%= render "website/shared/header" %>
<main id="main-content" class="flex-1 w-full" data-test="website-access-request"><section class="bg-white border-b border-stone-200"><div class="max-w-5xl mx-auto px-4 py-14 md:py-20 grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-start">
  <div><p class="font-mono text-[11px] text-gray-500"><%= t("website.access_request.path") %></p><h1 class="mt-3 font-display text-[clamp(1.75rem,4vw,2.5rem)] leading-[1.12] tracking-[-0.015em] font-semibold text-zinc-900 text-balance"><%= t("website.access_request.heading") %></h1><p class="mt-4 text-[14.5px] leading-relaxed text-gray-600 max-w-[52ch]"><%= t("website.access_request.summary") %></p><div class="mt-8 rounded-lg bg-zinc-900 border border-zinc-800 p-4 font-mono text-[11px] leading-[1.8] text-stone-100/70" aria-hidden="true"><p><span class="text-indigo-400">signal</span> → evidence</p><p class="pl-8">→ decision → <span class="text-emerald-400">resolved</span></p></div></div>
  <div class="rounded-lg border border-stone-200 bg-white p-5 sm:p-6"><% if params[:sent] == "1" %><div role="status" data-test="access-request-success" class="rounded-md bg-emerald-50 px-4 py-3 text-[13.5px] leading-relaxed text-emerald-800"><p class="font-semibold"><%= t("website.access_request.success.heading") %></p><p class="mt-1"><%= t("website.access_request.success.body") %></p></div><% end %><% if @access_request.errors.any? %><div role="alert" class="mb-5 rounded-md bg-red-50 px-4 py-3 text-[13px] text-red-800"><p class="font-semibold"><%= t("website.access_request.errors.heading") %></p><ul class="mt-1 list-disc pl-5"><% @access_request.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
    <%= form_with model: @access_request, url: website_page_path(:access_request), class: "space-y-4", data: { test: "access-request-form" } do |form| %><% { name: :text, email: :email, team: :text }.each do |field, type| %><div><%= form.label field, t("website.access_request.fields.#{field}"), class: "block text-[12.5px] font-medium text-zinc-900 mb-1.5" %><%= form.public_send("#{type}_field", field, required: true, autocomplete: { name: "name", email: "email", team: "organization" }.fetch(field), class: "w-full h-10 rounded-md border border-stone-300 bg-white px-3 text-[14px] text-zinc-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1") %></div><% end %><div><%= form.label :context, t("website.access_request.fields.context"), class: "block text-[12.5px] font-medium text-zinc-900 mb-1.5" %><%= form.text_area :context, required: true, rows: 5, placeholder: t("website.access_request.fields.context_placeholder"), class: "w-full rounded-md border border-stone-300 bg-white px-3 py-2.5 text-[14px] leading-relaxed text-zinc-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1" %></div><%# CYRA-698 — il modulo raccoglie nome, email di lavoro e testo libero: l'informativa va offerta
    PRIMA di premere, non cercata dopo. %>
<p class="text-[12px] text-gray-500"><%= t("website.access_request.privacy_note_html", link: link_to(t("website.footer.privacy"), website_page_path(:privacy), class: "text-indigo-600 hover:text-indigo-700", data: { test: "request-access-privacy" })) %></p>
<%= form.submit t("website.access_request.submit"), class: "h-10 px-5 inline-flex items-center rounded-md bg-indigo-600 text-white text-[14px] font-medium hover:bg-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %><% end %>
  </div>
</div></section></main><%= render "website/shared/footer" %>
