<% content_for :title, t("auth.passwords.new_title") %>

<%= render Ui::CardComponent.new do %>
  <h1 class="font-display text-[20px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("auth.passwords.new_title") %></h1>
  <p class="mt-1 text-[12.5px] text-gray-500 dark:text-zinc-400"><%= t("auth.passwords.new_subtitle") %></p>

  <%= form_with url: passwords_path, method: :post, class: "mt-5 space-y-4", data: { test: "forgot-form" } do %>
    <%= render Ui::InputComponent.new(name: "email", label: t("auth.fields.email"), type: "email", required: true, test_id: "forgot-email") %>
    <%= render Ui::ButtonComponent.new(label: t("auth.passwords.send"), type: "submit", size: :lg, test_id: "forgot-submit", class: "w-full") %>
  <% end %>
<% end %>

<p class="mt-5 text-center text-[12.5px] text-gray-500 dark:text-zinc-400">
  <%= link_to t("auth.passwords.back_to_login"), login_path, class: "font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300", data: { test: "forgot-to-login" } %>
</p>
