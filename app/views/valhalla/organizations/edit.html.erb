<% content_for :title, t("valhalla.organizations.edit_title") %>

<div class="p-7">
  <%= form_with url: valhalla_organization_path(@organization), method: :patch, class: "space-y-6", data: { test: "valhalla-organization-form" } do %>
    <%= render Ui::PageHeaderComponent.new(
          title: t("valhalla.organizations.edit_title"),
          breadcrumb: [ { label: t("valhalla.organizations.title"), href: valhalla_organizations_path }, { label: @organization.name, href: valhalla_organization_path(@organization) }, { label: t("member.breadcrumb.edit") } ],
          root_href: valhalla_root_path) do |h| %>
      <% h.with_actions do %>
        <%= render Ui::ButtonComponent.new(label: t("valhalla.cancel"), href: valhalla_organization_path(@organization), variant: :secondary_muted, size: :sm) %>
        <%= render Ui::ButtonComponent.new(label: t("valhalla.save"), type: "submit", size: :sm, test_id: "valhalla-organization-submit") %>
      <% end %>
    <% end %>

    <div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
          <%= render Ui::InputComponent.new(name: "name", label: t("valhalla.organizations.form_name"), required: true, test_id: "organization-name", value: @organization.name, error: @errors&.dig(:name)&.first) %>
          <%= render Ui::InputComponent.new(name: "slug", label: t("valhalla.organizations.form_slug"), required: true, test_id: "organization-slug", value: @organization.slug, hint: t("valhalla.organizations.form_slug_hint"), error: @errors&.dig(:slug)&.first) %>
        </div>
      </div>
    </div>
  <% end %>
</div>
