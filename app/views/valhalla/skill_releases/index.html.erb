<% content_for :title, t("valhalla.skill_releases.index.title") %>
<% sync_button = Ui::ButtonComponent.new(label: t("valhalla.skill_releases.index.sync"), href: sync_valhalla_skill_releases_path, method: :post,
     form_id: "skill-release-actions", variant: :primary, size: :sm, icon: "refresh-cw", test_id: "skill-releases-sync") %>

<div class="p-7 space-y-6" data-test="valhalla-skill-releases">
  <%= render Ui::PageHeaderComponent.new(
        title: t("valhalla.skill_releases.index.title"),
        subtitle: t("valhalla.skill_releases.index.lead"),
        breadcrumb: [ { label: t("valhalla.skill_releases.index.title") } ],
        root_href: valhalla_root_path) %>

  <%= render Ui::RowActionsFormComponent.new(id: "skill-release-actions", test_id: "skill-release-actions") %>

  <% if @total.zero? %>
    <%= render Ui::EmptyStateComponent.new(icon: "package", framed: true, test_id: "skill-releases-empty",
          title: t("valhalla.skill_releases.index.empty_title"), body: t("valhalla.skill_releases.index.empty")) do |empty| %>
      <% empty.with_action { render sync_button } %>
    <% end %>
  <% else %>
    <%= render Ui::SectionComponent.new(title: t("valhalla.skill_releases.index.panel_title"), body_class: nil, test_id: "skill-releases-table") do |section| %>
      <% section.with_subtitle do %>
        <span class="mt-0.5 flex flex-wrap items-center gap-x-1" data-test="skill-releases-counts">
          <%= render Ui::StatLabelComponent.new(label: t("valhalla.skill_releases.index.count_versions", count: @total), value: @total, test_id: "skill-releases-stat-total") %>
          <%= render Ui::StatLabelComponent.new(label: t("valhalla.skill_releases.index.count_withdrawn", count: @withdrawn_total), value: @withdrawn_total, test_id: "skill-releases-stat-withdrawn") %>
        </span>
      <% end %>
      <% section.with_actions { render sync_button } %>

      <%= render(Ui::TableToolbarComponent.new(framed: true, url: valhalla_skill_releases_path, query: params[:q],
            search_placeholder: t("valhalla.skill_releases.index.search"), hidden: { sort: params[:sort] },
            search_test_id: "skill-releases-search", test_id: "skill-releases-toolbar")) do |toolbar| %>
        <% toolbar.with_filter(key: "state", label: t("valhalla.skill_releases.index.state")) do %>
          <div class="w-44"><%= render Ui::SelectComponent.new(name: "state", multiple: true, summary: true,
            options: [ [ t("valhalla.skill_releases.index.available"), "available", "emerald" ], [ t("valhalla.skill_releases.index.withdrawn"), "withdrawn", "gray" ] ],
            selected: params[:state], placeholder: t("valhalla.skill_releases.index.state"), test_id: "filter-state") %></div>
        <% end %>
      <% end %>

      <% if @releases.empty? %>
        <%= render Ui::NoResultsComponent.new(reset_href: valhalla_skill_releases_path, query: params[:q].presence, test_id: "skill-releases-no-results") %>
      <% else %>
        <%= render(Ui::TableComponent.new(stacked: true, label: t("valhalla.skill_releases.index.title"))) do |table| %>
          <% table.with_head do %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("valhalla.skill_releases.index.version"), sort: "version", initial: :desc) %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("valhalla.skill_releases.index.published"), sort: "published_at", initial: :desc) %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("valhalla.skill_releases.index.state"), sort: "state") %>
            <%= render Ui::TableComponent::HeaderComponent.new(label: t("valhalla.skill_releases.index.actions"), label_hidden: true, classes: "w-28") %>
          <% end %>
          <%= render partial: "valhalla/skill_releases/release", collection: @releases, as: :release %>
        <% end %>
        <%= render Ui::PaginationComponent.new(pagination: @pagination, test_id: "skill-releases-pagination") %>
      <% end %>
    <% end %>
  <% end %>
</div>
