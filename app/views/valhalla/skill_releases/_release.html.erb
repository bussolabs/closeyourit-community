<%# locals: (release:) %>
<%= render Ui::TableComponent::RowComponent.new(faded: release.withdrawn?, id: dom_id(release), test_id: "skill-release-#{release.id}") do %>
  <%= render Ui::TableComponent::CellComponent.new(header: true, mono: true) do %>
    <span class="text-[13px] font-medium text-zinc-900 dark:text-zinc-100"><%= release.version %></span>
  <% end %>
  <%= render(Ui::TableComponent::CellComponent.new(label: t("valhalla.skill_releases.index.published"), mono: true, class: "text-gray-500 dark:text-zinc-400")) do %>
    <%= l(release.published_at.to_date) %>
  <% end %>
  <%= render Ui::TableComponent::CellComponent.new(label: t("valhalla.skill_releases.index.state")) do %>
    <%= render Ui::BadgeComponent.new(label: t(release.withdrawn? ? "valhalla.skill_releases.index.withdrawn" : "valhalla.skill_releases.index.available"),
          color: release.withdrawn? ? :gray : :green, dot: true) %>
  <% end %>
  <%= render Ui::TableComponent::CellComponent.new(actions: true) do %>
    <% if release.withdrawn? %>
      <%= render Ui::ButtonComponent.new(label: t("valhalla.skill_releases.index.restore"), href: restore_valhalla_skill_release_path(release), method: :patch,
            form_id: "skill-release-actions", variant: :secondary_muted, size: :sm, icon: "undo-2", test_id: "skill-release-restore-#{release.id}") %>
    <% else %>
      <%= render Ui::ConfirmDialogComponent.new(title: t("valhalla.skill_releases.index.withdraw_dialog.title", version: release.version),
            url: withdraw_valhalla_skill_release_path(release), method: :patch, confirm_label: t("valhalla.skill_releases.index.withdraw"),
            test_id: "skill-release-withdraw-dialog-#{release.id}") do |dialog| %>
        <% dialog.with_body { t("valhalla.skill_releases.index.withdraw_dialog.body") } %>
        <%= dialog.button_trigger(label: t("valhalla.skill_releases.index.withdraw"), icon: "ban", variant: :secondary_muted,
              test_id: "skill-release-withdraw-#{release.id}") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
