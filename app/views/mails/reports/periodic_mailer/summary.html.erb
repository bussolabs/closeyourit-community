<%# Riepilogo periodico dei dati (frame: layouts/mailer.html.erb). Tre numeri in testa — traffico,
    errori, uptime — e poi il dettaglio per progetto: chi apre l'email deve capire come è andata
    senza scorrere. %>
<% heading = t("reports.periodic.mailer.heading.#{@report.cadence}") %>
<% content_for :preheader, heading %>

<h1 style="<%= mail_h1_style(size: 20) %>"><%= heading %></h1>
<p style="<%= mail_note_style %>margin-top:0;">
  <%= t("reports.periodic.mailer.period", from: l(@report.from.to_date, format: :long), to: l(@report.to.to_date, format: :long)) %>
  · <%= @organization.name %>
</p>

<!-- i tre numeri di testa -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:18px 0 0 0;">
  <tr>
    <td width="33%" valign="top" style="padding:14px 16px;border:1px solid <%= MailerHelper::MAIL_BORDER %>;border-radius:10px;background-color:<%= MailerHelper::MAIL_SUBTLE %>;">
      <p style="<%= mail_overline_style %>"><%= t("reports.periodic.mailer.traffic_title") %></p>
      <p style="margin:0;font-family:<%= MailerHelper::FONT_DISPLAY %>;font-size:22px;font-weight:600;color:<%= MailerHelper::MAIL_INK %>;"><%= number_with_delimiter(@report.pageviews) %></p>
      <p style="margin:2px 0 0 0;<%= mail_mono_style(color: MailerHelper::MAIL_SECONDARY) %>"><%= t("reports.periodic.mailer.visitors", count: @report.visitors) %></p>
    </td>
    <td style="width:10px;">&nbsp;</td>
    <td width="33%" valign="top" style="padding:14px 16px;border:1px solid <%= MailerHelper::MAIL_BORDER %>;border-radius:10px;background-color:<%= MailerHelper::MAIL_SUBTLE %>;">
      <p style="<%= mail_overline_style %>"><%= t("reports.periodic.mailer.errors_title") %></p>
      <p style="margin:0;font-family:<%= MailerHelper::FONT_DISPLAY %>;font-size:22px;font-weight:600;color:<%= @report.error_events.positive? ? MailerHelper::ACCENTS[:red] : MailerHelper::MAIL_INK %>;"><%= number_with_delimiter(@report.error_events) %></p>
      <p style="margin:2px 0 0 0;<%= mail_mono_style(color: MailerHelper::MAIL_SECONDARY) %>"><%= t("reports.periodic.mailer.new_errors", count: @report.new_error_groups) %></p>
    </td>
    <td style="width:10px;">&nbsp;</td>
    <td width="33%" valign="top" style="padding:14px 16px;border:1px solid <%= MailerHelper::MAIL_BORDER %>;border-radius:10px;background-color:<%= MailerHelper::MAIL_SUBTLE %>;">
      <p style="<%= mail_overline_style %>"><%= t("reports.periodic.mailer.uptime_title") %></p>
      <p style="margin:0;font-family:<%= MailerHelper::FONT_DISPLAY %>;font-size:22px;font-weight:600;color:<%= MailerHelper::MAIL_INK %>;">
        <%= @report.uptime_percent ? "#{@report.uptime_percent}%" : "—" %>
      </p>
      <p style="margin:2px 0 0 0;<%= mail_mono_style(color: MailerHelper::MAIL_SECONDARY) %>">
        <%= @report.uptime_percent ? t("reports.periodic.mailer.uptime_hint") : t("reports.periodic.mailer.uptime_missing") %>
      </p>
    </td>
  </tr>
</table>

<%# Il confronto col periodo precedente: senza, un numero da solo non dice se è andata bene. %>
<p style="<%= mail_note_style %>">
  <% if @report.pageviews_delta.nil? %>
    <%= t("reports.periodic.mailer.delta_missing") %>
  <% else %>
    <%= t("reports.periodic.mailer.delta", value: number_to_percentage(@report.pageviews_delta, precision: 0, format: "%{number}%"), previous: number_with_delimiter(@report.previous_pageviews)) %>
  <% end %>
</p>

<!-- dettaglio per progetto -->
<p style="<%= mail_overline_style %>margin:22px 0 8px 0;"><%= t("reports.periodic.mailer.projects_title") %></p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid <%= MailerHelper::MAIL_BORDER %>;border-radius:10px;">
  <tr>
    <td style="padding:8px 14px;background-color:<%= MailerHelper::MAIL_SUBTLE %>;<%= mail_mono_style(color: MailerHelper::MAIL_MUTED) %>"><%= t("reports.periodic.mailer.col_project") %></td>
    <td align="right" style="padding:8px 14px;background-color:<%= MailerHelper::MAIL_SUBTLE %>;<%= mail_mono_style(color: MailerHelper::MAIL_MUTED) %>"><%= t("reports.periodic.mailer.col_pageviews") %></td>
    <td align="right" style="padding:8px 14px;background-color:<%= MailerHelper::MAIL_SUBTLE %>;<%= mail_mono_style(color: MailerHelper::MAIL_MUTED) %>"><%= t("reports.periodic.mailer.col_errors") %></td>
    <td align="right" style="padding:8px 14px;background-color:<%= MailerHelper::MAIL_SUBTLE %>;<%= mail_mono_style(color: MailerHelper::MAIL_MUTED) %>"><%= t("reports.periodic.mailer.col_uptime") %></td>
  </tr>
  <% @report.rows.each do |row| %>
    <tr>
      <td style="padding:10px 14px;border-top:1px solid <%= MailerHelper::MAIL_BORDER %>;font-family:<%= MailerHelper::FONT_SANS %>;font-size:13px;color:<%= MailerHelper::MAIL_INK %>;"><%= row.name %></td>
      <td align="right" style="padding:10px 14px;border-top:1px solid <%= MailerHelper::MAIL_BORDER %>;<%= mail_mono_style %>"><%= number_with_delimiter(row.pageviews) %></td>
      <td align="right" style="padding:10px 14px;border-top:1px solid <%= MailerHelper::MAIL_BORDER %>;<%= mail_mono_style(color: row.error_events.positive? ? MailerHelper::ACCENTS[:red] : MailerHelper::MAIL_TEXT) %>"><%= number_with_delimiter(row.error_events) %></td>
      <td align="right" style="padding:10px 14px;border-top:1px solid <%= MailerHelper::MAIL_BORDER %>;<%= mail_mono_style %>"><%= row.uptime_percent ? "#{row.uptime_percent}%" : "—" %></td>
    </tr>
  <% end %>
</table>
<% if @report.other_projects.positive? %>
  <p style="<%= mail_footnote_style %>"><%= t("reports.periodic.mailer.other_projects", count: @report.other_projects) %></p>
<% end %>

<div style="margin:22px 0 0 0;">
  <%# `_url` e non `_path`: nei mailer i path helper non esistono, e un link relativo in un client di posta non porta da nessuna parte. %>
  <%= render "mails/shared/button", label: t("reports.periodic.mailer.action"), url: member_monitoring_analytics_url, color: MailerHelper::MAIL_ACCENT %>
</div>

<p style="<%= mail_note_style %>"><%= t("reports.periodic.mailer.footer") %></p>
