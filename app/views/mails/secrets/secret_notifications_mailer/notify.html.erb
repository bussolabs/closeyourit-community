<%# Notifica del vault (rotazione/cancellazione/sync) — corpo della mail (frame: layouts/mailer.html.erb). Accento indigo del dominio vault. %>
<% content_for :accent, MailerHelper::MAIL_ACCENT %>
<% content_for :preheader, @notification.title %>

<% if @variable %>
  <!-- pill nome variabile (solo quando è ancora viva, es. rotazione: assente su cancellazione/sync, il nome resta comunque nel titolo snapshottato) -->
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 12px 0;"><tr>
    <td style="background-color:<%= MailerHelper::MAIL_SUBTLE %>;border-radius:6px;padding:3px 10px;font-family:<%= MailerHelper::FONT_MONO %>;font-size:11.5px;font-weight:600;color:<%= MailerHelper::MAIL_ACCENT %>;"><%= @variable.name %></td>
  </tr></table>
<% end %>

<h1 style="<%= mail_h1_style(size: 20) %>"><%= @notification.title %></h1>

<!-- meta box: progetto + ambiente (MAI il valore del secret) -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0 0 0;border:1px solid <%= MailerHelper::MAIL_BORDER %>;border-radius:10px;background-color:<%= MailerHelper::MAIL_SUBTLE %>;">
  <tr><td style="padding:14px 16px;">
    <% if @notification.project %>
      <p style="margin:0 0 8px 0;<%= mail_mono_style %>"><span style="color:<%= MailerHelper::MAIL_MUTED %>;"><%= t("secrets.secret_notifications.mailer.notify.label_project") %>&nbsp;&nbsp;</span><span style="color:<%= MailerHelper::MAIL_ACCENT %>;font-weight:500;"><%= @notification.project.key %></span> · <%= @notification.project.name %></p>
    <% end %>
    <% if @variable %>
      <p style="margin:0;<%= mail_mono_style %>"><span style="color:<%= MailerHelper::MAIL_MUTED %>;"><%= t("secrets.secret_notifications.mailer.notify.label_environment") %>&nbsp;&nbsp;</span><%= @variable.environment.label %></p>
    <% end %>
  </td></tr>
</table>

<% if @notification.url.present? %>
  <div style="margin:22px 0 0 0;">
    <%= render "mails/shared/button", label: t("secrets.secret_notifications.mailer.notify.action"), url: mail_absolute_url(@notification.url), color: MailerHelper::MAIL_ACCENT %>
  </div>
<% end %>

<p style="<%= mail_note_style %>"><%= t("secrets.secret_notifications.mailer.notify.footer") %></p>
