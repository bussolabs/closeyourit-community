<%= t("secrets.secret_notifications.mailer.notify.greeting") %>

<%= @notification.title %>

<%= t("secrets.secret_notifications.mailer.notify.label_project") %> <%= @notification.project&.name %>
<% if @variable %>
<%= t("secrets.secret_notifications.mailer.notify.label_environment") %> <%= @variable.environment.label %>
<% end %>

<%= mail_absolute_url(@notification.url) %>

<%= t("secrets.secret_notifications.mailer.notify.footer") %>
