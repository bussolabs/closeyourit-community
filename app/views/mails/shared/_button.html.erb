<%# CTA bulletproof (table-based) — locals: label, url, color (default accento indigo) %>
<% color ||= MailerHelper::MAIL_ACCENT %>
<table role="presentation" cellpadding="0" cellspacing="0"><tr>
  <td align="center" style="background-color:<%= color %>;border-radius:8px;">
    <a href="<%= url %>" style="display:inline-block;padding:11px 22px;font-family:<%= MailerHelper::FONT_SANS %>;font-size:13.5px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;"><%= label %></a>
  </td>
</tr></table>
