<%# locals: (update:) %>
<%# CYRA-1035 — on every page for the god of a community install, while a newer release waits or runs. %>
<%# CYRA-1160 — red while the stored security list marks the running version as insecure. %>
<% busy = %i[queued running].include?(update.state) %>
<% insecurity = update.insecurity %>
<% if update.available || busy || insecurity %>
  <% tone = insecurity ? :red : :indigo %>
  <% styles = {
       indigo: { bar: "bg-indigo-50 dark:bg-indigo-500/15 border-indigo-200 dark:border-indigo-500/40", icon: "text-indigo-600 dark:text-indigo-400", text: "text-indigo-800 dark:text-indigo-200",
                 link: "text-indigo-700 dark:text-indigo-300 hover:text-indigo-900 dark:hover:text-indigo-100" },
       red: { bar: "bg-red-50 dark:bg-red-500/15 border-red-200 dark:border-red-500/40", icon: "text-red-600 dark:text-red-400", text: "text-red-800 dark:text-red-200",
              link: "text-red-700 dark:text-red-300 hover:text-red-900 dark:hover:text-red-100" }
     }.fetch(tone) %>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 border-b <%= styles[:bar] %>" data-test="instance-update-strip" data-tone="<%= tone %>">
    <%= render Ui::IconComponent.new(name: (busy ? "loader-circle" : (insecurity ? "triangle-alert" : "circle-arrow-up")), class: "#{styles[:icon]} text-[13px]") %>
    <p class="text-[12.5px] <%= styles[:text] %>">
      <% if busy %>
        <%= t("valhalla.instance_update.strip_running") %>
      <% elsif insecurity %>
        <%= t("valhalla.instance_update.strip_insecure", current: update.current_version, fixed_in: insecurity.fixed_in) %>
      <% else %>
        <%= t("valhalla.instance_update.strip_available", version: update.available.version, current: update.current_version) %>
      <% end %>
    </p>
    <%= link_to t("valhalla.instance_update.strip_open"), valhalla_root_path(anchor: "instance-update"),
          class: "ml-auto text-[12px] font-medium underline underline-offset-2 #{styles[:link]}", data: { test: "instance-update-strip-open" } %>
  </div>
<% end %>
