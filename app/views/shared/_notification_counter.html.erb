<%# Contatore in flusso accanto all'icona nella pill topbar (no absolute; ms-1.5), così il segmento si allarga invece di far sforare il badge oltre il bordo. Cap a "99+". Locals: count:, label:, test_id? %><%- if count.to_i.positive? -%>
<%= tag.span(count.to_i > 99 ? "99+" : count, "aria-label": label, data: (local_assigns[:test_id] ? { test: local_assigns[:test_id] } : {}), class: "ms-1.5 inline-flex items-center justify-center min-w-[16px] h-4 px-1 rounded-full bg-indigo-600 text-white font-mono text-[9.5px] font-semibold") -%>
<%- end -%>
