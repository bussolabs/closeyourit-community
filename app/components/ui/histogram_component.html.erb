<%# CYRA-570 — periodo senza niente da disegnare: una riga che lo dice, non quarantotto barrette
    tutte alte uguale dentro un riquadro alto un quarto di schermata. La frase è a schermo (prima
    esisteva solo nel summary per i lettori di schermo) e sostituisce plot, assi e tooltip. %>
<% if no_data? %>
  <%= render Ui::EmptyNoteComponent.new(text: empty_text, inset: true, class: "text-center", test_id: "#{@buckets_test_id}-empty") %>
<% else %>
<div class="relative" data-controller="ui--scroll-hint">
<div class="overflow-x-auto" data-ui--scroll-hint-target="scroller">
<div class="px-4 pb-4 pt-3 min-w-(--histogram-min-width) md:min-w-0" style="<%= min_width_style %>" data-controller="monitoring--histogram">
  <div class="flex gap-2">
    <%# Gutter Y: etichette valore allineate alle gridline (bottom = pct del fondo scala) %>
    <div class="relative shrink-0 h-28 font-mono text-[10px]" style="<%= gutter_style %>" aria-hidden="true">
      <% @gridlines.each do |g| %>
        <% style, extra = ytick_style(g[:pct]) %>
        <span class="absolute right-0 whitespace-nowrap leading-none text-gray-500 dark:text-zinc-400 <%= extra %>" style="<%= style %>"><%= g[:value] %></span>
      <% end %>
    </div>
    <%# Plot: gridline dietro, barre davanti (ordine DOM) %>
    <div class="relative flex-1 h-28">
      <% @gridlines.each do |g| %>
        <span class="absolute inset-x-0 border-t <%= g[:baseline] ? "border-solid" : "border-dashed" %> border-stone-200 dark:border-zinc-800" style="bottom: <%= g[:pct] %>%" <%= 'data-zero-baseline'.html_safe if g[:baseline] %> aria-hidden="true"></span>
      <% end %>
      <%# aria-hidden solo se NON interattivo: con barre-link la riga dev'essere raggiungibile (CYRA-46). %>
      <div class="absolute inset-0 flex items-end gap-[2px]" data-test="<%= @buckets_test_id %>" <%= 'aria-hidden="true"'.html_safe unless interactive? %>>
        <% @bars.each do |bar| %>
          <% if bar[:href].present? %>
            <%# Barra cliccabile: link a piena altezza colonna (area di click ampia), barra visibile in
                basso; drill-down al blocco temporale. Il ring evidenzia il blocco selezionato. %>
            <a href="<%= bar[:href] %>"
               class="group flex-1 self-stretch flex items-end rounded-[2px] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 <%= "ring-2 ring-indigo-500 dark:ring-indigo-400 ring-offset-1" if bar[:active] %>"
               aria-label="<%= bar[:aria_label] %>"
               title="<%= bar[:aria_label] %>"
               data-test="bucket-link"
               data-monitoring--histogram-target="bar"
               data-label="<%= bar[:time_label] %>"
               data-value="<%= bar[:value_line] %>"
               data-action="mouseenter->monitoring--histogram#show mouseleave->monitoring--histogram#hide">
              <span class="w-full rounded-[2px] <%= bar[:color_class] %>" style="<%= bar_style(bar) %>"></span>
            </a>
          <% elsif bar[:unsampled] %>
            <%# Blocco senza campioni: fascia tratteggiata a piena altezza (CYRA-457). "Non misurato",
                distinto da una barra minima a valore zero. Stesso tooltip (finestra + "nessun dato"). %>
            <span class="flex-1 self-stretch rounded-[2px] bg-hatch"
                  <%= 'aria-hidden="true"'.html_safe if interactive? %>
                  data-monitoring--histogram-target="bar"
                  data-label="<%= bar[:time_label] %>"
                  data-value="<%= bar[:value_line] %>"
                  data-action="mouseenter->monitoring--histogram#show mouseleave->monitoring--histogram#hide"></span>
          <% else %>
            <span class="flex-1 rounded-[2px] <%= bar[:color_class] %> <%= "ring-2 ring-indigo-500 dark:ring-indigo-400 ring-offset-1" if bar[:active] %>"
                  style="<%= bar_style(bar) %>"
                  <%= 'aria-hidden="true"'.html_safe if interactive? %>
                  data-monitoring--histogram-target="bar"
                  data-label="<%= bar[:time_label] %>"
                  data-value="<%= bar[:value_line] %>"
                  data-action="mouseenter->monitoring--histogram#show mouseleave->monitoring--histogram#hide"></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <%# Asse X: etichette temporali (allineate al plot, oltre il gutter) %>
  <div class="mt-2 flex gap-2">
    <div class="shrink-0 font-mono text-[10px]" style="<%= gutter_style %>" aria-hidden="true"></div>
    <div class="relative flex-1 h-3.5">
      <% @xticks.each do |tick| %>
        <% style, extra = xtick_style(tick[:pct]) %>
        <span class="absolute font-mono text-[10px] whitespace-nowrap text-gray-500 dark:text-zinc-400 <%= extra %>" style="<%= style %>"><%= tick[:label] %></span>
      <% end %>
    </div>
  </div>
  <p class="sr-only" data-test="<%= @buckets_test_id %>-summary"><%= @summary %></p>
  <%# Tooltip flottante: light, position:fixed dal controller. Toggle via [hidden] (mai .hidden — TS-TAILWIND-001). %>
  <div hidden role="tooltip" data-monitoring--histogram-target="tooltip"
       class="z-50 w-max max-w-[220px] rounded-md border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-2.5 py-1.5">
    <span class="block font-mono text-[10px] leading-tight text-gray-500 dark:text-zinc-400" data-monitoring--histogram-target="tooltipTime"></span>
    <span class="block text-[12px] font-semibold leading-tight text-zinc-900 dark:text-zinc-100" data-monitoring--histogram-target="tooltipValue"></span>
  </div>
</div>
</div>
<div hidden data-ui--scroll-hint-target="horizontal" aria-hidden="true"
     class="pointer-events-none absolute bottom-3 right-3 z-20 inline-flex items-center gap-1.5 rounded-md bg-zinc-900/90 px-2 py-1 text-xs font-medium text-white">
  <%= t("shared.scroll_horizontal") %><%= render Ui::IconComponent.new(name: "arrow-right", class: "text-[9px]") %>
</div>
</div>
<% end %>
