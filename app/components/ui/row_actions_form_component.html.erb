<%# Nessun `action`: lo sceglie la riga — col `formaction` del bottone, o (dentro un dialog
    condiviso) impostandolo all'apertura. Per questo il token dev'essere quello globale. %>
<%= tag.form(**form_options) do %>
  <% if protect_against_forgery? %>
    <%= hidden_field_tag(:authenticity_token, form_authenticity_token, autocomplete: "off") %>
  <% end %>
  <%= content %>
<% end %>
