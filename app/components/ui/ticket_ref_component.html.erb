<%= link_to href, title: @ticket.title, data: { test: "ticket-ref" },
            class: "inline-flex max-w-full items-baseline gap-1 rounded-md border border-stone-200 dark:border-zinc-700 px-1 align-baseline no-underline! text-zinc-700 dark:text-zinc-300 hover:border-indigo-300 dark:hover:border-indigo-500/50" do %>
  <span class="font-mono font-medium"><%= @ticket.code %></span>
  <span class="truncate"><%= short_title %></span>
  <%= render Ui::BadgeComponent.new(label: @ticket.status.display_label, color: @ticket.status.color, size: :sm, dot: true) %>
<% end %>
