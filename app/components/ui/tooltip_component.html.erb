<%= tag.span(**html_options) do %><button type="button" class="<%= trigger_klass %>" data-ui--tooltip-target="trigger" data-action="mouseenter->ui--tooltip#show mouseleave->ui--tooltip#hide focus->ui--tooltip#show blur->ui--tooltip#hide keydown.esc->ui--tooltip#hideOnEsc" aria-describedby="<%= panel_id %>" aria-label="<%= aria_label %>"><%= render Ui::IconComponent.new(name: @icon) %></button><span id="<%= panel_id %>" role="tooltip" hidden data-ui--tooltip-target="panel" class="<%= panel_klass %>"><% if @title %><span class="block font-semibold text-zinc-900 dark:text-zinc-100 mb-0.5"><%= @title %></span><% end %><%= @text %></span><% end %>
