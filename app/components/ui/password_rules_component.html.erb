<%= tag.ul(**html_options) do %>
  <% rules.each do |rule| %>
    <%# met_text/unmet_text: stringhe tradotte lette dal controller Stimulus per aggiornare lo
        span sr-only sotto — evita di hardcodare lingua in JS. %>
    <%= tag.li(class: "flex items-center gap-1.5 text-gray-500 dark:text-zinc-400", data: {
          "ui--password-rules-target" => "rule", "rule" => rule,
          "met-text" => t("auth.password_rules.status.met"),
          "unmet-text" => t("auth.password_rules.status.unmet")
        }) do %>
      <%= render Ui::IconComponent.new(name: "circle", class: "w-[1.25em] text-[8px] text-gray-300 dark:text-zinc-600") %><%= t("auth.password_rules.#{rule}") %>
      <%# Equivalente testuale per gli AT dello stato icona/colore (oltre a icona/colore). %>
      <span class="sr-only" data-status><%= t("auth.password_rules.status.unmet") %></span>
    <% end %>
  <% end %>
<% end %>
