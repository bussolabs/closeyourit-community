<%= tag.div(**wrapper_options) do %>
  <span class="inline-flex items-center justify-center <%= icon_size %> rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-400 dark:text-zinc-500">
    <%= render Ui::IconComponent.new(name: icon) %>
  </span>
  <h2 class="mt-3 font-display <%= title_size %> font-semibold text-zinc-900 dark:text-zinc-100" data-test="empty-title"><%= title %></h2>
  <p class="mt-1.5 text-[12.5px] text-gray-500 dark:text-zinc-400 leading-relaxed <%= text_width %>" data-test="empty-body"><%= body %></p>
  <%# L'esempio è la parte che rende afferrabile la spiegazione: sta più in basso e più leggero.
      Può mancare solo quando insegnerebbe un'azione a chi non può farla (CYRA-692): in quel caso
      niente paragrafo vuoto. %>
  <% if example.present? %>
    <p class="mt-2 text-[12px] text-gray-400 dark:text-zinc-500 leading-relaxed <%= text_width %>" data-test="empty-example"><%= example %></p>
  <% end %>
  <% if action? %>
    <div class="mt-4"><%= action %></div>
  <% end %>
<% end %>
