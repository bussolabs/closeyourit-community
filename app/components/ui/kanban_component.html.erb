<%= tag.div(**html_options) do %>
  <%= toolbar %>
  <div class="relative min-h-0 flex-1 overflow-hidden" data-controller="ui--scroll-hint">
    <div class="h-full overflow-x-auto p-2" data-ui--scroll-hint-target="scroller">
      <div class="flex h-full gap-2">
        <% columns.each do |column| %><%= column %><% end %>
      </div>
    </div>
    <div hidden data-ui--scroll-hint-target="horizontal" aria-hidden="true"
         class="pointer-events-none absolute bottom-4 right-3 z-20 inline-flex items-center gap-1.5 rounded-md bg-zinc-900/90 px-2.5 py-1.5 text-xs font-medium text-white">
      <%= t("shared.scroll_horizontal") %><%= render Ui::IconComponent.new(name: "arrow-right", class: "text-[9px]") %>
    </div>
  </div>
<% end %>
