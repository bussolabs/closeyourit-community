<%= tag.div(**html_options) do %>
  <%= toolbar %>
  <% if no_results? %>
    <%= no_results %>
  <% else %>
    <% if groups? %>
      <div class="divide-y divide-stone-200 dark:divide-zinc-800">
        <% groups.each do |group| %><%= group %><% end %>
      </div>
    <% end %>
  <% end %>
  <% if setup_items? %>
    <div class="flex flex-wrap items-center gap-2 border-t border-stone-100 dark:border-zinc-800 px-4 py-3 text-[12px]" <%= tag.attributes(data: { test: setup_test_id }) %>>
      <span class="font-mono uppercase text-[10px] tracking-[1.2px] text-gray-500 dark:text-zinc-400"><%= t("ui.card_grid.to_set_up") %></span>
      <% setup_items.each do |item| %><%= item %><% end %>
    </div>
  <% end %>
  <% if more? && !no_results? %>
    <div class="flex justify-center border-t border-stone-200 dark:border-zinc-800 px-4 py-3"><%= more %></div>
  <% end %>
<% end %>
