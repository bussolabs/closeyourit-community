<%= tag.div(**wrapper_options) do %>
  <span class="inline-flex items-center justify-center <%= icon_size %> rounded-full bg-stone-100 dark:bg-zinc-800 text-gray-400 dark:text-zinc-500">
    <%= render Ui::IconComponent.new(name: icon) %>
  </span>
  <h2 class="mt-3 font-display <%= title_size %> font-semibold text-zinc-900 dark:text-zinc-100" data-test="no-results-title"><%= title %></h2>
  <%# Il corpo è la frase che smentisce il «non esiste niente»: cita quanti elementi ci sono davvero.
      Facoltativo perché nelle colonne strette della bacheca non ci sta, e lì il conteggio reale è
      già scritto nella testata della colonna. %>
  <% if body.present? %>
    <p class="mt-1.5 text-[12.5px] text-gray-500 dark:text-zinc-400 leading-relaxed <%= text_width %>" data-test="no-results-body"><%= body %></p>
  <% end %>
  <div class="mt-4 flex items-center flex-wrap justify-center gap-2">
    <%= render Ui::ButtonComponent.new(label: reset_label, href: reset_href, variant: :primary,
          size: :sm, icon: "x", test_id: reset_test_id, data: reset_data) %>
    <% actions.each do |extra| %><%= extra %><% end %>
  </div>
<% end %>
