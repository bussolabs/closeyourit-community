<div class="flex items-center gap-2.5" data-test="<%= test_id %>">
  <span class="font-mono text-[10px] uppercase tracking-[1px] text-gray-500 dark:text-zinc-400 shrink-0 w-36 truncate" title="<%= label %>"><%= label %></span>
  <span class="h-1.5 flex-1 rounded-full bg-stone-100 dark:bg-zinc-800 overflow-hidden">
    <span class="block h-full rounded-full <%= fill_class %>" style="<%= fill_style %>" data-test="<%= fill_test_id %>"></span>
  </span>
  <span class="font-mono text-[11.5px] text-zinc-900 dark:text-zinc-100 shrink-0 tabular-nums"><%= value_text %></span>
</div>
