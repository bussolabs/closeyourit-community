<%= tag.div(**html_options) do %>
  <% if header? %>
    <div class="flex items-center justify-between px-4 py-3 border-b border-stone-200 dark:border-zinc-800"><%= header %></div>
  <% end %>
  <div class="px-4 py-4 text-[13px] text-gray-500 dark:text-zinc-400"><%= content %></div>
  <% if footer? %>
    <div class="flex items-center justify-end gap-2 px-4 py-3 border-t border-stone-200 dark:border-zinc-800"><%= footer %></div>
  <% end %>
<% end %>
