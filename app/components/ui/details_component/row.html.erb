<%= tag.div(**html_options) do %>
  <span class="flex shrink-0 items-baseline gap-2 text-gray-500 dark:text-zinc-400"><%= @label %><%= @action %></span>
  <div class="flex min-w-0 flex-wrap items-center gap-1.5 text-zinc-900 dark:text-zinc-100 sm:justify-end sm:text-right"><%= content.presence || @value %></div>
<% end %>
