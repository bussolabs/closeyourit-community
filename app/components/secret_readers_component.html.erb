<section class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="<%= test_id %>">
  <div class="flex items-center gap-2.5 px-4 py-3 border-b border-stone-200 dark:border-zinc-800">
    <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 shrink-0"><%= render Ui::IconComponent.new(name: "user-lock", class: "text-[12px]") %></span>
    <div class="min-w-0">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.secret_readers.title") %></h2>
      <p class="text-[12px] text-gray-500 dark:text-zinc-400" data-test="secret-readers-count"><%= t("member.secret_readers.count", count: readers.size) %></p>
    </div>
  </div>

  <div class="px-4 py-3">
    <% if readers.empty? %>
      <%= render Ui::EmptyNoteComponent.new(text: t("member.secret_readers.empty"), test_id: "secret-readers-empty") %>
    <% elsif reveal_names %>
      <ul class="flex flex-wrap gap-1.5" data-test="secret-readers-list">
        <% readers.each do |reader| %>
          <li class="inline-flex items-center gap-1.5 rounded-md border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-800 px-2 py-1" data-test="secret-reader">
            <span class="text-[12.5px] text-zinc-800 dark:text-zinc-200"><%= reader.account.name %></span>
            <%= render Ui::BadgeComponent.new(label: t("member.roles.#{reader.role}"), color: role_color(reader.role), size: :sm) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-[12.5px] text-gray-600 dark:text-zinc-400" data-test="secret-readers-hidden"><%= t("member.secret_readers.hidden_hint") %></p>
    <% end %>

    <% if permissions_href %>
      <%= link_to permissions_href, class: "mt-3 inline-flex items-center gap-1 text-[12px] font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300", data: { test: "secret-readers-permissions-link" } do %>
        <%= render Ui::IconComponent.new(name: "arrow-up-right-from-square", class: "text-[10px]") %><%= t("member.secret_readers.manage_link") %>
      <% end %>
    <% end %>
  </div>
</section>
