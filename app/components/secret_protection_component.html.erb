<section class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900" data-test="<%= test_id %>">
  <div class="flex items-start gap-2.5 px-4 py-3.5">
    <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 shrink-0"><%= render Ui::IconComponent.new(name: "shield-half", class: "text-[12px]") %></span>
    <div class="min-w-0 space-y-1.5">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.secret_protection.title") %></h2>
      <ul class="space-y-1 text-[12.5px] text-gray-600 dark:text-zinc-400 leading-relaxed">
        <li class="flex items-start gap-2" data-test="secret-protection-encryption"><%= render Ui::IconComponent.new(name: "lock", class: "text-[10px] text-gray-400 dark:text-zinc-500 mt-1 w-3.5 text-center") %><span><%= t("member.secret_protection.encryption.#{kind}") %></span></li>
        <li class="flex items-start gap-2" data-test="secret-protection-audit"><%= render Ui::IconComponent.new(name: "history", class: "text-[10px] text-gray-400 dark:text-zinc-500 mt-1 w-3.5 text-center") %><span><%= t("member.secret_protection.audit") %></span></li>
        <li class="flex items-start gap-2" data-test="secret-protection-retention"><%= render Ui::IconComponent.new(name: "infinity", class: "text-[10px] text-gray-400 dark:text-zinc-500 mt-1 w-3.5 text-center") %><span><%= t("member.secret_protection.retention") %></span></li>
      </ul>
    </div>
  </div>
</section>
