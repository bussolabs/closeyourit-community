<%= content_tag(wrapper_tag, class: "group rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900", data: { test: test_id, controller: "tabs" }) do %>
  <%= content_tag(header_tag, class: header_class) do %>
    <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 shrink-0"><%= render Ui::IconComponent.new(name: "terminal", class: "text-[12px]") %></span>
    <div class="min-w-0">
      <h2 class="font-display text-[14px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t("member.secret_usage.title") %></h2>
      <p class="text-[12px] text-gray-500 dark:text-zinc-400"><%= t("member.secret_usage.subtitle") %></p>
    </div>
    <% if collapsible %><%= render Ui::IconComponent.new(name: "chevron-down", class: "ml-auto text-[10px] text-gray-400 dark:text-zinc-500 -rotate-90 group-open:rotate-0 motion-safe:transition-transform") %><% end %>
  <% end %>

  <div class="px-4 py-4 space-y-3">
    <% if shared? %>
      <%= render Ui::AlertComponent.new(variant: :info, test_id: "secret-usage-shared-note") do %>
        <%= t("member.secret_usage.shared_note") %>
      <% end %>
    <% end %>

    <%= picker if picker? %>

    <%# Barra schede — progressive enhancement: senza JS nessun pannello è nascosto, restano tutti leggibili. %>
    <div class="flex flex-wrap gap-1.5" role="tablist">
      <button type="button" role="tab" data-test="secret-usage-tab-local" data-tabs-target="tab" data-action="tabs#select" data-tabs-index-param="0"
              class="h-7 rounded-md border border-stone-200 dark:border-zinc-800 px-2.5 font-mono text-[11px] text-gray-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 aria-selected:border-indigo-300 dark:aria-selected:border-indigo-500/50 aria-selected:bg-indigo-50 dark:aria-selected:bg-indigo-500/15 aria-selected:text-indigo-700 dark:aria-selected:text-indigo-300">
        <%= render Ui::IconComponent.new(name: "laptop", class: "text-[10px] mr-1") %><%= t("member.secret_usage.tab_local") %>
      </button>
      <button type="button" role="tab" data-test="secret-usage-tab-ci" data-tabs-target="tab" data-action="tabs#select" data-tabs-index-param="1"
              class="h-7 rounded-md border border-stone-200 dark:border-zinc-800 px-2.5 font-mono text-[11px] text-gray-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 aria-selected:border-indigo-300 dark:aria-selected:border-indigo-500/50 aria-selected:bg-indigo-50 dark:aria-selected:bg-indigo-500/15 aria-selected:text-indigo-700 dark:aria-selected:text-indigo-300">
        <%= render Ui::IconComponent.new(name: "bot", class: "text-[10px] mr-1") %><%= t("member.secret_usage.tab_ci") %>
      </button>
      <button type="button" role="tab" data-test="secret-usage-tab-server" data-tabs-target="tab" data-action="tabs#select" data-tabs-index-param="2"
              class="h-7 rounded-md border border-stone-200 dark:border-zinc-800 px-2.5 font-mono text-[11px] text-gray-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 aria-selected:border-indigo-300 dark:aria-selected:border-indigo-500/50 aria-selected:bg-indigo-50 dark:aria-selected:bg-indigo-500/15 aria-selected:text-indigo-700 dark:aria-selected:text-indigo-300">
        <%= render Ui::IconComponent.new(name: "server", class: "text-[10px] mr-1") %><%= t("member.secret_usage.tab_server") %>
      </button>
    </div>

    <%# Scheda 0 — sul computer di chi sviluppa %>
    <div data-test="secret-usage-panel-local" data-tabs-target="panel" class="space-y-2.5">
      <p class="text-[12.5px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.secret_usage.local_intro") %></p>
      <%= render "member/secrets/usage_snippet", label: t("member.secret_usage.label_command"), lines: snippets.local %>
      <% if personal? %>
        <p class="text-[12px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.secret_usage.direnv_note") %></p>
        <%= render "member/secrets/usage_snippet", label: ".envrc", lines: snippets.local_direnv %>
      <% end %>
      <% if multi_environment? %>
        <p data-test="secret-usage-env-note" class="text-[11.5px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.secret_usage.env_note", codes: environment_codes.join(", ")) %></p>
      <% end %>
    </div>

    <%# Scheda 1 — build automatiche (GitHub Actions dedicato + altri sistemi, chiarimento CYRA-401) %>
    <div data-test="secret-usage-panel-ci" data-tabs-target="panel" class="space-y-3">
      <% if snippets.ci_github %>
        <div data-test="secret-usage-ci-github" class="space-y-1.5">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[1px] text-gray-500 dark:text-zinc-400"><%= t("member.secret_usage.ci_github_title") %></p>
          <p class="text-[12.5px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t("member.secret_usage.ci_github_note") %></p>
          <%= render "member/secrets/usage_snippet", label: t("member.secret_usage.ci_github_title"), lines: snippets.ci_github %>
        </div>
      <% end %>
      <div data-test="secret-usage-ci-generic" class="space-y-1.5">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[1px] text-gray-500 dark:text-zinc-400"><%= t("member.secret_usage.ci_generic_title") %></p>
        <p class="text-[12.5px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t(personal? ? "member.secret_usage.ci_personal_note" : "member.secret_usage.ci_generic_note") %></p>
        <%= render "member/secrets/usage_snippet", label: t("member.secret_usage.ci_generic_title"), lines: snippets.ci_generic %>
      </div>
      <% unless personal? %>
        <p class="text-[11.5px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.secret_usage.token_note") %></p>
      <% end %>
    </div>

    <%# Scheda 2 — sul server %>
    <div data-test="secret-usage-panel-server" data-tabs-target="panel" class="space-y-2.5">
      <p class="text-[12.5px] text-gray-600 dark:text-zinc-400 leading-relaxed"><%= t(personal? ? "member.secret_usage.ci_personal_note" : "member.secret_usage.server_note") %></p>
      <%= render "member/secrets/usage_snippet", label: t("member.secret_usage.label_command"), lines: snippets.server %>
      <% unless personal? %>
        <p class="text-[11.5px] text-gray-500 dark:text-zinc-400 leading-relaxed"><%= t("member.secret_usage.token_note") %></p>
      <% end %>
    </div>
  </div>
<% end %>
