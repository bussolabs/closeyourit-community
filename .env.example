# Placeholder — valori applicativi reali su CloseYourIt (NON generare .env su disco: usa `cyi run`).
# Database (sviluppo locale: postgres locale)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/closeyourit_development
QUEUE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/closeyourit_queue_development

# Rails
SECRET_KEY_BASE=change_me_in_production

# ActiveRecord::Encryption — cifratura at-rest dei secret del vault (dominio Secrets::).
# Bootstrap di CloseYourIt: arrivano dal canale gestito dall'operatore. Genera con `bin/rails db:encryption:init`.
# In development/test un fallback locale non-segreto è già impostato in config/environments/*.
# ATTENZIONE: perdere queste chiavi = perdere tutti i valori cifrati (backup su 1Password).
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
SECRET_ASSETS_MASTER_KEY=

# GitHub App (integrazione repo↔progetto, binding tag→release, branch/PR↔ticket).
# App unica "CloseYourIt" installata sull'org; valori reali su CloseYourIt CYRA. Nel DB solo
# installation_id; gli installation-token si coniano a richiesta con la private key qui sotto.
GH_APP_ID=
GH_APP_SLUG=closeyourit
GH_APP_PRIVATE_KEY=
GH_WEBHOOK_SECRET=

# Self-monitoring via server ingest indipendente. Senza token il client resta no-op.
CLOSEYOURIT_ENDPOINT_URL=https://ingest.example.com
CLOSEYOURIT_PROJECT_ID=
CLOSEYOURIT_ENVIRONMENT=development
CLOSEYOURIT_TOKEN=
