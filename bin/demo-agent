#!/usr/bin/env bash
# Compatibility entrypoint for bin/dev; the laboratory lives in its own repository.
set -euo pipefail
cd "$(dirname "$0")/.."
labs="../closeyourit-labs/bin/simulator"
if [ ! -f "$labs" ]; then
  echo "Laboratory unavailable: clone closeyourit-labs beside closeyourit-rails."
  exit 0
fi
exec "$labs" run "$@"
