<%= render(Ui::CardComponent.new) do |card| %>
  <% card.with_header do %>
    <h3 class="font-display text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Titolo card</h3>
  <% end %>
  Corpo della card. Superficie flat, bordo 1px, niente shadow.
  <% card.with_footer do %>
    <%= render(Ui::ButtonComponent.new(label: "Annulla", variant: :ghost, size: :sm)) %>
    <%= render(Ui::ButtonComponent.new(label: "Salva", size: :sm)) %>
  <% end %>
<% end %>
