<div class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
  <%= render(Ui::TableToolbarComponent.new(url: "#", search_placeholder: "Search…", count: "38 results", search_test_id: "demo-search", test_id: "demo-toolbar")) do |toolbar| %>
    <% toolbar.with_filter(key: "status", label: "Status") do %>
      <div class="w-40"><%= render(Ui::SelectComponent.new(name: "status", multiple: true, summary: true, options: [ [ "Open", "open", "amber" ], [ "In progress", "in_progress", "indigo" ] ], placeholder: "Status", test_id: "demo-filter-status")) %></div>
    <% end %>
  <% end %>
  <div class="px-4 py-10 text-center text-[12px] text-gray-400 dark:text-zinc-500">— table —</div>
</div>
