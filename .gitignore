# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# CYRA-711 — quanto dura ogni prova è una misura, non un file temporaneo: senza, la suite parallela
# divide i gruppi per dimensione dei file e dura di più senza dirlo. Sta qui perché è il percorso
# che parallel_tests legge da sé (rspec/runner.rb), e `rails tmp:clear` non lo tocca.
!/tmp/parallel_runtime_rspec.log

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Credenziali Rails cifrate: non usate (i secret stanno su ENV/CloseYourIt; bootstrap dichiarato) → mai versionate.
/config/credentials.yml.enc
/config/credentials/*.yml.enc


/app/assets/builds/*
!/app/assets/builds/.keep

# Versiona il template ENV (placeholder) anche se /.env* è ignorato.
!/.env.example

# Overmind socket (dev) + coverage output.
/.overmind.sock
/coverage
# Resultset degli shard scaricati dai controlli automatici (input di `rake coverage:collate`):
# compare anche in locale se si prova la collazione a mano.
/coverage-results

# Superdesign genera template intermedi prima di caricarli nel canvas.
/.superdesign/tmp/

# Claude Code — worktree/sessione (mai committare), tranne i command e le skill versionati
.claude/*
!.claude/commands/
!.claude/skills/

# Installazione delle librerie: non deve MAI finire nel repository.
# Un `bundle install` con path dentro il progetto scarica qui migliaia di file (una volta ne sono
# arrivati 15.608, 372 MB) e il ramo diventa impubblicabile. Le gem vanno fuori dal progetto:
# `~/.bundle/config` con BUNDLE_PATH. `/bin` NON va ignorato: contiene i comandi veri del progetto.
/gems/
/specifications/
/extensions/
/ruby/
/cache/
/vendor/bundle/

# Ambiente/editor montati nel worktree dall'automator (dotfile shell, IDE, MCP) — mai committare.
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc

# macOS scrive un .DS_Store in ogni cartella aperta nel Finder: ne erano finiti due nel repository
# (CYRA-278). Va qui e non nel gitignore globale, che protegge una macchina sola — non chi clona.
# Senza slash iniziale la regola vale a qualsiasi profondità.
.DS_Store

# Local Coworkers layout captures include personal test data.
/.impeccable/review/
/docs/mockups/coworkers-in-app.html
**/.impeccable/hook.cache.json
